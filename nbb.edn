;; nbb reads this file. It does NOT read deps.edn, and the
;; .cljs here are run as bare `nbb <file>`, so a coordinate declared only
;; there is invisible to them.
;;
;; :paths and every sha below are COPIED from deps.edn, not chosen here.
{:paths ["src" "."]
 :deps {
        ;; Declared HERE and not only in deps.edn: nbb reads nbb.edn and does NOT
        ;; read deps.edn or bb.edn, and the .cljs in this repo are run as
        ;; bare `nbb <file>`. A coordinate they cannot see is not a
        ;; declaration. sha and :paths are COPIED from deps.edn.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
        ;; COPIED from deps.edn (git coordinate, not a Maven version): site.cljk
        ;; requires jp-go-dds.* for the render pass; without it kbb -M:render
        ;; fails with "Could not find namespace: jp-go-dds.core".
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system.git"
         :git/sha "94ffae44a8e248b196b7d0b8a692f0645c9d34b1"}
        ;; COPIED from deps.edn: chat_site/knowledge_site require cloud-kotoba-dds.
        io.github.kotoba-lang/cloud-kotoba-dds
        {:git/url "https://github.com/kotoba-lang/cloud-kotoba-dds.git"
         :git/sha "01db80709df67183fb29c0b1bae585895276b137"}
        ;; COPIED from deps.edn: scripts/uiux-audit.cljk + uiux_audit_test.cljk
        ;; require shinkansen.audit / shinkansen.coscientist.
        io.github.kotoba-lang/shinkansen
        {:git/url "https://github.com/kotoba-lang/shinkansen.git"
         :git/sha "e085c42537cceb53358fda254ef063ae1ff086c5"}
        ;; Transitive via jp-go-dds tokens (css.core): declared here because
        ;; nbb does not read the dependency's own deps.edn.
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/css.git"
         :git/sha "6eda5ee28ec177b9e09fdbee92c55a050b18cf7d"}}}
