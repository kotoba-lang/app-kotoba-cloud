{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotoba-research-authority",
  "main": "build/research/worker.js",
  "account_id": "4da88288dc30d9ee257f319d3c33ecf0",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESEARCH_RECORDS",
        "class_name": "ResearchAuthority"
      },
      {
        "name": "ORG_RECORDS",
        "class_name": "OrgAuthority2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-research-records",
      "new_sqlite_classes": [
        "ResearchAuthority"
      ]
    },
    {
      "tag": "v2-org-records",
      "new_sqlite_classes": [
        "OrgAuthority"
      ]
    },
    {
      "tag": "v3a-org-records2-add",
      "new_sqlite_classes": [
        "OrgAuthority2"
      ]
    }
  ],
  "vars": {}
}