{:deps {:aliases [:cljs]}
 :builds
 {:research-providers {:target :esm :output-dir "build/providers"
                       :modules {:providers {:exports {createSession app-kotoba-cloud.research-providers/create-session-js
                                                       verifyEvent app-kotoba-cloud.research-providers/verify-event-js
                                                       infer app-kotoba-cloud.research-providers/infer-js}}}
                       :compiler-options {:output-feature-set :es2020 :infer-externs :auto}}
  :free-sites-test
  {:target :node-test
   :output-to "build/free-sites-tests.cjs"
   :ns-regexp "app-kotoba-cloud.free-sites.*-test$"
   :autorun true}
  :browser
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:session {:init-fn app-kotoba-cloud.browser/init!}}
   :compiler-options {:output-feature-set :es2020
                      :infer-externs :auto}}
  :app
  {:target :esm
   :output-dir "build"
   :modules {:worker {:exports {default app-kotoba-cloud.worker/app
                               PqKeyRegistry app-kotoba-cloud.pq-key-registry/make-pq-key-registry
                               route app-kotoba-cloud.worker/route
                               resetFunnelStore app-kotoba-cloud.worker/reset-funnel-store!}}}
   :compiler-options {:output-feature-set :es2020
                      :infer-externs :auto}}}}
