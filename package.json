{
  "name": "@kotoba-lang/app-kotoba-cloud",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "render": "clojure -M:render",
    "build": "npm run render && shadow-cljs release browser app",
    "test": "clojure -M:test && node test/aiueos-boot-manifest-cli.mjs && node test/freebuff-attribution.mjs",
    "test:worker": "node test/worker-smoke.mjs",
    "dry-run": "npm test && npm run build && npm run test:worker && wrangler deploy --dry-run --outdir dist --env=\"\"",
    "deploy": "npm test && npm run build && npm run test:worker && wrangler deploy --env=\"\"",
    "test:contract": "forge test --root contracts",
    "build:contract": "forge build --root contracts",
    "deploy:registry": "nbb scripts/deploy-registry.cljk"
  },
  "devDependencies": {
    "shadow-cljs": "3.5.1",
    "wrangler": "^4.131.0"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1"
  }
}
