{
  "name": "@kotoba-lang/app-kotoba-cloud",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "render": "kbb -M:render",
    "build": "npm run render && amu compile --target wasm32-browser browser app",
    "test": "kbb -M:test && node test/aiueos-boot-manifest-cli.mjs",
    "test:worker": "node test/worker-smoke.mjs",
    "dry-run": "npm test && npm run build && npm run test:worker && wrangler deploy --dry-run --outdir dist --env=\"\"",
    "deploy": "npm test && npm run build && npm run test:worker && wrangler deploy --env=\"\"",
    "test:contract": "forge test --root contracts",
    "build:contract": "forge build --root contracts",
    "deploy:registry": "kbb --backend sci scripts/deploy-registry.cljk",
    "test:providers": "node test/research-providers.mjs",
    "build:security-data": "node scripts/build-security-data.mjs",
    "test:security-data": "node test/security-data.mjs"
  },
  "devDependencies": {
    "shadow-cljs": "3.5.1",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "svix": "1.92.2"
  }
}
