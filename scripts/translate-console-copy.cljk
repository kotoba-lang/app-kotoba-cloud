#!/usr/bin/env kbb
;; scripts/translate-console-copy.cljk — the console's copy in every public
;; locale, generated from the authored en / ja source over the OpenRouter API
;; (owner direction 2026-09-15 / 16: the landing page carries 22 locales, the
;; console chrome AND its bodies must too; machine translation is permitted by
;; ADR-2609091700 and is not mistaken for native review).
;;
;;   kbb --backend sci scripts/translate-console-copy.cljk --check                 ; coverage of every source, no network
;;   kbb --backend sci scripts/translate-console-copy.cljk --source account        ; the locales not yet generated for one source
;;   kbb --backend sci scripts/translate-console-copy.cljk --source account --all  ; regenerate every locale of it
;;   kbb --backend sci scripts/translate-console-copy.cljk --source account --only id,fr
;;   kbb --backend sci scripts/translate-console-copy.cljk --all-sources            ; every source, the locales not yet generated
;;
;; Sources (the registry below):
;;   :console   the chrome — (def source {key {:en :ja}}) in console_locales.cljk; keys are keywords
;;   the rest   a body namespace — every literal (txt "ja" "en") / (t "ja" "en") pair, every
;;              {:ja "…" :en "…"} data pair and (for :secure) the English-only :description /
;;              :note strings of the policy data; keys are the ENGLISH strings themselves, so a
;;              call site stays (txt "ja" "en") and the generated map answers by English
;;              (app-kotoba-cloud.copy/txt-for). A dynamic (t (str …) (str …)) is invisible to
;;              this extraction and must be written as a {placeholder} template first.
;;
;; Writes:  src/app_kotoba_cloud/<source>_copy_generated.cljk  (def copy {locale {key text}}) + provenance
;; Env:     OPENROUTER_API_KEY (required for generation), OPENROUTER_MODEL
;;          (default anthropic/claude-sonnet-5 — a model, not an alias, because
;;          this is a one-off authoring tool, not the fleet's inference path).
;;
;; Every generated locale is validated before it is written: every source key
;; present, no blank, every {placeholder} of the source kept verbatim, product
;; names kept. Long sources go to the model in batches of 40 keys. A batch that
;; fails validation rejects that locale (nothing partial is written) and is
;; reported; --check fails (exit 1) on any source × locale × key that is
;; missing or blank.
(ns translate-console-copy
  (:require [clojure.edn :as edn]
            [clojure.string :as str]
            ["node:fs" :as fs]
            ["node:process" :as proc]))

(def argv (vec (.slice (.-argv proc) 2)))
(defn- flag? [f] (some #(= % f) argv))
(defn- opt [f] (let [i (.indexOf argv f)] (when-not (neg? i) (nth argv (inc i) nil))))

(def locales-file "src/app_kotoba_cloud/public_locales.cljk")

(def sources
  "name → where its authored pairs live and where the generated map goes."
  {:console  {:kind :def-map :file "src/app_kotoba_cloud/console_locales.cljk" :def "source"
              :out "src/app_kotoba_cloud/console_copy_generated.cljk" :ns "console-copy-generated"}
   :account  {:kind :pairs :files ["src/app_kotoba_cloud/account_site.cljk" "src/app_kotoba_cloud/account_browser.cljk"]
              :out "src/app_kotoba_cloud/account_copy_generated.cljk" :ns "account-copy-generated"}
   :secure   {:kind :pairs :files ["src/app_kotoba_cloud/secure_site.cljk" "src/app_kotoba_cloud/shell_browser.cljk"]
              :en-only-files ["src/app_kotoba_cloud/secure.cljk"]
              :out "src/app_kotoba_cloud/secure_copy_generated.cljk" :ns "secure-copy-generated"}
   :models   {:kind :pairs :files ["src/app_kotoba_cloud/models_site.cljk"]
              :out "src/app_kotoba_cloud/models_copy_generated.cljk" :ns "models-copy-generated"}
   :security {:kind :pairs :files ["src/app_kotoba_cloud/security_site.cljk" "assets/security-data.js"
                                   "src/app_kotoba_cloud/security_services_site.cljk" "src/app_kotoba_cloud/security_services.cljk"]
              :out "src/app_kotoba_cloud/security_copy_generated.cljk" :ns "security-copy-generated"}
   :billing  {:kind :pairs :files ["src/app_kotoba_cloud/billing_site.cljk" "src/app_kotoba_cloud/billing_browser.cljk"]
              :out "src/app_kotoba_cloud/billing_copy_generated.cljk" :ns "billing-copy-generated"}
   :site     {:kind :pairs :files ["src/app_kotoba_cloud/site.cljk" "src/app_kotoba_cloud/apps_site.cljk"]
              :out "src/app_kotoba_cloud/site_copy_generated.cljk" :ns "site-copy-generated"}})

(defn- read-def
  "The literal of `(def <name> …)` in a .cljk file — the first collection
   opening with `open` (\"{\" or \"[\") after the def — read as EDN
   (comments allowed)."
  ([file name] (read-def file name "{"))
  ([file name open]
   (let [text (fs/readFileSync file "utf8")
         i (str/index-of text (str "(def " name))
         _ (when (nil? i) (throw (ex-info (str "no (def " name ") in " file) {})))
         ;; skip the docstring, whose own braces would otherwise be read
         after (+ i (count (str "(def " name)))
         body (str/triml (subs text after))
         start (if (str/starts-with? body "\"")
                 (loop [k 1]                        ; the closing quote, escapes skipped
                   (let [c (nth body k)]
                     (cond (= c "\\") (recur (+ k 2))
                           (= c "\"") (inc k)
                           :else (recur (inc k)))))
                 0)
         j (str/index-of body open start)]
     (edn/read-string (subs body j)))))

(defn- unescape [s] (-> s (str/replace "\\\"" "\"") (str/replace "\\\\" "\\")))
(defn- unescape-js [s] (-> s (str/replace "\\'" "'") (str/replace "\\\\" "\\")))

(def ^:private pair-re
  ;; (txt "ja" "en") / (t "ja" "en") in .cljk — whitespace / newlines between
  #"\((?:txt|t)\s+\"((?:[^\"\\]|\\.)*)\"\s+\"((?:[^\"\\]|\\.)*)\"")
(def ^:private map-pair-re
  ;; {:ja "…" :en "…"} data pairs (secure views, models labels, services catalog)
  #":ja\s+\"((?:[^\"\\]|\\.)*)\"\s+:en\s+\"((?:[^\"\\]|\\.)*)\"")
(def ^:private js-pair-re
  ;; t('ja','en') in assets/security-data.js
  #"\bt\('((?:[^'\\]|\\.)*)'\s*,\s*'((?:[^'\\]|\\.)*)'\)")
(def ^:private en-only-re
  ;; the policy data's English-only prose (secure.cljk :description / :note)
  #":(?:description|note)\s+\"((?:[^\"\\]|\\.)*)\"")

(defn- extract-pairs
  "{en {:en en :ja ja}} over the source's files. A key is the English
   string; an English string that appears with two Japanese readings keeps
   the first (the translation is made from the English)."
  [{:keys [files en-only-files]}]
  (let [from-file (fn [file]
                    (let [text (fs/readFileSync file "utf8")
                          js? (str/ends-with? file ".js")]
                      (if js?
                        (map (fn [[_ ja en]] [(unescape-js en) (unescape-js ja)]) (re-seq js-pair-re text))
                        (concat (map (fn [[_ ja en]] [(unescape en) (unescape ja)]) (re-seq pair-re text))
                                (map (fn [[_ ja en]] [(unescape en) (unescape ja)]) (re-seq map-pair-re text))))))
        en-only (mapcat (fn [file]
                          (map (fn [[_ en]] [(unescape en) (unescape en)]) (re-seq en-only-re (fs/readFileSync file "utf8"))))
                        en-only-files)]
    (reduce (fn [acc [en ja]]
              (if (or (str/blank? en) (contains? acc en)) acc (assoc acc en {:en en :ja ja})))
            {}
            (concat (mapcat from-file files) en-only))))

(defn- read-source [{:keys [kind file def] :as src}]
  (case kind
    :def-map (read-def file def)
    :pairs (extract-pairs src)))

(defn- key-name [k] (if (keyword? k) (name k) (str k)))

(def language-names
  "IANA subtag → the name the translator is told (ADR-2609091700: ar is
   Modern Standard Arabic, arz Egyptian Arabic, ar-MA Moroccan Darija, pcm
   Nigerian Pidgin — not English, pt region-neutral)."
  {:zh-Hans "Simplified Chinese" :hi "Hindi" :es "Spanish" :ar "Modern Standard Arabic"
   :fr "French" :bn "Bengali" :pt "Portuguese (region-neutral)" :id "Indonesian"
   :ur "Urdu" :ru "Russian" :de "German" :ko "Korean" :pcm "Nigerian Pidgin (Naijá — not English)"
   :arz "Egyptian Arabic (Masri, distinct from Modern Standard Arabic)" :mr "Marathi"
   :jv "Javanese" :su "Sundanese" :he "Hebrew" :it "Italian"
   :ar-MA "Moroccan Arabic (Darija, distinct from Modern Standard Arabic)"})

(defn- placeholders [s] (set (re-seq #"\{[a-zA-Z]+\}" (str s))))

(defn- validate
  "nil when `translated` (key-name→string) covers `source` faithfully; else a
   vector of reasons."
  [source translated]
  (let [reasons (for [[k {:keys [en]}] source
                      :let [v (get translated (key-name k))]
                      :when (or (not (string? v)) (str/blank? v)
                                (not= (placeholders en) (placeholders v))
                                (and (str/includes? en "Kotoba Cloud") (not (str/includes? v "Kotoba Cloud")))
                                (and (str/starts-with? en "＋ ") (not (str/starts-with? v "＋ "))))]
                  (str (key-name k) ": " (pr-str v)))]
    (when (seq reasons) (vec reasons))))

(defn- prompt [locale source]
  (str "You localize the user interface of Kotoba Cloud, a developer console for an AI research API (identity verification, research access, organizations, security controls, models, billing).\n"
       "Target language: " (get language-names locale (name locale)) " (BCP 47 " (name locale) ").\n\n"
       "SOURCE (JSON: key → English text; the English is the original):\n"
       (js/JSON.stringify (clj->js (into {} (map (fn [[k v]] [(key-name k) (:en v)]) source))) nil 1)
       "\n\nREFERENCE (the same keys in Japanese, only to disambiguate meaning):\n"
       (js/JSON.stringify (clj->js (into {} (map (fn [[k v]] [(key-name k) (:ja v)]) source))) nil 1)
       "\n\nRules:\n"
       "- Labels, buttons and status chips stay short and idiomatic for a software UI in the target language; explanations keep their full meaning.\n"
       "- Keep product, protocol and technical names: Kotoba Cloud, Stripe, Stripe Identity, Passkey, OpenID Connect, IdP, DID, did:webvh, VC, API, AI, MCP, CPE/CVE, KEV, ATT&CK, SCAP, JSON-LD, IPLD, CID, AML/CTF, AUP. URLs, e-mail addresses, code and identifiers stay verbatim.\n"
       "- Keep every {placeholder} such as {done}, {total}, {step}, {username} exactly as written.\n"
       "- Keep a leading \"＋ \" where the English has one. Keep leading / trailing spaces where the English has them (they join sentences).\n"
       "- No explanations, no quotes. Never answer in English unless the term is kept on purpose.\n"
       "OUTPUT: exactly one JSON object with exactly the SOURCE keys, and every value a plain string in the target language — never a nested object.\n"))

(defn- first-json-object
  "The first balanced {…} of `text` (a model sometimes appends a second
   object or prose after its answer)."
  [text]
  (let [i (str/index-of text "{")]
    (when i
      (loop [k i depth 0 in-str? false esc? false]
        (when (< k (count text))
          (let [c (nth text k)]
            (cond
              esc? (recur (inc k) depth in-str? false)
              (and in-str? (= c "\\")) (recur (inc k) depth in-str? true)
              (= c "\"") (recur (inc k) depth (not in-str?) false)
              in-str? (recur (inc k) depth in-str? false)
              (= c "{") (recur (inc k) (inc depth) in-str? false)
              (= c "}") (if (= depth 1) (subs text i (inc k)) (recur (inc k) (dec depth) in-str? false))
              :else (recur (inc k) depth in-str? false))))))))

(defn- plain-value
  "A translated value as a string: the string itself, or — when the model
   mirrored the input shape — the target-language / value member of an
   object. Anything else is nil (rejected by validate)."
  [locale v]
  (cond
    (string? v) v
    (map? v) (some #(let [x (get v %)] (when (string? x) x))
                   [(name locale) "value" "translation" "text" "target"])
    :else nil))

(defn- translate-batch! [locale source]
  (let [key (.-OPENROUTER_API_KEY (.-env proc))
        model (or (.-OPENROUTER_MODEL (.-env proc)) "anthropic/claude-sonnet-5")]
    (when (str/blank? key) (throw (ex-info "OPENROUTER_API_KEY is not set" {})))
    (-> (js/fetch "https://openrouter.ai/api/v1/chat/completions"
                  #js {:method "POST"
                       :headers #js {"authorization" (str "Bearer " key)
                                     "content-type" "application/json"
                                     "http-referer" "https://kotoba.cloud"
                                     "x-title" "kotoba.cloud console copy"}
                       :body (js/JSON.stringify
                              #js {:model model
                                   :temperature 0.2
                                   :max_tokens 16000
                                   :response_format #js {:type "json_object"}
                                   :messages #js [#js {:role "user" :content (prompt locale source)}]})})
        (.then (fn [r] (.then (.json r) (fn [j] [(.-status r) j]))))
        (.then (fn [[status j]]
                 (let [content (some-> j .-choices (aget 0) .-message .-content)]
                   (when (or (not= 200 status) (nil? content))
                     (throw (ex-info (str "openrouter " status ": " (subs (js/JSON.stringify j) 0 300)) {})))
                   (let [text (or (first-json-object (str content))
                                  (throw (ex-info (str "no JSON object in the answer: " (subs (str content) 0 200)) {})))
                         obj (js->clj (js/JSON.parse text))]
                     {:model (or (.-model j) model)
                      :translated (into {} (map (fn [[k v]] [k (plain-value locale v)]) obj))})))))))

(def batch-size 40)

(defn- translate!
  "All of `source` for `locale`, in batches; a batch that fails validation
   rejects the whole locale (nothing partial is written)."
  [locale source]
  (let [batches (partition-all batch-size (sort-by (comp key-name first) source))]
    (reduce (fn [p batch]
              (.then p (fn [acc]
                         (let [part (into {} batch)]
                           (-> (translate-batch! locale part)
                               (.then (fn [{:keys [model translated]}]
                                        (if-let [reasons (validate part translated)]
                                          (throw (ex-info (str "batch rejected: " (str/join "; " (take 5 reasons))
                                                               (when (> (count reasons) 5) (str " … +" (- (count reasons) 5))))
                                                          {}))
                                          (-> acc
                                              (update :translated merge translated)
                                              (assoc :model model))))))))))
            (js/Promise.resolve {:translated {} :model nil})
            batches)))

(defn- read-generated [{:keys [out]}]
  (if (fs/existsSync out)
    {:copy (read-def out "copy") :provenance (read-def out "provenance")}
    {:copy {} :provenance {}}))

(defn- write-generated! [{:keys [out ns]} source-name {:keys [copy provenance]}]
  (let [ordered (into (sorted-map) (map (fn [[loc m]] [loc (into (sorted-map) m)]) copy))
        prov (into (sorted-map) provenance)]
    (fs/writeFileSync
     out
     (str "(ns app-kotoba-cloud." ns "\n"
          "  \"GENERATED by scripts/translate-console-copy.cljk --source " (name source-name) " — do not edit by hand.\n"
          "   Copy for every public locale other than en / ja, machine-translated from the\n"
          "   authored source over the OpenRouter API (keys: keywords for the console chrome,\n"
          "   the English strings themselves for a body — app-kotoba-cloud.copy/txt-for answers\n"
          "   by them). `provenance` names the model and date per locale; none of it is\n"
          "   native-speaker reviewed (ADR-2609091700 permits machine translation and forbids\n"
          "   claiming review). Regenerate a locale with --only <code>.\")\n\n"
          "(def provenance\n  " (pr-str prov) ")\n\n"
          "(def copy\n  " (pr-str ordered) ")\n"))))

(defn- coverage
  "[missing-count report-lines] over every locale except en / ja."
  [source locale-order copy]
  (let [targets (remove #{:en :ja} locale-order)
        rows (for [loc targets
                   [k {:keys [en]}] source
                   :let [v (get-in copy [loc k])]
                   :when (or (not (string? v)) (str/blank? v) (not= (placeholders en) (placeholders v)))]
               (str (name loc) "\t" (subs (key-name k) 0 (min 60 (count (key-name k)))) "\t" (pr-str (when (string? v) (subs v 0 (min 40 (count v)))))))]
    [(count rows) rows]))

(defn- source-keys
  "The generated map is keyed like the source: keywords for :def-map,
   strings for :pairs."
  [{:keys [kind]} translated]
  (into {} (map (fn [[k v]] [(if (= kind :def-map) (keyword k) k) v]) translated)))

(defn- run-source! [source-name locale-order]
  (let [src (get sources source-name)
        _ (when-not src (throw (ex-info (str "unknown source " source-name " — one of " (str/join " " (map name (keys sources)))) {})))
        source (read-source src)
        targets (vec (remove #{:en :ja} locale-order))
        gen (read-generated src)
        only (some-> (opt "--only") (str/split #",") (->> (map keyword) set))
        todo (cond
               only (filter only targets)
               (flag? "--all") targets
               :else (remove #(let [[n _] (coverage source [%] (:copy gen))] (zero? n)) targets))]
    (println (str (name source-name) ": " (count source) " keys; translating " (count todo) " locale(s): " (str/join " " (map name todo))))
    (-> (reduce (fn [p loc]
                  (.then p (fn [acc]
                             (-> (translate! loc source)
                                 (.then (fn [{:keys [model translated]}]
                                          (println (str "OK\t" (name source-name) "\t" (name loc) "\t" (count translated) " keys\t" model))
                                          (-> acc
                                              (assoc-in [:copy loc] (source-keys src translated))
                                              (assoc-in [:provenance loc] {:model model :date (subs (.toISOString (js/Date.)) 0 10)}))))
                                 (.catch (fn [e] (println (str "FAILED\t" (name source-name) "\t" (name loc) "\t" (.-message e))) acc))))))
                (js/Promise.resolve gen)
                todo)
        (.then (fn [acc]
                 (write-generated! src source-name acc)
                 (let [[n _] (coverage source locale-order (:copy acc))]
                   (println (str "wrote " (:out src) " — locales " (count (:copy acc)) ", missing " n))
                   n))))))

(defn -main []
  (let [locale-order (read-def locales-file "locale-order" "[")
        targets (vec (remove #{:en :ja} locale-order))]
    (cond
      (flag? "--check")
      (let [total (atom 0) scanned (atom 0)]
        (doseq [[source-name src] (sort-by (comp name key) sources)]
          (let [source (read-source src)
                [n rows] (coverage source locale-order (:copy (read-generated src)))]
            (swap! scanned + (* (count targets) (count source)))
            (swap! total + n)
            (println (str "SOURCE\t" (name source-name) "\t" (count source) " keys\tmissing " n))
            (doseq [r (take 20 rows)] (println (str "MISSING\t" (name source-name) "\t" r)))))
        (println (str "SCANNED\t" @scanned "\tlocales " (count targets)))
        (println (str "MISSING\t" @total))
        (.exit proc (if (zero? @total) 0 1)))

      (flag? "--all-sources")
      (-> (reduce (fn [p s] (.then p (fn [acc] (.then (run-source! s locale-order) (fn [n] (+ acc n))))))
                  (js/Promise.resolve 0)
                  (sort (keys sources)))
          (.then (fn [n] (.exit proc (if (zero? n) 0 1)))))

      :else
      (let [source-name (keyword (or (opt "--source") "console"))]
        (.then (run-source! source-name locale-order)
               (fn [n] (.exit proc (if (zero? n) 0 1))))))))

(-main)
