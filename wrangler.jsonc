{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotoba-cloud-control-plane",
  "main": "build/worker.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "kotoba.cloud", "custom_domain": true },
    { "pattern": "www.kotoba.cloud", "custom_domain": true },
    { "pattern": "api.kotoba.cloud", "custom_domain": true },
    { "pattern": "console.kotoba.cloud", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PQ_KEY_REGISTRY", "class_name": "PqKeyRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1-pq-key-registry", "new_sqlite_classes": ["PqKeyRegistry"] }
  ],
  "observability": { "enabled": true }
}
