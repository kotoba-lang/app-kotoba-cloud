{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotoba-cloud-control-plane",
  "main": "build/worker.js",
  "account_id": "4da88288dc30d9ee257f319d3c33ecf0",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "kotoba.cloud",
      "custom_domain": true
    },
    {
      "pattern": "www.kotoba.cloud",
      "custom_domain": true
    },
    {
      "pattern": "api.kotoba.cloud",
      "custom_domain": true
    },
    {
      "pattern": "console.kotoba.cloud",
      "custom_domain": true
    },
    {
      "pattern": "boot.kotoba.cloud",
      "custom_domain": true
    },
    {
      "pattern": "admin.kotoba.cloud",
      "custom_domain": true
    },
    {
      // docs.kotoba.cloud — the /docs/… documents of the same asset tree
      // (worker.cljk route-docs-host; owner direction 2026-09-15)
      "pattern": "docs.kotoba.cloud",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "IDENTITY_AUTHORITY",
      "service": "kotoba-identity-authority"
    },
    {
      "binding": "RESEARCH_AUTHORITY",
      "service": "kotoba-research-authority"
    },
    {
      "binding": "ORG_AUTHORITY",
      "service": "kotoba-research-authority"
    },
    {
      "binding": "DATABASE_SERVICE",
      "service": "kotoba-cloud-database"
    },
    {
      "binding": "AUTHN_SERVICE",
      "service": "kotobase-authn"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_BLOCKS",
      "bucket_name": "kotobase-graph-database-production"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PQ_KEY_REGISTRY",
        "class_name": "PqKeyRegistry"
      },
      {
        "name": "BILLING_ACCOUNTS",
        "class_name": "BillingAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-pq-key-registry",
      "new_sqlite_classes": [
        "PqKeyRegistry"
      ]
    },
    {
      "tag": "v2-billing-accounts",
      "new_sqlite_classes": [
        "BillingAccount"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Billing runs against the AWAI live Stripe account (docs/billing/
    // stripe-live-catalog.json, verified 2026-09-15). The two launch flags
    // below are the ONLY switch left: while either is "false",
    // billing-gateway/configured? is false, /v1/billing/catalog answers
    // checkoutEnabled:false and no Checkout session can be created.
    // Flip both to "true" to accept live payments (owner decision — see
    // docs/billing/configuration.md: paid usage is not yet metered, so a
    // purchased balance is a ledger entry, not consumed capacity).
    "BILLING_ENABLED": "false",
    "BILLING_METERING_READY": "false",
    "BILLING_MODE": "live",
    "BILLING_SANDBOX_ENABLED": "false",
    "BILLING_ENVIRONMENT_ID": "acct_1TuxvPIzvFrqWhXK-live",
    // live price map = docs/billing/stripe-live-catalog.json (never test ids
    // in live mode). SKUs without a live price (the credits-* monthly tiers)
    // are absent here and the page shows them as not yet purchasable.
    "STRIPE_PRICE_IDS": "{\"pro\": \"price_1UFJ5TIzvFrqWhXKHHsr82B0\", \"team\": \"price_1UFnZ5IzvFrqWhXKvUHHAwO5\", \"max\": \"price_1UFJ60IzvFrqWhXKzi7RBX6d\", \"ultra\": \"price_1UFJ6UIzvFrqWhXKl2ichBCD\", \"ai-credits-25\": \"price_1UFJ72IzvFrqWhXKEvUlJ9Nj\", \"storage-credits-25\": \"price_1UFJ7YIzvFrqWhXKqs1H0DCV\"}",
    // the live portal configuration is resolved at runtime by the billing
    // account (billing_account.cljk portal-configuration!): the test id
    // bpc_1UFI88ITDawH5x8adO7LxkD1 belongs to the Kotoba Labs test account
    // and must not be sent to the live account.
    "STRIPE_PORTAL_CONFIGURATION_ID": "",
    // blue-team route (research.cljk teams :blue → OpenRouter). The key itself is a
    // secret on the research authority Worker (OPENROUTER_API_KEY,
    // wrangler.research.jsonc); this flag is what /v1/models reports as the
    // blue models' availability. Set to "true" once the secret is stored.
    // Organization SSO (ADR-2609151900): Enterprise is quote-based, so an
    // operator grants it here as {"com-<handle>.kotoba.cloud": "enterprise"}.
    // Team comes from the org owner's paid Stripe plan (billing/active-plan).
    // ORG_SSO_ENTITLEMENT_SECRET is a Worker secret shared with kotobase-authn.
    "ORG_PLAN_OVERRIDES": "{}",
    "OPENROUTER_CONFIGURED": "false"
  }
}
