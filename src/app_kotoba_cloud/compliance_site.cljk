(ns app-kotoba-cloud.compliance-site
  "Compliance & vulnerability-product catalog (worldwide): frameworks,
   product categories, providers and pricing. Shell from the
   cloud-kotoba-dds catalog pattern; this file keeps the callout and copy."
  (:require [cloud-kotoba-dds.catalog :as catalog]
            [app-kotoba-cloud.security-fit :as security-fit]
            [jp-go-dds.core :as dds]
            [clojure.string :as clojure.string]))

(def css
  (str ".kcp-fit{margin-top:var(--hig-spacing-6);display:grid;gap:var(--hig-spacing-3)}\n.kcp-fit__list{list-style:none;margin:0;padding:0;display:grid;gap:var(--hig-spacing-2);font-size:var(--hig-text-body-font-size,1rem)}\n.kcp-fit__list li{padding:var(--hig-spacing-2) 0;border-block-start:1px solid var(--hig-color-separator)}\n.kcp-fit__controls{font-family:var(--hig-font-mono,var(--hig-font-mono));font-size:var(--hig-text-caption2-font-size);color:var(--hig-color-secondary-label)}\n"
       ".kc-comp-row{list-style:none;border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-md,12px);margin-bottom:var(--hig-spacing-2)}
.kc-comp-row__btn{all:unset;display:block;inline-size:100%;padding:var(--hig-spacing-3) var(--hig-spacing-4);cursor:pointer}
.kc-comp-row__btn:hover{background:var(--hig-color-secondary-system-background)}
.kc-comp-row__name{display:block;font-weight:600}
.kc-comp-row__meta{display:block;color:var(--hig-color-secondary-label);font-size:var(--hig-text-caption1-font-size)}
.kc-comp-empty{color:var(--hig-color-secondary-label);list-style:none;padding:var(--hig-spacing-4)}
.kc-comp-detail{border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-md,12px);padding:var(--hig-spacing-5);background:var(--hig-color-secondary-system-background)}"))

(defn view
  ([] (view false))
  ([embedded?]
   (catalog/page
    {:title "コンプライアンス & 脆弱性対策製品カタログ（基準・カテゴリ・価格・プロバイダ）"
     :lead "全世界のコンプライアンス基準（ISO / SOC 2 / PCI DSS / GDPR / DORA / CRA ほか）と、脆弱性管理・AppSec・EDR・GRC などの製品カテゴリ、プロバイダーと価格帯を 1 つの出典付きカタログにまとめた公開データです。"
       :nav (catalog/breadcrumb
          "カタログ"
          [["ホーム" "/ja/"]
           ["セキュリティ公開データ" "/ja/security/"]
           ["このカタログ" nil]])
     :embedded? embedded?
     :id "kcp-main"}
    (catalog/callout
     [:strong "使い方："]
     " 「基準」タブでフレームワークを、「製品」タブでカテゴリ・プロバイダ・価格帯を検索できます。価格は各ベンダー公開ページの list 価格（2026-09 時点、layer: secondary-reported）または「見積り」の別であり、実際の契約条件・為替・割引は反映しません。必ず出典の公式ページで最新情報を確認してください。")
    (catalog/status "kcp-summary" "データを読み込んでいます…")
    (catalog/tabs {:id "kcp-tabs" :label "カタログ種別"})
    (catalog/tools
     {:search-id "kcp-search" :search-label "検索"
      :search-placeholder "基準名・発行機関／製品名・プロバイダーで検索"})
    (catalog/grid
     {:list-id "kcp-results" :list-label "一覧"}
     (catalog/detail {:id "kcp-detail" :label "詳細"}))
    (catalog/about
     {:summary "このカタログについて"
      :links [[:a {:href "/compliance-data/compliance/index.json"} "IPLD インデックス"]]
      :footnote "データはコード生成による content-addressed block（IPLD形式）として公開されています。商標・製品名は各所有者に帰属します。価格・適合情報は各ベンダーの公開ページに基づく収集データで、各レコードに出典URLを付けています。価格は変更されることがあるため、購入判断の前に必ず公式ページで最新情報を確認してください。掲載は網羅を主張するものではなく、代表的なカテゴリの代表的なプロバイダのスナップショットです。"})
    [:section {:id "compliance-fit" :class "kcp-fit"}
     (dds/heading 2 "第一次セキュリティサービスのコンプライアンス適合（Fit Finder）" {:size "24"})
     [:p "kotoba.cloud の第一次セキュリティサービス（CTEM・DAST・SAST・VM）が、コミット済みカタログのカテゴリを経由してどの基準コントロールに対応するかの決定論的マッピングです（サービス → カテゴリ → コントロールの推移的展開、AI 不使用）。コントロールレベルの展開は NIST CSF 2.0 に対してコミット済みです。API からは "
      [:code "GET /v1/security/compliance-fit?framework=nist-csf-20"]
      " でも同じデータが取得できます。"]
     [:ul {:class "kcp-fit__list"}
      (map (fn [{:keys [service categories controls]}]
             [:li [:strong (clojure.string/upper-case service)] " → "
              (clojure.string/join "・" categories)
              (when (seq controls)
                (list " → " [:span {:class "kcp-fit__controls"}
                             (str (count controls) " コントロール（" (clojure.string/join " " controls) "）")]))])
           (:services (security-fit/fit "nist-csf-20")))]
     [:p {:class "kc-comp-footnote"}
      "このセクションと API は同じ正本定義（app-kotoba-cloud.security-fit）から描画されます。対応は「カテゴリがコントロールに対処する」ことの表明であり、個別の認証・監査の適合証明ではありません。"]]
    [:script {:src "/js/compliance-catalog.js" :defer true}])))
