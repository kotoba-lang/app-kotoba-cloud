(ns app-kotoba-cloud.research-gateway
  "Private service-binding seam. No public upstream URL, identity evidence or prompt logs."
  (:require [app-kotoba-cloud.research :as policy]
            [app-kotoba-cloud.billing :as billing]
            [app-kotoba-cloud.billing-binding :as billing-binding]
            [app-kotoba-cloud.session :as session]
            [app-kotoba-cloud.pat :as pat]))

(def paths #{"/v1/research/status" "/v1/research/applications" "/v1/chat/completions" "/v1/models"
             "/v1/research/jobs" "/v1/research/job"
             "/v1/research/ekyc/start" "/v1/research/ekyc/status" "/v1/research/ekyc/webhook" "/v1/research/review"
             "/v1/research/ekyc/kotoba-proof/submit"})
(def submit-path "/v1/research/ekyc/kotoba-proof/submit")
;; DG1/DG5/DG11/DG12 base64 + SOD DER: a passport face image (DG5) alone can
;; be ~100 KB, and layer-2 adds the portraitJpeg plus up to three selfie
;; frames on top, so the chip-evidence hop gets a 1.5 MiB bound — above the
;; 32 KiB start/status bodies, below the 2 MiB completion bound.
(def proof-submit-body-limit 1572864)
(def origins #{"https://kotoba.cloud" "https://www.kotoba.cloud" "https://console.kotoba.cloud"
               "https://admin.kotoba.cloud"})

(defn bounded-json [message limit]
  (if-not (.-body message)
    (js/Promise.reject (ex-info "invalid-json" {:status 400}))
    (let [reader (.getReader (.-body message)) chunks (array)]
      (letfn [(step [size]
                (-> (.read reader)
                    (.then (fn [part]
                             (if (.-done part)
                               (-> (.text (js/Blob. chunks))
                                   (.then #(js->clj (js/JSON.parse %) :keywordize-keys true)))
                               (let [next-size (+ size (.-byteLength (.-value part)))]
                                 (if (> next-size limit)
                                   (-> (.cancel reader)
                                       (.then (fn [] (throw (ex-info "body-too-large" {:status 413})))))
                                   (do (.push chunks (.-value part)) (step next-size)))))))))]
        (-> (step 0)
            (.catch (fn [error]
                      (if (ex-data error) (throw error)
                          (throw (ex-info "invalid-json" {:status 400}))))))))))

(defn- service [binding path payload]
  (-> (.fetch binding (str "https://research.internal" path)
              #js {:method "POST" :redirect "manual"
                   :signal (js/AbortSignal.timeout 60000)
                   :headers #js {"content-type" "application/json"}
                   :body (js/JSON.stringify (clj->js payload))})
      (.then (fn [r]
               (if (.-ok r)
                 ;; 2 MiB: a /jobs/status answer carries the whole request and
                 ;; completion (128k-token prompts, 32k-token answers, UTF-8)
                 (bounded-json r 2097152)
                 ;; Surface the authority's own error body so operator-visible
                 ;; codes (e.g. card-verification-not-configured) survive the hop.
                 (-> (.text r)
                     (.catch (fn [_] ""))
                     (.then (fn [detail]
                              (let [code (try (get (js->clj (js/JSON.parse detail) :keywordize-keys true) :error)
                                              (catch :default _ nil))]
                                (throw (ex-info (if (string? code) code "research-service-unavailable")
                                                {:status (if (contains? #{402 403 404 409 429 502 503} (.-status r))
                                                           (.-status r) 503)})))))))))))

;; Authority error codes the account console maps to a specific sentence
;; (account-browser start-ekyc!). Everything else collapses to the status
;; family below, so nothing internal leaks through the edge.
(def surfaced-ekyc-codes
  #{"card-verification-not-configured" "prepaid-card-not-accepted" "stripe-unavailable"
    "invalid-stripe-session"
    ;; kotoba-proof submit: operator-visible sentences the console maps for the
    ;; chip-evidence chain (challenge gate, tamper reject, duplicate person).
    "challenge-unknown-or-expired" "chip-evidence-not-admissible"
    "duplicate-person-rejected"})

(defn- kotoba-proof-submit-route [request binding principal reference respond]
  ;; kotoba-proof chip evidence (layer 1 + layer-2 biometric). The principal is
  ;; the session's, never the body's, as on start; the authority validates the
  ;; seeded challenge, the ICAO digests, the selfie↔DG5 binding and the
  ;; nullifier dedupe itself. The 2xx status is passed through: 202
  ;; operator-review-pending (mismatch / liveness fail) is part of the
  ;; layer-2 contract and `service` would flatten it to 200.
  (-> (bounded-json request proof-submit-body-limit)
      (.then
       (fn [body]
         (if-not (and (policy/text? (:scopeId body) 256)
                      (vector? (:tasks body)) (pos? (count (:tasks body)))
                      (every? #(policy/text? % 200000)
                              [(:sodDer body) (:dg1 body) (:dg11 body)
                               (:dg12 body) (:dg5 body)]))
           (respond {:error {:code "invalid-kotoba-proof-submit"}} 400)
           (let [payload (cond-> {:principalId principal :sessionRef reference
                                  :sodDer (:sodDer body) :dg1 (:dg1 body)
                                  :dg11 (:dg11 body) :dg12 (:dg12 body) :dg5 (:dg5 body)
                                  :scopeId (:scopeId body) :tasks (vec (:tasks body))}
                            (and (policy/text? (:portraitJpeg body) 400000)
                                 (vector? (:selfieFrames body)) (pos? (count (:selfieFrames body))))
                            (assoc :portraitDigest (:portraitDigest body)
                                   :portraitJpeg (:portraitJpeg body)
                                   :selfieFrames (vec (:selfieFrames body))))]
             (-> (.fetch binding "https://research.internal/ekyc/kotoba-proof/submit"
                         #js {:method "POST" :redirect "manual"
                              :signal (js/AbortSignal.timeout 60000)
                              :headers #js {"content-type" "application/json"}
                              :body (js/JSON.stringify (clj->js payload))})
                 (.then (fn [r]
                          (-> (.json r)
                              (.then (fn [j]
                                       (respond (js->clj j :keywordize-keys true)
                                                (.-status r))))))))))))))

(defn- ekyc-start-route [request binding principal reference respond]
  (-> (bounded-json request 32768)
      (.then
       (fn [body]
         ;; The principal is the session's, never the body's — the console
         ;; sends {scopeId, tasks} only (a principalId requirement here
         ;; turned every browser start into 400 invalid-ekyc-request,
         ;; measured live 2026-09-15). The PAT path may still send one; it
         ;; is ignored the same way.
         (if-not (and (policy/text? (:scopeId body) 256)
                      (vector? (:tasks body)) (pos? (count (:tasks body))))
           (respond {:error {:code "invalid-ekyc-request"}} 400)
           (-> (service binding "/ekyc/start"
                        {:principalId principal :sessionRef reference
                         :scopeId (:scopeId body) :tasks (:tasks body)})
               (.then #(respond % 200))))))))

(defn- ekyc-route [request path binding principal reference respond]
  (cond
    (= path "/v1/research/ekyc/status")
    (-> (service binding "/ekyc/status" {:principalId principal :sessionRef reference})
        (.then #(respond % 200)))
    (if (= path submit-path)
      (kotoba-proof-submit-route request binding principal reference respond)
      (ekyc-start-route request binding principal reference respond))))

;; Stripe calls this server-to-server: no origin gate, no auth, no viewer. The
;; edge only reads the raw body + signature header and extracts ROUTING HINTS
;; (metadata.principal, client_reference_id); hints are never trusted for any
;; decision — the authority verifies the signature and binding itself. Nothing
;; beyond the event id is logged.
(defn- public-webhook-route [request binding respond]
  (let [signature (.get (.-headers request) "stripe-signature")]
    (-> (.text request)
        (.then (fn [raw]
                 (let [event (try (js->clj (js/JSON.parse raw) :keywordize-keys true)
                                  (catch :default _ nil))
                       obj (get-in event [:data :object])]
                   (when-not (map? obj)
                     (throw (ex-info "stripe-event-invalid" {:status 400})))
                   ;; :redirect "manual", never "error": workerd rejects "error" with a
                   ;; TypeError before any request leaves (the authority hops already
                   ;; say so). Here it made EVERY Stripe delivery a 503 with an empty
                   ;; eventId — 5 of 5 this week, an identity.verification_session
                   ;; .verified for a real person among them (AWAI dashboard, 2026-09-15).
                   (-> (.fetch binding "https://research.internal/ekyc/webhook"
                               #js {:method "POST" :redirect "manual"
                                    :signal (js/AbortSignal.timeout 60000)
                                    :headers #js {"content-type" "application/json"}
                                    :body (js/JSON.stringify
                                           (clj->js {:principalId (get-in obj [:metadata :principal])
                                                     :raw raw :signatureHeader signature
                                                     :sessionId (:id obj)
                                                     :externalId (:client_reference_id obj)}))})
                       (.then (fn [r]
                                (if (.-ok r)
                                  ;; Stripe needs a 2xx Response to stop retrying;
                                  ;; the authority's receipt (no PII) is the body.
                                  ;; Returning the parsed map here was a
                                  ;; non-Response worker result.
                                  (-> (bounded-json r 131072)
                                      (.then #(respond % 200)))
                                  ;; Fail closed on signature/bind mismatch; never
                                  ;; echo the payload, only the event id.
                                  (throw (ex-info "stripe-webhook-rejected"
                                                  {:status (if (contains? #{400 403} (.-status r))
                                                             (.-status r) 503)
                                                   :eventId (str (:id event))}))))))))))))

(defn- note-projection-refusal!
  "Name a refusal that hinges on the authority's projection clocks. Only the
  stamps and this machine's `now` are logged (numbers, no principal, no
  prompt): `lead` > 0 means the authority stamped the projection later than
  the edge's clock reads now — two clocks, not stale evidence."
  [reason record now]
  (when (contains? #{"trust-route-required" "session-reverification-required"} reason)
    (let [p (if (= reason "trust-route-required") (:trust record) (:continuous record))]
      (js/console.warn "projection-refused" reason
                       (js/JSON.stringify #js {:evaluatedAt (:evaluatedAt p) :expiresAt (:expiresAt p)
                                               :now now
                                               :lead (when (number? (:evaluatedAt p)) (- (:evaluatedAt p) now))
                                               :projected (boolean (:policyVersion p))})))))

(defn- status-response [record principal reference respond]
  (let [now (js/Date.now) reason (or (policy/eligibility principal record now)
                                   (when-not (policy/session-current? reference "code-review" (:continuous record) now) "session-reverification-required"))
        same-principal? (= principal (:principalId record))]
    (when reason (note-projection-refusal! reason record now))
    (respond {:status (if reason "pending" "eligible") :reason reason
              :freeTier policy/free-limits :policyVersion policy/policy-version
              :trust (when (and same-principal? (policy/trust-current? (:trust record) now))
                       (select-keys (:trust record) [:policyVersion :score :routes :evaluatedAt :expiresAt]))
              :scopes (if same-principal? (mapv #(select-keys % [:id :status :tasks :expiresAt]) (:scopes record)) [])}
             200)))

(defn- completion-envelope
  "The OpenAI answer. Native tool_calls from the origin ride in the message
  with finish_reason tool_calls; content is null then, as OpenAI does.
  `billing` is what this completion drew on: \"free\" (the daily research
  quota) or \"paid\" (the principal's prepaid ledger, settled from the
  provider's receipt — `usage` and `chargedMicroUSD` are that receipt's
  numbers, never an estimate)."
  [request-id result model & [{:keys [billing usage charged settlement]}]]
  (let [tool-calls (seq (:toolCalls result))
        content (:content result)]
    (cond-> {:id request-id :object "chat.completion"
             :created (js/Math.floor (/ (js/Date.now) 1000))
             :model (or model policy/model-id)
             :choices [{:index 0
                        :finish_reason (cond tool-calls "tool_calls"
                                             (= "length" (:finishReason result)) "length"
                                             :else "stop")
                        :message (cond-> {:role "assistant" :content (if (policy/text? content 1048576) content nil)}
                                   tool-calls (assoc :tool_calls (vec tool-calls)))}]
             :receiptId (:receiptId result) :billing (or billing "free")}
      usage (assoc :usage {:prompt_tokens (:inputTokens usage)
                           :completion_tokens (:outputTokens usage)
                           :total_tokens (+ (:inputTokens usage) (:outputTokens usage))})
      charged (assoc :chargedMicroUSD charged)
      settlement (assoc :settlement settlement))))

(defn- terminal-answer?
  "A succeeded job must carry text or native tool calls; anything else is a
  broken receipt, never a 200 with content null."
  [result]
  (or (policy/text? (:content result) 1048576)
      (and (vector? (:toolCalls result)) (seq (:toolCalls result)) (every? policy/tool-call? (:toolCalls result)))))

(defn- sse-line [value] (str "data: " (js/JSON.stringify (clj->js value)) "\n\n"))

(defn sse-emulation
  "The whole completion as an OpenAI `chat.completion.chunk` stream: one
  content chunk, one finish chunk, `[DONE]`. Nothing is streamed early — the
  job model has no partial output — but every OpenAI SDK client that asked
  for `stream: true` reads this as a normal stream instead of failing on a
  JSON body (hermes 2026-09-15). Same headers family as the JSON answers."
  [envelope]
  (let [base {:id (:id envelope) :object "chat.completion.chunk"
              :created (:created envelope) :model (:model envelope)}
        message (get-in envelope [:choices 0 :message])
        finish (get-in envelope [:choices 0 :finish_reason])
        ;; streaming tool calls carry an index per call, arguments whole
        delta (cond-> {:role "assistant" :content (:content message)}
                (seq (:tool_calls message))
                (assoc :tool_calls (vec (map-indexed (fn [i c] (assoc c :index i)) (:tool_calls message)))))
        body (str (sse-line (assoc base :choices [{:index 0 :delta delta :finish_reason nil}]))
                  (sse-line (cond-> (assoc base :choices [{:index 0 :delta {} :finish_reason finish}]
                                           :receiptId (:receiptId envelope) :billing (:billing envelope))
                              (:usage envelope) (assoc :usage (:usage envelope))
                              (:chargedMicroUSD envelope) (assoc :chargedMicroUSD (:chargedMicroUSD envelope))))
                  "data: [DONE]\n\n")]
    (js/Response. body #js {:status 200
                            :headers #js {"content-type" "text/event-stream; charset=utf-8"
                                          "cache-control" "no-store, private"
                                          "x-content-type-options" "nosniff"
                                          "x-accel-buffering" "no"}})))

(defn- bounded-delay [ms]
  (js/Promise. (fn [resolve] (js/setTimeout resolve ms))))

;; Upstream inference measures 90–250 s; the OpenAI transport cannot poll, so
;; the edge waits for the terminal state on the client's behalf. Budget covers
;; observed worst case; the job itself survives an edge timeout and a client
;; retry re-attaches to the same reservation via the deterministic job id.
;; 14 minutes: 32k output tokens at the origin's observed 40-60 tok/s is
;; ~10-13 min; hermes' request_timeout_seconds is 900. Each poll hop still has
;; its own 60 s AbortSignal.
(def job-wait-budget-ms 840000)

(defn- completion-job-id [principal body]
  ;; Deterministic job identity: SHA-256 over the admission-relevant request,
  ;; shaped as a v4 UUID to satisfy the job-id contract. A retry of an
  ;; identical completion re-attaches to the same reservation (receipt
  ;; recovery, no double-charged quota) instead of minting a new job.
  (-> (.digest (.-subtle js/crypto) "SHA-256"
               (.encode (js/TextEncoder.)
                        (js/JSON.stringify #js ["kotoba-research-completion-v1" principal
                                                (:model body) (:task body) (:scopeId body)
                                                (:max_tokens body) (clj->js (:messages body))])))
      (.then (fn [d]
               (let [h (apply str (map (fn [b] (.padStart (.toString b 16) 2 "0"))
                                        (array-seq (js/Uint8Array. d))))]
                 (str (subs h 0 8) "-" (subs h 8 12) "-4" (subs h 13 16) "-"
                      (nth "89ab" (bit-and 3 (js/parseInt (subs h 16 17) 16)))
                      (subs h 17 20) "-" (subs h 20 32)))))))

;; --- paid inference: reserve on the prepaid ledger, settle from the receipt ---
;;
;; A principal with an available AI balance (a paid plan's included credits or
;; a top-up, billing/plans) runs on it: the edge reserves the MAXIMUM the job
;; can cost before the authority admits it, and settles from the provider's
;; measured token counts after the terminal state. No balance (or metering
;; off, or the ledger frozen) means the free daily quota exactly as before —
;; payment never removes an entitlement (docs/billing/design.md).
(def ^:private prompt-fixed-overhead-tokens
  "Tokens the origin adds that the caller never sees (chat template, its own
  system prefix, special tokens): a fixed part plus a per-message part. The
  bound must not be undershot — an under-reserved settlement FREEZES the
  ledger (billing-limits/settle) instead of charging the excess."
  512)
(def ^:private prompt-per-message-overhead-tokens 64)
(def ^:private reservation-margin-percent 25)

(defn- utf8-bytes [s] (.-byteLength (.encode (js/TextEncoder.) (str s))))

(defn reservation-maximum
  "Upper bound of one completion in micro-USD at billing/rates. Input: a
  byte-level BPE never yields more tokens than UTF-8 bytes, plus the template
  overhead; output: max_tokens is the origin's hard cap (reasoning tokens
  count inside it). Both rated as uncached, then a margin on top."
  [body]
  (let [messages (:messages body)
        input-tokens (+ prompt-fixed-overhead-tokens
                        (* prompt-per-message-overhead-tokens (count messages))
                        (reduce + 0 (map #(utf8-bytes (:content %)) messages)))
        output-tokens (:max_tokens body)
        micro (+ (js/Math.ceil (/ (* input-tokens (:input-per-million billing/rates)) 1000000))
                 (js/Math.ceil (/ (* output-tokens (:output-per-million billing/rates)) 1000000)))]
    (js/Math.ceil (/ (* micro (+ 100 reservation-margin-percent)) 100))))

(defn- account-json
  "The ledger's JSON answer plus the HTTP status under :http (the ledger's
  own :status — \"held\", \"settled\" — must survive)."
  [response]
  (-> (.json response)
      (.then (fn [json] (assoc (js->clj json :keywordize-keys true) :http (.-status response))))
      (.catch (fn [_] {:http (.-status response) :error "unreadable"}))))

(defn- paid-admission
  "Promise of {:billing \"paid\" :maximumMicroUSD n} when a reservation for
  this job id now holds on the principal's ledger, else {:billing
  \"free-only\"}. 402 usage-limit-exceeded (no balance — the common case),
  503 (frozen or unavailable) and a missing binding all fall to the free
  quota; a paid failure never blocks free research."
  [^js env principal job-id body]
  (if-not (billing-binding/metering-ready? env)
    (js/Promise.resolve {:billing "free-only"})
    (let [maximum (reservation-maximum body)]
      (-> (billing-binding/account env principal "/reserve" {:id job-id :scope "ai" :maximum maximum})
          (.then account-json)
          (.then (fn [{:keys [http] :as r}]
                   (if (and (= 200 http) (= "held" (:status r)) (not (:error r)))
                     {:billing "paid" :maximumMicroUSD maximum}
                     (do (when-not (= 402 http)
                           (js/console.warn "paid-admission-unavailable" job-id http (str (:error r))))
                         {:billing "free-only"}))))
          (.catch (fn [e]
                    (js/console.warn "paid-admission-unavailable" job-id (str (or (.-message e) e)))
                    {:billing "free-only"}))))))

(defn- usage-receipt
  "The provider receipt the authority stored, in the shape billing/token-event
  rates: token counts, model, an ISO timestamp — nothing from the prompt."
  [result job-id]
  (let [u (:usageReceipt result)]
    (when (and (map? u) (integer? (:inputTokens u)) (integer? (:outputTokens u)))
      {:requestId job-id :model (or (:model u) (:model result))
       :inputTokens (:inputTokens u) :cachedInputTokens (or (:cachedInputTokens u) 0)
       :outputTokens (:outputTokens u)
       :occurredAt (.toISOString (js/Date. (or (:observedAt u) (js/Date.now))))})))

(defn- settle-paid!
  "Settle the job's reservation from its receipt. Promise of {:charged n} or
  {:settlement \"pending\"} — the answer is served either way (the work is
  done and the hold stays until reconciliation), and the pending case is
  logged by name."
  [^js env principal job-id receipt]
  (if-not receipt
    (do (js/console.error "paid-settlement-no-receipt" job-id)
        (js/Promise.resolve {:settlement "pending"}))
    (-> (billing-binding/account env principal "/settle-usage" {:id job-id :kind "inference" :receipt receipt})
        (.then account-json)
        (.then (fn [{:keys [http] :as r}]
                 (if (and (= 200 http) (true? (:settled r)) (integer? (:amountMicroUSD r)))
                   {:charged (:amountMicroUSD r)}
                   (do (js/console.error "paid-settlement-failed" job-id http (str (:error r)))
                       {:settlement "pending"}))))
        (.catch (fn [e]
                  (js/console.error "paid-settlement-failed" job-id (str (or (.-message e) e)))
                  {:settlement "pending"})))))

(defn- release-paid!
  "A job that ended without a receipt (failed, cancelled) cost nothing:
  settle the hold at zero so the balance is free again. A job that is still
  running keeps its hold — the client's retry re-attaches and settles."
  [^js env principal job-id]
  (-> (billing-binding/account env principal "/settle" {:id job-id :actual 0 :receiptId (str "released:" job-id)})
      (.then account-json)
      (.then (fn [{:keys [http] :as r}]
               (when-not (= 200 http)
                 (js/console.error "paid-release-failed" job-id http (str (:error r))))))
      (.catch (fn [e] (js/console.error "paid-release-failed" job-id (str (or (.-message e) e)))))))

(defn- poll-completion-job [binding principal reference job-id model attempt started]
  (-> (service binding "/jobs/status" {:principalId principal :sessionRef reference :jobId job-id})
      (.then (fn [result]
               (let [status (:status result)]
                 (cond
                   ;; a succeeded job with neither text nor tool calls is a
                   ;; broken receipt, not an answer — never a 200 with content
                   ;; null (8 問 #1)
                   (and (= "succeeded" status) (not (terminal-answer? result)))
                   (throw (ex-info "invalid-job-receipt" {:status 502}))
                   (= "succeeded" status)
                   ;; the terminal result: the envelope is built by the caller,
                   ;; which knows whether a reservation has to be settled first
                   (select-keys result [:content :toolCalls :finishReason :receiptId :billing :usageReceipt])
                   ;; the origin refused the REQUEST (400/413/422: context
                   ;; window, shape): that is the caller's 400 with the
                   ;; origin's reason, not a 502 — measured 2026-09-15:
                   ;; 480,018 characters passed the edge's character ceiling
                   ;; and were 131,057 tokens at the origin's 131,072 window
                   (and (= "failed" status) (contains? #{400 413 422} (:upstreamStatus result)))
                   (throw (ex-info "inference-rejected"
                                   {:status 400
                                    :message (let [m (get-in result [:upstreamError :message])]
                                               (if (policy/text? m 2000) m "the inference route refused the request"))}))
                   ;; the route refused the AUTHORITY (401/403/404: token, URL):
                   ;; operator configuration, served as unavailable
                   (and (= "failed" status) (contains? #{401 403 404} (:upstreamStatus result)))
                   (throw (ex-info "inference-route-misconfigured" {:status 503}))
                   (contains? #{"failed" "cancelled" "unknown"} status)
                   (throw (ex-info (if (= "unknown" status) "inference-job-timeout" "inference-run-failed")
                                   {:status (if (= "unknown" status) 504 502)}))
                   (contains? #{"queued" "running"} status)
                   (if (> (- (js/Date.now) started) job-wait-budget-ms)
                     (throw (ex-info "inference-job-timeout" {:status 504}))
                     (-> (bounded-delay (if (zero? attempt) 1000 3000))
                         (.then #(poll-completion-job binding principal reference job-id model (inc attempt) started))))
                   :else (throw (ex-info "invalid-job-receipt" {:status 502}))))))))

(defn- complete-via-job [^js env binding principal reference body respond & [{:keys [stream?]}]]
  ;; The synchronous /complete path is retired at 501; an OpenAI transport has
  ;; no job API, so the edge reserves atomically via /jobs/create (the
  ;; authority re-checks eligibility/scope/quota inside that write, and a repeat
  ;; with the same deterministic id returns the existing reservation) and polls
  ;; the terminal state. Same admission, one audit receipt, ~20 service hops
  ;; (well under the subrequest limit). Accounting: a reservation on the
  ;; prepaid ledger when the principal has one (paid-admission), else the
  ;; free daily quota. The deterministic job id is also the reservation id, so
  ;; a retry re-attaches to both and can never be charged twice.
  (-> (completion-job-id principal body)
      (.then
       (fn [job-id]
         (let [started (js/Date.now)]
           (-> (paid-admission env principal job-id body)
               (.then
                (fn [admission]
                  (let [paid? (= "paid" (:billing admission))]
                    (-> (service binding "/jobs/create"
                                 {:principalId principal :sessionRef reference :jobId job-id
                                  :policyVersion policy/policy-version :billing (:billing admission)
                                  :trustPolicyVersion (:version policy/trust-policy)
                                  :sessionPolicyVersion (:version policy/session-policy)
                                  :request body :limits policy/free-limits})
                        (.then (fn [_] (poll-completion-job binding principal reference job-id (:model body) 0 started)))
                        (.then (fn [terminal]
                                 (if-not (or paid? (= "paid" (:billing terminal)))
                                   ;; the provider's measured usage rides on free completions
                                   ;; too: an agent budgets its context from it (hermes logged
                                   ;; usage=unavailable on every free call, 2026-09-15)
                                   (completion-envelope job-id terminal (:model body) {:usage (:usageReceipt terminal)})
                                   (-> (settle-paid! env principal job-id (usage-receipt terminal job-id))
                                       (.then (fn [{:keys [charged settlement]}]
                                                (completion-envelope job-id terminal (:model body)
                                                                     {:billing "paid" :usage (:usageReceipt terminal)
                                                                      :charged charged :settlement settlement})))))))
                        (.then #(if stream? (sse-emulation %) (respond % 200)))
                        (.catch (fn [e]
                                  ;; a paid job that ended without a receipt holds
                                  ;; nothing; a timed-out one keeps its hold
                                  (if (and paid? (not= "inference-job-timeout" (ex-message e)))
                                    (-> (release-paid! env principal job-id) (.then (fn [_] (throw e))))
                                    (throw e))))))))))))
      (.catch
       (fn [e]
         ;; the authority code is the ex-info MESSAGE (see `service`); ex-data
         ;; never carried :message, so every failure read as unavailable
         (let [code (or (ex-message e) (str e))]
           (respond {:error (case code
                              ;; the origin's refusal of the request, in the
                              ;; OpenAI error shape an agent's log shows a person
                              "inference-rejected" {:code "invalid-research-request"
                                                    :message (:message (ex-data e))
                                                    :type "invalid_request_error"}
                              {:code (case code
                                       "inference-run-failed" "inference-failed"
                                       "inference-job-timeout" "inference-timeout"
                                       "inference-route-misconfigured" "research-service-unavailable"
                                       "invalid-job-receipt" "invalid-inference-receipt"
                                       "job-input-conflict" "invalid-research-request"
                                       "research-service-unavailable")})}
                    (or (:status (ex-data e)) 503)))))))

(defn- complete [^js env binding principal reference body respond & [opts]]
  (if (policy/blue? (:model body))
    ;; Blue team: the edge has authenticated the principal (cookie session or
    ;; PAT); the authority admits on guardrails + task + free quota and routes
    ;; to the shared route. No identity ladder, no scope, no continuous session.
    (complete-via-job env binding principal reference body respond opts)
    (-> (service binding "/status" {:principalId principal :sessionRef reference :action (:task body)})
        (.then
         (fn [record]
           (let [now (js/Date.now) reason (or (policy/eligibility principal record now)
                                            (when-not (policy/session-current? reference (:task body) (:continuous record) now) "session-reverification-required"))]
             (cond
               reason (do (note-projection-refusal! reason record now)
                          (respond {:error {:code reason}} 403))
               (not (policy/scope-approved? record body now))
               (respond {:error {:code "research-scope-required"}} 403)
               :else (complete-via-job env binding principal reference body respond opts))))))))

(defn- session-reference [request principal]
  (let [token (session/cookie-value (.get (.-headers request) "cookie") session/cookie-name)]
    (when-not (policy/text? token 4096) (throw (ex-info "session-missing" {:status 401})))
    (-> (.digest (.-subtle js/crypto) "SHA-256"
                 (.encode (js/TextEncoder.) (js/JSON.stringify #js ["kotoba-research-session-v1" "https://kotoba.cloud" principal token])))
        (.then #(apply str (map (fn [b] (.padStart (.toString b 16) 2 "0")) (array-seq (js/Uint8Array. %))))))))

(defn job-id? [id]
  (and (string? id) (boolean (re-matches #"[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}" id))))

(defn- job-response [result principal reference id respond]
  (let [record (:record result) task (:task result) scope (:scopeId result) now (js/Date.now)
        status (:status result)]
    (cond
      (not (and (= id (:jobId result)) (= principal (:principalId result))
                 (= reference (:sessionRef result))
                 (= policy/policy-version (:policyVersion result))
                 (= (:version policy/trust-policy) (:trustPolicyVersion result))
                 (= (:version policy/session-policy) (:sessionPolicyVersion result))
                 (contains? policy/model-ids (:model result)) (contains? #{"free" "paid"} (:billing result)) (= "allowed" (:policyDecision result))
                 (contains? #{"queued" "running" "succeeded" "cancelled" "unknown"} status)
                 (policy/text? (:receiptId result) 512)))
      (respond {:error {:code "invalid-job-receipt"}} 502)
      ;; The red team re-verifies the whole ladder on every poll; a blue job
      ;; was admitted on the principal alone (research.cljk teams).
      (and (not (policy/blue? (:model result)))
           (or (policy/eligibility principal record now)
               (not (policy/session-current? reference task (:continuous record) now))
               (not (policy/scope-approved? record {:task task :scopeId scope} now))))
      (respond {:error {:code "job-reverification-required"}} 403)
      (and (= "succeeded" status) (not (terminal-answer? result)))
      (respond {:error {:code "invalid-job-receipt"}} 502)
      :else
      (respond (cond-> {:jobId id :status status :billing (:billing result) :model policy/model-id
                        :receiptId (:receiptId result) :pollAfterMs 5000}
                 (= "succeeded" status) (assoc :content (:content result)
                                               :toolCalls (:toolCalls result)
                                               :finishReason (:finishReason result)))
               (if (contains? #{"queued" "running"} status) 202 200)))))

(defn- job-route [request path binding principal reference respond]
  (let [create? (= path "/v1/research/jobs")
        id (if create? (.get (.-headers request) "idempotency-key")
               (.get (.-searchParams (js/URL. (.-url request))) "jobId"))]
    (if-not (job-id? id) (respond {:error {:code "invalid-job-id"}} 400)
      (-> (if create? (bounded-json request 98304) (js/Promise.resolve nil))
          (.then
           (fn [body]
             (if (and create? (not (policy/completion? body)))
               (respond {:error {:code "invalid-research-request"}} 400)
               ;; The authority must reserve quota+job atomically before returning
               ;; 202. A repeated id with different input must return 409.
               (-> (service binding (if create? "/jobs/create" "/jobs/status")
                            (cond-> {:principalId principal :sessionRef reference :jobId id
                                     :policyVersion policy/policy-version :billing "free-only"
                                     :trustPolicyVersion (:version policy/trust-policy)
                                     :sessionPolicyVersion (:version policy/session-policy)}
                              create? (assoc :request body :limits policy/free-limits)))
                   (.then #(job-response % principal reference id respond))))))))))

(defn- bearer?
  "True when the request authenticated via a personal API token (no browser
  session). Only the bearer path gets the OpenAI-compatible shape: cookie
  browser clients keep the strict site shape."
  [request]
  (.startsWith (or (.get (.-headers request) "authorization") "") (str "Bearer " pat/prefix)))

(defn- normalize-completion
  "Server-derive the admission fields an OpenAI transport cannot send: task
  defaults to code-review (the always-approved task) and scopeId to `owned`
  (the scope the ekyc chain approves for the caller's own material). The
  forwarded body is rebuilt from the strict admission shape only — ignorable
  OpenAI parameters never reach the authority or the upstream."
  [body]
  (cond-> {:model (or (:model body) policy/model-id)
           :task (or (:task body) "code-review")
           :scopeId (or (:scopeId body) "owned")
           ;; OpenAI clients may send max_completion_tokens instead; absent both, a
           ;; modest default rather than the ceiling
           :max_tokens (or (:max_tokens body) (:max_completion_tokens body) 2048)
           :messages (mapv policy/sanitize-message (:messages body))}
    ;; tool definitions and the choice travel to the origin (see research.cljk)
    (seq (:tools body)) (assoc :tools (vec (:tools body)))
    (some? (:tool_choice body)) (assoc :tool_choice (:tool_choice body))))

(defn- authorized-route [request path binding principal reference respond & [^js env]]
  (if (= path "/v1/research/review")
    ;; Operator decisions are HMAC-verified by the authority; the edge only
    ;; requires an authenticated principal on the admin origin and passes the
    ;; bounded body through untouched.
    (if-not (= (.-origin (js/URL. (.-url request))) "https://admin.kotoba.cloud")
      (respond {:error {:code "review-origin-required"}} 403)
      (-> (bounded-json request 32768)
          (.then (fn [body]
                   (-> (service binding "/review" (assoc body :principalId principal :sessionRef reference))
                       (.then (fn [result]
                                (if (and (= principal (:principalId result)) (policy/text? (:receiptId result) 512))
                                  (respond result 200)
                                  (respond {:error {:code "invalid-review-receipt"}} 502)))))))))
    (if (#{"/v1/research/jobs" "/v1/research/job"} path)
    (job-route request path binding principal reference respond)
    (if (= path "/v1/research/status")
    (-> (service binding "/status" {:principalId principal :sessionRef reference :action "code-review"})
        (.then #(status-response % principal reference respond)))
    ;; 2 MiB: 524,288 input characters JSON-escaped and UTF-8 encoded
    (-> (bounded-json request 2097152)
        (.then
         (fn [body]
           (if (= path "/v1/research/applications")
             (if-not (policy/application? body)
               (respond {:error {:code "invalid-application"}} 400)
               (-> (service binding "/applications" {:principalId principal :sessionRef reference
                                                      :requestId (str (random-uuid)) :application body})
                   (.then (fn [result]
                            (if (and (= principal (:principalId result)) (policy/text? (:applicationId result) 256))
                              (respond {:status "pending-review" :applicationId (:applicationId result)} 202)
                              (respond {:error {:code "invalid-application-receipt"}} 502))))))
             ;; The browser (cookie) path keeps the strict site shape; the
             ;; bearer path accepts the OpenAI-compatible shape and
             ;; server-derives task/scopeId before forwarding the strict body.
             ;; Validation runs on the RAW body (unknown keys rejected), the
             ;; normalized body is what the authority sees.
             (let [normalized (if (bearer? request) (normalize-completion body) body)
                   valid? (if (bearer? request)
                            (policy/completion-openai-compatible? body)
                            (policy/completion? body))]
               (cond
                 (not valid?)
                 ;; say WHICH rule on the bearer path: an agent's log is the only
                 ;; place a person sees this (hermes fell back silently on a 400)
                 (respond {:error (cond-> {:code "invalid-research-request"}
                                    (bearer? request)
                                    (assoc :message (policy/completion-openai-compatible-problem body)
                                           :type "invalid_request_error"))} 400)
                 ;; a listed model with no origin is refused here, by name, before
                 ;; a job is reserved and a quota unit spent
                 (not (policy/model-served? (:model normalized)))
                 (respond {:error {:code "model-route-not-configured"
                                   :message (str "model " (:model normalized) " has no origin yet; see /v1/models availability")
                                   :type "invalid_request_error"}} 503)
                 :else
                 (complete env binding principal reference normalized respond
                           {:stream? (and (bearer? request) (true? (:stream body)))})))))))))))



;; Bearer personal-API-token (PAT) path for local CLI/IDE agents. Bypasses the
;; browser origin gate ONLY — ekyc/screening/trust/scope/quota checks are the
;; same code path as the cookie session, against the same authority. The
;; authority trusts the edge's sessionRef, so a stable agent-domain reference
;; is enough; the token itself is verified statelessly by HMAC before any
;; service hop. No origin header, no cookie, no viewer is required here.
(defn- edge-error-code
  "The code the edge answers with for a failed authority hop. Status families
  first; on the eKYC paths an allow-listed authority code (the ex-info message
  `service` threw) wins over the family, since 503 alone cannot tell the
  console 'Stripe refused' from 'no key configured'."
  [e status ekyc?]
  (let [code (ex-message e)]
    (if (and ekyc? (contains? surfaced-ekyc-codes code))
      code
      (case status 413 "body-too-large" 400 "invalid-json" 401 "sign-in-required"
            403 "research-access-denied" 404 "job-not-found" 409 "idempotency-conflict"
            429 "free-quota-exhausted" "research-service-unavailable"))))

(defn- bearer-auth [request ^js env respond path ekyc?]
  (let [binding (.-RESEARCH_AUTHORITY env)
        secret (aget env pat/secret-name)]
    (if (nil? binding)
      (respond {:error {:code "verification-provider-not-configured"}
                :status "pending-provider-setup" :freeTier policy/free-limits} 503)
      (if-not (string? secret)
        (respond {:error {:code "pat-not-configured"}} 503)
        (let [token (subs (.get (.-headers request) "authorization") 7)]
          (-> (pat/verify token secret)
              (.then (fn [auth]
                       (if (nil? auth)
                         (respond {:error {:code "research-access-denied"}} 403)
                         ;; the registry's answer first: a revoked (or never
                         ;; registered) v2 token, or a legacy token after the
                         ;; principal revoked legacy tokens, acts no further.
                         ;; 401 token-revoked names it for the agent's log.
                         (-> (service binding "/tokens/check" {:principalId (:principalId auth)
                                                                :tokenId (:tokenId auth)})
                             (.then (fn [_]
                                      (-> (pat/agent-session-reference
                                           (:principalId auth) (subs (:tokenHash auth) 0 16))
                                          (.then #(if ekyc?
                                                    (ekyc-route request path binding (:principalId auth) % respond)
                                                    (authorized-route request path binding (:principalId auth) % respond env))))))
                             (.catch (fn [e]
                                       (if (= 403 (:status (ex-data e)))
                                         (respond {:error {:code "token-revoked"
                                                           :message (str "personal API token refused: " (ex-message e)
                                                                         " — issue a new one at https://kotoba.cloud/account")
                                                           :type "invalid_request_error"}} 401)
                                         (throw e))))))))))))))

;; Token registry calls the account console makes over the cookie session
;; (the token itself never travels here; only its id and label).
(defn token-registry-call
  "Promise of the authority's answer for one registry op, for the account
  console routes in worker.cljk."
  [^js env op principal payload]
  (let [binding (.-RESEARCH_AUTHORITY env)]
    (if (nil? binding)
      (js/Promise.reject (ex-info "research-service-unavailable" {:status 503}))
      (service binding (str "/tokens/" op) (assoc payload :principalId principal)))))


(defn route [request ^js env fetch-viewer respond]
  (let [path (.-pathname (js/URL. (.-url request))) method (.-method request)
        post? (= method "POST") binding (.-RESEARCH_AUTHORITY env)
        public-webhook? (= path "/v1/research/ekyc/webhook")
        ekyc? (contains? #{"/v1/research/ekyc/start" "/v1/research/ekyc/status" submit-path} path)
        auth-header (or (.get (.-headers request) "authorization") "")
        pat-prefix (str "Bearer " pat/prefix)
        required-method (cond
                          (= path "/v1/research/applications") "POST"
                          (= path "/v1/chat/completions") "POST"
                          (= path "/v1/research/jobs") "POST"
                          (= path "/v1/research/review") "POST"
                          (or public-webhook? (= path "/v1/research/ekyc/start") (= path submit-path)) "POST"
                          :else "GET")]
    (cond
      (not= method required-method)
      (respond {:error {:code "method-not-allowed"}} 405)
      (= path "/v1/models")
      ;; blue-team availability is an environment fact: the shared route's
      ;; key is an operator secret on the RESEARCH authority; the edge reads
      ;; its own copy of the flag (BLUE_ROUTE_CONFIGURED) rather than the key
      (respond (update policy/catalog :data
                       (fn [rows]
                         (mapv (fn [m]
                                 (if (= "blue" (:team m))
                                   (assoc m :availability (if (= "true" (aget env "BLUE_ROUTE_CONFIGURED"))
                                                            "route-configured"
                                                            "route-key-not-configured"))
                                   m))
                               rows)))
               200)
      ;; Stripe server-to-server webhook: no origin, auth or viewer gate.
      public-webhook?
      (-> (if-not binding
            (js/Promise.reject (ex-info "research-service-unavailable" {:status 503}))
            (public-webhook-route request binding respond))
          (.catch (fn [e]
                    (let [status (or (:status (ex-data e)) 503)]
                      ;; Name the failure on the log line (error name + message +
                      ;; event id only, never the payload): a 503 that says nothing
                      ;; hid the redirect-mode TypeError behind Stripe's retries.
                      (js/console.error "stripe-webhook-failed" status
                                        (or (ex-message e) (str (.-name e) ": " (.-message e)))
                                        (str (:eventId (ex-data e))))
                      (respond {:error {:code (case status 400 "invalid-json" "stripe-webhook-rejected")
                                  :eventId (str (:eventId (ex-data e)))}} status)))))
      ;; Bearer PAT: no browser origin, no cookie. This gate must sit BEFORE
      ;; the cookie-session origin/json checks so curl clients without an
      ;; Origin header are not rejected by the browser-only gates.
      (and auth-header (.startsWith auth-header pat-prefix))
      (-> (if (and post? (not (re-find #"(?i)^application/json(?:;|$)" (or (.get (.-headers request) "content-type") ""))))
            (js/Promise.reject (ex-info "json-required" {:status 415}))
            (js/Promise.resolve nil))
          (.then (fn [] (bearer-auth request env respond path ekyc?)))
          (.catch (fn [e]
                    (let [status (or (:status (ex-data e)) 503)]
                      (respond {:error {:code (if (= 415 status) "json-required" (edge-error-code e status ekyc?))}}
                               status)))))
      (and post? (not (contains? origins (.get (.-headers request) "origin"))))
      (respond {:error {:code "origin-not-allowed"}} 403)
      (and post? (not (re-find #"(?i)^application/json(?:;|$)" (or (.get (.-headers request) "content-type") ""))))
      (respond {:error {:code "json-required"}} 415)
      :else
      (-> (fetch-viewer request)
          (.then (fn [viewer]
                   (cond
                     (not (true? (:valid viewer))) (respond {:error {:code "sign-in-required"}} 401)
                     (nil? binding) (respond {:error {:code "verification-provider-not-configured"}
                                             :status "pending-provider-setup" :freeTier policy/free-limits} 503)
                     :else (-> (session-reference request (:principalId viewer))
                               (.then #(if ekyc?
                                         (ekyc-route request path binding (:principalId viewer) % respond)
                                         (authorized-route request path binding (:principalId viewer) % respond env)))))))
          (.catch (fn [e]
                    (let [status (or (:status (ex-data e)) 503)]
                      (respond {:error {:code (edge-error-code e status ekyc?)}} status))))))))
