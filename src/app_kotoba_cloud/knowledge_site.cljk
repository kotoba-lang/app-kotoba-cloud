(ns app-kotoba-cloud.knowledge-site
  "Kotoba Cloud host for the shared Kotobase workbench. Credentials and network
   policy live here, never in the shared components."
  (:require [cloud-kotoba-dds.graph-workbench :as graph]
            [jp-go-dds.core :as dds]))

(def css
  (str graph/page-css
       "#knowledge-view[hidden]{display:none;}\n"
       "#knowledge-view{padding-block:var(--hig-spacing-6);background:var(--color-neutral-white);border-top:1px solid var(--color-neutral-solid-gray-200);}\n"
       ".kc-knowledge-header{margin-bottom:var(--hig-spacing-6);padding-bottom:var(--hig-spacing-4);border-bottom:1px solid var(--color-neutral-solid-gray-100);}\n"
       ".kc-knowledge-nav{display:flex;align-items:center;gap:var(--hig-spacing-4);margin-bottom:var(--hig-spacing-3);}\n"
       ".kc-knowledge-back{display:inline-flex;align-items:center;gap:.35rem;font-weight:600;text-decoration:none;font-size:.875rem;color:var(--color-key-900);}\n"
       ".kc-knowledge-back:hover{text-decoration:underline;}\n"
       ".kc-knowledge-badges{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:var(--hig-spacing-2);}\n"
       ".kc-knowledge-badge{display:inline-flex;align-items:center;font-size:.75rem;padding:.2rem .65rem;border-radius:9999px;background:var(--color-neutral-solid-gray-100);color:var(--color-neutral-solid-gray-800);border:1px solid var(--color-neutral-solid-gray-200);}\n"
       ".kc-knowledge-badge--primary{background:var(--color-primitive-blue-50);color:var(--color-key-900);border-color:var(--color-key-300);font-weight:600;}\n"
       ".kc-knowledge-connect{display:flex;align-items:center;gap:var(--hig-spacing-4);flex-wrap:wrap;margin-bottom:var(--hig-spacing-6);padding:var(--hig-spacing-4);border-radius:.5rem;background:var(--color-neutral-solid-gray-50);border:1px solid var(--color-neutral-solid-gray-200);}\n"
       ".kc-knowledge-state{margin:0;font-size:.875rem;color:var(--color-neutral-solid-gray-700);}\n"
       ".kc-knowledge-state[data-bad=\"1\"]{color:var(--color-semantic-error-1);font-weight:600;}\n"
       "#knowledge-view template{display:none;}\n"))

(defn view [locale]
  (let [ja? (= locale :ja) t (fn [ja en] (if ja? ja en))]
    [:section {:id "knowledge-view" :hidden true :aria-label "Knowledge Graph & Ontology Database"}
     (dds/container
      [:header {:class "kc-knowledge-header"}
       [:nav {:class "kc-knowledge-nav"}
        [:a {:href "#chat" :class "kc-knowledge-back"} (t "← 調査チャットに戻る" "← Back to Research Chat")]]
       (dds/heading 2 (t "Knowledge Graph & オントロジーデータベース" "Knowledge Graph & Ontology Database") {:size "32"})
       [:p (t "Kotoba Cloud のセッション認証と暗号化通信で第一者データベース（api.kotoba.cloud）を直接管理します。"
              "Manage your first-party databases directly through api.kotoba.cloud using your Kotoba Cloud session.")]
       [:div {:class "kc-knowledge-badges"}
        [:span {:class "kc-knowledge-badge kc-knowledge-badge--primary"} "api.kotoba.cloud/v1/database"]
        [:span {:class "kc-knowledge-badge"} (t "IPLD / CID 正本" "IPLD / CID Authoritative")]
        [:span {:class "kc-knowledge-badge"} (t "オントロジー型推論" "Ontology Type Inference")]
        [:span {:class "kc-knowledge-badge"} (t "Datalog · Cypher · SQL" "Datalog · Cypher · SQL")]]
       [:p {:class "kb-footnote kb-mut" :style {:margin-top "0.75rem"}}
        (t "オントロジー画面は蓄積データから観測した属性（observed attributes）と型を可視化・分析します。不変のIPLDスナップショットに基づく厳密なデータ管理を提供します。"
           "The ontology inspector visualizes and analyzes observed attributes and types from persistent datoms, backed by immutable IPLD snapshots.")]]
      [:div {:class "kc-knowledge-connect"}
       [:label {:for "knowledge-tenant"} (t "ワークスペース" "Workspace")]
       [:select {:id "knowledge-tenant"} [:option {:value ""} (t "個人のカタログ（参照のみ）" "Personal catalog (catalog only)")]]
       [:label {:for "knowledge-tenant-name"} (t "新しいワークスペース名" "New workspace name")]
       [:input {:id "knowledge-tenant-name" :maxlength "80" :value "Billing verification"}]
       [:button {:id "knowledge-tenant-create" :type "button"} (t "ワークスペースを作成" "Create workspace")]]
      [:form {:id "knowledge-connect" :class "kc-knowledge-connect"}
       (dds/button (t "データベースを開く" "Open databases") {:type :solid-fill :submit? true})
       (dds/button (t "ワークベンチを閉じる" "Close workbench") {:type :outline :attrs {:type "button" :id "knowledge-disconnect" :hidden true}})
       [:a {:id "knowledge-sign-in" :class "dads-button dads-button--outline" :href "https://auth.kotoba.cloud/sign-in"} (t "ログイン" "Sign in")]
       [:p {:id "knowledge-state" :class "kc-knowledge-state" :role "status"}]]
      [:div {:id "knowledge-mount"}]
      [:template {:id "knowledge-template"}
       [:div {:lang (if ja? "ja" "en")}
        (graph/view {:heading-level 2
                     :title (t "データベース・オントロジー管理" "Database & Ontology Workbench")
                     :billing [:p [:a {:href "/billing/"} (t "Kotoba Cloud の料金・プラン設定" "Kotoba Cloud Billing & Plans")]]})]])
     [:script {:src "/js/graph-workbench.js" :defer true}]
     [:script {:src "/js/knowledge-host.js" :defer true}]]))

(def script
  "(function(){
  var view=document.getElementById('knowledge-view');if(!view)return;
  var form=document.getElementById('knowledge-connect'),mount=document.getElementById('knowledge-mount'),
    status=document.getElementById('knowledge-state'),disconnect=document.getElementById('knowledge-disconnect'),
    signIn=document.getElementById('knowledge-sign-in'),controller=null,instance=null,generation=0;
  var api=location.origin+'/v1/database';
  signIn.href='https://auth.kotoba.cloud/sign-in?return_to='+encodeURIComponent(location.origin+location.pathname+'#knowledge/overview');
  function clear(){generation++;if(controller)controller.abort();if(instance)instance.dispose();controller=null;instance=null;mount.replaceChildren();disconnect.hidden=true;form.querySelector('[type=submit]').disabled=false;status.textContent='Workbench closed.';status.setAttribute('data-bad','0');}
  var tenantSelect=document.getElementById('knowledge-tenant'),tenantName=document.getElementById('knowledge-tenant-name');
  function sessionCall(path,body){return fetch('/v1/database/session/'+path,{method:body?'POST':'GET',credentials:'same-origin',headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined}).then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.error||'Workspace request failed');return d;});});}
  function loadTenants(selected){return sessionCall('tenants').then(function(d){tenantSelect.replaceChildren(new Option('個人のカタログ（参照のみ）',''));(d.memberships||[]).filter(function(m){return m.status==='active';}).forEach(function(m){tenantSelect.add(new Option(m.tenantId,m.tenantId));});if(selected)tenantSelect.value=selected;});}
  document.getElementById('knowledge-tenant-create').addEventListener('click',function(){var button=this;button.disabled=true;clear();sessionCall('tenants',{name:tenantName.value.trim()}).then(function(d){if(!d.tenant||!d.tenant.id)throw new Error('Workspace not created');return loadTenants(d.tenant.id);}).then(function(){status.textContent='ワークスペースを作成しました。「データベースを開く」で接続してください。';}).catch(function(e){status.textContent=e.message;}).finally(function(){button.disabled=false;});});
  tenantSelect.addEventListener('change',clear);
  loadTenants().catch(function(){});
  form.addEventListener('submit',function(e){e.preventDefault();clear();var run=generation,tenant=tenantSelect.value;
    controller=new AbortController();var signal=controller.signal;form.querySelector('[type=submit]').disabled=true;
    status.textContent='Checking your Kotoba Cloud session…';status.setAttribute('data-bad','0');
    fetch('/v1/session',{credentials:'same-origin',cache:'no-store',signal:signal}).then(function(r){if(!r.ok)throw new Error('Session unavailable');return r.json();}).then(function(session){
      if(signal.aborted||run!==generation)return;
      if(!session.valid){signIn.hidden=false;throw new Error('Sign in to Kotoba Cloud to continue.');}
      signIn.hidden=true;disconnect.hidden=false;
      mount.appendChild(document.getElementById('knowledge-template').content.cloneNode(true));
      instance=window.cloudKotobaGraph.mount(mount.querySelector('.kb-console'),{
        hashPrefix:'knowledge/',blockHref:function(cid){return api+'/ipld/'+encodeURIComponent(cid);},
        request:function(path,options){
          if(signal.aborted)return Promise.reject(new Error('disconnected'));
          if(!/^\\/(xrpc\\/|pins(?:[/?]|$)|v1\\/audit(?:[/?]|$)|api\\/)/.test(path)||path.indexOf('..')!==-1)return Promise.reject(new Error('Unsupported database route'));
          var headers=new Headers(options.headers||{});if(tenant)headers.set('x-kotobase-tenant',tenant);
          var data={};try{data=JSON.parse(options.body||'{}');}catch(e){}
          var graphOp=path.endsWith('datomic.q')||path.endsWith('datomic.transact')||path.endsWith('datomic.asOf')||path.endsWith('datomic.dbStats')||path.endsWith('kg.query')||path.indexOf('/api/')===0;
          var supplied=headers.get('authorization'),write=path.endsWith('transact')||(path.endsWith('kg.query')&&String(data.query||'').trim().toUpperCase().startsWith('CREATE '));
          var prepare=Promise.resolve();
          if(graphOp&&(!supplied||supplied==='Biscuit session')){
            if(!tenant||!data.db_name){status.textContent='データの読み書きにはワークスペースとDBを選択してください。';return Promise.reject(new Error('Workspace and database required'));}
            prepare=sessionCall('token',{tenantId:tenant,dbName:data.db_name,permissions:write?['data:read','data:write']:['data:read']}).then(function(d){if(signal.aborted||run!==generation)throw new Error('disconnected');if(d.tokenType!=='Biscuit'||!d.token)throw new Error('Database authorization unavailable');headers.set('authorization','Biscuit '+d.token);});
          }
          return prepare.then(function(){return fetch(api+path,Object.assign({},options,{headers:headers,credentials:'include',redirect:'error',cache:'no-store',signal:signal}));}).then(function(r){
            if(r.status===401){status.textContent='Database authorization was rejected. Reconnect the workspace or refresh its permission.';status.setAttribute('data-bad','1');return r.clone().json().then(function(d){if(signal.aborted||run!==generation)return r;var detail=[d.error_origin,d.stage,d.message,d.reason,d.details].filter(function(v){return typeof v==='string';}).join(' ').slice(0,300);if(detail)status.textContent+=' '+detail;return r;},function(){return r;});}
            if(r.status===503){status.textContent='Database service is not ready. Please try again later.';status.setAttribute('data-bad','1');}
            return r;
          });
        }
      });
      if(tenant){var authInput=mount.querySelector('#cacao-token');if(authInput){authInput.value='session';authInput.type='hidden';}}
      status.textContent='Connected through api.kotoba.cloud. Each operation checks your database permissions.';status.setAttribute('data-bad','0');
      mount.querySelector('.kb-console').addEventListener('kb:tenant-ready',function(){status.textContent='Database tenant confirmed.';});
    }).catch(function(e){if(signal.aborted||run!==generation)return;form.querySelector('[type=submit]').disabled=false;status.textContent=e.message;status.setAttribute('data-bad','1');});
  });
  disconnect.addEventListener('click',clear);window.addEventListener('pagehide',clear);
  function route(){var open=location.hash.indexOf('#knowledge/')===0||location.hash==='#knowledge';view.hidden=!open;
    var chat=document.getElementById('chat-view'),security=document.getElementById('security-view');
    if(chat)chat.hidden=open||location.hash==='#security';if(security)security.hidden=location.hash!=='#security';}
  window.addEventListener('hashchange',route);window.addEventListener('popstate',route);route();
})();")
