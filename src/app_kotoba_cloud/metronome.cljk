(ns app-kotoba-cloud.metronome)
(defn call [env path body key]
  (when-not (aget env "METRONOME_API_KEY") (throw (ex-info "metronome-not-configured" {})))
  (-> (js/fetch (str "https://api.metronome.com" path)
                #js {:method "POST" :redirect "error" :signal (js/AbortSignal.timeout 15000)
                     :headers #js {"content-type" "application/json" "authorization" (str "Bearer " (aget env "METRONOME_API_KEY"))
                                   "Idempotency-Key" key}
                     :body (js/JSON.stringify (clj->js body))})
      (.then (fn [r]
               (if (.-ok r) (-> (.json r) (.then #(js->clj % :keywordize-keys true)))
                   (throw (ex-info "metronome-request-failed" {:status (.-status r)})))))))
(defn grant [env customer contract product scope grant]
  ;; Externally collected money: no invoice_schedule, so this never invoices twice.
  ;; Scope to the service's usage products and this customer's contract.
  (call env "/v1/contracts/customerCommits/create"
        {:customer_id customer :type "prepaid" :name (:id grant) :product_id product
         :priority (if (:topup grant) 100 10) :applicable_contract_ids [contract]
         :applicable_product_tags [scope] :uniqueness_key (:id grant)
         :access_schedule {:credit_type_id (aget env "METRONOME_CREDIT_TYPE_ID") :schedule_items [{:amount (* 100 (:credits grant))
                                             :starting_at (.toISOString (js/Date. (* 1000 (:start grant))))
                                             :ending_before (.toISOString (js/Date. (* 1000 (:end grant))))}]}}
        (:id grant)))
