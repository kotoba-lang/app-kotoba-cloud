(ns app-kotoba-cloud.crypto-site
  "Crypto-asset fraud response catalog (exchanges, report windows,
   country procedures). Shell from the cloud-kotoba-dds catalog pattern;
   this file keeps the catalog's callout and copy."
  (:require [cloud-kotoba-dds.catalog :as catalog]))

(def css
  "Pattern owns the shell. Nothing catalog-specific is left here.")

(defn view
  ([] (view false))
  ([embedded?]
   (catalog/page
    {:title "暗号資産詐欺対応カタログ（取引所・通報窓口・各国手順）"
     :lead "全世界の暗号資産取引所の情報とセキュリティ通報窓口、そして国・地域ごとの詐欺被害時の相談・通報手順をまとめた公開データカタログです。被害に遭った疑いがある場合は、まず下の注意書きをお読みください。"
       :nav (catalog/breadcrumb
          "カタログ"
          [["ホーム" "/ja/"]
           ["セキュリティ公開データ" "/ja/security/"]
           ["このカタログ" nil]])
     :embedded? embedded?
     :id "kcc-main"}
    (catalog/callout
     [:strong "被害の可能性があるときは："]
     " 日本国内では、まず "
     [:a {:href "https://www.npa.go.jp/cyber/" :target "_blank" :rel "noopener"} "警察相談専用電話（#9110）"]
     " または最寄りの警察署・"
     [:a {:href "https://www.npa.go.jp/" :target "_blank" :rel "noopener"} "都道府県警察サイバー犯罪相談窓口"]
     " に相談し、取引所には直ちにアカウント凍結（不正アクセスの申告）を依頼してください。金融機関からの送金がある場合は "
     [:a {:href "https://www.fude.or.jp/" :target "_blank" :rel "noopener"} "振り込み詐欺・送金犯罪被害者救援センター"]
     " への相談も有効です。早通報ほど資金冻结・回収の可能性が上がります。")
    (catalog/status "kcc-summary" "データを読み込んでいます…")
    (catalog/tabs {:id "kcc-tabs" :label "カタログ種別"})
    (catalog/tools
     {:search-id "kcc-search" :search-label "検索"
      :search-placeholder "取引所名・国・規制当局／国名・窓口名で検索"})
    (catalog/grid
     {:list-id "kcc-results" :list-label "一覧"}
     (catalog/detail {:id "kcc-detail" :label "詳細"}))
    (catalog/about
     {:summary "このカタログについて"
      :links [[:a {:href "/crypto-data/crypto/index.json"} "IPLD インデックス"]
              [:a {:href "/crypto-data/crypto/exchanges.json"} "取引所レコード"]
              [:a {:href "/crypto-data/crypto/procedures.json"} "通報手順レコード"]]
      :footnote "データはコード生成による content-addressed block（IPLD形式）として公開されています。商標・名称は各所有者に帰属します。掲載内容は各取引所・機関の公開情報（公式サイト・規制当局の公開登録簿等）に基づく収集データで、各レコードに出典URLを付けています。通報窓口・手続きは変更されることがあるため、実行前に必ず出典の公式ページで最新情報を確認してください。このカタログは法的助言や捜査の代わりではありません。"})
    [:script {:src "/js/crypto-catalog.js" :defer true}])))
