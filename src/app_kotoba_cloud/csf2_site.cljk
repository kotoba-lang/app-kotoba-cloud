(ns app-kotoba-cloud.csf2-site
  "NIST CSF 2.0 security-product catalog: pick a product, see which CSF 2.0
   subcategories it supports. Static page over sourced IPLD-style data.
   Shell, tools, list, chips and detail come from the cloud-kotoba-dds
   catalog pattern; this file keeps the catalog's coverage chart and copy."
  (:require [cloud-kotoba-dds.catalog :as catalog]))

(def css
  "Chart-only CSS. Shell/tools/list/chips/detail come from
   cloud-kotoba-dds.catalog/css (concatenated in site.cljk)."
  (str
  ".csf2-chart{display:grid;gap:var(--hig-spacing-2,8px);margin:var(--hig-spacing-4,16px) 0 var(--hig-spacing-5,20px)}.csf2-row{display:grid;grid-template-columns:5.5em 1fr 4.5em;align-items:center;gap:var(--hig-spacing-2,8px)}"
  ".csf2-fn{font-size:var(--hig-text-footnote-font-size,.85rem);color:var(--hig-color-secondary-label)}.csf2-count{font-variant-numeric:tabular-nums;color:var(--hig-color-label);font-size:var(--hig-text-footnote-font-size,.85rem);text-align:right}"
  ".csf2-bar{height:12px;border-radius:var(--hig-radius-capsule,999px);border:1px solid var(--hig-color-separator);background:var(--hig-color-tertiary-system-background);overflow:hidden}.csf2-fill{height:100%;min-width:2px;border-radius:var(--hig-radius-capsule,999px);transition:width .2s}"
  "@media(prefers-reduced-motion:reduce){.csf2-fill{transition:none}}"))

(defn view
  ([] (view false))
  ([embedded?]
   (catalog/page
    {:title "セキュリティ製品 × NIST CSF 2.0 カタログ"
     :lead "全世界のサイバーセキュリティ製品から、使っている（導入を検討している）製品を選ぶと、NIST CSF 2.0 の 106 サブカテゴリのどれをその製品がサポートするかを機能別チャートで表示します。"
       :nav (catalog/breadcrumb
          "カタログ"
          [["ホーム" "/"]
           ["セキュリティ公開データ" "/security/"]
           ["このカタログ" nil]])
     :embedded? embedded?
     :id "csf2-main"}
    (catalog/status "csf2-summary" "データを読み込んでいます…")
    (catalog/tools
     {:search-id "csf2-search" :search-label "製品を検索"
      :search-placeholder "製品名・ベンダー・カテゴリで検索"
      :select-id "csf2-kind" :select-label "製品カテゴリ"
      :options [[:option {:value ""} "すべてのカテゴリ"]]})
    (catalog/grid
     {:list-id "csf2-results" :list-label "製品一覧"}
     [:section {:id "csf2-coverage" :aria-live "polite"}]
     [:div {:id "csf2-chart" :class "csf2-chart" :role "img" :aria-label "機能別サブカテゴリカバー率"}]
     (catalog/chips {:id "csf2-chips"})
     (catalog/detail {:id "csf2-detail" :label "製品の詳細"})
     [:button {:id "csf2-report" :type "button" :hidden true} "カバレッジレポートをダウンロード（JSON）"])
    (catalog/about
     {:summary "このカタログについて"
      :links [[:a {:href "/security-data/csf2/index.json"} "IPLD インデックス"]
              [:a {:href "/security-data/csf2/subcategories.json"} "サブカテゴリ定義"]
              [:a {:href "/security-data/csf2/products.json"} "製品レコード"]]
      :footnote "NIST Cybersecurity Framework 2.0 の利用条件は NIST の公表物に従います。製品名・ベンダー名は各所有者の商標です。CSF 2.0 のサブカテゴリ定義は NIST CSWP 29（2024-02-26 公表）の本文から抽出した正本テキストです。製品のマッピングは各ベンダーの公開文書に基づく代表 capability の主張であり、第三者検証や認定の代わりではありません。マッピングの正否は各製品の公開資料で確認してください。"})
    [:script {:src "/js/csf2-catalog.js" :defer true}])))
