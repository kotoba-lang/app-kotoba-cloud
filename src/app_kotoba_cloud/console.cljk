(ns app-kotoba-cloud.console
  "The console's information architecture as DATA (ADR-2608080100: views
  are data, the nav is generated). One table declares every sidebar
  destination — its group, label, href, badge — and everything else derives
  from it: the sidebar, the top bar's section label, the setup steps.

  Reference IA (owner-supplied, 2026-09-15): a console —
  MAIN / MANAGE / SECURE / ACCOUNT groups, a top bar with the section name,
  a credit chip, a docs link and a 'Get started n/N' progress chip, a
  'Resume setup' banner naming the next step, and an account chip at the
  foot of the sidebar. Every destination here is a REAL document or a
  Worker route (shinkansen.audit :links-resolve is a hard axis); every
  badge is a fact, not a decoration.

  Pure .cljk: no DOM, no fetch. site.cljk renders it; shell-browser
  hydrates the chips from the session. Every label is a KEY into
  console-locales (22 public locales, ADR-2609091700); the table holds no
  copy of its own."
  (:require [kotoba.lang.text :as str]
            [app-kotoba-cloud.console-locales :as cl]))

(def groups
  "Sidebar groups in order. :items are {:id :key :href :badge?}; :key names
   the label in console-locales. :href is where the item lands; a fragment
   on a document is a view of that document (one document, several views —
   never a second page). The group :label is the reference IA's own
   uppercase mark (MAIN / MANAGE / SECURE / ACCOUNT) and is not translated;
   the top bar's section name is (:group-key)."
  [{:id :main :label "MAIN" :group-key :group-main
    :items [{:id :docs :key :nav-docs :href "/docs/"}
            {:id :apps :key :nav-apps :href "/apps/"}
            {:id :blog :key :nav-blog :href "/blog/"}]}
   {:id :manage :label "MANAGE" :group-key :group-manage
    :items [{:id :keys :key :nav-keys :href "/account#account-panel-cli"}
            {:id :models :key :nav-models :href "/models/"}
            {:id :register :key :nav-register :href "/#research-register"}
            {:id :usage :key :nav-usage :href "/docs/reference/billing-and-usage/"}]}
   {:id :secure :label "SECURE" :group-key :group-secure
    :items [{:id :guardrails :key :nav-guardrails :href "/secure/#guardrails"}
            {:id :firewall :key :nav-firewall :href "/secure/#firewall"}
            {:id :compliance :key :nav-compliance :href "/secure/#compliance"}
            {:id :services :key :nav-services :href "/security/services/"}
            {:id :aup :key :nav-aup :href "/security/aup/"}]}
   {:id :account :label "ACCOUNT" :group-key :group-account
    :items [{:id :account :key :nav-account :href "/account"}
            {:id :team :key :nav-team :href "/account#account-panel-org" :badge "Team"}
            {:id :billing :key :nav-billing :href "/billing/"}]}])

(def get-started
  "The sidebar's primary action — the quickstart, once."
  {:key :get-started :href "/docs/reference/quickstart/"})

(defn label
  "An item's label in `locale` (console-locales; English when the locale
   has no entry)."
  [item locale] (cl/t locale (:key item)))

;; --- surfaces ---------------------------------------------------------------
;; One emit tree, two hosts (owner direction 2026-09-15: /docs/ moves to
;; docs.kotoba.cloud). Every href in this repo is written ONCE in its apex
;; form (/docs/reference/quickstart/, /account) and resolved for the
;; surface the document is emitted on: same surface → a path relative to
;; that surface's root; another surface → an absolute URL. Query-only
;; (?lang=), fragment-only, absolute and mailto hrefs pass through.

(def surfaces
  {:apex {:origin "https://kotoba.cloud" :root "/"}
   :docs {:origin "https://docs.kotoba.cloud" :root "/docs/"}})

(defn surface-of
  "The surface that owns an apex-form path: /docs/… → :docs, else :apex."
  [href]
  (if (or (= href "/docs") (str/starts-with? href "/docs/")) :docs :apex))

(def shared-asset-prefixes
  "Paths every surface serves from the one asset tree as its own: the
   stylesheet, scripts, the brand mark, favicon. Never rewritten."
  ["/css/" "/js/" "/assets/" "/favicon.ico"])

(defn href-for
  "The href as written on `surface` for an apex-form href."
  [surface href]
  (if-not (and (string? href) (str/starts-with? href "/") (not (str/starts-with? href "//"))
               (not (some #(str/starts-with? href %) shared-asset-prefixes)))
    href
    (let [home (surface-of href)
          {:keys [origin root]} (get surfaces home)
          local (if (= home :apex)
                  href
                  (let [tail (subs href (count "/docs"))]
                    (if (str/blank? tail) "/" tail)))]
      (if (= home surface)
        local
        (str origin local)))))

(defn- document-of
  "/secure/#guardrails → /secure/ ; /account#x → /account"
  [href]
  (first (str/split href #"#" 2)))

(defn current-item
  "The item the page `current` belongs to: exact href first, then the item
   whose document is the page (so /secure/ highlights ガードレール, the
   first view of that document), then the longest document prefix (so
   /docs/reference/quickstart/ highlights ドキュメント)."
  [current]
  (let [items (mapcat :items groups)
        cur (document-of (str current))]
    (or (some #(when (= (:href %) current) %) items)
        (some #(when (= (document-of (:href %)) cur) %) items)
        (->> items
             (filter #(let [d (document-of (:href %))]
                        (and (str/ends-with? d "/") (str/starts-with? cur d) (not= d "/"))))
             (sort-by #(- (count (:href %))))
             first))))

(defn section-label
  "The top bar's section name for a page: the group label + item label
   (セキュリティ › ガードレール). Nil when the page is not in the table."
  [current locale]
  (when-let [item (current-item current)]
    (let [group (some #(when (some #{item} (:items %)) %) groups)]
      {:group (cl/t locale (:group-key group))
       :item (label item locale)})))

(defn sidebar-items
  "Render-ready rows for the sidebar: {:label :href :badge :current?}."
  [current locale]
  (let [cur (current-item current)]
    (for [g groups]
      {:group (:label g)
       :items (for [i (:items g)]
                {:label (label i locale) :href (:href i) :badge (:badge i)
                 :current? (= i cur)})})))

;; --- setup progress ---------------------------------------------------------
;; The reference shows "Get started 2/4" and a "Resume setup — finish
;; connecting your key" banner. Ours has three measurable steps (each backed
;; by an endpoint the console already reads); a fourth ("first request")
;; needs a job-list endpoint that does not exist yet, so it is NOT shown —
;; a step whose state cannot be read is not a step.

(def setup-steps
  [{:id :sign-in :key :step-sign-in :href "/account"}
   {:id :verify :key :step-verify :href "/account#account-panel-identity"}
   {:id :eligible :key :step-eligible :href "/account#account-panel-eligibility"}])

(defn setup-progress
  "state: {:signed-in? bool :ekyc \"verified\"|\"pending\"|\"missing\"|nil :eligible? bool|nil}
   → {:done n :total 3 :steps [{:id :label :done? :href}] :next step-or-nil}.
   Unknown (nil) never counts as done. `labels` is a locale (console-
   locales) or a fn of the step's :key → label (the browser reads the
   document's own copy, not the map)."
  [{:keys [signed-in? ekyc eligible?]} labels]
  (let [done {:sign-in (true? signed-in?)
              :verify (= "verified" ekyc)
              :eligible (true? eligible?)}
        label-of (if (fn? labels) labels (fn [k] (cl/t labels k)))
        steps (mapv (fn [s] {:id (:id s) :label (label-of (:key s)) :href (:href s)
                             :done? (get done (:id s))})
                    setup-steps)]
    {:done (count (filter :done? steps))
     :total (count steps)
     :steps steps
     :next (first (remove :done? steps))}))
