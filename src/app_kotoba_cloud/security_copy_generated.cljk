(ns app-kotoba-cloud.security-copy-generated
  "GENERATED by scripts/translate-console-copy.cljk --source security — do not edit by hand.
   Copy for every public locale other than en / ja, machine-translated from the
   authored source over the OpenRouter API (keys: keywords for the console chrome,
   the English strings themselves for a body — app-kotoba-cloud.copy/txt-for answers
   by them). `provenance` names the model and date per locale; none of it is
   native-speaker reviewed (ADR-2609091700 permits machine translation and forbids
   claiming review). Regenerate a locale with --only <code>.")

(def provenance
  {:ar {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :ar-MA {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :arz {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :bn {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :de {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :es {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :fr {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :he {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :hi {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :id {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :it {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :jv {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :ko {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :mr {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :pcm {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :pt {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :ru {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :su {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :ur {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}, :zh-Hans {:model "anthropic/claude-sonnet-5", :date "2026-09-16"}})

(def copy
