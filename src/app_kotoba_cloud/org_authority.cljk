(ns app-kotoba-cloud.org-authority
  "Private organization authority (ADR-2609141633). Runs as a Durable Object in
  the private kotoba-research-authority Worker; the public control plane reaches
  it only through a service binding. It owns the organization signing key pair
  (Ed25519, generated on first create), the membership roster with per-member
  status, and mints the organization's did:webvh genesis log at create."
  (:require [kotoba.lang.text :as str]
            [didwebvh.entry :as entry]
            [didwebvh.signer :as vh-signer]
            [biscuit.token :as bt]
            [ed25519.sign :as ed]
            [app-kotoba-cloud.org-registry :as org-registry]))

(def schema-version "kotoba-org-membership-2026-09-v1")
(def roles #{"owner" "admin" "member" "billing"})
(def handle-pattern #"^com-[a-z0-9][a-z0-9-]{2,62}\.kotoba\.cloud$")
(def role-rank {"owner" 3 "admin" 2 "member" 1 "billing" 1})

(defn- response [body status]
  (js/Response. (js/JSON.stringify (clj->js body))
                #js {:status status
                     :headers #js {"content-type" "application/json; charset=utf-8"
                                   "cache-control" "no-store"}}))

(defn- text? [x n] (and (string? x) (<= 1 (count x) n) (re-find #"\S" x)))

(defn- decode [x]
  (if (or (nil? x) (undefined? x)) nil (js->clj x :keywordize-keys true)))

(defn- load-org! [storage handle]
  (-> (js-invoke storage "get" (str "org:" handle)) (.then decode)))

(defn- save-org! [storage handle org]
  (js-invoke storage "put" (str "org:" handle) (js/JSON.stringify (clj->js org))))

(defn- all-orgs! [storage]
  (-> (js-invoke storage "list" #js {:prefix "org:"})
      (.then (fn [listing]
               (js/Promise.all
                (map (fn [k] (-> (js-invoke storage "get" k) (.then decode)))
                     (array-seq (or (.-keys listing) []))))))))

(defn- org-for-member [orgs principal-id]
  (some (fn [org]
          (when (some #(and (= principal-id (:principalId %))
                            (= "active" (:status %)))
                      (:members org))
            org))
        orgs))

(defn- active-member [org principal-id]
  (some #(when (and (= principal-id (:principalId %)) (= "active" (:status %))) %)
        (:members org)))

(defn- generate-signing-key! []
  (-> (.generateKey (.-subtle js/crypto) "Ed25519" true #js ["sign" "verify"])
      (.then (fn [keys]
               (js/Promise.all
                [(js-invoke (.-subtle js/crypto) "exportKey" "jwk" (.-publicKey keys))
                 (js-invoke (.-subtle js/crypto) "exportKey" "jwk" (.-privateKey keys))])))))

(defn- membership-vc [org member-principal role]
  {:schemaVersion schema-version
   :type ["VerifiableCredential" "KotobaOrgMembership"]
   :issuer (:did org)
   :credentialStatus {:id (str "https://kotoba.cloud/.well-known/kotoba-org-status/"
                               (:handle org) "/v1")
                      :type "KotobaOrgStatusList"}
   :credentialSubject {:id member-principal :org (:did org) :role role :handle (:handle org)}})

;; --- VC proof (Data Integrity over canonical JSON) --------------------------
(defn- b64url [buf]
  (let [bytes (js/Uint8Array. buf)]
    (-> (js/btoa (apply str (map char (array-seq bytes))))
        (.replaceAll "+" "-") (.replaceAll "/" "_") (.replace #"=+$" ""))))

(defn- b64url-decode [s]
  (let [s (-> s (.replaceAll "-" "+") (.replaceAll "_" "/"))
        pad (mod (count s) 4)
        s (if (= 0 pad) s (str s (apply str (repeat (- 4 pad) "="))))]
    (vec (map #(bit-and (int %) 0xff) (.atob js/globalThis s)))))

(defn- mint-biscuit-authority! [org member-principal role member-next-public-key]
  ;; Root block signed with the org key (pure-RFC8032 over its raw private key
  ;; from the stored JWK `d`). Carries the member fact; the member attenuates
  ;; offline with their own key — the org never sees it.
  (let [d (b64url-decode (:d (js->clj (js/JSON.parse (:privateJwk org)) :keywordize-keys true)))
        sk (ed/secret-key! d)
        pub (vh-signer/multikey (:public sk))]
    (bt/authority
     {:facts (list (list 'org (:did org))
                   (list 'member member-principal role))
      :next-public-key member-next-public-key
      :root-private-key d
      :sign-fn (fn [_private-key payload] (vec (ed/sign sk payload)))})))

(defn- import-signing-key! [private-jwk]
  (.importKey (.-subtle js/crypto) "jwk" (js/JSON.parse private-jwk)
              (clj->js {:name "Ed25519"}) false #js ["sign"]))

(defn- sign-vc! [org vc]
  ;; Deterministic construction: membership-vc builds the map with a fixed key
  ;; order, so JSON.stringify(vc-without-proof) is the canonical form.
  (let [payload (js/JSON.stringify (clj->js (dissoc vc :proof)))]
    (-> (import-signing-key! (:privateJwk org))
        (.then (fn [key]
                 (.sign (.-subtle js/crypto) (clj->js {:name "Ed25519"})
                        key (.encode (js/TextEncoder.) payload))))
        (.then (fn [sig]
                 (assoc vc :proof
                        {:type "DataIntegrityProof"
                         :cryptosuite "eddsa-jcs-2022"
                         :verificationMethod (str (:did org) "#key-1")
                         :proofPurpose "assertionMethod"
                         :jws (b64url sig)}))))))

(defn- verify-vc! [org vc]
  ;; Byte-compare: re-sign the proof-less form with the org's stored key and
  ;; compare to the presented jws. A tampered subject/role/issuer fails here.
  (if-not (:proof vc)
    (js/Promise.resolve false)
    (let [presented (:jws (:proof vc))
          payload (js/JSON.stringify (clj->js (dissoc vc :proof)))]
      (-> (import-signing-key! (:privateJwk org))
          (.then (fn [key]
                   (.sign (.-subtle js/crypto) (clj->js {:name "Ed25519"})
                          key (.encode (js/TextEncoder.) payload))))
          (.then (fn [sig] (= presented (b64url sig))))
          (.catch (fn [_] false))))))

;; --- webvh genesis (ADR-2609141633 layer 1) ---------------------------------
;; The update key is generated from a fresh 32-byte seed held only long enough
;; to sign the genesis entry; the seed is NOT persisted (pre-rotation via
;; nextKeyHashes is the recovery path, as in the root log). Witnesses are the
;; fleet's standard five, matching kotoba.cloud's own root log.
(def witness-ids
  ["did:key:z6MknGZkCR98UzhYRRPbyhgWDyAA7PVECo5cxyTjFBs3bnje"
   "did:key:z6MkpLgbFtPAXb9hk8dc2YvBwon8eLP6SY6RDr1huqBhK5MT"
   "did:key:z6MkqugHi3ogacJzSTRXER5e9ZQBPCX4CXKDJdP2YEytidfn"
   "did:key:z6Mkr9TzzqnyQH3GhHJdYq9H4HYvqe8MTDhdzFtfPNfYEUtt"
   "did:key:z6Mkn6sbjuho8t6VJxdpjfKDvEHcmnNgKjTxFX3gxd16cZgE"])

(defn- random-seed! []
  (let [a (js/Uint8Array. 32)]
    (js/crypto.getRandomValues a)
    (array-seq a)))

(defn- mint-genesis! [did-domain handle]
  (let [seed (random-seed!)
        signer (vh-signer/from-seed seed)
        version-time (str (subs (.toISOString (js/Date.)) 0 19) "Z")
        {:keys [parameters state]}
        {:parameters {"method" "did:webvh:1.0"
                      "scid" "{SCID}"
                      "updateKeys" [(:multikey signer)]
                      "nextKeyHashes" []
                      "portable" true
                      "witness" {"threshold" 2
                                 "witnesses" (mapv (fn [id] {"id" id}) witness-ids)}}
         :state {"@context" ["https://www.w3.org/ns/did/v1"
                             "https://w3id.org/security/multikey/v1"
                             "https://w3id.org/security/data-integrity/v2"]
                 "id" "{SCID}"
                 "alsoKnownAs" [(str "https://" handle)]
                 "controller" [(:did-key signer)]
                 "verificationMethod"
                 [{"id" (str "{SCID}#" (:multikey signer))
                   "type" "Multikey"
                   "controller" "{SCID}"
                   "publicKeyMultibase" (:multikey signer)}]
                 "authentication" [(str "{SCID}#" (:multikey signer))]
                 "assertionMethod" [(str "{SCID}#" (:multikey signer))]}}]
    (-> (entry/sign-async (entry/genesis {:version-time version-time
                                          :parameters parameters
                                          :state state})
                          {:multikey (:multikey signer) :sign-fn (:sign-fn signer)})
        ;; the seed dies with this closure — only the public log persists
        (.then (fn [signed]
                 (let [scid (subs (get signed "versionId") 2)]
                   {:log (js/JSON.stringify signed)
                    :scid scid
                    :did (str "did:webvh:" scid ":" did-domain)
                    :update-key-multikey (:multikey signer)}))))))

(defn- handle-create [storage body now]
  (let [handle (str (:handle body))]
    (cond
      (not (and (text? handle 80) (re-find handle-pattern handle)))
      (js/Promise.resolve (response {:error "invalid-org-handle"} 400))

      (not (and (text? (:principalId body) 256) (contains? roles (:role body))))
      (js/Promise.resolve (response {:error "invalid-org-create"} 400))

      :else
      (-> (load-org! storage handle)
          (.then (fn [existing]
                   (if existing
                     (response {:error "org-handle-taken"} 409)
                     ;; Mint the real did:webvh genesis log first: the DID and
                     ;; its SCID come from the signed entry, not from string
                     ;; assembly (ADR-2609141633 layer 1).
                     (-> (mint-genesis! handle handle)
                         (.then (fn [minted]
                                  (-> (generate-signing-key!)
                                      (.then (fn [[public-jwk private-jwk]]
                                               (let [org {:did (:did minted)
                                                          :handle handle
                                                          :webvhLog (:log minted)
                                                          :scid (:scid minted)
                                                          :updateKeyMultikey (:update-key-multikey minted)
                                                          :publicJwk (select-keys (js->clj public-jwk :keywordize-keys true) [:kty :crv :x])
                                                          :privateJwk (js/JSON.stringify private-jwk)
                                                          :members [{:principalId (:principalId body)
                                                                     :role (:role body)
                                                                     :status "active"
                                                                     :issuedAt now}]
                                                          :createdAt now}]
                                                 (-> (save-org! storage handle org)
                                                     (.then (fn [_]
                                                              (response {:orgDid (:did org) :handle handle
                                                                         :scid (:scid minted)
                                                                         :webvhLog (:log minted)
                                                                         :ownerPrincipal (:principalId body)
                                                                         :schemaVersion schema-version}
                                                                        200))))))))))))))))))

(defn- handle-delegate [storage body now]
  (cond
    (not (and (text? (:principalId body) 256) (text? (:memberPrincipalId body) 256)
              (contains? roles (:role body))))
    (js/Promise.resolve (response {:error "invalid-org-delegate"} 400))

    :else
    (-> (all-orgs! storage)
        (.then (fn [orgs]
                 (let [org (org-for-member orgs (:principalId body))]
                   (cond
                     (nil? org) (response {:error "org-membership-required"} 403)

                     (< (get role-rank (:role (active-member org (:principalId body))) 0)
                        (if (= "member" (:role body)) 1 2))
                     (response {:error "org-role-insufficient"} 403)

                     (some #(= (:memberPrincipalId body) (:principalId %)) (:members org))
                     (response {:error "org-already-member"} 409)

                     :else
                     (let [member {:principalId (:memberPrincipalId body)
                                   :role (:role body) :status "active" :issuedAt now}
                           org (update org :members conj member)]
                       (-> (save-org! storage (:handle org) org)
                           (.then (fn [_]
                                    ;; The membership VC is issued with a Data
                                    ;; Integrity proof signed by the org key.
                                    (sign-vc! org (membership-vc org (:memberPrincipalId body) (:role body)))))
                           (.then (fn [vc]
                                    (if (text? (:memberNextPublicKey body) 200)
                                      (let [tok (mint-biscuit-authority! org (:memberPrincipalId body) (:role body)
                                                                         (:memberNextPublicKey body))]
                                        (response {:orgDid (:did org) :handle (:handle org)
                                                   :member member
                                                   :membership vc
                                                   :biscuit (pr-str tok)}
                                                  200))
                                      (response {:orgDid (:did org) :handle (:handle org)
                                                 :member member
                                                 :membership vc}
                                                200))))))))))))

(defn- handle-revoke [storage body now]
  (if-not (text? (:principalId body) 256)
    (js/Promise.resolve (response {:error "invalid-org-revoke"} 400))
    (-> (all-orgs! storage)
        (.then (fn [orgs]
                 (let [org (org-for-member orgs (:principalId body))]
                   (cond
                     (nil? org) (response {:error "org-membership-required"} 403)

                     (nil? (some #(when (= (:memberPrincipalId body) (:principalId %)) %) (:members org)))
                     (response {:error "org-member-unknown"} 404)

                     :else
                     (let [updated (update org :members
                                           (fn [ms]
                                             (mapv #(if (= (:memberPrincipalId body) (:principalId %))
                                                      (assoc % :status "revoked" :revokedAt now)
                                                      %)
                                                   ms)))]
                       (-> (save-org! storage (:handle org) updated)
                           (.then (fn [_]
                                    (response {:orgDid (:did org) :handle (:handle org)
                                               :revoked (:memberPrincipalId body)} 200))))))))))))

(defn- handle-authorize [storage body now]
  ;; Org-scoped database access (ADR-2609141633 step 4): the caller must hold an
  ;; active membership, and the tenant must be bound to the caller's organization.
  ;; First use binds the tenant to the org; only owner/admin may bind.
  (cond
    (not (and (text? (:principalId body) 256) (text? (:orgHandle body) 80)
              (string? (:tenantId body)) (re-matches #"t_[a-z0-9]{12,48}" (:tenantId body))
              (string? (:dbName body)) (<= 1 (count (:dbName body)) 256)))
    (js/Promise.resolve (response {:error "invalid-org-authorize"} 400))

    :else
    (-> (load-org! storage (:orgHandle body))
        (.then (fn [org]
                 (cond
                   (nil? org) (response {:error "org-unknown"} 404)
                   (nil? (active-member org (:principalId body)))
                   (response {:error "org-membership-required"} 403)
                   :else
                   (let [member (active-member org (:principalId body))
                         tenants (or (:tenants org) {})
                         bound (get tenants (:tenantId body))]
                     (cond
                       (and (nil? bound) (not (contains? #{"owner" "admin"} (:role member))))
                       (response {:error "org-tenant-bind-forbidden"} 403)

                       (and bound (not= bound (:dbName body)))
                       (response {:error "org-tenant-mismatch"} 403)

                       :else
                       (let [org (assoc org :tenants (assoc tenants (:tenantId body) (:dbName body)))]
                         (-> (save-org! storage (:handle org) org)
                             (.then (fn [_]
                                      (response {:ok true :orgDid (:did org) :handle (:handle org)
                                                 :role (:role member) :tenantId (:tenantId body)
                                                 :bound (nil? bound)} 200)))))))))))))

(defn- handle-didlog [storage body]
  ;; Public: a did:webvh log is published for anyone to resolve (ADR layer 1).
  (let [handle (:handle body)]
    (if-not (and (string? handle) (re-find handle-pattern handle))
      (js/Promise.resolve (response {:error "invalid-org-handle"} 400))
      (-> (load-org! storage handle)
          (.then (fn [org]
                   (cond
                     (nil? org) (response {:error "org-unknown"} 404)
                     :else (response {:did (:did org) :scid (:scid org)
                                      :log (:webvhLog org)
                                      :publishedAt (:createdAt org)}
                                     200))))))))

(defn- handle-verify [storage body]
  ;; Third-party presentation path: anyone holding a membership VC can have it
  ;; verified — signature via the org's stored key, subject/issuer binding, and
  ;; live roster status. No session required beyond the binding hop.
  (let [vc (:credential body)]
    (if-not (and (map? vc) (string? (get-in (js->clj (:credential body) :keywordize-keys true) [:credentialSubject :org])))
      (js/Promise.resolve (response {:error "invalid-org-verify"} 400))
      (let [v (js->clj (:credential body) :keywordize-keys true)
            org-handle (get-in v [:credentialSubject :handle])]
        (-> (load-org! storage org-handle)
            (.then (fn [org]
                     (cond
                       (nil? org) (response {:verified false :reason "org-unknown"} 404)
                       (not= (:did org) (:issuer v)) (response {:verified false :reason "issuer-mismatch"} 400)
                       (not= (:did org) (get-in v [:credentialSubject :org])) (response {:verified false :reason "org-mismatch"} 400)
                       :else
                       (-> (verify-vc! org v)
                           (.then (fn [sig-ok?]
                                    (let [member (some #(when (= (get-in v [:credentialSubject :id]) (:principalId %)) %)
                                                       (:members org))]
                                      (response {:verified (and sig-ok? member (= "active" (:status member)))
                                                 :reason (cond
                                                           (not sig-ok?) "signature-invalid"
                                                           (nil? member) "not-on-roster"
                                                           (not= "active" (:status member)) "revoked"
                                                           :else nil)
                                                 :role (:role member)}
                                                200))))))))))))))

(defn- handle-registry [storage _body _now]
  ;; Returns the COMPLETE registry document (static policy + live organization
  ;; projection). The worker serializes this verbatim — no edge-side merging,
  ;; so keyword-vs-JS-object pitfalls stay on this side of the binding.
  (-> (all-orgs! storage)
      (.then (fn [orgs]
               (let [orgs (vec (js->clj (clj->js orgs) :keywordize-keys true))]
               (response
                (assoc (org-registry/registry)
                       :organizations
                       (vec (for [org orgs]
                              {:orgDid (:did org) :handle (:handle org)
                               :scid (:scid org)
                               :didLog (str "/.well-known/kotoba-org-dids/" (:handle org) "/did.jsonl")
                               :members (count (:members org))
                               :createdAt (:createdAt org)}))
                       :statusLists
                       (vec (for [org orgs]
                              {:id (str "https://kotoba.cloud/.well-known/kotoba-org-status/"
                                        (:handle org) "/v1")})))
                 200))))))

(defn- handle-status [storage body]
  (if-not (text? (:principalId body) 256)
    (js/Promise.resolve (response {:error "invalid-org-status"} 400))
    (-> (all-orgs! storage)
        (.then (fn [orgs]
                 (response
                  {:organizations
                   (vec (for [org orgs
                              :let [m (some #(when (= (:principalId body) (:principalId %)) %)
                                            (:members org))]
                              :when m]
                          {:orgDid (:did org) :handle (:handle org)
                           :role (:role m) :status (:status m)
                           :members (count (:members org))}))}
                  200))))))

(defn- route-op [path]
  (case path
    "/create" handle-create
    "/delegate" handle-delegate
    "/revoke" handle-revoke
    "/status" handle-status
    "/authorize" handle-authorize
    "/verify" handle-verify
    "/didlog" handle-didlog
    "/registry" handle-registry
    nil))

(defn- handle [state env path body]
  (let [storage (aget state "storage") now (.now js/Date)]
    (if-let [op (route-op path)]
      (cond
        ;; arity-3 handlers take (storage body now)
        (contains? #{handle-create handle-delegate handle-revoke handle-authorize} op)
        (op storage body now)
        (contains? #{handle-didlog handle-verify handle-status} op)
        (op storage body)
        :else (op storage))
      (js/Promise.resolve (response {:error "not-found"} 404)))))

(deftype OrgAuthority [^js state env]
  Object
  (fetch [_ request]
    (if (= "https://org.internal" (.-origin (js/URL. (.-url request))))
      (-> (.json request)
          (.then (fn [body]
                   (.blockConcurrencyWhile state
                     (fn [] (handle state env (.-pathname (js/URL. (.-url request)))
                                    (js->clj body :keywordize-keys true))))))
          (.catch (fn [e]
                    (js/console.error "org-authority-op-failed" (.-stack e))
                    (response {:error "org-authority-internal"} 500))))
      (js/Promise.resolve (response {:error "private-binding-required"} 403)))))

(defn make-org-authority [state env] (OrgAuthority. state env))
