(ns app-kotoba-cloud.apps-site
  "Apps catalog: a card grid of products built on the
  kotoba.cloud gateway — each card carries an icon tile, title, description,
  status badge and Open/Docs actions. The catalog data lives in apps-edn
  below so the page and the /apps data export cannot drift."
  (:require [cloud-kotoba-dds.catalog :as catalog]
            [app-kotoba-cloud.security-services :as security-services]
            [jp-go-dds.core :as dds]))

(def css
  ".kc-apps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr));gap:var(--hig-spacing-5);margin-top:var(--hig-spacing-5)}
.kc-app-card{display:grid;gap:var(--hig-spacing-3);border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-md,12px);padding:var(--hig-spacing-5)}
.kc-app-card__icon{inline-size:2.75rem;block-size:2.75rem;display:grid;place-items:center;border-radius:var(--hig-radius-sm,8px);background:var(--hig-color-secondary-system-background);border:1px solid var(--hig-color-separator);font-weight:700;color:var(--hig-color-tint);font-family:var(--hig-font-mono,var(--hig-font-mono))}
.kc-app-card__head{display:flex;align-items:center;gap:var(--hig-spacing-3)}
.kc-app-card__title{margin:0;font-size:var(--hig-text-title3-font-size);line-height:var(--hig-text-title3-line-height)}
.kc-app-card__desc{margin:0;color:var(--hig-color-secondary-label)}
.kc-app-card__meta{display:flex;flex-wrap:wrap;gap:var(--hig-spacing-2);font-family:var(--hig-font-mono,var(--hig-font-mono));font-size:var(--hig-text-caption2-font-size);color:var(--hig-color-secondary-label)}
.kc-app-card__status{display:inline-flex;align-items:center;gap:var(--hig-spacing-2)}
.kc-app-card__status::before{content:'';inline-size:.6rem;block-size:.6rem;border-radius:var(--hig-radius-capsule);background:var(--hig-palette-green,var(--hig-color-tint))}
.kc-app-card__status[data-state=live]::before{background:var(--hig-palette-green)}
.kc-app-card__status[data-state=beta]::before{background:var(--hig-color-tint)}
.kc-app-card__actions{display:flex;flex-wrap:wrap;gap:var(--hig-spacing-3);align-items:center;margin-top:auto}")

(defn- service->card
  "Derive an /apps grid card from the ONE canonical security-services def —
  the card and the /security/services/ page cannot drift."
  [{:keys [id name summary capabilities status]}]
  {:id (str "security-" (clojure.core/name id))
   :name name
   :kind "security-service"
   :status (if (= status "component-shipped") "live" "beta")
   :desc (:ja summary)
   :desc-en (:en summary)
   :links [["サービス詳細" security-services/ledger-page]]
   :meta [(str (count capabilities) " capabilities")]})

(def apps
  "The public app catalog. status: live (shipped, reachable) / beta (data live,
  UI complete). Every href must resolve after render — the smoke checks it.
  The four security-service cards derive from the ONE canonical
  security-services def, so card and document cannot drift."
  (into
   [{:id "pep-registry"
    :name "PEP Registry"
    :kind "public-data"
    :status "live"
    :desc "日本の重要政府職員 (PEP) レジストリ。OpenSanctions jp_shugiin スナップショットを出典付き EAV datoms として公開。AML/CTF スクリーニングの基盤データ。"
    :desc-en "Japan PEP (politically exposed person) registry: the OpenSanctions jp_shugiin snapshot published as sourced EAV datoms — the screening substrate for AML/CTF."
    :links [["データを開く" "/security-data/pep/index.json"]
            ["スキーマ" "/security-data/pep/schema.edn"]
            ["生成スクリプト" "https://github.com/kotoba-lang/app-kotoba-cloud/blob/main/scripts/build-pep-data.mjs"]]
    :meta ["465 persons" "CC BY-NC 4.0" "snapshot 2026-09"]}
   {:id "ekyc-guide"
    :name "eKYC 登録ガイド"
    :kind "agent-docs"
    :status "live"
    :desc "agent-followable な本人確認・研究者登録ガイド。サインイン → カード認証 / Stripe Identity → 自動承認 → 研究ジョブまでを 1 文書で追跡可能。"
    :desc-en "The agent-followable registration guide: sign in → card verification / Stripe Identity → automatic approval → research jobs, in one document."
    :links [["ガイドを開く" "/ekyc.md"]
            ["アカウント" "/account"]
            ["MCP設定" "/mcp.json"]]
    :meta ["agent-followable" "assurance ladder" "card+identity"]}
   {:id "security-data"
    :name "Security Data Hub"
    :kind "public-data"
    :status "live"
    :desc "脆弱性・攻撃手法・グループ・公開ログを、出典まで辿って調べる公開データカタログ (KEV / ATT&CK / OTRF)。"
    :desc-en "Public security-data catalog: KEV, ATT&CK and OTRF lab logs with sources you can trace."
    :links [["ハブを開く" "/security/"]
            ["IPLD" "/security-data/index.json"]]
    :meta ["KEV" "ATT&CK" "OTRF"]}
   {:id "compliance-catalog"
    :name "コンプライアンス & 製品カタログ"
    :kind "public-data"
    :status "live"
    :desc "全世界のコンプライアンス基準 (ISO / SOC 2 / PCI DSS / GDPR / DORA / CRA ほか) と脆弱性対策製品のカテゴリ・価格・プロバイダーをまとめた出典付きカタログ。"
    :desc-en "Worldwide compliance frameworks and vulnerability-management product catalog: categories, providers and pricing, fully sourced."
    :links [["カタログを開く" "/security/compliance/"]
            ["IPLD" "/compliance-data/compliance/index.json"]
            ["生成スクリプト" "https://github.com/kotoba-lang/app-kotoba-cloud/blob/main/scripts/build-compliance-catalog.mjs"]]
    :meta ["16 基準" "350 プロダクト" "CSF 2.0 対応あり"]}
   {:id "aup"
    :name "Security Research AUP"
    :kind "policy"
    :status "live"
    :desc "Security Research 層の Assurance Ladder と利用ポリシー。rung (カード→identity→business→contracted) と許可/厳禁利用、プライバシー条件。"
    :desc-en "The Security Research tier's assurance ladder and acceptable use policy: rungs, allowed/prohibited uses, privacy conditions."
    :links [["ポリシーを開く" "/security/aup/"]]
    :meta ["4 rungs" "ZDR" "CSAM/CBRN screened"]}
   {:id "knowledge-search"
    :name "Knowledge Search"
    :kind "api"
    :status "live"
    :desc "公開セキュリティエビデンスの読み取り専用検索 API。認証不要、CORS オープン。"
    :desc-en "Read-only public security-evidence search API. Unauthenticated, CORS-open."
    :links [["API" "/v1/knowledge/search?q=ATT%26CK"]
            ["MCP設定" "/mcp.json"]]
    :meta ["GET" "CORS-open" "no auth"]}
   {:id "orgbrain"
    :name "組織運営オントロジー — Kyber orgbrain"
    :kind "public-data"
    :status "live"
    :desc "法人・組織の運営プロセスをオントロジー × BPMN 2.0 × 決定論的リスクの三層で公開する管理アプリ。図・RACI・権限監査・シミュレーターがその場で動き、BPMN 2.0 XML / EDN としてダウンロード可能。正本は kotoba-lang/kyber。"
    :desc-en "A management app publishing organization operations as three layers: responsibility/authority ontology, BPMN 2.0 processes and a deterministic risk model. Live diagram, RACI, authority audit and in-browser simulator; downloadable as BPMN 2.0 XML / EDN. Source of truth: kotoba-lang/kyber."
    :links [["管理アプリを開く" "/orgs/"]
            ["データ (index)" "/org-data/index.json"]
            ["正本リポジトリ" "https://github.com/kotoba-lang/kyber/tree/main/docs/orgbrain"]]
    :meta ["3 layers" "5 risk axes" "rev-pinned + sha256"]}
   {:id "models"
    :name "Model Catalog"
    :kind "api"
    :status "live"
    :desc "推論モデルカタログとアクセスゲート状態 (availability / requirements / freeTier)。"
    :desc-en "Inference model catalog with live access-gate state (availability, requirements, freeTier)."
    :links [["API" "/v1/models"]]
    :meta ["OpenAI-compatible" "gate state"]}]
   (map service->card security-services/security-services)))

(defn app-card [{:keys [name desc links meta status id]}]
  [:article {:class "kc-app-card" :data-app id}
   [:div {:class "kc-app-card__head"}
    [:span {:class "kc-app-card__icon" :aria-hidden "true"} (subs name 0 1)]
    [:h2 {:class "kc-app-card__title"} name]]
   [:p {:class "kc-app-card__desc"} desc]
   (when (seq meta)
     (into [:div {:class "kc-app-card__meta"}]
           (map (fn [m] [:span m]) meta)))
   [:div {:class "kc-app-card__status" :data-state status}
    (case status "live" "稼働中 / Live" "beta" "ベータ / Beta" status)]
   (when (seq links)
     (into [:div {:class "kc-app-card__actions"}]
           (map (fn [[label href]]
                  (dds/button label {:href href :type :outline :size "sm"}))
                links)))])

(defn view [locale]
  (let [ja? (= locale :ja)]
    (catalog/page
     {:title (if ja? "Apps" "Apps")
      :lead (if ja?
              "kotoba.cloud ゲートウェイ上で動く公開プロダクト。データ・API・ドキュメントをそのまま開けます。"
              "Public products on the kotoba.cloud gateway — data, APIs and docs you can open directly.")
      :nav (catalog/breadcrumb
            "Apps"
            [["ホーム" "/"]
             ["Apps" nil]])}
     (into [:div {:class "kc-apps-grid"}]
           (map app-card apps))
     [:p {:class "ck-catalog__footnote"}
      (if ja?
        "新しいアプリはこのページにカードとして追加されます (サイドバーは増えません)。"
        "New apps land here as cards — the sidebar never grows.")])))

;; html is emitted by site.cljk (site-layout wrapper) — no bare page here.
