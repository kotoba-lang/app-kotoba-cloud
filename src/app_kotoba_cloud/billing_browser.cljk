(ns app-kotoba-cloud.billing-browser
  "Hydration for the billing console (billing-site). Reveal-when-known:
  the balance tiles appear only with numbers from /v1/billing/status, the
  sign-in block only when the session says signed-out, the plan buttons
  only when /v1/billing/catalog says checkout is enabled. Nothing is
  greyed out to mean 'unknown'.")

(defn- el [id] (.getElementById js/document id))
(defn- ja? [] (= "ja" (.-lang (.-documentElement js/document))))
(defn- t [ja en] (if (ja?) ja en))
(defn- status! [message] (when-let [x (el "billing-status")] (set! (.-textContent x) message)))
(defn- show! [id] (when-let [x (el id)] (set! (.-hidden x) false)))
(defn- cell! [id text]
  (when-let [x (el id)] (.setAttribute x "data-state" "value") (set! (.-textContent x) text)))

(defn- balances! []
  (-> (js/fetch "/v1/billing/status" #js {:credentials "same-origin"})
      (.then (fn [r]
               (cond
                 (.-ok r) (.json r)
                 (contains? #{401 403} (.-status r)) :signed-out
                 :else nil)))
      (.then (fn [body]
               (cond
                 (= :signed-out body) (show! "billing-signed-out")
                 (nil? body) (status! (t "残高を取得できませんでした。" "Could not read the balance."))
                 :else
                 (let [balances (js->clj (aget body "balances") :keywordize-keys true)
                       available (fn [scope] (or (:availableMicroUSD (first (filter #(= scope (:scope %)) balances))) 0))]
                   (cell! "billing-balance-ai" (str "$" (.toFixed (/ (available "ai") 1000000) 2)))
                   (cell! "billing-balance-storage" (str (.toFixed (/ (available "storage.capacity") 200000) 1) " GiB"))
                   (cell! "billing-balance-excess" (str "$" (.toFixed (/ (available "storage") 1000000) 2)))
                   (show! "billing-balances")))))
      (.catch (fn [_] (status! (t "残高を取得できませんでした。" "Could not read the balance."))))))

(defn- action! [path sku]
  (-> (js/fetch path #js {:method "POST" :credentials "same-origin" :headers #js {"content-type" "application/json"}
                         :body (js/JSON.stringify #js {:sku sku :requestId (.randomUUID js/crypto)})})
      (.then (fn [r] (if (.-ok r) (.json r) (throw (js/Error. (t "決済を開始できません。サインインして再試行してください。" "Billing is not available. Please sign in and try again."))))))
      (.then (fn [body] (let [url (js/URL. (.-url body))]
                         (if (and (= "https:" (.-protocol url)) (contains? #{"checkout.stripe.com" "billing.stripe.com"} (.-hostname url)))
                           (.assign js/location (.-href url)) (throw (js/Error. "Invalid payment destination"))))))
      (.catch #(status! (.-message %)))))

(defn init! []
  (when (el "billing-status")
    (balances!)
    (-> (js/fetch "/v1/billing/catalog") (.then #(.json %))
        (.then (fn [catalog]
                 (if-not (true? (aget catalog "checkoutEnabled"))
                   (status! (t "料金は検証中です。購入はまだできません。" "Billing setup is pending; purchases are not available yet."))
                   (do
                     (status! (if (= "test" (aget catalog "mode"))
                                (t "テスト決済のみ・実際の請求はありません。" "Test payments only — nothing is charged.")
                                ""))
                     (let [purchasable (set (js->clj (or (aget catalog "purchasable") #js [])))]
                       (doseq [button (array-seq (.querySelectorAll js/document "[data-billing-sku]"))]
                         (let [sku (.getAttribute button "data-billing-sku")]
                           (if (contains? purchasable sku)
                             (do (set! (.-hidden button) false)
                                 (.addEventListener button "click" #(action! "/v1/billing/checkout" sku)))
                             ;; a plan the live catalog has no price for is shown, not sold
                             (when-let [note (.querySelector js/document (str "[data-billing-unavailable=\"" sku "\"]"))]
                               (set! (.-hidden note) false))))))
                     (when-let [button (el "billing-portal")]
                       (show! "billing-manage")
                       (.addEventListener button "click" #(action! "/v1/billing/portal" nil)))))))
        (.catch (fn [_] (status! (t "料金情報を取得できません。" "Billing information is unavailable.")))))))
