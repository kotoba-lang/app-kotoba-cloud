(ns app-kotoba-cloud.locale
  "Origin locale negotiation shared with kotobase.net.

  Order: path > ?lang= query > kb_locale cookie > Accept-Language >
  request.cf.country > en. Country never selects jv or su; those stay path,
  query, cookie, or Accept-Language.

  The public URL of a document is locale-free (shinkansen.locale: one route,
  the edge negotiates). The language switch is `?lang=<locale>` on the SAME
  route — served directly (200, the variant) with the choice persisted as
  kb_locale; the JS-off path needs no client script. An explicit locale
  PREFIX (/ja/billing/) is compatibility only: 301 to the locale-free route
  with the cookie set (owner direction 2026-09-15: the paths are no longer
  needed)."
  (:require [app-kotoba-cloud.public-locales :as locales]
            [kotoba.lang.text :as str]))

(def cookie-name "kb_locale")
(def default-locale :en)
(def country-never #{:jv :su})

(def aliases
  {"zh" :zh-Hans
   "zh-cn" :zh-Hans
   "zh-hans" :zh-Hans
   "zh-sg" :zh-Hans
   "cmn" :zh-Hans
   "iw" :he
   "in" :id
   "ar-eg" :arz
   "ar-ma" :ar-MA
   "ary" :ar-MA})

(def country-locales
  {"id" :id
   "il" :he
   "kr" :ko
   "es" :es
   "it" :it
   "de" :de
   "ma" :ar-MA
   "eg" :arz})

(def supported-set (set locales/locale-order))

(defn normalize-tag [value]
  (when (string? value)
    (let [norm (-> value str/trim str/lower (str/replace #"_" "-"))]
      (when (and (seq norm)
                 (not= "*" norm)
                 (re-matches #"[a-z]{1,8}(?:-[a-z0-9]{1,8})*" norm))
        norm))))

(defn- known-locale [norm]
  (when norm
    (let [found (or (get aliases norm)
                    (first (filter #(= (str/lower (name %)) norm)
                                   locales/locale-order)))]
      (when (contains? supported-set found) found))))

(defn parse-locale
  "Resolve one BCP 47 tag or cookie/path code onto the public catalog."
  [value]
  (when-let [norm (normalize-tag value)]
    (or (known-locale norm)
        (known-locale (first (str/split norm #"-"))))))

(defn path-locale
  "First path segment wins when it is a public locale or alias. /legal stays nil."
  [path]
  (when (string? path)
    (parse-locale (first (remove str/blank? (str/split path #"/"))))))

(defn apex-path? [path]
  (or (str/blank? path) (= path "/") (= path "/index.html")))

(defn locale-path [locale]
  (if (= locale :en)
    "/"
    (str "/" (name locale) "/")))

(defn- parse-quality [param]
  (let [p (str/trim (or param ""))]
    (when (str/starts-with? p "q=")
      (let [n (subs p 2)]
        (cond
          (re-matches #"1(?:\.0+)?" n) 1.0
          (re-matches #"0(?:\.\d+)?" n)
          #?(:clj (Double/parseDouble n)
             :cljs (js/parseFloat n)
             :default nil))))))

(defn accept-language-locale
  "First q-weighted tag that maps onto the catalog."
  [header]
  (when (string? header)
    (->> (str/split header #",")
         (keep (fn [part]
                 (let [bits (str/split (str/trim part) #";")
                       tag (parse-locale (first bits))
                       q (or (first (keep parse-quality (rest bits))) 1.0)]
                   (when (and tag (number? q) (<= 0 q 1))
                     {:locale tag :q q}))))
         (sort-by (comp - :q))
         first
         :locale)))

(defn country-locale
  "Cloudflare ISO 3166-1 alpha-2. Never returns jv or su."
  [country]
  (when (string? country)
    (let [code (str/lower (str/trim country))
          loc (get country-locales code)
          loc (if (and (= loc :ar-MA) (not (contains? supported-set :ar-MA)))
                :ar
                loc)]
      (when (and loc
                 (contains? supported-set loc)
                 (not (country-never loc)))
        loc))))

(def query-param "lang")

(defn query-locale
  "The `?lang=` choice of the language switch. A value outside the public
  catalog is ignored (fail-closed) — never trusted, never persisted."
  [value]
  (when (string? value) (parse-locale value)))

(defn negotiate
  "path > ?lang= query > cookie > Accept-Language > country > en."
  [{:keys [path query cookie accept-language country]}]
  (or (path-locale path)
      (query-locale query)
      (parse-locale cookie)
      (accept-language-locale accept-language)
      (country-locale country)
      default-locale))

(def shared-prefixes
  "URL namespaces that are locale-independent infrastructure (never rewritten
  and never canonicalized): admin, JS, MCP descriptors, the asset planes, and
  the API/versioned prefixes. The account console is NOT one of them any
  more (nor is /identity, 2026-09-15, for the same reason): it is emitted per locale (site.cljk account-html) and negotiated like
  /billing/ — measured 2026-09-15: /account?lang=en answered the Japanese
  document because \"account\" was listed here and the Worker fetched the
  one emit directly."
  #{"admin" "js" "css" "assets" "ipfs" "ipns" "v1" ".well-known"
    ".well-known-templated" "mcp.json" "favicon.ico" "robots.txt"
    "sitemap.xml" "og.png" "llms.txt" "llms-full.txt" "agent-quickstart.md"
    "ekyc.md" "public-locale-coverage.json"})

(defn- shared-path? [path]
  (boolean
   (some (fn [pfx]
           (or (= path (str "/" pfx))
               (str/starts-with? path (str "/" pfx "/"))
               (str/starts-with? path (str "/" pfx))))
         shared-prefixes)))

(defn canonical-path
  "Strip an explicit locale prefix off a path (nil when none). /ja/billing/ →
  /billing/; /ja/ → /; shared namespaces pass through untouched (nil)."
  [path]
  (when (string? path)
    (when-let [loc (path-locale path)]
      (let [prefix (str "/" (name loc))
            tail (subs path (count prefix))
            tail (if (str/blank? tail) "/" tail)]
        (when-not (shared-path? tail) tail)))))

(def variant-roots
  "Content roots that have per-locale emit variants (site.cljk -main writes
  public/<locale>/<root>/…): the shared chrome pages. The apex is a variant
  by itself. Measured live 2026-09-15: /blog/ and /apps/ were emitted under
  /ja/ but absent here, so a Japanese reader got English at /blog/ while
  /ja/blog/ 301'd to it — test/worker-smoke.mjs now derives this set from
  the emit tree and fails when they drift."
  ["billing" "legal" "security" "csf2" "docs" "blog" "apps" "account"
   ;; 2026-09-15 (owner, driven in Chrome): the remaining console documents
   ;; that answered in Japanese to an English reader
   "secure" "models" "identity" "security-data"])

(defn- forkable-path?
  "Content paths that have per-locale emit variants: the landing apex and
  variant-roots. Shared infrastructure namespaces are never forked."
  [path]
  (and (not (shared-path? path))
       (or (apex-path? path)
           (some (fn [seg]
                   (str/starts-with? path (str "/" seg)))
                 variant-roots))))

(defn serve-path
  "The emit-directory asset path to serve for a locale-free URL. /billing/ with
  locale ja → /ja/billing/ (when a variant emit exists — the caller falls back
  to the original path on a miss). Root stays at its own emit: apex variants
  live in the locale directory itself."
  [path locale]
  (when (and (forkable-path? path)
             (not= locale :en)
             (contains? supported-set locale))
    (if (apex-path? path)
      (locale-path locale)
      (str (locale-path locale)
           (subs path 1)))))

(defn static-decision
  "Worker decision before Static Assets HIT. Cookie-negotiated, path-independent
  serving (shinkansen.locale contract): one locale-free URL per document. A
  weaker signal than the path never redirects — the Worker rewrites the asset
  path to the negotiated emit directory in place (variant fallback: root doc).
  `?lang=<locale>` (the language switch) is served directly as that variant
  with the choice persisted as kb_locale — one request, no redirect hop.
  An explicit locale prefix is canonicalized away with a 301 (its variant is
  reachable at the locale-free path); the choice is persisted as kb_locale."
  [{:keys [path query] :as opts}]
  (let [from-path (path-locale path)
        from-query (query-locale query)
        locale (negotiate opts)]
    (cond
      from-path {:locale from-path
                 :set-cookie? true
                 :canonical (canonical-path path)}
      from-query {:locale from-query
                  :source :query
                  :set-cookie? true
                  :serve (serve-path path from-query)}
      :else {:locale locale
             :set-cookie? (and (apex-path? path) (not= locale :en))
             :serve (serve-path path locale)})))

(defn cookie-header [locale]
  (str cookie-name "=" (name locale)
       "; Path=/; Max-Age=31536000; SameSite=Lax; Secure"))

(def language-cookie-script
  "Persists an explicit language-selector choice as kb_locale (the
  shinkansen.locale contract: the switch writes the cookie client-side; the
  Worker writes the same cookie on the `?lang=` response for the JS-off
  path). The choice is the href's `lang` query — a locale-prefixed href is
  read for compatibility only."
  (str
   "(()=>{'use strict';"
   "document.addEventListener('click',event=>{"
   "const item=event.target.closest('[data-language-selector-item]');"
   "if(!item)return;"
   "const href=item.getAttribute('href')||'';"
   "const url=new URL(href,location.href);"
   "const seg=(url.pathname.split('/').filter(Boolean)[0]||'en');"
   "const locale=url.searchParams.get('" query-param "')||(seg==='zh'?'zh-Hans':seg);"
   "document.cookie='" cookie-name "='+encodeURIComponent(locale)"
   "+'; Path=/; Max-Age=31536000; SameSite=Lax; Secure';"
   "});"
   "})();"))
