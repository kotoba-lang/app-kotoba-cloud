(defn graph-docs-view [locale]
  (let [ja? (= locale :ja)
        t (translation locale)
        txt (fn [ja en] (if ja? ja en))]
    [[:a {:class "kc-skip dads-button" :data-type "outline" :data-size "sm"
          :href "#main"} (:skip t)]
     (site-header locale t)
     [:main {:id "main" :class "kc-docs"}
      (dds/container
       (dds/section {:title (txt "Graph・Ontologyデータベース — ドキュメント"
                                 "Graph & Ontology database — documentation")}
        [:p {:class "kc-legal__lead"}
         (txt "Kotoba Cloud Database (旧 Kotobase graph 面) の Graph・Ontology ワークベンチの使い方と、周辺プロジェクト (ayatori, capability-bench) の資料をまとめたページです。"
              "Usage guide for the Kotoba Cloud Database (formerly the Kotobase graph plane) Graph & Ontology workbench, plus reference material for the surrounding projects (ayatori, capability-bench).")]
        (dds/heading 2 (txt "グラフ・ワークベンチを開く" "Open the graph workbench") {:size "28"})
        [:p
         (txt "kotoba.cloud トップの「データベース・オントロジー管理」ワークベンチを使うと、不変 IPLD スナップショット上で observed attribute と型を可視化・分析できます。"
              "The Database & Ontology workbench on the kotoba.cloud home page visualizes and analyzes observed attributes and types over immutable IPLD snapshots.")]
        (dds/row
         (dds/button (txt "ワークベンチを開く (トップページ)" "Open the workbench (home page)")
                     {:type :solid-fill :size "md" :href "/#knowledge/overview"})
         (dds/button (txt "料金・プラン" "Billing & plans")
                     {:type :outline :size "md" :href "/billing/"}))
        (dds/heading 2 (txt "周辺プロジェクト" "Surrounding projects") {:size "28"})
        [:ul {:class "kc-docs__list"}
         [:li
          [:strong "ayatori"] " — "
          (txt "kotobase.disclosure-grant プロトコル (:decrypt-fn seam 経由) を消費する recipient decryptor。contract と rollout gate は "
               "the recipient decryptor that consumes the kotobase.disclosure-grant protocol (via the :decrypt-fn seam). Contract and rollout gates: ")
          [:a {:href "https://github.com/kotoba-lang/kotobase/blob/main/docs/disclosure-grants.edn"}
           "kotobase/docs/disclosure-grants.edn"]]
         [:li
          [:strong "capability-bench"] " — "
          (txt "OrbitDB / Ceramic / ActorDB / Holochain と kotobase の Prolly Tree + commit DAG 形を一つの capability contract と datom workload で比較したベンチ。結果と方法論は "
               "benchmarks comparing OrbitDB / Ceramic / ActorDB / Holochain against kotobase's own Prolly Tree + commit DAG shape under one capability contract and datom workload. Results and methodology: ")
          [:a {:href "https://github.com/kotoba-lang/kotobase/blob/main/capability-bench/README.md"}
           "kotobase/capability-bench/README.md"]]]
        (dds/heading 2 (txt "URI 設計" "URI design") {:size "28"})
        [:p
         (txt "旧 kotobase.net は操作面 (graph) と資料面 (docs) を kotoba.cloud の path に統合しました。操作は "
              "The former kotobase.net now integrates its operation surface (graph) and documentation surface (docs) under kotoba.cloud paths. Operations: ")
         [:code "/graph"] " → " [:code "#knowledge/overview"]
         (txt " へ、資料はこの " " ; documentation: this ")
         [:code "/docs/graph"]
         (txt " ページへ。graph.kotoba.cloud サブドメインは設定しません (canonical を一つに保つため)。"
              " page. The graph.kotoba.cloud subdomain is not provisioned, to keep one canonical origin.")]))]
     (site-footer t)]))

(defn graph-docs-html
     ([] (graph-docs-html :en))
     ([locale]
      (let [ja? (= locale :ja) path "/docs/graph/"]
        (str "<!DOCTYPE html>\n"
         (html/->html
          (surface-hrefs :docs
           (page/page
               {:title (if ja? "Graph・Ontologyデータベース — Kotoba Cloud"
                         "Graph & Ontology database — Kotoba Cloud")
                :description (if ja? "Kotoba Cloud Database の Graph・Ontology ワークベンチの使い方と ayatori・capability-bench などの周辺資料。"
                               "Usage guide for the Kotoba Cloud Database graph & ontology workbench plus ayatori and capability-bench reference material.")
                :lang (if ja? "ja" "en") :css (document-css)
                :app-css (str tokens/skin-css tokens/bridge-css shell/css
                              ".kc-docs{padding-block:var(--hig-spacing-4)}.kc-docs__list li{padding:var(--hig-spacing-3)}@media(max-width:30rem){.kc-docs h2{font-size:1.25rem}.kc-docs__list li{padding:var(--hig-spacing-2)}}")
                :head [[:link {:rel "canonical" :href (variant-url path locale)}]
                       [:link {:rel "alternate" :hreflang "ja" :href (variant-url path :ja)}]
                       [:link {:rel "alternate" :hreflang "en" :href (variant-url path :en)}]
                       [:link {:rel "alternate" :hreflang "x-default" :href (variant-url path :en)}]
                       [:script {:src "/js/language-selector.js" :defer true}]
                       [:script {:src "/js/session.js" :defer true}]]}
               (graph-docs-view locale))))))))

(defn not-found-html
     ([] (not-found-html :en))
     ([locale]
      (let [t (translation locale)
            dds-css (resource-read "jp_go_dds/dds.css")]
        (->page
         {:title (:not-found-title t) :description (:not-found-lead t)
          :lang (:html-lang t) :css dds-css :app-css (str tokens/skin-css app-css shell/css research-site/css)
          :head [[:script {:src "https://freebuff.com/freebuff-tag.js" :async true}]
                 [:script "window.freebuff=window.freebuff||function(){(window.freebuff.q=window.freebuff.q||[]).push(arguments)}"]]}
         (dds/container
          [:main {:id "main"}
           [:section {:class "kc-hero"}
            [:p {:class "kc-eyebrow"} "404 / NOT FOUND"]
            (dds/heading 1 (:not-found-heading t) {:size "45"})
            [:p {:class "kc-lead"} (:not-found-lead t)]
            (dds/button (:not-found-cta t) {:href "/" :size "lg"})]])
         (site-footer t)))))

(defn- fs-walk-files
  "file-seq's file filter: absolute paths of every file under dir (recursive).
   Dirent objects do not survive js->clj, so classify with statSync instead."
  [dir]
  (let [out (js/Array.)]
    (letfn [(walk [d]
              (doseq [name (js->clj (fs/readdirSync d))]
                (let [p (node-path/join d name)]
                  (if (.isDirectory (fs/statSync p))
                    (walk p)
                    (.push out p)))))]
      (walk dir))
    (vec out)))

(defn- spit-file [path content]
  (fs/mkdirSync (node-path/dirname path) #js {:recursive true})
  (fs/writeFileSync path content))

(defn- spit-locale-variants!
  "One console document per public locale at `rel` (e.g. \"secure\"):
   the locale-free emit is English, /en/ its prefixed address, every other
   locale under its directory — the shape locale/variant-roots negotiates
   (cookie, ?lang=, Accept-Language). Measured 2026-09-15 in Chrome:
   /secure/ /models/ /security/ /security/services/ /identity/ answered in
   Japanese to an English reader because each was one ja emit."
  [root rel html-fn]
  (spit-file (node-path/join root rel "index.html") (html-fn :en))
  (spit-file (node-path/join root "en" rel "index.html") (html-fn :en))
  (doseq [locale supported-locales :when (not= locale :en)]
    (spit-file (node-path/join root (name locale) rel "index.html") (html-fn locale))))


(defn- copy-file [src target]
  (fs/mkdirSync (node-path/dirname target) #js {:recursive true})
  (fs/copyFileSync src target))

(defn -main [& _]
  (let [root (node-path/join (js/process.cwd) "public")
        ja-dir (node-path/join root "ja")
        en-dir (node-path/join root "en")
        js-dir (node-path/join root "js")
        ipfs-source (node-path/join (js/process.cwd) "assets" "ipfs")
        ipfs-target (node-path/join root "ipfs")
        registry-source (node-path/join (js/process.cwd) "assets" "kotoba-package-registry.edn")
        registry-target (node-path/join root ".well-known" "kotoba-package-registry.edn")]
      (fs/mkdirSync root #js {:recursive true})
      (fs/mkdirSync ja-dir #js {:recursive true})
      (fs/mkdirSync en-dir #js {:recursive true})
      (fs/mkdirSync js-dir #js {:recursive true})
      ;; Shared stylesheet (referenced by site-css-link): the union of
      ;; document-css + every stylesheet a site-layout page can carry. Emitted
      ;; once so documents ship ~110KB lighter and the browser caches it.
      (spit-file (node-path/join root "css" "site.css") (site-css))
      (doseq [dir [(node-path/join root "legal")
                   (node-path/join root "legal" "tokushoho")
                   (node-path/join ja-dir "legal")
                   (node-path/join ja-dir "legal" "tokushoho")
                   (node-path/join en-dir "legal")
                   (node-path/join en-dir "legal" "tokushoho")]]
        (fs/mkdirSync dir #js {:recursive true}))
      (doseq [name ["llms.txt" "llms-full.txt" "ekyc.md" "agent-quickstart.md" "robots.txt" "sitemap.xml" "og.png" "public-locale-coverage.json"]]
        (copy-file (node-path/join "assets" name) (node-path/join root name)))
      ;; the brand mark every sidebar document shows top-left (site: kc-sb__brand)
      (copy-file (node-path/join "assets" "kotoba-logo.png") (node-path/join root "assets" "kotoba-logo.png"))
      (doseq [locale supported-locales :when (not (#{:en :ja} locale))]
        (let [dir (node-path/join root (name locale))]
          (fs/mkdirSync dir #js {:recursive true})
          (spit-file (node-path/join dir "index.html") (page-html locale))))
      ;; Simplified Chinese compatibility alias uses the canonical document.
      (fs/mkdirSync (node-path/join root "zh") #js {:recursive true})
      (spit-file (node-path/join root "zh" "index.html") (page-html :zh-Hans))
      (doseq [[path locale] [["billing/index.html" :en] ["ja/billing/index.html" :ja] ["en/billing/index.html" :en]]]
        (spit-file (node-path/join root path) (billing-html locale)))
      (spit-file (node-path/join root "index.html") (page-html :en))
      (spit-file (node-path/join root "404.html") (not-found-html :en))
      (spit-file (node-path/join root "legal" "index.html") (legal-html :en))
      (spit-file (node-path/join root "legal" "tokushoho" "index.html") (tokushoho-html :en))
      (spit-file (node-path/join ja-dir "index.html") (page-html :ja))
      (spit-file (node-path/join ja-dir "404.html") (not-found-html :ja))
      (spit-file (node-path/join ja-dir "legal" "index.html") (legal-html :ja))
      (spit-file (node-path/join ja-dir "legal" "tokushoho" "index.html") (tokushoho-html :ja))
      ;; Keep the old English URL addressable while canonical English moves
      ;; to the apex. Existing links should not become a language regression.
      (spit-file (node-path/join en-dir "index.html") (page-html :en))
      (spit-file (node-path/join en-dir "404.html") (not-found-html :en))
      (spit-file (node-path/join en-dir "legal" "index.html") (legal-html :en))
      (spit-file (node-path/join en-dir "legal" "tokushoho" "index.html") (tokushoho-html :en))
      (spit-file (node-path/join js-dir "language-selector.js")
                 (str behavior/language-selector-script "\n" locale/language-cookie-script))
      ;; the theme choice, applied in <head> before paint on every document
      (spit-file (node-path/join js-dir "theme.js") theme-toggle/script)
      ;; the shell chrome's runtime (cloud-kotoba-dds.shell: the account
      ;; entry's fill + reveal, Escape / outside close) — external because
      ;; script-src is 'self'
      (spit-file (node-path/join js-dir "shell.js") shell/script)
      ;; the code block's copy control (cloud-kotoba-dds.code): reveals the
      ;; control where the clipboard is writable, copies the block verbatim
      (spit-file (node-path/join js-dir "code.js") code/script)
      (doseq [source (fs-walk-files ipfs-source)]
        (copy-file source (node-path/join ipfs-target (node-path/basename source))))
      (copy-file registry-source registry-target)
      ;; kotoba.cloud's did:webvh root and its did:web alias
      ;; (net-kotobase/control-plane ADR-2609021500): did.jsonl,
      ;; did-witness.json and did.json are minted offline by
      ;; authn/scripts/webvh_root.clj and committed under assets/well-known;
      ;; they ship verbatim. `_headers` gives the log its JSON Lines content
      ;; type and lets any resolver fetch it cross-origin.
      (doseq [source (fs-walk-files (node-path/join "assets" "well-known"))]
        ;; The schema subdirectory keeps its path: schema $id is
        ;; /.well-known/kotoba-org-membership-schema/v1.json (ADR-2609141633).
        (let [target (if (str/includes? (str source) "kotoba-org-membership-schema")
                       (node-path/join root ".well-known"
                                       (node-path/join (node-path/basename (node-path/dirname source))
                                                       (node-path/basename source)))
                       (node-path/join root ".well-known" (node-path/basename source)))]
          (fs/mkdirSync (node-path/dirname target) #js {:recursive true})
          (copy-file source target)
          ;; `<did>/whois` transforms to `/.well-known/whois` (no extension)
          ;; while the #whois service names `whois.vp`; a static host has no
          ;; rewrite, so the same file is published under both names.
          (when (= "whois.vp" (node-path/basename source))
            (copy-file source (node-path/join root ".well-known" "whois")))))
      (let [headers (node-path/join "assets" "_headers")]
        (when (fs/existsSync headers)
          (copy-file headers (node-path/join root "_headers"))))
      (spit-locale-variants! root "identity" identity-html)
      ;; the account console: one variant per public locale (en at the
      ;; locale-free root, the rest under their locale directory)
      (spit-file (node-path/join root "account" "index.html") (account-html :en))
      (spit-file (node-path/join en-dir "account" "index.html") (account-html :en))
      (doseq [locale supported-locales :when (not= locale :en)]
        (let [dir (node-path/join root (name locale) "account")]
          (fs/mkdirSync dir #js {:recursive true})
          (spit-file (node-path/join dir "index.html") (account-html locale))))
      (let [out (node-path/join root "admin" "index.html")]
        (spit-file out (admin-html)))
      ;; security + csf2 + crypto static pages and their data blocks
      (doseq [folder ["security-data" "security-watch"]]
        (let [sources (fs-walk-files (node-path/join "assets" folder))]
          (doseq [source sources]
            (let [rel (node-path/relative (node-path/join "assets") source)
                  target (node-path/join root rel)]
              (copy-file source target)))))
      (copy-file (node-path/join "assets" "security-data.js") (node-path/join js-dir "security-data.js"))
      (spit-locale-variants! root "security" security-html)
      (spit-locale-variants! root "security-data" security-html)
      (doseq [path ["csf2/index.html" "security/csf2/index.html" "ja/security/csf2/index.html"]]
        (spit-file (node-path/join root path) (csf2-html)))
      (doseq [source (fs-walk-files (node-path/join "assets" "csf2-catalog"))]
        (let [rel (node-path/relative (node-path/join "assets" "csf2-catalog") source)
              target (node-path/join root "security-data" "csf2" rel)]
          (copy-file source target)))
      (doseq [source (fs-walk-files (node-path/join "assets" "security-watch"))]
        (let [rel (node-path/relative (node-path/join "assets" "security-watch") source)
              target (node-path/join root "security-data" "security-watch" rel)]
          (copy-file source target)))
      (spit-file (node-path/join js-dir "chat-components.js") chat-site/browser-script)
      (spit-file (node-path/join js-dir "graph-workbench.js") graph-workbench/script)
      (spit-file (node-path/join js-dir "knowledge-host.js") knowledge-site/script)
      (copy-file (node-path/join "assets" "csf2-catalog.js") (node-path/join js-dir "csf2-catalog.js"))
      (copy-file (node-path/join "assets" "norbert-chat.js") (node-path/join js-dir "norbert-chat.js"))
      (spit-file (node-path/join root "apps" "index.html") (apps-html :en))
      (spit-file (node-path/join root "ja" "apps" "index.html") (apps-html :ja))
      (spit-locale-variants! root (node-path/join "security" "services") security-services-html)
      (spit-file (node-path/join root "security" "aup" "index.html") (aup-html :en))
      (spit-file (node-path/join root "ja" "security" "aup" "index.html") (aup-html :ja))
      (spit-file (node-path/join root "crypto" "index.html") (crypto-html))
      (spit-file (node-path/join root "security" "crypto" "index.html") (crypto-html))
      (spit-file (node-path/join root "ja" "security" "crypto" "index.html") (crypto-html))
      ;; orgbrain management app (data at /org-data/, ADR-2609142000)
      (spit-file (node-path/join root "orgs" "index.html") (orgbrain-html false))
      (spit-file (node-path/join root "ja" "orgs" "index.html") (orgbrain-html true))
      (spit-file (node-path/join root "compliance" "index.html") (compliance-html))
      (spit-file (node-path/join root "security" "compliance" "index.html") (compliance-html))
      (spit-file (node-path/join root "ja" "security" "compliance" "index.html") (compliance-html))
      (spit-file (node-path/join root "enforcement" "index.html") (enforcement-html))
      (spit-file (node-path/join root "security" "enforcement" "index.html") (enforcement-html))
      (spit-file (node-path/join root "ja" "security" "enforcement" "index.html") (enforcement-html))
      ;; VC fund catalog: /vc/ + /ja/vc/ (same pattern as the compliance surface)
      (spit-file (node-path/join root "vc" "index.html") (vc-html))
      (spit-file (node-path/join root "ja" "vc" "index.html") (vc-html))
      ;; blog: security-research thinktank feed (articles = assets/blog/posts.edn).
      ;; One index per addressable locale, one article page per locale the
      ;; post actually carries (:en canonical, :ja, plus :i18n languages).
      (let [posts (blog-posts)]
        (doseq [l (blog-locale-catalog posts)]
          (let [dir (if (= l :en) root (node-path/join root (name l)))]
            (spit-file (node-path/join dir "blog" "index.html") (blog-html l))))
        (doseq [p posts]
          (doseq [l (distinct (concat [:en :ja] (keys (:i18n p))))]
            (let [dir (if (= l :en) root (node-path/join root (name l)))]
              (spit-file (node-path/join dir "blog" (:slug p) "index.html")
                         (blog-article-html l p))))))
      ;; compliance catalog data blocks + browser script (data at /compliance-data/compliance/)
      (doseq [source (fs-walk-files (node-path/join "assets" "compliance-catalog"))]
        (let [rel (node-path/relative (node-path/join "assets" "compliance-catalog") source)
              target (node-path/join root "compliance-data" "compliance" rel)]
          (copy-file source target)))
      (copy-file (node-path/join "assets" "compliance-catalog.js") (node-path/join js-dir "compliance-catalog.js"))
      ;; enforcement catalog data blocks + browser script (data at /enforcement-data/enforcement/)
      (doseq [source (fs-walk-files (node-path/join "assets" "enforcement-catalog"))]
        (let [rel (node-path/relative (node-path/join "assets" "enforcement-catalog") source)
              target (node-path/join root "enforcement-data" "enforcement" rel)]
          (copy-file source target)))
      (copy-file (node-path/join "assets" "enforcement-catalog.js") (node-path/join js-dir "enforcement-catalog.js"))
      ;; VC fund catalog data blocks + browser script (data at /vc-data/vc/)
      (doseq [source (fs-walk-files (node-path/join "assets" "vc-catalog"))]
        (let [rel (node-path/relative (node-path/join "assets" "vc-catalog") source)
              target (node-path/join root "vc-data" "vc" rel)]
          (copy-file source target)))
      (copy-file (node-path/join "assets" "vc-catalog.js") (node-path/join js-dir "vc-catalog.js"))
      ;; graph docs: former kotobase.net content surface
      (spit-file (node-path/join root "docs" "graph" "index.html") (graph-docs-html :en))
      (spit-file (node-path/join root "ja" "docs" "graph" "index.html") (graph-docs-html :ja))
      ;; docs: integrations overview + one page per client
      ;; console documents rendered from policy data (2026-09-15 round 3)
      (spit-locale-variants! root "secure" secure-html)
      (spit-locale-variants! root "models" models-html)
      ;; /docs/ landing — the document the sidebar links (2026-09-15)
      (spit-file (node-path/join root "docs" "index.html") (docs-index-html :en))
      (spit-file (node-path/join root "ja" "docs" "index.html") (docs-index-html :ja))
      (spit-file (node-path/join root "docs" "reference" "index.html")
                 (docs-page :en (fn [_] "API reference — Kotoba Cloud") "/docs/reference/"
                            (fn [ja?]
                              (into [:ul {:class "kc-docs__list"}]
                                    (for [r docs-site/ref-pages]
                                      [:li [:strong (:name r)]
                                       [:p (if ja? (:desc-ja r) (:desc-en r))]
                                       [:a {:href (str "/docs/reference/" (:id r) "/")} "Open"]])))))
      (spit-file (node-path/join root "ja" "docs" "reference" "index.html")
                 (docs-page :ja (fn [_] "API リファレンス — Kotoba Cloud") "/docs/reference/"
                            (fn [ja?]
                              (into [:ul {:class "kc-docs__list"}]
                                    (for [r docs-site/ref-pages]
                                      [:li [:strong (:name r)]
                                       [:p (if ja? (:desc-ja r) (:desc-en r))]
                                       [:a {:href (str "/docs/reference/" (:id r) "/")} "開く"]])))))
      (doseq [r docs-site/ref-pages]
        (spit-file (node-path/join root "docs" "reference" (:id r) "index.html") ((docs-ref-html (:id r)) :en))
        (spit-file (node-path/join root "ja" "docs" "reference" (:id r) "index.html") ((docs-ref-html (:id r)) :ja)))
      (spit-file (node-path/join root "docs" "integrations" "index.html") (docs-integrations-html :en))
      (spit-file (node-path/join root "ja" "docs" "integrations" "index.html") (docs-integrations-html :ja))
      (doseq [c docs-site/clients]
        (let [dir (node-path/join root "docs" "integrations" (:id c))]
          (spit-file (node-path/join dir "index.html") ((docs-integration-html (:id c)) :en))
          (spit-file (node-path/join root "ja" "docs" "integrations" (:id c) "index.html")
                     ((docs-integration-html (:id c)) :ja))))
      ;; crypto catalog data blocks + browser script (data at /crypto-data/crypto/)
      (doseq [source (fs-walk-files (node-path/join "assets" "crypto-catalog"))]
        (let [rel (node-path/relative (node-path/join "assets" "crypto-catalog") source)
              target (node-path/join root "crypto-data" "crypto" rel)]
          (copy-file source target)))
      (copy-file (node-path/join "assets" "crypto-catalog.js") (node-path/join js-dir "crypto-catalog.js"))
      ;; orgbrain catalog data (public/org-data/) + browser scripts
      (doseq [source (fs-walk-files (node-path/join "assets" "orgbrain-catalog"))]
        (let [rel (node-path/relative (node-path/join "assets" "orgbrain-catalog") source)
              target (node-path/join root "org-data" rel)]
          (copy-file source target)))
      (copy-file (node-path/join "assets" "orgbrain-risk.js") (node-path/join js-dir "orgbrain-risk.js"))
      (copy-file (node-path/join "assets" "orgbrain-app.js") (node-path/join js-dir "orgbrain-app.js"))
      (println "rendered English-first root, locale emit dirs, legal/tokushoho documents, and localized 404s")))
