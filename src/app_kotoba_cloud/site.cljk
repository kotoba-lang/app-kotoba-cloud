(defn aup-view [locale]
  ;; Security Research Acceptable Use Policy + assurance ladder: allowed /
  ;; strictly prohibited / offensive conditions / privacy
  ;; plus the public rung schedule. The data comes from research.cljk so the
  ;; page and the API contract cannot drift apart.
  (let [aup research/acceptable-use-policy
        ladder research/assurance-ladder
        ja? (= locale :ja)
        txt (fn [ja en] (if ja? ja en))]
    (dds/container
     (dds/heading 1 (:title aup) {:size "36"})
     [:p (txt
          "Security Research 層は, 認可された合法的なセキュリティ業務のための無制限モデルを提供します. アクセスは検証済みのセキュリティ専門家に付与され, 本ポリシーに従います. 悪用は即時失効となります. "
          (:intro aup))]
     (dds/heading 2 (txt "Assurance Ladder(Assurance Ladder)" "Assurance ladder") {:size "24"})
     [:p (txt "各レベルが満たすべきEvidenceと, 解禁される 1 日あたりトークンAllowance. カード登録(レベル1)で無料研究枠が開き, 本人確認・ガバナンス確認(レベル2以降)で上限が上がります. "
              "The evidence each rung requires and the daily token allowance it unlocks. The card rung opens the free research allowance; identity and governance checks raise the ceiling after it.")]
     (into [:ol]
           (map (fn [r]
                  [:li [:strong (:label r)]
                   [:p (str (if ja? "Evidence: " "Evidence: ") (:evidence r))]
                   [:p (txt "Allowance: " "Allowance: ") (:defaultTokensPerDay r) " tokens/day · "
                    (txt "上限 " "ceiling ") (:ceilingTokensPerDay r)]])
                (:rungs ladder)))
     (dds/heading 2 (txt "Allowed uses" "Allowed uses") {:size "24"})
     (into [:ul] (map (fn [x] [:li x]) (:allowed aup)))
     (dds/heading 2 (txt "Strictly prohibited" "Strictly prohibited") {:size "24"})
     (into [:ul] (map (fn [x] [:li x]) (:prohibited aup)))
     [:p (:prohibitedNote aup)]
     (dds/heading 2 (txt "攻撃的機能(条件付き)" "Offensive capability, on conditions") {:size "24"})
     [:p (get-in aup [:offensive :intro])]
     (dds/heading 2 (txt "Privacy" "Privacy") {:size "24"})
     (into [:ul] (map (fn [x] [:li x]) (:points (:privacy aup))))
     (dds/heading 2 (txt "ローカル実行境界" "Local execution boundary") {:size "24"})
     (into [:ul] (map (fn [x] [:li x]) (:points (:localExecution aup))))
     (dds/heading 3 (str "Version: " (:version aup)) {:size "20"}))))

(defn aup-html
  ([] (aup-html :en))
  ([locale]
   (let [ja? (= locale :ja)]
     (site-layout {:title (if ja?
                            "Security Research AUP - Kotoba Cloud"
                            "Acceptable Use Policy - Security Research - Kotoba Cloud")
                   :description "Assurance ladder, allowed and prohibited uses for the Security Research tier."
                   :lang (if ja? "ja" "en")
                   :sidebar? true :current "/security/aup/"}
      (aup-view locale)))))

