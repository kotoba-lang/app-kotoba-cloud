(ns app-kotoba-cloud.site
  "Localized public pages for kotoba.cloud. Pure CLJC views render finite
  Worker Static Assets for every supported locale."
  (:require [app-kotoba-cloud.billing :as billing]
            [app-kotoba-cloud.chat-site :as chat-site]
            [app-kotoba-cloud.knowledge-site :as knowledge-site]
            [cloud-kotoba-dds.graph-workbench :as graph-workbench]
            [app-kotoba-cloud.identity-site :as identity-site]
            [app-kotoba-cloud.account-site :as account-site]
            [cloud-kotoba-dds.console :as dds-console]
            [cloud-kotoba-dds.shell :as shell]
            [app-kotoba-cloud.console-locales :as cl]
            [cloud-kotoba-dds.code :as code]
            [app-kotoba-cloud.code-block :as code-block]
            [cloud-kotoba-dds.catalog :as dds-catalog]
            [app-kotoba-cloud.admin-site :as admin-site]
            [app-kotoba-cloud.csf2-site :as csf2-site]
            [app-kotoba-cloud.crypto-site :as crypto-site]
            [app-kotoba-cloud.orgbrain-site :as orgbrain-site]
            [app-kotoba-cloud.compliance-site :as compliance-site]
            [app-kotoba-cloud.enforcement-site :as enforcement-site]
            [app-kotoba-cloud.vc-site :as vc-site]
            [app-kotoba-cloud.security-site :as security-site]
            [app-kotoba-cloud.apps-site :as apps-site]
                        [app-kotoba-cloud.security-services-site :as security-services-site]
            [app-kotoba-cloud.blog-site :as blog-site]
            [app-kotoba-cloud.docs-site :as docs-site]
            [app-kotoba-cloud.research-site :as research-site]
            [app-kotoba-cloud.research :as research]
            [app-kotoba-cloud.profile :as profile]
            [app-kotoba-cloud.public-locales :as locales]
            [app-kotoba-cloud.locale :as locale]
            [app-kotoba-cloud.console :as console]
            [jp-go-dds.theme-toggle :as theme-toggle]
            [jp-go-dds.dark :as dark]
            [app-kotoba-cloud.secure-site :as secure-site]
            [app-kotoba-cloud.models-site :as models-site]
            [app-kotoba-cloud.billing-site :as billing-site]
            [app-kotoba-cloud.extended-translations :as extended]
            [kotoba.lang.text :as str]
            [cljs.reader :as reader]
            [app-kotoba-cloud.session :as session]
            [jp-go-dds.behavior :as behavior]
            [jp-go-dds.core :as dds]
            [jp-go-dds.css :as dcss]
            [jp-go-dds.page :as page]
            [html.core :as html]
            [jp-go-dds.tokens :as tokens]
            #?(:clj [clojure.java.io :as io])
            ;; render runs on the kbb engine (JVM-free): node's fs/path stand in
            ;; for clojure.java.io (see document-css / -main below).
            ["fs" :as fs]
            ["path" :as node-path]))

(def supported-locales locales/locale-order)

(def operator-name "Kotoba Labs Inc")
(def public-contact-email "support@kotoba.cloud")
(def legal-disclosure "請求があった場合、法令に従い遅滞なく開示します")
(def kotobase-connect-href "/#knowledge/overview")

(def reference-package-command
  (str "# install and run the live Ed25519 + ML-DSA-65 reference package\n"
       "kotoba package add kotoba-lang/reference-math@0.1.0 --catalog-cid "
       profile/reference-package-catalog-cid
       "\nkotoba package run kotoba-lang/reference-math  # 42\n\n"
       "kotoba library inspect <name|CID|#hash> --store .kotoba/codebase --namespace demo\n\n"
       "# dry-run by default\n"
       "kotoba library publish --store .kotoba/codebase --namespace demo --hosted\n\n"
       "# replicate one exact release closure\n"
       "kotoba library publish --store .kotoba/codebase --namespace demo --hosted --dry-run false \\\n"
       "  --pqc-seed-file <ml-dsa-seed> \\\n"
       "  --provider east=https://east.example --provider-token-file <east-token> \\\n"
       "  --provider west=https://west.example --provider-token-file <west-token>\n\n"
       "# qualification and execution are release-CID addressed\n"
       "kotoba library verify ipfs://<release-cid> --store .kotoba/codebase \\\n"
       "  --provider east=https://east.example --provider west=https://west.example\n"
       "kotoba library run ipfs://<release-cid> --entry answer --store .kotoba/codebase \\\n"
       "  --provider east=https://east.example --provider west=https://west.example\n\n"
       "# rotate or revoke the Principal-pinned ML-DSA key; both finish with Passkey\n"
       "kotoba pq-key rotate --current-pqc-seed-file <current> \\\n"
       "  --next-pqc-seed-file <next> --expected-epoch 1\n"
       "kotoba pq-key revoke --current-pqc-seed-file <current> --expected-epoch 2"))

