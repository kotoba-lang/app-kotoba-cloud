(defn docs-page
  "Shared chrome for a docs page — the shared site-layout WITH the app
  sidebar (docs are part of the app navigation, orca-style)."
  [locale title-fn path content-fn]
  (site-layout {:title (title-fn (= locale :ja))
                ;; docs live on docs.kotoba.cloud (owner direction
                ;; 2026-09-15): every href is resolved for that surface
                :surface :docs
                :description "Docs — kotoba.cloud"
                :lang (if (= locale :ja) "ja" "en")
                :sidebar? true :current path
                :extra-css docs-site/css}
   ;; the docs' own map first (sections → documents, current page marked),
   ;; then the document
   (dds/container (docs-site/docs-nav locale path) (content-fn (= locale :ja)))))

(defn docs-index-html
  "/docs/ (the root of docs.kotoba.cloud) — the introduction (owner
   direction 2026-09-15, reference IA docs.orcarouter.ai/introduction): what
   this is in one sentence, why, and where to start. The docs map above it
   (docs-site/docs-nav) lists every section; each link is a real document —
   shinkansen :links-resolve refuses the build otherwise."
  [locale]
  (docs-page locale
             (fn [ja?] (if ja? "Kotoba Cloud へようこそ — ドキュメント" "Welcome to Kotoba Cloud — Docs"))
             "/docs/"
             (fn [_] (into [:div {:class "kc-docs"}] (docs-site/intro-view locale)))))

(defn docs-integrations-html
  ([] (docs-integrations-html :en))
  ([locale]
   (docs-page locale
              (fn [ja?] (if ja? "接続ガイド — Agents & Harnesses — Kotoba Cloud"
                          "Connect Agents & Harnesses — Kotoba Cloud"))
              "/docs/integrations/"
              (fn [_ja?] (docs-site/overview-view locale)))))

(defn docs-ref-html [id]
  (fn [locale]
    (let [entry (first (filter #(= (:id %) id) docs-site/ref-pages))
          title (if (and entry (fn? (:title entry))) ((:title entry) (= locale :ja))
                  (str (:name entry " ") "— Kotoba Cloud"))]
      (docs-page locale
                 (fn [_] title)
                 (str "/docs/reference/" id "/")
                 (fn [_] (docs-site/ref-view id locale))))))

