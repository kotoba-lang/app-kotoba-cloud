(def app-css
  (str
   ".kc-skip{position:absolute;inset-inline-start:var(--hig-spacing-4);top:-10rem;z-index:10;}"
   ".kc-skip:focus{top:var(--hig-spacing-4);}"
   ".kc-header{border-bottom:1px solid var(--hig-color-separator);background:var(--hig-color-system-background);}"
   ".kc-header__inner{min-height:4.5rem;display:flex;align-items:center;justify-content:space-between;gap:var(--hig-spacing-4);}"
   ".kc-wordmark{display:flex;align-items:center;gap:var(--hig-spacing-3);color:var(--hig-color-label);font-weight:700;text-decoration:none;letter-spacing:.04em;}"
   ".kc-mark{inline-size:2rem;block-size:2rem;display:grid;place-items:center;border:2px solid var(--hig-color-tint);border-radius:var(--hig-radius-xs);color:var(--hig-color-tint);font-weight:700;}"
   ".kc-nav{display:flex;align-items:center;gap:var(--hig-spacing-4);}"
   ".kc-header__tools{display:flex;align-items:center;gap:var(--hig-spacing-2);margin-inline-start:auto;}"".kc-app-menu{position:relative;}.kc-app-menu summary{display:inline-flex;align-items:center;gap:var(--hig-spacing-2);min-height:2.75rem;padding:var(--hig-spacing-2) var(--hig-spacing-3);border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-sm,8px);background:var(--hig-color-system-background);color:var(--hig-color-label);font:inherit;font-weight:700;cursor:pointer;list-style:none;white-space:nowrap;}.kc-app-menu summary::-webkit-details-marker{display:none;}.kc-app-menu__icon{font-size:1.15rem;line-height:1;}.kc-app-menu__label{font-size:var(--hig-text-caption1-font-size);}.kc-app-menu__panel{position:absolute;inset-inline-end:0;top:calc(100% + var(--hig-spacing-2));z-index:40;min-inline-size:13rem;display:grid;padding:var(--hig-spacing-2);border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-md,12px);background:var(--hig-color-system-background);box-shadow:0 8px 24px rgb(0 0 0 / 12%);}.kc-app-menu__panel a{display:flex;align-items:center;min-height:2.75rem;padding:var(--hig-spacing-2) var(--hig-spacing-3);border-radius:var(--hig-radius-sm,8px);color:var(--hig-color-label);font-weight:700;text-decoration:none;white-space:nowrap;}.kc-app-menu__panel a:hover{background:var(--hig-color-secondary-system-background);}.kc-app-menu[open] .kc-app-menu__panel{display:grid;}.kc-app-menu:not([open]) .kc-app-menu__panel{display:none;}.kc-header--compact .kc-header__inner{min-height:3.5rem;}.kc-header--compact .kc-nav{display:none;}@media(max-width:64rem){.kc-app-menu{margin-inline-start:auto;}}@media(max-width:48rem){.kc-app-menu__label{display:none;}.kc-header--compact .kc-wordmark__text{display:none;}}"
   ".kc-nav>a{color:var(--hig-color-label);font-weight:700;text-underline-offset:.25em;}"
   ".kc-nav>a,.kc-nav .dads-menu-list-box__opener,.kc-nav .dads-button{white-space:nowrap;}"
   ;; 48-64rem: the header cannot fit every item unwrapped. The two anchor
   ;; links duplicate content reachable from the home hero (design rule: one
   ;; home per fact); the real documents — 料金・決済 / アカウント / セキュリティ —
   ;; stay. Hide only the anchors in this band.
   "@media(max-width:64rem){.kc-nav>a[href$='#research-models'],.kc-nav>a[href$='#research-register']{display:none}.kc-nav{gap:var(--hig-spacing-3)}}"
   ".kc-hero{padding-block:var(--hig-spacing-10);border-bottom:1px solid var(--hig-color-separator);}"
   ".kc-eyebrow{margin:0 0 var(--hig-spacing-4);font-family:var(--hig-font-mono);font-size:var(--hig-text-caption1-font-size);font-weight:700;letter-spacing:.12em;color:var(--hig-color-tint);}"
   ".kc-hero h1{max-width:17ch;text-wrap:balance;}"
   ".kc-lead{max-width:48rem;font-size:var(--hig-text-title3-font-size);line-height:var(--hig-text-title3-line-height);color:var(--hig-color-secondary-label);}"
   ".kc-philosophy{max-width:48rem;margin:var(--hig-spacing-4) 0 0;color:var(--hig-color-secondary-label);}"
   ".kc-next{max-width:48rem;margin:var(--hig-spacing-4) 0 0;}"
   ".kc-actions{margin-top:var(--hig-spacing-7);}"
   ".kc-live{margin-top:var(--hig-spacing-5);display:flex;align-items:center;gap:var(--hig-spacing-3);color:var(--hig-color-secondary-label);}"
   ".kc-live__dot{inline-size:.75rem;block-size:.75rem;flex:none;border-radius:var(--hig-radius-capsule);background:var(--hig-palette-green);}"
   ".kc-identity{padding-block:var(--hig-spacing-8);border-bottom:1px solid var(--hig-color-separator);background:var(--hig-color-secondary-system-background);}"
   ".kc-identity[hidden]{display:none;}"
   ".kc-identity-waiting p,.kc-identity-done p{max-width:48rem;color:var(--hig-color-secondary-label);}"
   ".kc-identity__done{margin:0 0 var(--hig-spacing-5);font-weight:700;color:var(--hig-color-tint);}"
   ".kc-identity__next{margin-top:var(--hig-spacing-6);}"
   ".kc-identity__grid{display:grid;grid-template-columns:minmax(12rem,1fr) repeat(2,minmax(0,2fr));gap:var(--hig-spacing-5);align-items:start;}"
   ".kc-identity__label{margin:0 0 var(--hig-spacing-2);font-family:var(--hig-font-mono);font-size:var(--hig-text-caption1-font-size);font-weight:700;color:var(--hig-color-secondary-label);}"
   ".kc-identity__value{margin:0;font-family:var(--hig-font-mono);overflow-wrap:anywhere;}"
   ".kc-identity__username{font-size:var(--hig-text-title2-font-size);font-weight:700;color:var(--hig-color-tint);}"
   ".kc-architecture{background:var(--hig-color-secondary-system-background);}"
   ".kc-control{border-inline-start:.4rem solid var(--hig-color-tint);}"
   ".kc-control__origin{font-family:var(--hig-font-mono);color:var(--hig-color-tint);}"
   ".kc-control__origin a{color:inherit;font-weight:700;text-underline-offset:.25em;}"
   ".kc-flow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--hig-spacing-5);margin-top:var(--hig-spacing-7);padding-top:var(--hig-spacing-7);border-top:1px solid var(--hig-color-separator);}"
   ".kc-plane{position:relative;}.kc-plane::before{content:'↓';position:absolute;inset-block-start:calc(-1 * var(--hig-spacing-9));inset-inline-start:50%;color:var(--hig-color-tint);font-weight:700;}"
   ".kc-plane__kind{font-family:var(--hig-font-mono);font-size:var(--hig-text-caption1-font-size);font-weight:700;letter-spacing:.08em;color:var(--hig-color-secondary-label);}"
   ".kc-plane h3{margin-block:var(--hig-spacing-2);}.kc-plane p{color:var(--hig-color-secondary-label);}.kc-plane a{font-family:var(--hig-font-mono);font-weight:700;}.kc-plane__connect{display:inline-block;margin-top:var(--hig-spacing-3);}.kc-plane__connect[hidden]{display:none;}"
   ".kc-steps{counter-reset:step}.kc-step{counter-increment:step}.kc-step::before{content:'0' counter(step);display:block;margin-bottom:var(--hig-spacing-3);font-family:var(--hig-font-mono);font-weight:700;color:var(--hig-color-tint);}"
   ".kc-publish-approval{margin-top:var(--hig-spacing-7);border-inline-start:.4rem solid var(--hig-color-tint);}.kc-publish-approval[hidden]{display:none}.kc-publish-fields{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:var(--hig-spacing-2) var(--hig-spacing-4);}.kc-publish-fields dt{font-weight:700}.kc-publish-fields dd{margin:0;font-family:var(--hig-font-mono);overflow-wrap:anywhere}"
   ".kc-boundary{border-inline-start:.4rem solid var(--hig-color-separator);}"
   ".kc-footer{padding-block:var(--hig-spacing-8);border-top:1px solid var(--hig-color-separator);color:var(--hig-color-secondary-label);}.kc-footer__inner{display:flex;justify-content:space-between;gap:var(--hig-spacing-5);flex-wrap:wrap;}"
   ".kc-footer__legal{margin-top:var(--hig-spacing-4);display:flex;flex-wrap:wrap;gap:var(--hig-spacing-2) var(--hig-spacing-4);align-items:baseline;}"
   ".kc-footer__legal a{color:inherit;font-weight:700;text-underline-offset:.25em;}"
   ".kc-legal{padding-block:var(--hig-spacing-8);}.kc-legal__lead{max-width:48rem;font-size:var(--hig-text-title3-font-size);line-height:var(--hig-text-title3-line-height);color:var(--hig-color-secondary-label);}"
   ".kc-legal .dads-table{margin-top:var(--hig-spacing-6);overflow-x:auto;}.kc-legal__note{margin-top:var(--hig-spacing-6);color:var(--hig-color-secondary-label);}"
   "@media(max-width:48rem){.kc-nav__secondary{display:none}.kc-hero{padding-block:var(--hig-spacing-8)}.kc-hero .dads-heading[data-size='64']{font-size:var(--hig-text-large-title-font-size);line-height:var(--hig-text-large-title-line-height)}.kc-hero .dds-ext-row{display:grid;grid-template-columns:1fr}.kc-actions{margin-top:var(--hig-spacing-4)}.kc-actions .dads-button{width:100%;justify-content:center}.kc-identity__grid{grid-template-columns:1fr}.kc-flow{grid-template-columns:1fr}.kc-plane::before{inset-inline-start:var(--hig-spacing-4)}.kc-footer__inner{display:block}}"
   "@media(max-width:30rem){.kc-wordmark__text{display:none}.kc-header__inner{gap:var(--hig-spacing-2)}.kc-nav{gap:var(--hig-spacing-2)}}"
   "@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}"))

(defn infrastructure-translation [locale]
  (if-let [t (get locales/copy locale)]
    (merge (:en copy)
           {:html-lang (name locale) :og-locale (name locale)
            :path "/"
            :title (str "Kotoba Cloud — " (:cloud-headline t))
            :description (:cloud-lead t)
            :skip (:skip t) :home-label "Kotoba Cloud"
            :nav-architecture (:architecture t) :nav-libraries (:libraries t)
            :language-label (:language t) :nav-sign-in (:signin t)
            :headline (:cloud-headline t) :lead [(:cloud-lead t)]
            :passkey-cta (:start t) :cli-cta (:cli t) :live (:cloud-live t)
            :philosophy (or (:philosophy t) (get-in copy [:en :philosophy]))
            :next-step (or (:next-step t) (get-in copy [:en :next-step]))
            :identity-title (or (:identity-title t) (get-in copy [:en :identity-title]))
            :identity-waiting (or (:identity-waiting t) (get-in copy [:en :identity-waiting]))
            :identity-done (or (:identity-done t) (get-in copy [:en :identity-done]))
            :identity-label (or (:identity-label t) (get-in copy [:en :identity-label]))
            :next-step-hint (or (:next-step-hint t) (get-in copy [:en :next-step-hint]))
            :next-step-alt (or (:next-step-alt t) (get-in copy [:en :next-step-alt]))
            :signed-in-action (or (:signed-in-action t) (get-in copy [:en :signed-in-action]))
            :signed-in-status (or (:signed-in-status t) (get-in copy [:en :signed-in-status]))
            :boundary-heading (:boundary-heading t)
            :boundary-p1 (:boundary-body t) :boundary-p2 ""
            :contact-label (:contact t) :translation-note (:note t)})
    (or (get copy locale) (get copy :en))))

(defn translation [locale]
  (let [t (infrastructure-translation locale) r (research-site/copy locale)]
    (assoc t :title (str "Kotoba Cloud — " (:title r)) :description (:description r)
           :footer (str "Kotoba Cloud — " (:title r)))))

(defn passkey-href [locale]
  (session/passkey-href (if (= locale :ja) :ja :en)))

(defn language-href
  "The language switch's href: `?lang=<locale>` RELATIVE to the current
  document, so the route is preserved by construction (a query-only
  reference resolves against the document's own path). The Worker serves
  that variant directly and persists the choice as kb_locale
  (locale/static-decision); no /<locale>/ path is ever linked."
  [loc]
  (str "?" locale/query-param "=" (name loc)))

(defn language-links
  [locale label]
  (dds/language-selector
   {:id-prefix "kotoba-cloud-language"
    :size "md"
    :current locale
    :languages (mapv (fn [loc]
                       {:code loc :label (get locales/native-names loc)
                        :href (language-href loc)})
                     supported-locales)
    :attrs {:aria-label label}}))

(defn operator-lead [locale]
  (if (= locale :en)
    (str "The public operator of kotoba.cloud is " operator-name ".")
    (str "kotoba.cloud の公開運営元は " operator-name " です。")))

(defn contact-mailto []
  [:a {:href (str "mailto:" public-contact-email)} public-contact-email])

(def app-sidebar-css
  ;; Desktop: a fixed left column anchored at inset-inline-start:0 — the
  ;; anchor is load-bearing (shinkansen.audit :fixed-anchor): without it the
  ;; fixed nav floated at its static position inside the body padding, a
  ;; dead 15rem gutter with the content pushed over twice. The content is
  ;; offset ONCE (body padding), never body padding + main margin.
  ;; Below 64rem the same nav becomes a fixed, horizontally scrolling row of
  ;; chips at the top — 3rem tall instead of ~1,100px of stacked links
  ;; before the first content (measured on a 390px phone, 2026-09-15). The
  ;; nav sits AFTER <main> in document order so reading order is content
  ;; first on every band (shinkansen.audit :nav-before-content).
  ".kc-sb{box-sizing:border-box;position:fixed;inset-block:0;inset-inline-start:0;inline-size:15rem;background:var(--hig-color-secondary-system-background);border-inline-end:1px solid var(--hig-color-separator);display:flex;flex-direction:column;padding:var(--hig-spacing-3);gap:var(--hig-spacing-1);overflow:auto;z-index:30}
.kc-sb>*{flex-shrink:0}
.kc-sb a,.kc-sb__new,.kc-account-chip,#kc-session-nav-side .kc-session-menu__item{box-sizing:border-box}
.kc-sb__brand{display:block;padding:var(--hig-spacing-1) var(--hig-spacing-1) var(--hig-spacing-2)}
.kc-sb__brand img{display:block;inline-size:100%;max-inline-size:13rem;block-size:auto}
.kc-sb__new{display:flex;align-items:center;justify-content:center;min-height:2.25rem;margin-block-end:var(--hig-spacing-1);border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-sm,8px);background:var(--hig-color-system-background);color:var(--hig-color-label);font:inherit;font-size:var(--hig-text-subheadline-font-size);font-weight:700;cursor:pointer;text-decoration:none}
.kc-sb__new:hover{background:var(--hig-color-tertiary-system-background,var(--hig-color-secondary-system-background))}
.kc-sb__group{margin-top:var(--hig-spacing-3);padding-inline:var(--hig-spacing-2);font-family:var(--hig-font-mono);font-size:var(--hig-text-caption2-font-size);font-weight:700;letter-spacing:.08em;color:var(--hig-color-secondary-label)}
.kc-sb a{display:flex;align-items:center;min-height:2rem;padding:var(--hig-spacing-1) var(--hig-spacing-2);border-radius:var(--hig-radius-xs,6px);color:var(--hig-color-label);font-size:var(--hig-text-subheadline-font-size);line-height:1.4;font-weight:500;text-decoration:none;white-space:nowrap}
.kc-sb a:hover{background:var(--hig-color-system-background)}
.kc-sb a[data-current=true]{background:var(--hig-color-system-background);color:var(--hig-color-tint);font-weight:700;box-shadow:inset 3px 0 0 var(--hig-color-tint)}
.kc-sb__badge{margin-inline-start:auto;padding:0 var(--hig-spacing-2);border-radius:var(--hig-radius-capsule,999px);border:1px solid var(--hig-color-tint);color:var(--hig-color-tint);font-size:var(--hig-text-caption2-font-size);font-weight:700;letter-spacing:.04em;line-height:1.5}
.kc-sb__foot{flex:none;margin-top:auto;border-top:1px solid var(--hig-color-separator);padding-top:var(--hig-spacing-2);color:var(--hig-color-secondary-label);font-size:var(--hig-text-caption1-font-size)}
.kc-sb__foot .ck-account{color:var(--hig-color-label)}
.kc-header__tools .ck-account{inline-size:auto}
.kc-header__tools .ck-account__session{inline-size:auto}
.kc-header__tools .ck-account__chip{inline-size:auto;max-inline-size:14rem}
.kc-header__tools .ck-account__menu[data-chrome=float]{inset-inline:auto 0}
.kc-sb-main>.ck-topbar{margin:calc(-1 * var(--hig-spacing-6)) calc(-1 * var(--hig-spacing-5)) var(--hig-spacing-5)}
.kc-topbar__link{color:var(--hig-color-label);font-weight:700;text-decoration:none;padding:var(--hig-spacing-2) var(--hig-spacing-3);border-radius:var(--hig-radius-sm,8px)}
.kc-topbar__link:hover{background:var(--hig-color-secondary-system-background)}
.kc-topbar__chip{display:inline-flex;align-items:center;gap:var(--hig-spacing-2);min-height:2.25rem;padding:0 var(--hig-spacing-3);border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-capsule,999px);color:var(--hig-color-label);font-family:var(--hig-font-mono);font-weight:700;text-decoration:none;background:var(--hig-color-secondary-system-background)}
.kc-topbar__chip--setup{border-color:var(--hig-color-tint);color:var(--hig-color-tint);font-family:inherit}
.kc-topbar__chip--setup[data-state=done]{border-color:var(--hig-palette-green);color:var(--hig-palette-green)}
.kc-setup-banner{display:flex;flex-wrap:wrap;align-items:center;gap:var(--hig-spacing-3);margin:0 0 var(--hig-spacing-5);padding:var(--hig-spacing-3) var(--hig-spacing-4);border:1px solid var(--hig-color-separator);border-inline-start:4px solid var(--hig-color-tint);border-radius:var(--hig-radius-sm,8px);background:var(--hig-color-secondary-system-background)}
.kc-setup-banner a{font-weight:700}
body:has(.kc-sb){padding-inline-start:15rem}
.kc-sb-main{min-height:calc(100dvh - 65px);padding:var(--hig-spacing-6) var(--hig-spacing-5)}
@media(max-width:64rem){body:has(.kc-sb){padding-inline-start:0;padding-block-start:3.25rem}
.kc-sb{inset-block:0 auto;inset-inline:0;inline-size:auto;block-size:3.25rem;flex-direction:row;align-items:center;gap:var(--hig-spacing-1);padding:0 var(--hig-spacing-2);border-inline-end:none;border-block-end:1px solid var(--hig-color-separator);overflow-x:auto;overflow-y:hidden;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.kc-sb::-webkit-scrollbar{display:none}
.kc-sb__group{display:none}
.kc-sb__brand{flex:none;padding:0 var(--hig-spacing-1)}
.kc-sb__brand img{inline-size:auto;block-size:1.5rem}
.kc-sb__new{flex:none;min-height:2.25rem;padding-inline:var(--hig-spacing-3)}
.kc-sb a{flex:none;min-height:2.25rem;font-size:var(--hig-text-footnote-font-size)}
.kc-sb__foot{position:sticky;inset-inline-end:0;margin-top:0;margin-inline-start:auto;margin-inline-end:calc(-1 * var(--hig-spacing-2));border-top:none;padding:0 var(--hig-spacing-2);flex:none;background:var(--hig-color-secondary-system-background)}
.kc-sb__foot .ck-account{inline-size:auto}
.kc-sb__foot .ck-account__chip{min-height:2.25rem;max-inline-size:12rem}
.kc-sb-main{min-height:0;padding:var(--hig-spacing-5) var(--hig-spacing-4)}
.kc-sb-main>.ck-topbar{top:3.25rem;margin:calc(-1 * var(--hig-spacing-5)) calc(-1 * var(--hig-spacing-4)) var(--hig-spacing-4);padding:var(--hig-spacing-2) var(--hig-spacing-4)}
.ck-topbar__group,.ck-topbar__sep{display:none}}
@media(max-width:30rem){.kc-sb-main{padding:var(--hig-spacing-4) var(--hig-spacing-3)}
.kc-sb-main>.ck-topbar{min-height:2.5rem;margin:calc(-1 * var(--hig-spacing-4)) calc(-1 * var(--hig-spacing-3)) var(--hig-spacing-3);padding:var(--hig-spacing-1) var(--hig-spacing-3)}
.kc-topbar__link{display:none}
.kc-topbar__chip{min-height:2rem;font-size:var(--hig-text-caption1-font-size)}}")

(defn app-sidebar
  "Persistent left nav, generated from console/groups —
  the ONE table that declares every destination (a view added to the table
  and forgotten in the nav cannot happen). Emitted AFTER <main> (see
  site-layout) so content comes first on every band. Badges are facts from
  the table; the foot is the account entry on every view: a sign-in control
  until the session is known, then the account chip (shell-browser)."
  [locale _t current]
  (let [txt (fn [k] (cl/t locale k))]
    (into
     [:nav {:class "kc-sb" :aria-label (txt :app-navigation)}
      ;; the brand, top-left of every screen (owner direction 2026-09-15):
      ;; the Kotoba mark from kotoba-lang/kotoba's README header, one home —
      ;; the compact header on the app page drops its wordmark for it
      [:a {:class "kc-sb__brand" :href "/" :aria-label (txt :home)}
       [:img {:src "/assets/kotoba-logo.png" :alt "Kotoba" :width 208 :height 29 :decoding "async"}]]
      [:a {:class "kc-sb__new" :href (:href console/get-started)}
       (txt (:key console/get-started))]]
     (concat
      (mapcat (fn [{:keys [group items]}]
                (cons [:div {:class "kc-sb__group"} group]
                      (for [{:keys [label href badge current?]} items]
                        [:a (cond-> {:href href} current? (assoc :data-current "true"))
                         label
                         (when badge [:span {:class "kc-sb__badge"} badge])])))
              (console/sidebar-items current locale))
      ;; the account entry is cloud-kotoba-dds.shell's: both states in the
      ;; document (sign-in visible, the chip + FLOATING menu hidden), the
      ;; browser fills and reveals (shell-browser → cloudKotobaShell)
      [[:div {:class "kc-sb__foot" :aria-label (txt :menu-account)}
        (shell/account-entry
         {:id "kc-session-nav-side" :variant :rail
          :sign-in {:href (passkey-href locale) :label (txt :sign-in)}
          :menu-label (txt :account-menu)
          :items [{:href "/account" :label (txt :menu-account)}
                  {:href "/billing/" :label (txt :menu-billing)}
                  {:id "kc-session-signout" :action "sign-out" :label (txt :sign-out)}]})
        ;; the six strings shell-browser needs at runtime, in the document's
        ;; locale (the 22-locale map stays out of the bundle)
        [:span (into {:id "kc-console-copy" :hidden true}
                     (map (fn [k] [(keyword (str "data-" (name k))) (cl/t locale k)]) cl/browser-keys))]]]))))

(defn console-language-switch
  "The language switch of the console chrome — jp-go-dds's language-selector
   under cloud-kotoba-dds's :language-selector contract: base
   :jp-go-dds/language-selector, preserves the route, selection order
   explicit URL → saved choice → default. Every public locale is offered
   (the console chrome is in all 22 since 2026-09-15 — console-locales;
   until then two, and a reader of Bahasa Indonesia got an English
   console); each href is the SAME document with `?lang=` (language-href),
   which the Worker serves as that variant with the choice persisted as
   kb_locale (locale.cljk) — the click also writes the cookie client-side
   (language-cookie-script), so the route never forks."
  [locale _current]
  (dds/language-selector
   {:id-prefix "kc-console-language"
    :size "sm"
    :current locale
    :languages (mapv (fn [loc] {:code loc :label (get locales/native-names loc) :href (language-href loc)})
                     supported-locales)
    :attrs {:aria-label (cl/t locale :language)}}))

(defn console-topbar
  "The console's top bar: the section this page belongs to (from the IA
  table — navigation, not a second h1), then the actions every console
  view shares: a credit chip, the docs link and the setup-progress chip.
  The two chips are hidden until shell-browser has read the session — a
  chip with no number is not shown (no fabricated state)."
  [locale current]
  (let [section (console/section-label current locale)]
    ;; cloud-kotoba-dds.shell's top bar: sticky (data-chrome=top, measured
    ;; by shinkansen.audit :chrome-layers) — it no longer scrolls away
    (shell/topbar
     {:section (when section
                 (if (= (:group section) (:item section))
                   [:span (:item section)]
                   (shell/section-label (:group section) (:item section))))
      :actions [[:a {:class "kc-topbar__chip" :id "kc-credit-chip" :href "/billing/" :hidden true} "—"]
                [:a {:class "kc-topbar__link" :href "/docs/"} (cl/t locale :docs)]
                [:a {:class "kc-topbar__chip kc-topbar__chip--setup" :id "kc-setup-chip" :href "/account" :hidden true} "—"]
                ;; right edge (reference: … | EN): language, then the λ yin-yang
                ;; theme switch (jp-go-dds.theme-toggle; hidden until its script runs)
                (console-language-switch locale current)
                theme-toggle/control]})))

(defn setup-banner
  "'Resume setup — <next step> · Continue': hidden until the session is
   known; shell-browser fills the next step from console/setup-progress."
  [locale]
  [:div {:id "kc-setup-banner" :class "kc-setup-banner" :role "status" :hidden true}
   [:span {:id "kc-setup-banner-text"} (cl/t locale :resume-setup)]
   [:a {:id "kc-setup-banner-link" :href "/account"} (cl/t locale :continue)]])

(defn app-menu
  "Single dropdown menu over the compact app header.
   Every destination is a real document (no anchor-only items). Items are
   listed in nav copy order; the app surface owns only the container."
  [locale t]
  [:details {:id "kc-app-menu" :class "kc-app-menu"}
   [:summary {:aria-label (:menu-label t)}
    [:span {:class "kc-app-menu__icon" :aria-hidden "true"} "≡"]
    [:span {:class "kc-app-menu__label"} (:menu-label t)]]
   [:nav {:class "kc-app-menu__panel" :aria-label (:menu-label t)}
    [:a {:href "/#research-models"} (:menu-models t)]
    [:a {:href "/#research-register"} (:menu-register t)]
    [:a {:href "/billing/"} (:menu-billing t)]
    [:a {:href "/account"} (:menu-account t)]
    [:a {:href "/security/csf2/"} (:menu-security t)]
    [:a {:href "/blog/"} (:blog t)]
    [:a {:href "/apps/"} (:menu-apps t)]]])

(defn site-header
  ([locale t]
   (site-header locale t {}))
  ([locale t {:keys [nav] :or {nav true}}]
   [:header {:class (if nav "kc-header" "kc-header kc-header--compact")}
    (dds/container
     [:div {:class "kc-header__inner"}
      ;; the compact header sits beside the sidebar, whose top-left already
      ;; carries the Kotoba mark — one brand, one home. The full header (no
      ;; sidebar) keeps its wordmark. locale-free href: the edge negotiates
      ;; the variant by cookie (shinkansen.locale).
      (when nav
        [:a {:class "kc-wordmark" :href "/" :aria-label (:home-label t)}
         [:span {:class "kc-mark" :aria-hidden "true"} "こ"]
         [:span {:class "kc-wordmark__text"} "KOTOBA CLOUD"]])
      (when nav
        [:nav {:class "kc-nav" :aria-label (:nav-label t)}
         [:a {:class "kc-nav__secondary" :href "/#research-models"} (:nav-models t)]
         [:a {:class "kc-nav__secondary" :href "/#research-register"} (:nav-researchers t)]
         [:a {:class "kc-nav__secondary" :href "/billing/"} (:nav-billing t)]
         [:a {:class "kc-nav__secondary" :href "/account"} (:nav-account t)]
         [:a {:class "kc-nav__secondary" :href "/security/csf2/"} (:nav-security t)]
         [:a {:class "kc-nav__secondary" :href "/blog/"} (:blog t)]
         [:a {:class "kc-nav__secondary" :href "/apps/"} (:menu-apps t)]])
      ;; the right edge: language, theme, app menu (and, on the full
      ;; header, the sign-in entry) — one cluster pushed to the end
      [:div {:class "kc-header__tools"}
       (language-links locale (:language-label t))
       theme-toggle/control
      ;; The anonymous label. auth.kotoba.cloud's default way in is a Base
       ;; Account (smart-contract wallet) since 2026-09-07 (net-kotobase
       ;; ADR-2609071000); passkeys, wallets and recovery phrases remain.
       (app-menu locale t)
       ;; beside the sidebar the account entry is the sidebar's chip (one
       ;; home); the full header keeps its own
       (when nav
         (shell/account-entry
          {:id "kc-session-entry" :variant :header
           :sign-in {:href (passkey-href locale) :label (:nav-sign-in t)}
           :menu-label (if (= locale :ja) "アカウントメニュー" "Account menu")
           :items [{:href "/account" :label (if (= locale :ja) "アカウント管理" "Account")}
                   {:id "kc-session-signout" :action "sign-out" :label (if (= locale :ja) "ログアウト" "Sign out")}]}))]])]))

(defn site-footer [t]
  [:footer {:class "kc-footer"}
   (dds/container
    [:div {:class "kc-footer__inner"}
     [:span (:footer t)]
     [:a {:href "/agent-quickstart.md"} "AI agent quickstart"]
     [:a {:href "/ekyc.md"} "Research registration (Stripe Identity)"]
     [:a {:href "/llms.txt"} "LLM docs"]
     [:span (:footer-roles t)]]
    [:div {:class "kc-footer__legal"}
     [:span (:operator-label t) ": " operator-name]
     [:span (:contact-label t) ": " (contact-mailto)]
     ;; locale-free hrefs (the Worker serves the negotiated variant at
     ;; /legal/; the ja document's canonical is /legal/?lang=ja)
     [:a {:href "/legal/"} (:legal-link t)]
     [:a {:href "/legal/tokushoho/"} (:tokushoho-link t)]])])

(defn legal-rows [t]
  [[(:operator-label t) operator-name]
   [(:service-provider-label t) operator-name]
   [(:entity-label t) legal-disclosure]
   [(:representative-label t) legal-disclosure]
   [(:address-label t) legal-disclosure]
   [(:phone-label t) legal-disclosure]
   [(:contact-label t) public-contact-email]])

(defn tokushoho-rows [t]
  (concat (legal-rows t)
          [[(:service-label t) (:tokushoho-service t)]
           [(:price-label t) (:tokushoho-price t)]
           [(:other-costs-label t) (:tokushoho-other-costs t)]
           [(:payment-label t) (:tokushoho-payment t)]
           [(:payment-timing-label t) (:tokushoho-payment-timing t)]
           [(:provision-label t) (:tokushoho-provision t)]
           [(:term-label t) (:tokushoho-term t)]
           [(:cancel-label t) (:tokushoho-cancel t)]
           [(:refund-label t) (:tokushoho-refund t)]]))

(defn disclosure-table [caption rows]
  (dds/table {:caption caption
              :headers nil
              :row-header? true
              :rows rows}))

(defn legal-view [locale]
  (let [t (translation locale)]
    [[:a {:class "kc-skip dads-button" :data-type "outline" :data-size "sm"
          :href "#main"} (:skip t)]
     (site-header locale t)
     [:main {:id "main" :class "kc-legal"}
      (dds/container
       (dds/section {:title (:legal-heading t)}
        [:p {:class "kc-legal__lead"} (operator-lead locale)]
        [:p (:legal-about t)]
        [:p (:contact-label t) ": " (contact-mailto)]
        (disclosure-table (:legal-heading t) (legal-rows t))
        [:p {:class "kc-legal__note"} (:tokushoho-note t)]
        (dds/row
         (dds/button (:tokushoho-link t) {:type :text :size "md"
                                          :href "/legal/tokushoho/"}))))]
     (site-footer t)]))

(defn tokushoho-view [locale]
  (let [t (translation locale)]
    [[:a {:class "kc-skip dads-button" :data-type "outline" :data-size "sm"
          :href "#main"} (:skip t)]
     (site-header locale t)
     [:main {:id "main" :class "kc-legal"}
      (dds/container
       (dds/section {:title (:tokushoho-heading t)}
        [:p {:class "kc-legal__lead"} (operator-lead locale)]
        [:p (:tokushoho-updated t)]
        (disclosure-table (:tokushoho-heading t) (tokushoho-rows t))
        [:p {:class "kc-legal__note"} (:tokushoho-note t)]
        (dds/row
         (dds/button (:legal-link t) {:type :text :size "md"
                                      :href "/legal/"}))))]
     (site-footer t)]))

(defn plane-card [connect-label {:keys [kind name origin href body connect-href]}]
  (dds/card
   [:article {:class "kc-plane"}
    [:div {:class "kc-plane__kind"} kind]
    (dds/heading 3 name {:size "24"})
    [:p body]
    [:a {:href href} origin " ↗"]
    (when connect-href
      [:div
       [:a {:href connect-href :class "kc-plane__connect"
            :data-session-link "true" :hidden true}
        connect-label " →"]])]))

(defn infrastructure-view [locale]
  (let [t (translation locale)]
    [[:a {:class "kc-skip dads-button" :data-type "outline" :data-size "sm"
          :href "#main"} (:skip t)]
     (site-header locale t)
     [:main {:id "main"}
      (when-let [note (:translation-note t)]
        [:p {:class "kc-research-note"} note])
      (into [:div] (research-site/sections locale (passkey-href locale)))
      [:span {:id "kc-session-labels" :hidden true
              :data-signed-in-action (:signed-in-action t)
              :data-signed-in-status (:signed-in-status t)
              :data-signed-in-href kotobase-connect-href}]
      [:section {:class "kc-identity" :id "identity"
                 :aria-label (:identity-label t)}
       (dds/container
        [:div {:class "kc-identity-waiting" :id "kc-identity-waiting"}
         (dds/heading 2 (:identity-title t) {:size "24"})
         [:p (:identity-waiting t)]
         [:p (:next-step t)]
         (dds/button (:passkey-cta t) {:type :solid-fill :size "lg"
                                       :href (passkey-href locale)})]
        [:div {:class "kc-identity-done" :id "kc-identity-done" :hidden true}
         [:p {:class "kc-identity__done" :id "kc-identity-done-status"}
          (:identity-done t)]
         [:div {:class "kc-identity__grid"}
          [:div
           [:p {:class "kc-identity__label"} "PASSKEY USERNAME"]
           [:p {:class "kc-identity__value kc-identity__username"
                :id "kc-session-username"} "@kotoba-…"]]
          [:div
           [:p {:class "kc-identity__label"} "STABLE PRINCIPAL"]
           [:p {:class "kc-identity__value" :id "kc-session-principal"} "—"]]
          [:div
           [:p {:class "kc-identity__label"} "ACTIVE CONTROLLER"]
           [:p {:class "kc-identity__value" :id "kc-session-controller"} "—"]]]
         [:div {:class "kc-identity__next"}
          [:p (:next-step-hint t)]
          (dds/button (:signed-in-action t)
                      {:type :solid-fill :size "lg"
                       :id "kc-identity-next"
                       :href kotobase-connect-href})
          [:p [:a {:href (str (:path t) "#libraries")} (:next-step-alt t)]]]])]
      [:section {:class "kc-architecture" :id "architecture"}
       (dds/container
        (dds/section {:title (:architecture-title t)}
         [:p {:class "dds-ext-lead"} (:architecture-lead t)]
         (dds/card
          [:article {:class "kc-control"}
           [:div {:class "kc-plane__kind"} (:control-kind t)]
           (dds/heading 3 (:control-title t) {:size "24"})
           [:p (:control-body t)]
         [:div {:class "kc-control__origin"}
          [:a {:href profile/identity-href} "auth.kotoba.cloud"]
          "  ·  api.kotoba.cloud"]])
         (into [:div {:class "kc-flow"}]
               (map #(plane-card (:connect-label t) %) (:planes t)))))]
      (dds/container
       (dds/section {:title (:library-title t) :id "libraries"}
        [:p {:class "dds-ext-lead"} (:library-lead t)]
        (into
         [:div {:class "dds-ext-grid kc-steps" :style {:--dds-ext-grid-min "15rem"}}]
         (map (fn [[title body]]
                (dds/card [:article {:class "kc-step"}
                           (dds/heading 3 title {:size "20"})
                           [:p body]]))
              (:library-steps t)))
        (code-block/block locale reference-package-command)
        [:p {:class "kc-live"}
         [:span {:class "kc-live__dot" :aria-hidden "true"}]
         [:span (:library-status t)]]
        (dds/button (:library-catalog-cta t)
                    {:type :outline :size "lg"
                     :href "https://kotoba-lang.org/libraries/"})
        (dds/card
         [:article {:id "library-publish-approval" :hidden true
                    :class "kc-publish-approval"}
          (dds/heading 3 (:approval-title t) {:size "24"})
          [:p (:approval-lead t)]
          [:dl {:class "kc-publish-fields"}
           [:dt "Namespace"] [:dd {:id "library-publish-namespace"} "—"]
           [:dt "Release CID"] [:dd {:id "library-publish-release"} "—"]
           [:dt "Head record CID"] [:dd {:id "library-publish-record"} "—"]
           [:dt "IPNS name"] [:dd {:id "library-publish-name"} "—"]]
          (dds/button (:approval-button t)
                      {:type :primary :size "lg" :id "library-publish-submit"})
          [:p {:id "library-publish-result" :role "status" :aria-live "polite"}]])
        (dds/card
         [:article {:id "pq-key-transition-approval" :hidden true
                    :class "kc-publish-approval"}
          (dds/heading 3 (:key-approval-title t) {:size "24"})
          [:p (:key-approval-lead t)]
          [:dl {:class "kc-publish-fields"}
           [:dt "Action"] [:dd {:id "pq-key-transition-action"} "—"]
           [:dt "Expected epoch"] [:dd {:id "pq-key-transition-epoch"} "—"]
           [:dt "Current key"] [:dd {:id "pq-key-transition-current"} "—"]
           [:dt "Next key"] [:dd {:id "pq-key-transition-next"} "—"]]
          (dds/button (:key-approval-button t)
                      {:type :primary :size "lg" :id "pq-key-transition-submit"})
          [:p {:id "pq-key-transition-result" :role "status" :aria-live "polite"}]])))
      (dds/container
       (dds/section {:title (:deploy-title t) :id "deploy"}
        (into
         [:div {:class "dds-ext-grid kc-steps" :style {:--dds-ext-grid-min "13rem"}}]
         (map (fn [[title body]]
                (dds/card [:article {:class "kc-step"}
                           (dds/heading 3 title {:size "20"})
                           [:p body]]))
              (:steps t)))
        (code-block/block locale "kotoba research --scope <approved-scope> --task code-review\n# requests are admitted by Kotoba Cloud before inference"))
       (dds/section {:title (:boundary-title t) :id "trust"}
        (dds/card
         [:article {:class "kc-boundary"}
          (dds/heading 3 (:boundary-heading t) {:size "24"})
          [:p (:boundary-p1 t)]
          [:p (:boundary-p2 t)]
          (dds/row
           (dds/button (:profile-link t) {:type :text :size "md"
                                          :href "/.well-known/kotoba-cloud.json"})
           (dds/button (:spec-link t) {:type :text :size "md"
                                       :href "https://kotoba-lang.org"}))])))]
     (site-footer t)]))

(defn- resource-read
  "Read a classpath resource the JVM-free way. The kbb engine clones nbb.edn
  git deps into .nbb/.cache/<hash>/nbb-deps/, so a resource is found by scanning
  those cache roots. First match wins; missing resource throws."
  [resource-path]
  (let [cache (node-path/join (js/process.cwd) ".nbb" ".cache")
        roots (try (js->clj (fs/readdirSync cache)) (catch :default _ []))
        hits (for [root roots
                   :let [p (node-path/join cache root "nbb-deps" resource-path)]
                   :when (fs/existsSync p)]
               p)]
    (if-let [first-hit (first hits)]
      (str (fs/readFileSync first-hit "utf8"))
      (throw (ex-info (str "resource-not-found: " resource-path) {})))))

(defn- css-for-extras
  [components]
  (str/join "\n"
            (map resource-read (map dcss/component-path (dcss/extra-components components)))))

(defn document-css []
  (str (resource-read "jp_go_dds/dds.css")
       "\n" (css-for-extras [:language-selector :menu-list-box :menu-list :breadcrumb :step-navigation])))

(defn variant-url
  "The absolute URL of one locale variant of a locale-free route: English
  is the route itself (what a cookie-less crawler receives there); every
  other locale is `<route>?lang=<locale>`, which the Worker serves directly
  as that variant. Each variant is self-canonical so hreflang alternates
  stay valid without a /<locale>/ path fork."
  [path loc]
  (let [home (console/surface-of path)]
    (str (get-in console/surfaces [home :origin]) (console/href-for home path)
         (when-not (= loc :en) (language-href loc)))))

(defn document-head
     [locale path-key title description]
     (let [t (translation locale)
           path (path-key t)
           self (variant-url path locale)
           ja-href (variant-url path :ja)
           en-href (variant-url path :en)]
       (into (vec (for [loc supported-locales
                         :when (and (= path-key :path) (not (#{:en :ja} loc)))]
                     [:link {:rel "alternate" :hreflang (name loc)
                             :href (variant-url path loc)}]))
       [[:link {:rel "canonical" :href self}]
        [:script {:src "https://freebuff.com/freebuff-tag.js" :async true}]
        [:script "window.freebuff=window.freebuff||function(){(window.freebuff.q=window.freebuff.q||[]).push(arguments)}"]
        [:script {:src "/js/language-selector.js" :defer true}]
        [:script {:src "/js/shell.js" :defer true}]
        [:script {:src "/js/code.js" :defer true}]
        [:script {:src "/js/session.js" :defer true}]
        [:link {:rel "alternate" :hreflang "ja" :href ja-href}]
        [:link {:rel "alternate" :hreflang "en" :href en-href}]
        [:link {:rel "alternate" :hreflang "x-default" :href en-href}]
        [:link {:rel "alternate" :type "text/markdown" :href "https://kotoba.cloud/agent-quickstart.md" :title "AI agent quickstart"}]
        [:meta {:property "og:site_name" :content "Kotoba Cloud"}]
        [:meta {:name "twitter:card" :content "summary"}]
        [:meta {:name "twitter:title" :content title}]
        [:meta {:name "twitter:description" :content description}]
        [:script {:type "application/ld+json"}
         (str "{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://kotoba.cloud/#website\",\"url\":\"https://kotoba.cloud/\",\"name\":\"Kotoba Cloud\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Kotoba Labs Inc.\"},\"inLanguage\":["
              (apply str (interpose "," (map #(str "\"" (name %) "\"") supported-locales)))
              "]}")]
        [:meta {:property "og:type" :content "website"}]
        [:meta {:property "og:title" :content title}]
        [:meta {:property "og:description" :content description}]
        [:meta {:property "og:locale" :content (:og-locale t)}]
        [:meta {:property "og:url" :content self}]])))

(defn mark-english-fallback
  "Keep assistive technology honest for technical copy awaiting translation."
  [locale node]
  (let [catalog (get extended/copy locale)
        translated (set (vals (get locales/copy locale)))]
    (letfn [(walk [x]
              (cond
                (string? x) (if-let [localized (get catalog x)]
                              (if (= localized x) [:span {:lang "en" :dir "ltr"} x] localized)
                              (if (or (translated x) (not (re-find #"[A-Za-z]" x)))
                              x [:span {:lang "en" :dir "ltr"} x]))
                (and (vector? x) (keyword? (first x)))
                (let [[tag & more] x
                      attrs (when (map? (first more)) (first more))
                      children (if attrs (rest more) more)]
                  (if (or (:lang attrs) (#{:script :style :pre :code} tag))
                    (if (#{:pre :code} tag)
                      (into [tag (assoc (or attrs {}) :dir "ltr")] children) x)
                    (into (if attrs [tag attrs] [tag]) (map walk children))))
                (sequential? x) (map walk x)
                :else x))]
      (walk node))))

(defn- console-body
  "A console body authored in ja / en, placed in a document of `locale`: the
   body itself for :ja and :en, wrapped in lang=en for every other public
   locale so assistive tech reads it in the right language (the shell
   around it is in the document's locale)."
  [locale body]
  (if (contains? #{:ja :en} locale) body [:div {:lang "en"} body]))

(defn- body-locale [locale] (if (= locale :ja) :ja :en))

(defn view [locale]
  (let [t (translation locale)]
    [[:a {:class "kc-skip dads-button" :href "#main"} (:skip t)]
     ;; console shell: fixed left nav (Get started first), header
     ;; on top, and the research chat as one panel — not the landing hero.
     (site-header locale t {:nav false})
     [:div {:id "kc-app-main"}
      (chat-site/view locale (passkey-href locale))]
     ;; after the main surface: content first in reading order on every
     ;; band (the nav is fixed left on desktop, a chip row on top below 64rem)
     ;; the landing is the chat, which is not a nav destination: no item is current
     (app-sidebar locale t nil)
     (knowledge-site/view locale)
     [:div {:id "security-view" :hidden true}
      (console-body locale (security-site/view (body-locale locale) true))]
     [:span {:id "kc-session-labels" :hidden true
             :data-signed-in-action (:signed-in-action t)
             :data-signed-in-status (:signed-in-status t)
             :data-signed-in-href kotobase-connect-href}]]))

(defn- walk-hiccup
  "postwalk for hiccup: vectors, seqs and attribute maps. clojure.walk is
   not on every engine this file renders under; the shape here is closed
   (html.core's input), so a 12-line walk is enough."
  [f node]
  (cond
    (map? node) (f (into {} (map (fn [[k v]] [k (walk-hiccup f v)]) node)))
    (vector? node) (f (into [] (map #(walk-hiccup f %) node)))
    (seq? node) (f (doall (map #(walk-hiccup f %) node)))
    :else (f node)))

(defn surface-hrefs
  "Resolve every href / src-less link attribute of a document for the
   surface it is emitted on (console/href-for): on the apex, /docs/… becomes
   https://docs.kotoba.cloud/…; on the docs host, /docs/… loses its prefix
   and every other apex path becomes absolute. One walk over the whole page
   (sidebar, top bar, footer, body) so no link generator needs to know the
   host. Shared assets (/css/ /js/ /assets/) stay host-relative on both."
  [surface page]
  (walk-hiccup (fn [node]
                 (if (and (map? node) (string? (:href node)))
                   (update node :href #(console/href-for surface %))
                   node))
               page))

(defn ->page
  "page/->page with the surface walk: every document this file renders
   directly (apex landing, legal, 404) links the docs host absolutely."
  [opts & body]
  (str "<!DOCTYPE html>\n"
       (html/->html (surface-hrefs :apex (apply page/page opts body)))))

(defn page-html
     ([] (page-html :en))
     ([locale] (page-html locale view))
     ([locale view-fn]
      (let [t (translation locale)]
        (str/replace
         (apply ->page
               {:title (:title t)
                :description (:description t)
                :lang (:html-lang t)
                :css (document-css)
                :dark? true
                ;; the landing inlines its CSS (no /css/site.css link): the
                ;; sidebar's account entry needs shell/css here too — the
                ;; audit's :chrome-layers named it (24 apex variants at 0)
                :app-css (str theme-toggle/css tokens/skin-css app-css app-sidebar-css shell/css research-site/css chat-site/css knowledge-site/css tokens/bridge-css security-site/css csf2-site/css crypto-site/css compliance-site/css enforcement-site/css security-site/css)
                :head (into [[:script {:src "/js/theme.js"}]] (document-head locale :path (:title t) (:description t)))}
               (if (get locales/copy locale)
                 (mark-english-fallback locale (view-fn locale))
                 (view-fn locale)))
         (str "<html lang=\"" (:html-lang t) "\">")
         (str "<html lang=\"" (:html-lang t) "\" dir=\"" (locales/direction locale) "\">")))))

(def site-css-cache
  ;; One cacheable stylesheet per render: the union of every stylesheet the
  ;; site pages can inline. Pages reference it via <link> instead of carrying
  ;; ~110KB of inline CSS per document — the browser fetches it once and
  ;; reuses it across pages, and first paint/hydration no longer waits on a
  ;; 110KB style parse.
  (atom nil))

(def site-css-link
  "Shared <link> head entries for the emitted site stylesheet."
  [[:link {:rel "stylesheet" :href "/css/site.css"}]])

(defn site-css
  "The one shared stylesheet /css/site.css: document-css + every stylesheet
   a site-layout page can carry. One function so the render, the UI/UX audit
   (scripts/uiux-audit.cljk, uiux_audit_test) and any future consumer read
   the same bytes."
  []
  (str (document-css) "\n"
       ;; upstream → ext (page inlines it) → dark → app: the inversion layer
       ;; before every app rule so an app override stays last (page.cljk)
       (dark/dark-css (document-css)) "\n"
       theme-toggle/css "\n"
       tokens/skin-css "\n" app-css "\n" app-sidebar-css "\n"
       research-site/css "\n" chat-site/css "\n"
       knowledge-site/css "\n" tokens/bridge-css "\n"
       security-site/css "\n" csf2-site/css "\n"
       crypto-site/css "\n" compliance-site/css "\n" enforcement-site/css "\n"
       vc-site/css "\n"
       blog-site/css "\n"
       dds-console/css "\n" shell/css "\n" code/css "\n" account-site/css "\n"
       secure-site/css "\n" models-site/css "\n" billing-site/css "\n"
       apps-site/css "\n" docs-site/css "\n" orgbrain-site/css "\n"
       security-services-site/css))

(defn site-layout
  "ONE shared page shell for every kotoba.cloud document: header/nav +
  <main id=\"main\"> + footer. With :sidebar? the orca-style left nav
  (app-sidebar) replaces the marketing nav and the body is offset into the
  remaining column — the same shell the app surface uses, so /account,
  /apps, /docs, /security/aup all share one navigation. Layering:
  jp-go-dds owns tokens/parts; cloud-kotoba-dds owns the app-shell /
  navigation / account-entry PATTERNS (kc-* classes are this repo's
  implementation); shinkansen (CID-published documents) is the planned
  delivery successor — keep emitted documents self-contained (no NEW
  external assets)."
  [{:keys [title description lang robots extra-css sidebar? current locale surface]
    :or {surface :apex}} body]
  ;; page/page is the hiccup; the surface walk runs BEFORE rendering. The
  ;; document language follows the locale (its catalog html-lang) unless a
  ;; caller names one; a right-to-left locale gets dir="rtl" on <html>
  ;; exactly as page-html does for the landing (the shell's inline-start /
  ;; inline-end rules follow it).
  (let [lang (or lang (if locale (:html-lang (translation locale)) "ja"))]
  (cond-> (str "<!DOCTYPE html>\n"
   (html/->html
    (surface-hrefs surface
     (page/page
   {:title title
    :description description
    :lang lang
    :css ""
    :app-css ""
    ;; dark: the inversion layer lives in /css/site.css (site-css); page
    ;; derives the color-scheme / theme-color pair from :dark-source and
    ;; does not inline a second copy. theme.js runs in <head> before paint
    ;; (jp-go-dds.theme-toggle/script) — external, because script-src is
    ;; 'self' with no 'unsafe-inline' (csp.cljk).
    :dark? true :dark-source (document-css) :dark-inline? false
    :head (-> (if robots [[:meta {:name "robots" :content robots}]] [])
              (into [[:script {:src "/js/theme.js"}]])
              (into site-css-link)
              (into [[:script {:src "https://freebuff.com/freebuff-tag.js" :async true}]
                     [:script "window.freebuff=window.freebuff||function(){(window.freebuff.q=window.freebuff.q||[]).push(arguments)}"]
                     [:script {:src "/js/language-selector.js" :defer true}]
                     [:script {:src "/js/shell.js" :defer true}]
                     [:script {:src "/js/code.js" :defer true}]
                     [:script {:src "/js/session.js" :defer true}]])
              ;; the surface the document is emitted on: shell-browser
              ;; prefixes the hrefs it sets at runtime (setup chip /
              ;; banner) with the apex origin on another host
              (into (when (= surface :docs)
                      [[:meta {:name "kc-apex" :content (get-in console/surfaces [:apex :origin])}]])))}
   (let [locale (or locale :ja)
         t (translation locale)]
     (if sidebar?
       ;; content first: the sidebar nav is emitted after <main> (fixed to
       ;; the left on desktop, a chip row on top below 64rem) so the reading
       ;; order is the page, then the navigation — shinkansen.audit
       ;; :nav-before-content. The skip link still leads to #main for the
       ;; keyboard user who lands on the nav via the landmark. The top bar
       ;; and the setup banner are the console chrome the reference IA has;
       ;; both chips hydrate from the session (shell-browser).
       (list [:a {:class "kc-skip dads-button" :data-type "outline" :data-size "sm" :href "#main"} (:skip t)]
             [:main {:id "main" :class "kc-sb-main"}
              (console-topbar locale current)
              (setup-banner locale)
              body]
             (app-sidebar locale t (or current "/docs/reference/quickstart/")))
       (list [:a {:class "kc-skip dads-button" :data-type "outline" :data-size "sm" :href "#main"} (:skip t)]
             (site-header locale t)
             [:main {:id "main"} body])))
   (site-footer (translation (or locale :ja)))))))
    (and locale (locales/rtl-locales locale))
    (str/replace (str "<html lang=\"" lang "\">")
                 (str "<html lang=\"" lang "\" dir=\"rtl\">")))))

