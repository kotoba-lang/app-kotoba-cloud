(defn identity-html
  "Identity route is Stripe-Identity-only. The first-party browser capture
   console (identity-site / identity-browser / identity-gateway) stays in
   the repo as a tested component but is not rendered or linked today.
   One document per public locale (copy ja / en)."
  ([] (identity-html :ja))
  ([locale]
   (let [t (translation locale) ja? (= locale :ja)
         txt (fn [ja en] (if ja? ja en))]
     (site-layout {:title (txt "本人確認 — Kotoba Cloud" "Identity verification — Kotoba Cloud")
                   :lang (:html-lang t) :locale locale
                   :robots "noindex"
                   :extra-css research-site/css}
      (console-body locale
       (dds/container
        (dds/heading 1 (txt "本人確認は Stripe Identity 経路のみ" "Identity verification runs through Stripe Identity only") {:size "36"})
        [:p (txt "kotoba.cloud の本人確認は Stripe Identity（verify.stripe.com）のみを提供しています。書類と顔写真は Stripe にのみ送られ、kotoba.cloud は本人確認の状態・有効期限・証跡参照のみを保持します。"
                 "kotoba.cloud verifies identity through Stripe Identity (verify.stripe.com) only. Documents and the face image go to Stripe alone; kotoba.cloud keeps the verification status, its expiry and evidence references.")]
        [:p (txt "自社ブラウザ撮影・担当者審査による本人確認コンソールはコンポーネントとして整備・保管されていますが、現在は公開・受付していません。"
                 "A first-party console (browser capture, operator review) is maintained as a tested component but is not published or accepting requests today.")]
        (dds/row (dds/button (txt "研究者登録（Stripe Identity）" "Researcher registration (Stripe Identity)") {:href "https://kotoba.cloud/ekyc.md" :type :solid-fill})
                 (dds/button (txt "登録ガイド" "Registration guide") {:href "https://kotoba.cloud/llms.txt" :type :outline}))))))))

(defn account-html
  "Account console: session, identity verification, research eligibility,
   scopes, organizations and billing; client logic lives in account-browser.
   One document per public locale: the shell (top bar, sidebar, language
   selector) in that locale, the console body in Japanese for :ja and in
   English otherwise (account-site/section). /account is negotiated like
   every other variant root (locale/variant-roots): cookie, ?lang=,
   Accept-Language."
  ([] (account-html :ja))
  ([locale]
   (let [t (translation locale) ja? (= locale :ja)]
     (site-layout {:title (if ja? "アカウント管理 — Kotoba Cloud" "Account — Kotoba Cloud")
                   :lang (:html-lang t)
                   :locale locale
                   :robots "noindex"
                   :sidebar? true :current "/account"
                   :extra-css (str account-site/css dds-console/css)}
      ;; a non-ja, non-en shell carries an English body: say so on the
      ;; region so assistive tech reads it in the right language
      (if (contains? #{:ja :en} locale)
        (account-site/section locale)
        [:div {:lang "en"} (account-site/section locale)])))))

