(defn blog-posts []
  "Authored articles from assets/blog/posts.edn, newest date first."
  (let [posts (reader/read-string
               (str (fs/readFileSync (node-path/join "assets" "blog" "posts.edn") "utf8")))]
    (vec (reverse (sort-by :date posts)))))

(defn blog-locale-catalog
  "Locales addressable for the blog: English (canonical), Japanese, plus
   every locale that any post carries a real :i18n translation for."
  [posts]
  (distinct (concat [:en :ja] (mapcat (comp keys :i18n) posts))))

