(ns app-kotoba-cloud.account-browser
  "Client for the /account console. Reads /v1/session, /v1/research/ekyc/status,
  /v1/research/status and /v1/billing/status; every state maps to one action."
  (:require [clojure.string :as str]))

(defn el [id] (.getElementById js/document id))
(defn ja? [] (= "ja" (.-lang (.-documentElement js/document))))
(defn t [ja en] (if (ja?) ja en))
(defn say! [id s] (when-let [x (el id)] (set! (.-textContent x) s)))
(defn state! [id kind]
  (when-let [x (el id)]
    (.setAttribute x "data-state" (name kind))
    ;; loading/error/empty get their default text from the console pattern;
    ;; only :value/:ok callers pass explicit text afterwards via say!.
    (set! (.-textContent x)
          (case kind
            :loading "読み込んでいます…"
            :error "読み込めませんでした。更新してください。"
            :empty "—"
            (.-textContent x)))))
(defn show! [id] (when-let [x (el id)] (set! (.-hidden x) false)))
(defn hide! [id] (when-let [x (el id)] (set! (.-hidden x) true)))
(defn abbreviate [v]
  (if (and (string? v) (> (count v) 24)) (str (subs v 0 12) "…" (subs v (- (count v) 8))) (or v "—")))

(defn api
  ([path] (api path nil))
  ([path body]
   (-> (js/fetch path (clj->js (cond-> {:method (if body "POST" "GET") :credentials "same-origin"}
                                 body (assoc :headers {"content-type" "application/json"} :body (js/JSON.stringify (clj->js body))))))
       (.then (fn [r] (-> (.json r) (.then #(assoc (js->clj % :keywordize-keys true) :httpOk (.-ok r))))))
       (.catch (fn [_] {:httpOk false})))))

(def reason-label
  {"verification-required" (t "本人確認が未完了です。上の「本人確認」から開始してください。" "Identity verification is incomplete. Start it in 本人確認 above.")
   "verification-expired" (t "本人確認の有効期限が切れました。再確認してください。" "Identity verification has expired. Re-verify.")
   "trust-route-required" (t "有効な信頼経路がありません。本人確認をやり直してください。" "No current trust route. Restart verification.")
   "screening-expired" (t "AML/CTF 照合の有効期限が切れました。再審査をお待ちください。" "AML/CTF screening has expired. Re-review is required.")
   "review-required" (t "審査中、または追加確認が必要です。" "Under review or additional checks required.")
   "policy-acceptance-required" (t "利用規約の再同意が必要です。" "Policy re-acceptance required.")
   "session-reverification-required" (t "セッションの再確認が必要です。再読み込みしてください。" "Session reverification required. Reload this page.")
   "identity-mismatch" (t "記録された principal と一致しません。サポートに連絡してください。" "Principal mismatch. Contact support.")
   "eligible" (t "利用資格があります。無料枠で研究できます。" "Eligible. Your free allowance is available.")})

(defn render-session
  "The one status line of the document, then exactly one of the two hidden
  blocks is revealed: the signed-out action or the console body. A failed
  /v1/session read is an error, not a signed-out state (say so, offer retry)."
  [payload]
  (cond
    (and payload (:valid payload))
    (do (state! "account-session-status" :ok)
        (say! "account-session-status" (t (str "サインイン済み: @" (:username payload))
                                          (str "Signed in as @" (:username payload))))
        (state! "account-username" :value)
        (say! "account-username" (str "@" (:username payload)))
        (state! "account-principal" :value)
        (say! "account-principal" (abbreviate (:principalId payload)))
        (hide! "account-signed-out")
        (show! "account-console-body")
        (show! "account-refresh-slot")
        true)

    (and payload (:httpOk payload))
    (do (state! "account-session-status" :empty)
        (say! "account-session-status" (t "サインインしていません。" "Not signed in."))
        (hide! "account-console-body")
        (hide! "account-refresh-slot")
        (show! "account-signed-out")
        false)

    :else
    (do (state! "account-session-status" :error)
        (say! "account-session-status" (t "サインイン状態を確認できませんでした。更新してください。"
                                          "Could not check the sign-in state. Refresh."))
        (hide! "account-console-body")
        (hide! "account-signed-out")
        (show! "account-refresh-slot")
        false)))

(defn card-return
  "Where Stripe Checkout sent the person back to: the authority's setup
  session carries success_url ?card=done and cancel_url ?card=cancelled on
  this document. nil when the page was opened directly."
  []
  (let [v (.get (js/URLSearchParams. (.-search js/location)) "card")]
    (when (contains? #{"done" "cancelled"} v) v)))

(defn render-ekyc [r]
  (let [status (cond
                 (not (:httpOk r)) "unavailable"
                 (= "verified" (:status r)) "verified"
                 (= "missing" (:status r)) "missing"
                 :else "pending")]
    (case status
      "verified" (do (state! "account-ekyc-state" :ok)
                     (say! "account-ekyc-state" (t "確認済み" "Verified"))
                     (say! "account-ekyc-note" (t "本人確認は完了しています。" "Verification is complete."))
                     ;; nothing left to do here — hide the action, never grey it
                     (when-let [b (el "account-ekyc-start")] (set! (.-hidden b) true)))
      "pending" (do (state! "account-ekyc-state" :action)
                    (say! "account-ekyc-state" (t "確認中" "Pending"))
                    (say! "account-ekyc-note"
                          (case (card-return)
                            ;; back from checkout.stripe.com: the webhook approves
                            ;; within seconds; the refresh button re-reads status
                            "done" (t "カード登録を受け付けました。Stripe からの通知が届くと自動承認されます（通常は数秒）。「状態を更新」で確認できます。"
                                      "Card received. Approval follows Stripe's notification, usually within seconds. Use 状態を更新 to re-check.")
                            "cancelled" (t "カード登録を中断しました。下のボタンから再開できます。"
                                           "Card entry was cancelled. Resume below.")
                            (t "Stripe での確認が完了すると自動承認されます。この画面で状態が変わります。カード登録を中断した場合は下のボタンから再開できます。" "Approval happens automatically when Stripe completes. Refresh this page to see the change. If you left the card entry midway, resume below.")))
                    ;; A pending challenge means a setup session may still be
                    ;; open — re-running start mints a fresh one (or verifies
                    ;; inline once the card is on file), so keep the button
                    ;; enabled as the resume affordance.
                    (when-let [b (el "account-ekyc-start")]
                      (set! (.-hidden b) false)
                      (set! (.-disabled b) false)
                      (set! (.-textContent b) (t "カードを登録・再開" "Add or resume card"))))
      "missing" (do (state! "account-ekyc-state" :action)
                    (say! "account-ekyc-state" (t "未確認" "Not verified"))
                    (when-let [b (el "account-ekyc-start")] (set! (.-hidden b) false) (set! (.-disabled b) false))
                    (say! "account-ekyc-note" (t "開始すると Stripe の確認画面へ移動します（カード未登録なら checkout.stripe.com でカード登録、書類確認は verify.stripe.com）。" "Starting moves you to the Stripe check (card setup at checkout.stripe.com when no card is on file, documents at verify.stripe.com).")))
      (do (state! "account-ekyc-state" :error)
          (say! "account-ekyc-state" (t "確認不可" "Unavailable"))
          ;; the reason sits beside the greyed button
          (when-let [b (el "account-ekyc-start")] (set! (.-hidden b) false) (set! (.-disabled b) true))
          (say! "account-ekyc-note" (t "本人確認サービスに接続できません。時間をおいて更新してください。" "Verification service is unavailable. Refresh later."))))))

(defn render-eligibility [r]
  (let [status (:status r) reason (:reason r)]
    (if (and (:httpOk r) (= "eligible" status))
      (do (state! "account-eligibility-state" :ok)
          (say! "account-eligibility-state" (t "利用可能" "Eligible"))
          (say! "account-eligibility-note" (get reason-label "eligible")))
      (do (state! "account-eligibility-state" :action)
          (say! "account-eligibility-state" (t "保留" "Pending"))
          (say! "account-eligibility-note" (get reason-label (or reason "review-required")))))
    (if-let [ft (:freeTier r)]
      (do (state! "account-free-tier" :value)
          (say! "account-free-tier"
                (t (str (:requestsPerDay ft) " 件/日 · 出力最大 " (:maxOutputTokens ft) " tokens")
                   (str (:requestsPerDay ft) " req/day · up to " (:maxOutputTokens ft) " output tokens"))))
      (state! "account-free-tier" (if (:httpOk r) :empty :error)))))

(defn render-scopes [scopes]
  (let [host (el "account-scopes")]
    (when host
      (.replaceChildren host)
      (if (empty? scopes)
        (let [p (.createElement js/document "p")]
          (set! (.-className p) "ck-console__note")
          (set! (.-textContent p) (t "承認済みスコープはまだありません。研究者登録後に申請してください。" "No approved scopes yet. Apply after researcher registration."))
          (.append host p))
        (doseq [s scopes]
          (let [row (.createElement js/document "div")]
            (set! (.-className row) "ck-console__row")
            (set! (.-textContent row)
                  (str (:id s) " · " (:status s) " · " (str/join ", " (:tasks s))))
            (.append host row)))))))

(defn render-billing [r]
  (state! "account-billing-state" (if (:httpOk r) :value :error))
  (say! "account-billing-state"
        (cond
          (not (:httpOk r)) (t "請求サービスに接続できません。" "Billing service unavailable.")
          (:checkoutEnabled r) (t "有料枠の購入・管理は料金ページから行えます。" "Purchases and management are on the plans page.")
          :else (t "請求は検証中です。まだ購入できません。" "Billing is in validation. Purchases are not available yet."))))

(defn render-team [r]
  (let [host (el "account-team")]
    (when host
      (.replaceChildren host)
      (if (and (:httpOk r) (seq (:organizations r)))
        (doseq [o (:organizations r)]
          (let [row (.createElement js/document "div")]
            (set! (.-className row) "ck-console__row")
            (set! (.-textContent row)
                  (str (:handle o) " · role " (:role o) " · " (str/join ", " (or (:memberRoles o) []))))
            (.append host row)))
        (let [p (.createElement js/document "p")]
          (set! (.-className p) "ck-console__note")
          (set! (.-textContent p)
                (t "チームはありません。組織を作成すると owner ロールが付与され、メンバーを招待できます。"
                   "No team yet. Create an organization to become owner and invite members."))
          (.append host p))))))

(defn render-orgs [r]
  (let [host (el "account-orgs")]
    (when host
      (.replaceChildren host)
      (if (and (:httpOk r) (seq (:organizations r)))
        (doseq [o (:organizations r)]
          (let [row (.createElement js/document "div")]
            (set! (.-className row) "ck-console__row")
            (set! (.-textContent row)
                  (str (:handle o) " · " (:role o) " · " (:status o) " · " (:orgDid o)))
            (.append host row)))
        (let [p (.createElement js/document "p")]
          (set! (.-className p) "ck-console__note")
          (set! (.-textContent p)
                (t "所属する組織はまだありません。ハンドルを入力して作成してください。"
                   "No organizations yet. Enter a handle to create one."))
          (.append host p))))))

(declare refresh!)

;; ── linked identities (Google / GitHub) ─────────────────────────────────────

(defn- provider-label [p] (case p "google" "Google" "github" "GitHub" p))

(defn render-linked
  "Rows of Google / GitHub links from the identity ledger, each with an
  unlink action. Passkeys / wallets are ways in and are not listed here."
  [r]
  (let [host (el "account-linked")
        rows (filter #(and (contains? #{"google" "github"} (:provider %)) (nil? (:revokedAt %)))
                     (:identities r))]
    (when host
      (.replaceChildren host)
      (cond
        (not (:httpOk r))
        (let [p (.createElement js/document "p")]
          (set! (.-className p) "ck-console__note")
          (set! (.-textContent p) (t "連携状態を読み込めませんでした。" "Could not read linked accounts."))
          (.append host p))
        (empty? rows)
        (let [p (.createElement js/document "p")]
          (set! (.-className p) "ck-console__note")
          (set! (.-textContent p) (t "連携アカウントはありません。" "No linked accounts."))
          (.append host p))
        :else
        (doseq [row rows]
          (let [div (.createElement js/document "div")
                text (.createElement js/document "span")
                btn (.createElement js/document "button")]
            (set! (.-className div) "ck-console__row")
            (set! (.-textContent text)
                  (str (provider-label (:provider row)) " · " (or (:email row) (:name row) (abbreviate (:subject row)))))
            (set! (.-className btn) "dads-button")
            (.setAttribute btn "data-type" "text")
            (.setAttribute btn "data-size" "sm")
            (set! (.-type btn) "button")
            (set! (.-textContent btn) (t "解除" "Unlink"))
            (.addEventListener btn "click"
                               (fn [_]
                                 (set! (.-disabled btn) true)
                                 (-> (api "/v1/account/identities/revoke" {:provider (:provider row) :subject (:subject row)})
                                     (.then (fn [x]
                                              (say! "account-linked-note"
                                                    (if (:httpOk x)
                                                      (t "解除しました。" "Unlinked.")
                                                      (case (get-in x [:error :code])
                                                        "reauthentication-required" (t "解除するには、サインインし直してから操作してください。" "Sign in again before unlinking.")
                                                        (t "解除できませんでした。" "Could not unlink."))))
                                              (refresh!))))))
            (.append div text btn)
            (.append host div)))))))

(defn render-link-outcome!
  "The apex is returned to with ?linked=<provider> or ?link_error=<code>
  after auth.kotoba.cloud's link callback."
  []
  (let [params (.-searchParams (js/URL. (.-href js/location)))
        linked (.get params "linked")
        err (.get params "link_error")]
    (cond
      linked (say! "account-linked-note" (t (str (provider-label linked) " を連携しました。")
                                            (str (provider-label linked) " linked.")))
      err (say! "account-linked-note"
                (case err
                  "identity-linked-to-another-account"
                  (t "この Google / GitHub アカウントは別の Kotoba アカウントに連携済みです。" "That Google/GitHub account is already linked to another Kotoba account.")
                  (t (str "連携できませんでした: " err) (str "Could not link: " err)))))))

;; ── organization SSO ────────────────────────────────────────────────────────

(def ^:private sso-orgs (atom []))

(defn- parse-role-map [s]
  (into {} (for [pair (str/split (or s "") #",") :let [pair (str/trim pair)] :when (seq pair)
                 :let [[g r] (map str/trim (str/split pair #"=" 2))] :when (and (seq g) (seq r))]
             [g r])))

(defn- parse-domains [s]
  (vec (for [d (str/split (or s "") #",") :let [d (str/trim d)] :when (seq d)] d)))

(defn- selected-org []
  (some-> (el "account-sso-org") .-value))

(defn- fill-sso-form! [status]
  (let [sso (:sso status) policy (:policy status)]
    (when-let [x (el "account-sso-issuer")] (set! (.-value x) (or (:issuer sso) "")))
    (when-let [x (el "account-sso-max-age")] (set! (.-value x) (str (or (:maxAgeHours sso) ""))))
    (when-let [x (el "account-sso-enforce")] (set! (.-checked x) (boolean (or (:enforce sso) (:enforce policy)))))))

(defn render-sso-status [status]
  (let [gate (get-in status [:sso :gate])
        assertion (get-in status [:sso :assertion])]
    (state! "account-org-sso-state" :value)
    (say! "account-org-sso-state"
          (cond
            (not (:httpOk status)) (t "読み込めませんでした。" "Could not load.")
            (not (get-in status [:sso :configured]))
            (if (:eligible status)
              (t (str (:plan status) " プラン · 未設定") (str (:plan status) " plan · not configured"))
              (t (str "プラン: " (or (:plan status) "free") " · Team / Enterprise で利用できます")
                 (str "Plan: " (or (:plan status) "free") " · available on Team / Enterprise")))
            :else
            (str (t "設定済み" "Configured") " · " (get-in status [:sso :issuer])
                 " · " (if (get-in status [:sso :enforce]) (t "必須" "enforced") (t "任意" "optional"))
                 " · " (case gate
                         "open" (if assertion (t "認証済み" "asserted") (t "認証は任意" "not required"))
                         "sso-assertion-required" (t "IdP での認証が必要" "IdP assertion required")
                         "sso-assertion-expired" (t "IdP の再認証が必要" "IdP re-assertion required")
                         (or gate "")))))
    (if (:canConfigure status) (show! "account-org-sso-admin") (hide! "account-org-sso-admin"))
    (if (and (get-in status [:sso :configured]) (not= "open" gate))
      (show! "account-org-sso-member")
      (if (get-in status [:sso :configured]) (show! "account-org-sso-member") (hide! "account-org-sso-member")))
    (fill-sso-form! status)))

(defn load-sso-status! []
  (when-let [handle (selected-org)]
    (state! "account-org-sso-state" :loading)
    (-> (api (str "/v1/org/sso/status?org=" (js/encodeURIComponent handle)))
        (.then render-sso-status))))

(defn render-sso-orgs
  "Populate the org selector from /v1/org/status, then load the selected
  org's SSO standing. Without an org the panel says so and offers nothing."
  [r]
  (let [orgs (filter #(= "active" (:status %)) (:organizations r))
        sel (el "account-sso-org")]
    (reset! sso-orgs (vec orgs))
    (when sel
      (.replaceChildren sel)
      (doseq [o orgs]
        (let [opt (.createElement js/document "option")]
          (set! (.-value opt) (:handle o))
          (set! (.-textContent opt) (str (:handle o) " · " (:role o)))
          (.append sel opt)))
      (let [wanted (.get (.-searchParams (js/URL. (.-href js/location))) "sso")]
        (when (and wanted (some #(= wanted (:handle %)) orgs)) (set! (.-value sel) wanted))))
    (if (empty? orgs)
      ;; a known fact ("no organization yet") is a :value, not :empty —
      ;; :empty is "nothing said yet" and the browser arm refuses a cell
      ;; left there after hydration (test/account-browser.cljk)
      (do (state! "account-org-sso-state" :value)
          (say! "account-org-sso-state" (t "組織を作成すると設定できます。" "Create an organization first."))
          (hide! "account-org-sso-admin") (hide! "account-org-sso-member"))
      (load-sso-status!))))

(defn save-sso! []
  (when-let [b (el "account-sso-save")]
    (let [handle (selected-org)]
      (set! (.-disabled b) true)
      (say! "account-org-sso-note" (t "IdP を確認しています…" "Checking the identity provider…"))
      (-> (api "/v1/org/sso/configure"
               {:handle handle
                :issuer (.-value (el "account-sso-issuer"))
                :clientId (.-value (el "account-sso-client-id"))
                :clientSecret (.-value (el "account-sso-client-secret"))
                :domains (parse-domains (.-value (el "account-sso-domains")))
                :roleMap (parse-role-map (.-value (el "account-sso-role-map")))
                :maxAgeHours (let [v (js/parseInt (.-value (el "account-sso-max-age")) 10)] (if (js/isNaN v) 12 v))
                :enforce (.-checked (el "account-sso-enforce"))})
          (.then (fn [r]
                   (set! (.-disabled b) false)
                   (when-let [x (el "account-sso-client-secret")] (set! (.-value x) ""))
                   (say! "account-org-sso-note"
                         (if (:httpOk r)
                           (t "保存しました。メンバーは「組織の IdP で認証する」から認証できます。" "Saved. Members can now assert with the organization's IdP.")
                           (case (get-in r [:error :code])
                             "org-plan-not-eligible" (t "Team / Enterprise プランが必要です。" "A Team or Enterprise plan is required.")
                             "org-role-insufficient" (t "owner または admin だけが設定できます。" "Only an owner or admin can configure this.")
                             "org-sso-entitlement-not-configured" (t "この環境では組織 SSO がまだ有効化されていません。" "Organization SSO is not enabled in this environment yet.")
                             "connection is not usable" (t (str "設定を確認してください: " (get-in r [:error :detail])) (str "Check the settings: " (get-in r [:error :detail])))
                             (t (str "保存できませんでした: " (get-in r [:error :code])) (str "Could not save: " (get-in r [:error :code]))))))
                   (load-sso-status!)))))))

(defn remove-sso! []
  (when-let [b (el "account-sso-remove")]
    (set! (.-disabled b) true)
    (-> (api "/v1/org/sso/remove" {:handle (selected-org)})
        (.then (fn [r]
                 (set! (.-disabled b) false)
                 (say! "account-org-sso-note" (if (:httpOk r) (t "削除しました。" "Removed.") (t "削除できませんでした。" "Could not remove.")))
                 (load-sso-status!))))))

(defn sync-sso!
  "Back from the IdP (?sso=<org>): provision the membership the fresh
  assertion implies, then show the standing."
  []
  (let [handle (.get (.-searchParams (js/URL. (.-href js/location))) "sso")]
    (when (and handle (some #(= handle (:handle %)) @sso-orgs))
      (-> (api "/v1/org/sso/sync" {:handle handle})
          (.then (fn [r]
                   (say! "account-org-sso-note"
                         (if (:httpOk r)
                           (t (str "IdP の認証を確認しました" (when (get-in r [:member :role]) (str " · ロール " (get-in r [:member :role]))))
                              (str "IdP assertion confirmed" (when (get-in r [:member :role]) (str " · role " (get-in r [:member :role])))))
                           (t (str "同期できませんでした: " (get-in r [:error :code])) (str "Could not sync: " (get-in r [:error :code])))))
                   (refresh!)))))))

(defn create-org! []
  (when-let [b (el "account-org-create")]
    (let [handle (.-value (el "account-org-handle"))]
      (set! (.-disabled b) true)
      (say! "account-org-note" (t "組織を作成しています…" "Creating the organization…"))
      (-> (api "/v1/org/create" {:handle handle :role "owner"})
          (.then (fn [r]
                   (if (:httpOk r)
                     (do (say! "account-org-note"
                               (t (str "作成しました: " (:orgDid r))
                                  (str "Created: " (:orgDid r))))
                         (refresh!))
                     (do (say! "account-org-note"
                               (case (get-in r [:error :code])
                                 "invalid-org-handle" (t "ハンドルは com-<名前>.kotoba.cloud 形式で指定してください。" "Handle must look like com-<name>.kotoba.cloud.")
                                 "org-handle-taken" (t "このハンドルは既に使われています。" "That handle is already taken.")
                                 "sign-in-required" (t "先にサインインしてください。" "Sign in first.")
                                 "org-authority-not-configured" (t "組織サービスはまだ接続されていません。" "The organization service is not connected yet.")
                                 (t "作成できませんでした。状態を更新してください。" "Could not create. Refresh and retry.")))
                         (set! (.-disabled b) false)))))))))

(defn start-ekyc! []
  (when-let [b (el "account-ekyc-start")]
    (set! (.-disabled b) true)
    (say! "account-ekyc-note" (t "Stripe の確認セッションを作成しています…" "Creating the Stripe verification session…"))
    (-> (api "/v1/research/ekyc/start" {:scopeId "owned" :tasks ["code-review"]})
        (.then (fn [r]
                 (cond
                   (and (:httpOk r) (:verificationUrl r))
                   (set! (.-location js/window) (:verificationUrl r))
                   ;; an admissible card was already on file: the authority
                   ;; applied the approval chain inline and answered 200 with
                   ;; no URL — re-read the console instead of calling it a failure
                   (:httpOk r)
                   (refresh!)
                   :else
                   (do (say! "account-ekyc-note"
                             (case (get-in r [:error :code])
                               "card-verification-not-configured" (t "本人確認サービスは一時的に利用できません。時間をおいて再試行してください。" "Verification is temporarily unavailable. Try again later.")
                               "prepaid-card-not-accepted" (t "プリペイドカード・バーチャルカードは本人確認に使えません。クレジットカードまたはデビットカードを登録してください。" "Prepaid and virtual cards cannot be used for verification. Add a regular credit or debit card.")
                               ("stripe-unavailable" "invalid-stripe-session") (t "Stripe に接続できませんでした。時間をおいて再試行してください。続く場合は support@kotoba.cloud へ。" "Could not reach Stripe. Try again later; if it persists, contact support@kotoba.cloud.")
                               "sign-in-required" (t "先にサインインしてください。" "Sign in first.")
                               (t "開始できませんでした。状態を更新してください。" "Could not start. Refresh and retry.")))
                       (set! (.-disabled b) false))))))))

(defn render-pat [r]
  (let [result (el "account-pat-result")
        note (el "account-pat-note")]
    (when result
      (if (and (:httpOk r) (:token r))
        (let [token (:token r)
              env-line (str "KOTOBA_API_BASE=https://api.kotoba.cloud KOTOBA_API_TOKEN=" token)
              curl-line (str "curl -s -H 'Authorization: Bearer " token
                             "' https://api.kotoba.cloud/v1/research/status")]
          (say! "account-pat-token" token)
          (say! "account-pat-env" env-line)
          (say! "account-pat-curl" curl-line)
          (set! (.-hidden result) false)
          (when-let [b (el "account-pat-create")] (set! (.-disabled b) true))
          (when note (set! (.-textContent note)
                           (t "トークンをコピーして保存してください。この画面を離れると二度と表示されません。"
                              "Copy and store the token now. It is never shown again.")))
          (doseq [[button-id text] [["account-pat-copy" token]
                                    ["account-pat-copy-env" env-line]
                                    ["account-pat-copy-curl" curl-line]]]
            (when-let [b (el button-id)]
              (.addEventListener b "click"
                                 (fn [] (.writeText (.-clipboard js/navigator) text)
                                   (when note (set! (.-textContent note)
                                                    (t "コピーしました。" "Copied."))))))))
        (do (when note (set! (.-textContent note)
                             (case (get-in r [:error :code])
                               "pat-not-configured" (t "トークン発行はまだ有効化されていません。しばらく待ってから再試行してください。"
                                                       "Token issuance is not enabled yet. Try again later.")
                               "invalid-origin" (t "同じページから発行してください。" "Issue it from this page.")
                               "content-type-required" (t "同じページから発行してください。" "Issue it from this page.")
                               "sign-in-required" (t "先にサインインしてください。" "Sign in first.")
                               (t "発行できませんでした。状態を更新してください。" "Could not issue. Refresh and retry.")))))))))

(defn create-pat! []
  (when-let [b (el "account-pat-create")]
    (set! (.-disabled b) true)
    (-> (api "/v1/account/api-token" {:label "cli"})
        (.then (fn [r]
                 (render-pat r)
                 (when-not (and (:httpOk r) (:token r))
                   (set! (.-disabled b) false)))))))

(defn refresh! []
  (state! "account-session-status" :loading)
  (say! "account-session-status" (t "サインイン状態を確認しています…" "Checking sign-in state…"))
  (-> (api "/v1/session")
      (.then render-session)
      (.then (fn [signed-in?]
               (when signed-in?
                 ;; the body is visible now: each cell is pending until its
                 ;; fetch answers, and every fetch maps to one cell state
                 (doseq [id ["account-ekyc-state" "account-eligibility-state" "account-free-tier"
                             "account-scopes-state" "account-orgs-state" "account-team-state"
                             "account-billing-state"]]
                   (state! id :loading))
                 (-> (api "/v1/research/ekyc/status") (.then render-ekyc))
                 (-> (api "/v1/research/status")
                     (.then (fn [r] (render-eligibility r) (render-scopes (:scopes r [])))))
                 (-> (api "/v1/org/status" {})
                     (.then (fn [r] (render-orgs r) (render-team r) (render-sso-orgs r))))
                 (-> (api "/v1/account/identities") (.then render-linked))
                 (-> (api "/v1/billing/status") (.then render-billing)))))))

(defn init! []
  (when (el "account-console")
    (when-let [b (el "account-refresh")] (.addEventListener b "click" refresh!))
    (when-let [b (el "account-ekyc-start")] (.addEventListener b "click" start-ekyc!))
    (when-let [b (el "account-org-create")] (.addEventListener b "click" create-org!))
    (when-let [b (el "account-pat-create")] (.addEventListener b "click" create-pat!))
    (when-let [b (el "account-sso-save")] (.addEventListener b "click" save-sso!))
    (when-let [b (el "account-sso-remove")] (.addEventListener b "click" remove-sso!))
    (when-let [b (el "account-sso-org")] (.addEventListener b "change" load-sso-status!))
    (when-let [b (el "account-sso-assert")]
      (.addEventListener b "click" (fn [_] (when-let [h (selected-org)]
                                             (set! (.-href js/location) (str "/v1/org/sso/start?org=" (js/encodeURIComponent h)))))))
    (render-link-outcome!)
    (-> (refresh!)
        (.then (fn [_]
                 ;; The org list is known once refresh! resolved; a ?sso=
                 ;; return provisions the membership now.
                 (when (.get (.-searchParams (js/URL. (.-href js/location))) "sso")
                   (-> (api "/v1/org/status" {})
                       (.then (fn [r] (render-sso-orgs r) (sync-sso!))))))))))
