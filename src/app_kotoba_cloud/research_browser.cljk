(ns app-kotoba-cloud.research-browser
  (:require [app-kotoba-cloud.research :as research] [clojure.string :as str]))

(defn el [id] (.getElementById js/document id))
(defn value [id] (.-value (el id)))
(defn say! [id text] (set! (.-textContent (el id)) text))
(defn ja? [] (= "ja" (.-lang (.-documentElement js/document))))
(defonce job-pending? (atom false))
(defonce poll-timer (atom nil))
(defn message [code]
  (get (if (ja?)
         {"sign-in-required" "まずアカウントにログインしてください。"
          "verification-provider-not-configured" "本人確認・審査基盤は準備中です。申請は送信・保存されていません。"
          "trust-route-required" "有効な本人確認経路を確認できません。確認状態を更新してください。"
          "session-reverification-required" "この操作には最新のセッション確認が必要です。"
          "free-quota-exhausted" "本日の無料枠に達しました。自動課金はありません。"
          "research-scope-required" "この調査には有効な承認済みスコープが必要です。"
          "eligible" "本人確認と審査が有効です。無料枠を利用できます。"}
         {"sign-in-required" "Please sign in to your account first."
          "verification-provider-not-configured" "Verification and review infrastructure is being prepared. No application was sent or saved."
          "trust-route-required" "No current identity trust route is available. Refresh verification status."
          "session-reverification-required" "This action requires current session verification."
          "free-quota-exhausted" "Your daily free allowance is exhausted. No automatic charge will occur."
          "research-scope-required" "A current approved scope is required for this task."
          "eligible" "Verification and review are current. Your free allowance is available."})
       code (if (ja?) "確認待ち、または現在利用できません。時間をおいて再確認してください。"
                         "Pending review or currently unavailable. Please check again later.")))

(defn api
  ([path body] (api path body {}))
  ([path body headers]
  (-> (js/fetch path (clj->js (cond-> {:method (if body "POST" "GET") :credentials "same-origin"
                                     :headers (merge {"content-type" "application/json"} headers)}
                              body (assoc :body (js/JSON.stringify (clj->js body))))))
      (.then (fn [r] (-> (.json r) (.then #(assoc (js->clj % :keywordize-keys true) :httpOk (.-ok r)))))))))

(defn refresh! []
  (set! (.-disabled (el "research-apply")) true)
  (set! (.-disabled (el "research-run")) true)
  (-> (api "/v1/research/status" nil)
      (.then (fn [r]
               (say! "research-status"
                     (str (message (or (get-in r [:error :code]) (:reason r) (:status r)))
                          (when (research/trust-current? (:trust r) (js/Date.now))
                            (str (if (ja?) " 直近の信頼スコア：" " Last checked trust score: ")
                                 (get-in r [:trust :score]) "/100 ("
                                 (str/join " + " (map (if (ja?) {"web-reviewed" "Web審査" "app-passport" "アプリ旅券確認"}
                                                            {"web-reviewed" "Web review" "app-passport" "App passport"})
                                                      (get-in r [:trust :routes]))) ")"))))
               (when (:httpOk r)
                 (set! (.-disabled (el "research-apply")) false)
                 (set! (.-disabled (el "research-run")) (or @job-pending? (not= "eligible" (:status r)))))))
      (.catch (fn [_] (say! "research-status" (message nil))))))

(defn bind-submit! [form button output path body-fn result-fn]
  (.addEventListener
   (el form) "submit"
   (fn [event]
     (.preventDefault event)
     (when-not (.-disabled (el button))
       (set! (.-disabled (el button)) true)
       (say! output (if (ja?) "確認しています…" "Checking…"))
       (-> (api path (body-fn))
           (.then (fn [r]
                    (say! output (if (:httpOk r) (result-fn r)
                                    (message (get-in r [:error :code]))))))
           (.catch (fn [_] (say! output (message nil))))
           (.finally #(set! (.-disabled (el button)) false)))))))

(declare poll-job!)
(defn stop-poll! [] (when @poll-timer (js/clearTimeout @poll-timer)) (reset! poll-timer nil))
(defn resume-id []
  (second (re-matches #"#research-job=([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})" (.-hash js/location))))
(defn show-job! [id result]
  (stop-poll!)
  (cond
    (not (:httpOk result))
    (say! "research-output" (if (ja?) "結果を確認できません。ログインと利用資格を確認し、このページを再読み込みしてください。依頼は自動再送しません。"
                                "Unable to retrieve the result. Check your sign-in and eligibility, then reload this page. The request will not be resubmitted automatically."))
    (#{"queued" "running"} (:status result))
    (do (say! "research-output" (if (ja?) "受付済みです。モデルの起動には最大約35分かかる場合があります。このページのURLを保存すると結果の確認を再開できます。"
                                    "Request accepted. Model startup may take up to about 35 minutes. Save this page URL to return to the result."))
        (reset! poll-timer (js/setTimeout #(poll-job! id) 5000)))
    :else
    (do (reset! job-pending? false)
        (say! "research-output"
              (case (:status result)
                "succeeded" (:content result)
                "unknown" (if (ja?) "処理結果が不明のため、再実行を止めています。サポートにこのページの依頼番号をお知らせください。"
                                   "The execution outcome is uncertain. Further execution is paused. Give support the request ID in this page URL.")
                (if (ja?) "利用資格の変化または待機期限により停止しました。利用資格を確認してください。"
                          "Stopped because eligibility changed or the queue deadline passed. Check your eligibility.")))
        (refresh!))))
(defn poll-job! [id]
  (reset! job-pending? true)
  (set! (.-disabled (el "research-run")) true)
  (-> (api (str "/v1/research/job?jobId=" id) nil)
      (.then #(show-job! id %))
      (.catch (fn [_] (show-job! id {:httpOk false})))))

(defn init! []
  (when (el "research-application")
    (.addEventListener (el "research-refresh") "click" refresh!)
    (bind-submit! "research-application" "research-apply" "research-status" "/v1/research/applications"
                  #(cond-> {:verificationMode (value "research-mode") :policyVersion research/policy-version
                             :consent (.-checked (el "research-consent"))
                             :authorizedResearch (.-checked (el "research-authorized"))
                             :purpose (value "research-purpose") :scope (value "research-scope")}
                     (= "reuse" (value "research-mode"))
                     (assoc :issuer (value "research-issuer") :reference (value "research-reference")))
                  #(str (if (ja?) "審査待ち：" "Pending review: ") (:applicationId %)))
    (.addEventListener (el "research-completion") "submit"
      (fn [event]
        (.preventDefault event)
        (when-not (.-disabled (el "research-run"))
          (let [id (str (random-uuid))
                body {:model research/model-id :task (value "research-task") :scopeId (value "research-scope-id")
                      :max_tokens 2048 :messages [{:role "user" :content (value "research-input")}]}]
            (stop-poll!) (reset! job-pending? true)
            (set! (.-disabled (el "research-run")) true)
            ;; Only an opaque request ID persists in the fragment. Prompts and
            ;; credentials never enter browser storage or URLs.
            (.replaceState js/history nil "" (str "#research-job=" id))
            (say! "research-output" (if (ja?) "依頼を受け付けています…" "Submitting your request…"))
            (-> (api "/v1/research/jobs" body {"idempotency-key" id})
                (.then #(show-job! id %))
                (.catch (fn [_] (show-job! id {:httpOk false}))))))))
    (.addEventListener js/window "pagehide" stop-poll!)
    (when-let [id (resume-id)] (poll-job! id))
    (refresh!)))
