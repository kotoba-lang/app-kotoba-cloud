(ns app-kotoba-cloud.billing
  "Versioned prices and measurement contracts. Money is integer micro-USD.")
(def version "2026-09-15-v5")
(def plans
  [{:sku "pro" :name "Pro" :scope "platform" :cents 2000 :credits 12 :gib 20}
   {:sku "team" :name "Team" :scope "platform" :cents 15000 :credits 60 :gib 50 :seats 6}
   {:sku "max" :name "Max" :scope "platform" :cents 10000 :credits 60 :gib 100}
   {:sku "ultra" :name "Ultra" :scope "platform" :cents 20000 :credits 120 :gib 250}
   ;; credits-monthly tiers: the monthly plan purchases a
   ;; credits balance with a bonus that rises with commitment. Credits never
   ;; expire, the plan renews each period, cancel any time (terms surfaced on
   ;; the billing page). scope credits = fungible across ai+storage meters.
   {:sku "credits-50" :name "Credits 50" :scope "credits" :cents 5000
    :credits 51 :bonusPercent 2 :monthly true}
   {:sku "credits-100" :name "Credits 100" :scope "credits" :cents 10000
    :credits 103 :bonusPercent 3 :monthly true}
   {:sku "credits-500" :name "Credits 500" :scope "credits" :cents 50000
    :credits 525 :bonusPercent 5 :monthly true}
   {:sku "credits-1000" :name "Credits 1000" :scope "credits" :cents 100000
    :credits 1100 :bonusPercent 10 :monthly true}
   {:sku "ai-credits-25" :name "AI Credits $25" :scope "ai" :cents 2500 :credits 25 :topup true}
   {:sku "storage-credits-25" :name "Storage Credits $25" :scope "storage" :cents 2500 :credits 25 :topup true}])

(def credits-terms
  {:autoCharge false :creditsExpire false :cancelAnyTime true
   :renewal "monthly" :note "Auto-charged each period, cancel anytime, credits never expire."})
(defn plan [sku] (first (filter #(= sku (:sku %)) plans)))
(def plan-rank {"pro" 1 "team" 2 "max" 3 "ultra" 4})
(defn active-plan
  "The platform plan a ledger is currently on: the highest-ranked platform sku
  among grants whose paid period covers `now`, or nil. A grant written before
  skus were recorded (no :sku) contributes nothing — an unknown plan is not a
  plan, and organization SSO (Team/Enterprise) must not open on a guess."
  [ledger now]
  (->> (vals (:grants ledger))
       (filter #(and (string? (:sku %)) (contains? plan-rank (:sku %))
                     (not (:topup %)) (integer? (:start %)) (integer? (:end %))
                     (<= (:start %) now) (< now (:end %))))
       (map :sku)
       (sort-by plan-rank)
       last))
(def rates {:input-per-million 900000 :cached-input-per-million 225000
            :output-per-million 4500000 :storage-gib-month 200000
            :egress-gib 90000 :query-vcpu-hour 60000})
(def catalog {:version version :currency "usd" :status "sandbox-proposal"
              :creditValueUSD 1 :plans plans :ratesMicroUSD rates
              :free {:identityRequired true :existingResearchQuotaUnchanged true :storageGiB 1}
              :enterprise {:minimumMonthlyUSD 1000 :quoteRequired true :postpaidDefault false
                           ;; Reserved capacity: a dedicated B200-class GPU pool quoted per
                           ;; contract. Requires an annual commitment; minimum monthly covers
                           ;; the always-on cost floor so an unused reservation cannot
                           ;; strand us with idle GPU spend.
                           :reservedCapacity {:gpuClass "b200" :minimumMonthlyUSD 6000
                                              :commitmentMonths 12 :quoteRequired true}}
              :subscriptionScope "platform" :includedBalances ["ai" "storage.capacity"]
              :automaticTopup false :taxIncluded false
              ;; Storage is priced in stored GiB-months, not abstract credits:
              ;; 1 credit = $1 = 5 GiB stored for one month.
              :storageUSDPerGiBMonth (/ (:storage-gib-month rates) 1000000)
              :aiTopupCreditsPerUSD 1
              :platform {:pro {:usd 20 :aiCredits 12 :storageGiB 20}
                         :team {:usd 150 :aiCredits 60 :storageGiB 50 :seats 6}
                         :max {:usd 100 :aiCredits 60 :storageGiB 100}
                         :ultra {:usd 200 :aiCredits 120 :storageGiB 250}}})
(defn natural? [x] (and (integer? x) (<= 0 x 1000000000000)))
(defn token-event [receipt customer]
  (let [{:keys [requestId model inputTokens cachedInputTokens outputTokens occurredAt]} receipt]
    (when-not (and (string? requestId) (<= 1 (count requestId) 100)
                   (string? model) (<= 1 (count model) 200)
                   (every? natural? [inputTokens cachedInputTokens outputTokens])
                   (<= cachedInputTokens inputTokens) (string? occurredAt))
      (throw (ex-info "invalid-server-usage-receipt" {})))
    {:transaction_id (str "inference:" requestId) :customer_id customer
     :event_type "kotoba.inference" :timestamp occurredAt
     :properties {:scope "ai" :catalog_version version :model model
                  :input_tokens (- inputTokens cachedInputTokens)
                  :cached_input_tokens cachedInputTokens :output_tokens outputTokens}}))
(defn storage-event [sample customer]
  (let [{:keys [sampleId databaseId bytes seconds occurredAt]} sample]
    (when-not (and (string? sampleId) (<= 1 (count sampleId) 100)
                   (string? databaseId) (every? natural? [bytes seconds]) (<= 1 seconds 3600)
                   (string? occurredAt))
      (throw (ex-info "invalid-server-storage-sample" {})))
    {:transaction_id (str "storage:" sampleId) :customer_id customer
     :event_type "kotoba.storage" :timestamp occurredAt
     :properties {:scope "storage" :catalog_version version :database_id databaseId
                  :retained_bytes bytes :interval_seconds seconds}}))
(defn paid-line
  "Only full paid recurring invoice lines grant an allowance. Proration cannot refill it."
  [invoice line prices]
  (let [price (or (get-in line [:pricing :price_details :price]) (get-in line [:price :id]))
        sku (get prices price) p (plan sku)
        start (get-in line [:period :start]) end (get-in line [:period :end])]
    (when (and (= "paid" (:status invoice)) (= "usd" (:currency invoice))
               (contains? #{"subscription_create" "subscription_cycle"} (:billing_reason invoice))
               p (not (:topup p)) (= 1 (:quantity line))
               (not (get-in line [:parent :subscription_item_details :proration]))
               (not (:proration line)) (integer? start) (integer? end) (< start end)
               (string? (:id invoice)) (string? (:id line)))
      {:id (str (:id invoice) ":" (:id line)) :sku sku :scope (:scope p)
       :credits (:credits p) :gib (:gib p) :start start :end end})))

(defn allowance-grants
  "Fan out one paid subscription line into independently replay-safe balances.
  platform and credits scopes are both fungible across ai + storage meters."
  [line]
  (if (contains? #{"platform" "credits"} (:scope line))
    [(-> line (assoc :id (str (:id line) ":ai") :scope "ai") (dissoc :gib))
     (-> line (assoc :id (str (:id line) ":storage") :scope "storage") (dissoc :credits))]
    [line]))

(defn- rated [parts divisor]
  (let [n #?(:clj (reduce + (map (fn [[u r]] (* (bigint u) (bigint r))) parts))
             ;; nbb cannot analyze js* syntax; plain BigInt operator calls work.
             :cljs (reduce (fn [sum [u r]] (+ sum (* (js/BigInt u) (js/BigInt r))))
                           (js/BigInt 0) parts))
        d #?(:clj (bigint divisor) :cljs (js/BigInt divisor))
        value #?(:clj (quot (+ n (dec d)) d)
                 :cljs (js/Number (/ (+ n (- d (js/BigInt 1))) d)))]
    (when-not (natural? value) (throw (ex-info "usage-arithmetic-overflow" {})))
    value))

(defn receipt-charge
  "Rate only an authenticated producer receipt. Round once per receipt to micro-USD.
  Storage is retained byte-seconds over a fixed 30-day billing month."
  [kind receipt]
  (case kind
    "inference"
    (let [event (token-event receipt nil)
          {:keys [input_tokens cached_input_tokens output_tokens]} (:properties event)
          parts [[input_tokens (:input-per-million rates)]
                 [cached_input_tokens (:cached-input-per-million rates)]
                 [output_tokens (:output-per-million rates)]]]
      {:id (:transaction_id event) :scope "ai" :event event
       :amount (rated parts 1000000)})
    "storage"
    (let [event (storage-event receipt nil)
          byte-seconds (* (:bytes receipt) (:seconds receipt))]
      {:id (:transaction_id event) :scope "storage.capacity" :event event
       :amount (rated [[byte-seconds (:storage-gib-month rates)]] (* 1073741824 2592000))})
    (throw (ex-info "unknown-meter" {}))))
