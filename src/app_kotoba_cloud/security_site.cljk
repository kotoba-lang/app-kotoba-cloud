(ns app-kotoba-cloud.security-site
  "Security public-data hub (vulnerabilities, techniques, groups, logs).
   Shell from the cloud-kotoba-dds catalog pattern; this file keeps the
   card-grid results layout and the hub's own nav."
  (:require [cloud-kotoba-dds.catalog :as catalog]))

(def css
  "Card-grid results and detail pre are this hub's own layout."
  (str
  ".security-results{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:var(--hig-spacing-3,12px)}"
  ".security-results button{text-align:left;background:var(--hig-color-secondary-system-background);overflow-wrap:anywhere}"
  ".security-detail pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:400px;overflow:auto}"
  ".ck-catalog small{display:block;color:var(--hig-color-secondary-label)}"
  ".ck-catalog li{margin:var(--hig-spacing-3,10px) 0}"))

(defn view
  ([] (view false))
  ([embedded?]
   (catalog/page
    {:title "セキュリティ公開データ"
     :lead "脆弱性、攻撃手法、グループ、ログを、出典まで辿って調べる。"
     :embedded? embedded?
     :id "security-main"
     :nav (catalog/breadcrumb
          "公開データ"
          [["チャット" "/ja/"]
           ["百科" "https://wiki.kotobase.net/"]
           ["このハブ" nil]
           ["LLM向け利用案内" "/security-data/README.md"]])}
    (catalog/status "security-summary" "データを読み込んでいます…")
    (catalog/tools
     {:search-id "security-search" :search-label "データを検索"
      :search-placeholder "CVE、ATT&CK ID、名前で検索"
      :select-id "security-kind" :select-label "データの種類"
      :options [[:option {:value ""} "すべて"]
                [:option {:value "vulnerability"} "脆弱性"]
                [:option {:value "technique"} "攻撃手法"]
                [:option {:value "actor-group"} "グループ"]
                [:option {:value "attack-log"} "公開ログ"]
                [:option {:value "standard"} "SCAP"]
                [:option {:value "threat-model"} "脅威モデル"]]})
    [:div {:id "security-results" :class "security-results"}]
    (catalog/detail {:id "security-detail" :label "項目の詳細"})
    [:details
     [:summary "データの範囲・取得方法"]
     [:p "初回スナップショットです。KEVの最新50件、ATT&CKの3グループと関連手法、OTRFの公開ラボログを収録。SCAPは仕様カタログで、評価エンジンや全チェック定義の配信ではありません。自動更新は未設定です。"]
     [:p "出典付きの主張、観測ログ、分析用シナリオを区別します。KEVへの掲載だけで個別資産の脆弱性や攻撃者を判定しません。"]
     [:nav [:a {:href "/security-data/index.json"} "IPLDマニフェスト"] [:a {:href "/security-data/graph.jsonld"} "Linked Data"] [:a {:href "/security-data/ontology.jsonld"} "オントロジー"] [:a {:href "/security-data/datoms.json"} "Datoms"] [:a {:href "/security-data/schema.edn"} "Datomicスキーマ"]]
     [:p "IPLDのCIDを正本とし、JSON-LDとDatomic形式を同じデータから生成しています。HTTPS配信済みのブロックです。IPFSネットワークへの配布や百科の単一refへの登録は別工程です。"]
     [:p [:a {:href "/security-data/MITRE-LICENSE.txt"} "MITRE ATT&CKの利用条件"] " · " [:a {:href "/security-data/OTRF-LICENSE.txt"} "OTRFの利用条件"]]]
    [:script {:src "/js/security-data.js" :defer true}])))
