(ns app-kotoba-cloud.site-copy
  "Locale catalogs for the public kotoba.cloud pages. One key contract;
  routes are / for English and /{locale}/ for every other language.")

(def supported-locales [:en :ja :hi :ta :zh-Hans :ar :uk :es :fr])

(defn- locale-paths
  [locale]
  (if (= locale :en)
    {:path "/" :legal-path "/legal/" :tokushoho-path "/legal/tokushoho/"}
    (let [root (str "/" (name locale) "/")]
      {:path root
       :legal-path (str root "legal/")
       :tokushoho-path (str root "legal/tokushoho/")})))

(defn- planes
  [storage compute agent]
  [{:kind "STORAGE" :name "Kotobase" :origin "kotobase.net"
    :href "https://kotobase.net"
    :connect-href "https://auth.kotoba.cloud/connect?target=kotobase"
    :body storage}
   {:kind "COMPUTE" :name "Murakumo" :origin "murakumo.cloud"
    :href "https://murakumo.cloud"
    :connect-href "https://auth.kotoba.cloud/connect?target=murakumo"
    :body compute}
   {:kind "AGENT WORK" :name "Itonami" :origin "itonami.cloud"
    :href "https://itonami.cloud"
    :connect-href "https://auth.kotoba.cloud/connect?target=itonami"
    :body agent}])

