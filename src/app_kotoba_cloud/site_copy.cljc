(defn- catalog
  [locale specific]
  (merge shared (locale-paths locale) specific))

(def copy
  {:en (catalog :en en-existing)
   :ja (catalog :ja ja-existing)
   :hi (catalog :hi hi)
   :ta (catalog :ta ta)
   :zh-Hans (catalog :zh-Hans zh-Hans)
   :ar (catalog :ar ar)
   :uk (catalog :uk uk)
   :es (catalog :es es)
   :fr (catalog :fr fr)})

(def published-locales
  (filterv #(not (get-in copy [% :draft])) supported-locales))

(def draft-locales
  (filterv #(get-in copy [% :draft]) supported-locales))
