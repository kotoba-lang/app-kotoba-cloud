(ns app-kotoba-cloud.research-authority
  "Private research authority. Deployed as its own Worker (no public routes,
  workers.dev disabled) and reachable only through the RESEARCH_AUTHORITY
  service binding. Canonical durable state lives in Durable Object storage as
  the interim store until the private Kotobase ref (kotoba-cloud-security-research)
  is provisioned; every mutation is an atomic blockConcurrencyWhile transaction.

  Admission contract follows docs/research-authority-contract.md and the edge
  policy in app-kotoba-cloud.research. The authority recomputes trust points and
  the session projection itself from binding-trusted inputs; it never accepts
  browser-supplied evidence. Slow upstream inference runs detached (waitUntil)
  under a durable job; the edge polls /jobs/status within its 60-second limit.

  Operator decisions (eKYC verification, screening clearance, scope approval,
  suspension) require an HMAC-SHA256 signature over the canonical operation
  tuple with the RESEARCH_OPERATOR_SECRET. The secret never leaves the Worker;
  operator calls arrive over the same private binding."
  (:require [app-kotoba-cloud.research-providers :as providers]
            [app-kotoba-cloud.icao :as icao]
            [app-kotoba-cloud.research :as research-policy]
            [app-kotoba-cloud.secure :as secure]))

;; ---- kotoba-proof route (inlined from app-kotoba-cloud.kotoba-proof;
;; shadow-closure drops that ns from the esm graph; ADR 2609142200) ----

(defn hmac-async
  "HMAC-SHA256 hex via WebCrypto (async)."
  [secret msg]
  (-> (.importKey (.-subtle js/crypto) "raw" (.encode (js/TextEncoder.) secret)
                  #js {:name "HMAC" :hash "SHA-256"} false #js ["sign"])
      (.then (fn [key]
               (.sign (.-subtle js/crypto) #js {:name "HMAC"} key (.encode (js/TextEncoder.) msg))))
      (.then (fn [buf]
               (let [arr (js/Uint8Array. buf)]
                 (apply str (map #(let [h (.toString % 16)]
                                    (if (< (count h) 2) (str "0" h) h))
                                 arr)))))))


(defn normalize-doc-number
  "Uppercase, strip separators, prefix the issuing state. Documented in the
  ADR so operators can reason about collisions."
  [doc-number issuing-state]
  (str (some-> issuing-state (.replace "<" "")) "|" (some-> doc-number (.toUpperCase))))


(defn decode-stored
  "DO storage returns JSON strings; fetch responses give objects."
  [v]
  (cond
    (nil? v) nil
    (string? v) (js->clj (js/JSON.parse v) :keywordize-keys true)
    :else (js->clj v :keywordize-keys true)))


(defn- chain-continue
  "Post-verification chain: challenge check → nullifier → dup check →
  approval chain. Splits the old single deep (.then) nest into flat steps
  so each stage's promise type is visible to the compiler."
  [{:keys [storage env now load-state save-state response
           ekyc-ttl-ms screening-ttl-ms trust-window-ms]}
   verify-result]
  (let [principal-id (:principalId verify-result)
        doc-number (:doc-number verify-result)
        normalized (normalize-doc-number doc-number (:issuing-state verify-result))
        scope-id (:scopeId verify-result)
        tasks (vec (:tasks verify-result))
        challenge-key (str "ekyc:" principal-id)]
    (-> (js-invoke storage "get" challenge-key)
        (.then (fn [stored]
                 (let [challenge (decode-stored stored)]
                   (when-not (and (map? challenge)
                                  (= false (:consumed challenge))
                                  (number? (:expiresAt challenge))
                                  (< now (:expiresAt challenge)))
                     (throw (ex-info "challenge-unknown-or-expired" {:status 403})))
                   challenge)))
        (.then (fn [challenge]
                 (-> (hmac-async (aget env "NULLIFIER_KEY") normalized)
                     (.then (fn [nullifier]
                              {:nullifier (str "self-nullifier:" nullifier)
                               :challenge challenge})))))
        (.then (fn [{:keys [nullifier challenge]}]
                 (-> (js-invoke storage "get" nullifier)
                     (.then (fn [existing]
                              {:existing (decode-stored existing)
                               :nullifier nullifier
                               :challenge challenge})))))
        (.then (fn [{:keys [existing nullifier challenge]}]
                 (when (and existing (not= existing principal-id))
                   (throw (ex-info "duplicate-person-rejected" {:status 403})))
                 (-> (load-state storage)
                     (.then (fn [record]
                              {:record record
                               :nullifier nullifier
                               :challenge challenge})))))
        (.then (fn [{:keys [record nullifier challenge]}]
                 (let [record (or record {:status "none"
                                          :principalId principal-id
                                          :scopes [] :applications []})
                       next (-> record
                                (assoc :policyVersion "whitehat-2026-09-12-v1")
                                (assoc :ekyc {:status "verified"
                                              :evidenceRef doc-number
                                              :verifiedAt now
                                              :expiresAt (+ now ekyc-ttl-ms)})
                                (assoc :screening {:status "clear"
                                                   :evidenceRef (str "icao:" doc-number)
                                                   :checkedAt now
                                                   :expiresAt (+ now screening-ttl-ms)})
                                (assoc :trust {:score 80
                                               :routes ["app-passport"]
                                               :evaluatedAt now
                                               :expiresAt (+ now trust-window-ms)}))
                       next (assoc next :scopes
                                   (conj (filterv #(not= (:id %) scope-id) (:scopes record))
                                         {:id scope-id :status "approved"
                                          :tasks tasks
                                          :expiresAt (+ now 86400000)}))
                       next (assoc next :status "active")]
                   (-> (js-invoke storage "put" nullifier
                                  (js/JSON.stringify (clj->js principal-id)))
                       (.then (fn [_]
                                (js-invoke storage "put" challenge-key
                                           (js/JSON.stringify
                                            (clj->js (assoc challenge :consumed true))))))
                       (.then (fn [_] (save-state storage next)))
                       (.then (fn [_]
                                (response {:principalId principal-id
                                           :status (:status next)
                                           :provider "kotoba-proof"
                                           :trust 80
                                           :approvedBy "icao-passive-auth"} 200))))))))))


(def run-proof-submit
  (fn
  ;; Entry from the authority. args: {:storage :env :body :now :load-state
  ;; :save-state :response :hmac :ekyc-ttl-ms :screening-ttl-ms
  ;; :trust-window-ms}. Returns a JS Promise of a Response.
  ;; icao/verify-chip-evidence is ASYNC (WebCrypto digests): the verification
  ;; result resolves inside a promise, so the whole downstream chain hangs off
  ;; it. Rejections carry {:status :code :mismatched} ex-data and are surfaced
  ;; by the authority's fetch wrapper.
  [{:keys [storage env body now load-state save-state response hmac
           ekyc-ttl-ms screening-ttl-ms trust-window-ms]}]
  (let [{:keys [sodDer dg1 dg11 dg12 dg5]} body
        bundle {:sod-der sodDer :dg1 dg1 :dg11 dg11 :dg12 dg12 :dg5 dg5}]
    (-> (icao/verify-chip-evidence bundle)
        (.then (fn [verify-result]
                 (when-not (and (map? verify-result) (:valid verify-result))
                   (throw (ex-info "chip-evidence-not-admissible"
                                   {:status 403
                                    :mismatched (vec (:mismatched-dgs verify-result))})))
                 (chain-continue
                  {:storage storage :env env :now now
                   :load-state load-state :save-state save-state :response response
                   :ekyc-ttl-ms ekyc-ttl-ms :screening-ttl-ms screening-ttl-ms
                   :trust-window-ms trust-window-ms}
                  (assoc verify-result
                         :principalId (:principalId body)
                         :scopeId (:scopeId body)
                         :tasks (:tasks body)))))))))


(def version "kotoba-research-authority-2026-09-v2-DEBUG")

(defn text? [x n] (and (string? x) (<= 1 (count x) n) (boolean (re-find #"\S" x))))
(defn- response [body status]
  (js/Response. (js/JSON.stringify (clj->js body))
                #js {:status status :headers #js {"content-type" "application/json"
                                                  "cache-control" "no-store, private"}}))
(defn- decode [value]
  ;; Durable Object storage returns JSON strings, while Fetch Response.json()
  ;; returns an object. Accept both at their explicit trust boundary.
  (cond
    (nil? value) nil
    (string? value) (js->clj (js/JSON.parse value) :keywordize-keys true)
    :else (js->clj value :keywordize-keys true)))

;; Mirror of app-kotoba-cloud.research/free-limits (owner direction 2026-09-15:
;; 524,288 input characters ≈ a 128k-token context, 32k output tokens; the
;; daily count is unchanged).
(def free-limits {:requestsPerDay 1000 :maxOutputTokens 32768 :maxInputCharacters 524288})
;; Longest answer the job store accepts: 32k tokens of CJK text can approach
;; 200k characters; SQLite-backed DO storage takes values up to 2 MB.
(def max-content-characters 1048576)
(def tasks #{"code-review" "vulnerability-triage" "remediation"})
(def weights {"web-reviewed" 60 "app-passport" 80})
(def threshold 60)
(def screening-ttl-ms 86400000)
(def ekyc-ttl-ms (* 365 86400000))
(def trust-window-ms 60000)
(def session-window-ms 15000)
(def upstream-models
  {"qwen3.8-flash-next-whitehacker" "qwen3.8-flash-next-cybersecurity-nvfp4"
   "glm5.3-flash" "glm5.3-flash"
   ;; blue team (the shared route): the public id is the publisher's id
   "qwen/qwen3.8-flash" "qwen/qwen3.8-flash"
   "z-ai/glm-5.3-flash" "z-ai/glm-5.3-flash"})
(def blue-models #{"qwen/qwen3.8-flash" "z-ai/glm-5.3-flash"})
(defn- blue-model? [public-id] (contains? blue-models public-id))
(def public-model "qwen3.8-flash-next-whitehacker")
(defn- upstream-model-for [public-id] (get upstream-models public-id public-model))

;; --- Card-based identity verification (sole verification/approval path) -----
;; Assurance rung 1: a live payment method on file is the
;; verification instrument. Prepaid (and unknown-funding) cards are rejected;
;; only credit/debit funding admits. Challenges live under `ekyc:<principalId>`
;; (slot kept for wire compatibility). No document PII is persisted: only the
;; opaque challenge record, the funding kind, and a receipt reference survive.
(def stripe-origin "https://api.stripe.com")
(declare load-state save-state hmac! timing-safe=?)
(def challenge-ttl-ms 900000)
(def admissible-funding #{"credit" "debit"})
;; Hosted Checkout (mode=setup) is refused without success_url — Stripe 400
;; parameter_missing, measured live 2026-09-15 (every /v1/checkout/sessions
;; POST from this route on the AWAI account was 400). The human is sent back
;; to the account console, whose client re-reads /v1/research/ekyc/status;
;; approval itself comes from the checkout.session.completed webhook, never
;; from the redirect.
(def account-console-url "https://kotoba.cloud/account")
(def card-setup-success-url (str account-console-url "?card=done#account-panel-identity"))
(def card-setup-cancel-url (str account-console-url "?card=cancelled#account-panel-identity"))

(defn- stripe-error!
  "Turn a non-ok Stripe response into the thrown `code`, keeping Stripe's own
  error (type / code / param / message — never card or document data) in
  ex-data and on the log line, so an operator can tell a missing param from a
  revoked key from an outage. Discarding the body hid a 400 parameter_missing
  behind `stripe-unavailable`."
  [code path r]
  (-> (.text r)
      (.catch (fn [_] ""))
      (.then (fn [detail]
               (let [err (try (get (js->clj (js/JSON.parse detail) :keywordize-keys true) :error)
                              (catch :default _ nil))
                     stripe (when (map? err) (select-keys err [:type :code :param :message]))]
                 (js/console.error "stripe-request-failed" path (.-status r)
                                   (js/JSON.stringify (clj->js (or stripe {}))))
                 (throw (ex-info code {:status 503 :stripeStatus (.-status r) :stripe stripe})))))))

(defn- stripe-credential! [env]
  ;; Preferred dedicated card key; falls back to the Identity key, then the
  ;; AWAI live key. Fails closed on neither present.
  (let [key (or (aget env "STRIPE_CARD_KEY") (aget env "STRIPE_IDENTITY_KEY")
                (aget env "STRIPE_AWAI_LIVE_KEY"))]
    (when-not (and (string? key) (re-find #"^(rk|sk)_(live|test)_\S+" key))
      (throw (ex-info "card-verification-not-configured" {:status 503})))
    key))

(defn- stripe-get! [key path]
  ;; Workers fetch only accepts redirect "follow"|"manual" — "error" throws
  ;; TypeError at the edge, so guard Stripe redirects by status instead.
  (-> (js/fetch (str stripe-origin path)
                #js {:method "GET" :redirect "manual"
                     :signal (js/AbortSignal.timeout 30000)
                     :headers #js {"authorization" (str "Bearer " key)}})
      (.then (fn [r]
               (if (.-ok r) (.json r)
                   (stripe-error! "stripe-unavailable" path r))))))

(defn- card-customer!
  "One Stripe customer per principal, minted server-side with an idempotency
  key so a retried start never creates a second customer."
  [env principal]
  (let [key (stripe-credential! env)]
    (-> (js/fetch (str stripe-origin "/v1/customers")
                  #js {:method "POST" :redirect "manual"
                       :signal (js/AbortSignal.timeout 30000)
                       :headers #js {"content-type" "application/x-www-form-urlencoded"
                                     "authorization" (str "Bearer " key)
                                     "idempotency-key" (str "kotoba-card-customer:" principal)}
                       :body (str "metadata[principal]=" (js/encodeURIComponent principal))})
        (.then (fn [r]
                 (if (.-ok r) (.json r)
                     (stripe-error! "stripe-unavailable" "/v1/customers" r)))))))

(defn- create-identity-session!
  "Inline Stripe Identity session create (document type, bound verification
  flow). Fails closed without STRIPE_IDENTITY_KEY (or the AWAI fallback).
  STRIPE_VERIFICATION_FLOW is optional: when set it is sent as
  verification_flow; when absent a plain type=document session is created
  (Stripe accepts it, as verified live)."
  [env principal external-id]
  (let [key (stripe-credential! env)
        flow (let [f (aget env "STRIPE_VERIFICATION_FLOW")] (when (text? f 128) f))
        flow-part (if flow (str "&verification_flow=" (js/encodeURIComponent flow)) "")]
    ;; Workers fetch only accepts redirect "follow"|"manual" — "error" throws
    ;; TypeError at the edge, so guard Stripe redirects by status instead.
    (-> (js/fetch (str stripe-origin "/v1/identity/verification_sessions")
                  #js {:method "POST" :redirect "manual"
                       :signal (js/AbortSignal.timeout 30000)
                       :headers #js {"content-type" "application/x-www-form-urlencoded"
                                     "authorization" (str "Bearer " key)}
                       :body (str "type=document"
                                  flow-part
                                  "&client_reference_id=" (js/encodeURIComponent external-id)
                                  "&metadata[principal]=" (js/encodeURIComponent principal))})
        (.then (fn [r]
                 (if (.-ok r) (.json r)
                     (throw (ex-info "stripe-session-unavailable" {:status 503})))))
        (.then (fn [session]
                 (let [s (js->clj session :keywordize-keys true)]
                   (when-not (and (contains? #{"requires_input" "processing"} (:status s))
                                  (= external-id (:client_reference_id s))
                                  (text? (:url s) 512) (text? (:id s) 128))
                     (throw (ex-info "invalid-stripe-session" {:status 503})))
                   {:id (:id s) :url (:url s)}))))))

(defn- signature-parts [header]
  (when-not (text? header 4096) (throw (ex-info "stripe-signature-missing" {:status 400})))
  (let [t (second (re-find #"t=(\d+)" header)) v1 (second (re-find #"v1=([0-9a-f]{64})" header))]
    (when-not (and t v1) (throw (ex-info "stripe-signature-invalid" {:status 400})))
    [t v1]))

(defn- verify-webhook-signature!
  "Same check as the Stripe SDK's constructEventAsync: HMAC-SHA256 over
  \"<t>.<payload>\", timing-safe compare, |now - t| <= 300000ms."
  [secret raw header now]
  (let [[t v1] (signature-parts header) ts (js/parseInt t 10)]
    (when (> (js/Math.abs (- now (* 1000 ts))) 300000)
      (throw (ex-info "stripe-signature-expired" {:status 400})))
    (-> (hmac! secret (str t "." raw))
        (.then (fn [expected]
                 (when-not (timing-safe=? expected v1)
                   (throw (ex-info "stripe-signature-invalid" {:status 400}))))))))

(defn- stripe-event!
  "Extract only routing/binding fields from the verified payload. Never logged
  in full; no document PII is retained."
  [raw]
  (let [event (try (js->clj (js/JSON.parse raw) :keywordize-keys true)
                   (catch :default _ nil))
        obj (get-in event [:data :object])]
    (when-not (map? obj) (throw (ex-info "stripe-event-invalid" {:status 400})))
    {:type (:type event) :created (:created event) :status (:status obj)
     :session-id (:id obj) :external-id (:client_reference_id obj)
     :principal (get-in obj [:metadata :principal])}))

(defn- ekyc-challenge! [storage principal]
  (-> (js-invoke storage "get" (str "ekyc:" principal)) (.then decode)))

(defn- ekyc-session-challenge! [storage stripe-session-id]
  ;; Secondary index: a later /ekyc/start overwrites the principal's single
  ;; challenge slot, but Stripe may still verify an EARLIER session the human
  ;; already completed. Resolve the challenge for the verified session directly.
  (-> (js-invoke storage "get" (str "ekyc-session:" stripe-session-id)) (.then decode)))

(defn- save-challenge! [storage principal challenge]
  (js-invoke storage "put" (str "ekyc:" principal) (js/JSON.stringify (clj->js challenge))))

(defn- save-session-challenge! [storage stripe-session-id challenge]
  (js-invoke storage "put" (str "ekyc-session:" stripe-session-id)
             (js/JSON.stringify (clj->js challenge))))

(defn- card-method!
  "Card-based verification start (assurance rung 1). Mints/locates one
  customer per principal, requires a live card on file, and rejects prepaid
  (and unknown-funding) cards. Returns a hosted Setup Session URL when no card
  is on file (the human completes card entry at checkout.stripe.com — never the
  agent), or an immediate verified state when an admissible card exists."
  [env principal]
  (let [key (stripe-credential! env)]
    (-> (card-customer! env principal)
        (.then (fn [customer]
                 (let [id (.-id customer)]
                   (-> (stripe-get! key (str "/v1/customers/" (js/encodeURIComponent id) "/payment_methods"))
                       (.then (fn [pm]
                               (let [s (js->clj pm :keywordize-keys true)
                                     cards (:data s)]
                                 (if-let [card (first (filter #(admissible-funding (get-in % [:card :funding])) cards))]
                                   {:status "verified"
                                    :cardBrand (get-in card [:card :brand])
                                    :cardLast4 (get-in card [:card :last4])
                                    :customerId id}
                                   (if (seq cards)
                                     (throw (ex-info "prepaid-card-not-accepted"
                                                     {:status 403
                                                      :hint "prepaid and virtual cards cannot be used for verification; use a regular credit or debit card"}))
                                     (-> (js/fetch (str stripe-origin "/v1/checkout/sessions")
                                                   #js {:method "POST" :redirect "manual"
                                                        :signal (js/AbortSignal.timeout 30000)
                                                        :headers #js {"content-type" "application/x-www-form-urlencoded"
                                                                      "authorization" (str "Bearer " key)}
                                                        :body (str "mode=setup"
                                                                   "&customer=" (js/encodeURIComponent id)
                                                                   "&payment_method_types[0]=card"
                                                                   "&success_url=" (js/encodeURIComponent card-setup-success-url)
                                                                   "&cancel_url=" (js/encodeURIComponent card-setup-cancel-url)
                                                                   "&setup_intent_data[metadata][principal]=" (js/encodeURIComponent principal)
                                                                   "&metadata[principal]=" (js/encodeURIComponent principal)
                                                                   "&metadata[purpose]=identity-verification")})
                                         (.then (fn [r]
                                                  (if (.-ok r) (.json r)
                                                      (stripe-error! "stripe-unavailable" "/v1/checkout/sessions" r))))
                                         (.then (fn [sess]
                                                  (let [s (js->clj sess :keywordize-keys true)]
                                                    (when-not (and (text? (:url s) 512) (text? (:id s) 128))
                                                      (throw (ex-info "invalid-stripe-session" {:status 503})))
                                                    {:status "requires-card" :setupUrl (:url s)
                                                     :setupSessionId (:id s) :customerId id}))))))))))))))))

(defn- handle-ekyc-start [env storage body]
  (let [now (.now js/Date)]
    (when-not (and (text? (:principalId body) 256) (text? (:scopeId body) 256)
                   (vector? (:tasks body)) (pos? (count (:tasks body)))
                   (every? #(contains? tasks %) (:tasks body)))
      (throw (ex-info "invalid-ekyc-request" {:status 400})))
    (let [challenge {:sessionId (str (random-uuid))
                     :externalId (str "opaque-" (random-uuid))
                     :principal (:principalId body) :scopeId (:scopeId body)
                     :tasks (vec (:tasks body))
                     :createdAt now :expiresAt (+ now challenge-ttl-ms) :consumed false}]
      (-> (card-method! env (:principalId body))
          (.then (fn [result]
                   (cond
                     ;; Card verified already: apply the full approval chain inline.
                     (= "verified" (:status result))
                     (let [receipt-id (str "op-card-verify-" now)
                           evidence (str "card:" (:customerId result) ":" (:cardLast4 result))]
                       (-> (load-state storage)
                           (.then (fn [record]
                                    (let [record (or record {:status "none"
                                                             :principalId (:principalId body)
                                                             :scopes [] :applications []})
                                          next (-> record
                                                   (assoc :policyVersion "whitehat-2026-09-12-v1")
                                                   (assoc :cardVerification {:status "verified"
                                                                             :evidenceRef evidence
                                                                             :verifiedAt now
                                                                             :expiresAt (+ now ekyc-ttl-ms)})
                                                   (assoc :ekyc {:status "verified" :evidenceRef evidence
                                                                 :verifiedAt now :expiresAt (+ now ekyc-ttl-ms)})
                                                   (assoc :screening {:status "clear" :evidenceRef evidence
                                                                      :checkedAt now :expiresAt (+ now screening-ttl-ms)})
                                                   (assoc :trust {:score (get weights "web-reviewed")
                                                                  :routes ["web-reviewed"]
                                                                  :evaluatedAt now :expiresAt (+ now trust-window-ms)}))
                                          next (assoc next :scopes
                                                      (conj (filterv #(not= (:scopeId body) (:id %)) (:scopes record))
                                                            {:id (:scopeId body) :status "approved"
                                                             :tasks (vec (:tasks body)) :expiresAt (+ now 86400000)}))
                                          next (assoc next :status "active")]
                                      (-> (save-state storage (assoc next :lastReview
                                                                     {:op "card-verify" :actor "stripe-card"
                                                                      :caseId (:externalId challenge) :at now
                                                                      :receiptId receipt-id}))
                                          (.then (fn [_]
                                                   (response {:sessionId (:sessionId challenge)
                                                              :externalId (:externalId challenge)
                                                              :status (:status next) :receiptId receipt-id
                                                              :approvedBy "stripe-card"
                                                              :scopeId (:scopeId body)
                                                              :tasks (vec (:tasks body))} 200)))))))))
                     ;; No card on file: hand the human the hosted setup URL.
                     ;; The setup-session id is indexed so the checkout
                     ;; completion webhook can resolve the challenge even if a
                     ;; later /ekyc/start overwrote the principal's slot.
                     :else
                     (let [challenge (assoc challenge :stripeSessionId (:setupSessionId result)
                                            :cardRequired true)]
                       (-> (save-challenge! storage (:principalId body) challenge)
                           (.then (fn [_] (save-session-challenge! storage (:setupSessionId result) challenge)))
                           (.then (fn [_]
                                    (response {:sessionId (:sessionId challenge)
                                               :externalId (:externalId challenge)
                                               :verificationUrl (:setupUrl result)
                                               :requiresCard true
                                               :expiresAt (:expiresAt challenge)
                                               :scopeId (:scopeId body)
                                               :tasks (vec (:tasks body))} 200))))))))))))
(defn- handle-ekyc-webhook [env storage body]
  (let [now (.now js/Date)
        secret (aget env "STRIPE_IDENTITY_WEBHOOK_SECRET")
        raw (:raw body)]
    (when-not (text? secret 256) (throw (ex-info "stripe-identity-not-configured" {:status 503})))
    (when-not (and (string? raw) (pos? (count raw)) (<= (count raw) 262144)
                   (text? (:principalId body) 256))
      (throw (ex-info "stripe-event-invalid" {:status 400})))
    (-> (verify-webhook-signature! secret raw (:signatureHeader body) now)
        ;; Parse the event first, then resolve the challenge by the VERIFIED
        ;; Stripe session id — not by the principal's current slot. A later
        ;; /ekyc/start overwrites the principal slot, but the human may have
        ;; completed an earlier session.
        (.then (fn [_]
                 (let [ev (stripe-event! raw)
                       ;; Card-setup completions arrive as
                       ;; checkout.session.completed (mode=setup). They carry
                       ;; the SETUP session id in :session-id and the principal
                       ;; in metadata — resolve the challenge through the
                       ;; setup-session index written by /ekyc/start.
                       setup? (and (= "checkout.session.completed" (:type ev))
                                   (= "complete" (:status ev)))
                       lookup-id (:session-id ev)]
                   (-> (ekyc-session-challenge! storage lookup-id)
                       (.then (fn [ch] (if (map? ch)
                                         [ch ev]
                                         (-> (ekyc-challenge! storage (:principalId body))
                                             (.then (fn [c] [c ev]))))))))))
        (.then (fn [[challenge event]]
                 (let [event (if event event (stripe-event! raw))
                       setup? (= "checkout.session.completed" (:type event))]
                 (when-not (map? challenge) (throw (ex-info "stripe-challenge-unknown" {:status 403})))
                 (if (:consumed challenge)
                   ;; Idempotent replay: return the prior receipt, never re-apply.
                   (response {:principalId (:principalId body) :status "verified"
                              :receiptId (:receiptId challenge) :approvedBy (if setup? "stripe-card" "stripe-identity")} 200)
                   (let [event event]
                     (when-not (and (or setup?
                                        (and (= "identity.verification_session.verified" (:type event))
                                             (= "verified" (:status event))))
                                    (= (:stripeSessionId challenge) (:session-id event))
                                    (if setup?
                                      ;; checkout metadata carries the principal; the
                                      ;; challenge's own externalId never appears in
                                      ;; the checkout event, so only the principal and
                                      ;; freshness bind it.
                                      (and (= (:principal challenge) (:principalId body))
                                           (number? (:created event))
                                           (<= (- now (* 1000 (:created event))) 900000)
                                           (< now (:expiresAt challenge)))
                                      (and (= (:externalId challenge) (:external-id event))
                                           (= (:principal challenge) (:principal event))
                                           (number? (:created event))
                                           (<= (- now (* 1000 (:created event))) 900000)
                                           (< now (:expiresAt challenge)))))
                       (throw (ex-info "stripe-evidence-not-admissible" {:status 403})))
                     ;; One transaction (blockConcurrencyWhile): consume the
                     ;; challenge and apply the full approval chain.
                     (let [receipt-id (str (if setup? "op-card-setup-" "op-stripe-identity-") now)
                           evidence (:session-id event)
                           audit {:op (if setup? "card-setup-approve" "stripe-identity-approve")
                                  :actor (if setup? "stripe-card" "stripe-identity")
                                  :caseId (:sessionId challenge) :at now :receiptId receipt-id}]
                       (-> (load-state storage)
                           (.then (fn [record]
                                    (let [record (or record {:status "none"
                                                             :principalId (:principalId body)
                                                             :scopes [] :applications []})
                                          ;; challenge carries scope/tasks; record carries state.
                                          ;; policyVersion marks consent to the current policy
                                          ;; (edge eligibility checks it: policy-acceptance-required).
                                          next (-> record
                                                   (assoc :policyVersion "whitehat-2026-09-12-v1")
                                                   (assoc :ekyc {:status "verified" :evidenceRef evidence
                                                                 :verifiedAt now :expiresAt (+ now ekyc-ttl-ms)})
                                                   (assoc :screening {:status "clear" :evidenceRef evidence
                                                                      :checkedAt now :expiresAt (+ now screening-ttl-ms)})
                                                   (assoc :trust {:score (get weights "web-reviewed")
                                                                  :routes ["web-reviewed"]
                                                                  :evaluatedAt now :expiresAt (+ now trust-window-ms)}))
                                          next (assoc next :scopes
                                                      (conj (filterv #(not= (:scopeId challenge) (:id %)) (:scopes record))
                                                            {:id (:scopeId challenge) :status "approved"
                                                             :tasks (:tasks challenge) :expiresAt (+ now 86400000)}))
                                          next (assoc next :status "active")]
                                      (let [consumed (assoc challenge :consumed true
                                                            :receiptId receipt-id :verifiedAt now)]
                                        (-> (save-challenge! storage (:principalId body) consumed)
                                            ;; The replay lookup above resolves by the
                                            ;; session index first; an index copy left
                                            ;; unconsumed re-applied the chain on every
                                            ;; Stripe retry (the E2E only passed when
                                            ;; both calls shared a millisecond).
                                            (.then (fn [_] (when (text? (:stripeSessionId challenge) 128)
                                                             (save-session-challenge! storage (:stripeSessionId challenge) consumed))))
                                            (.then (fn [_] (save-state storage (assoc next :lastReview audit))))
                                            (.then (fn [_]
                                                     (response {:principalId (:principalId body)
                                                                :status (:status next)
                                                                :receiptId receipt-id
                                                                :approvedBy (if setup? "stripe-card" "stripe-identity")} 200))))))))))))))))))

(defn- handle-ekyc-status [storage body]
  (-> (load-state storage)
      (.then (fn [record]
        (-> (ekyc-challenge! storage (:principalId body))
            (.then (fn [challenge]
                     ;; Verified state wins: the card path applies the approval
                     ;; chain inline without marking the challenge consumed.
                     (if (and (map? record) (= (:principalId body) (:principalId record))
                              (= "verified" (get-in record [:ekyc :status])))
                       (response {:sessionId (or (when (map? challenge) (:sessionId challenge)) nil)
                                  :status "verified"
                                  :expiresAt (get-in record [:ekyc :expiresAt])} 200)
                       (response (if-not (map? challenge)
                                   {:sessionId nil :status "missing" :expiresAt nil}
                                   {:sessionId (:sessionId challenge)
                                    :status (if (:consumed challenge) "verified" "pending")
                                    :expiresAt (:expiresAt challenge)}) 200)))))))))

;; --- operator authorization -------------------------------------------------
(defn- canonical [items] (js/JSON.stringify (clj->js items)))
(defn- hex [buf]
  (apply str (map (fn [b] (.padStart (.toString b 16) 2 "0")) (array-seq (js/Uint8Array. buf)))))
(defn- hmac! [secret msg]
  (-> (.importKey (.-subtle js/crypto) "raw" (.encode (js/TextEncoder.) secret)
                  (clj->js {:name "HMAC" :hash "SHA-256"}) false (clj->js ["sign"]))
      (.then #(.sign (.-subtle js/crypto) (clj->js {:name "HMAC"}) % (.encode (js/TextEncoder.) msg)))
      (.then hex)))
(defn- timing-safe=? [a b]
  (and (= (count a) (count b))
       (zero? (reduce (fn [acc i] (+ acc (bit-xor (.charCodeAt a i) (.charCodeAt b i)))) 0 (range (count a))))))
(defn- require-operator! [env body now]
  (let [secret (aget env "RESEARCH_OPERATOR_SECRET")
        ts (:operatorTimestamp body) sig (:operatorSignature body)]
    (when-not (text? secret 256) (throw (ex-info "operator-not-enrolled" {:status 503})))
    (when-not (and (number? ts) (<= (- now ts) 120000) (<= 0 ts) (text? sig 128))
      (throw (ex-info "operator-proof-required" {:status 403})))
    (let [msg (canonical [(:op body) (:principalId body) (:caseId body) (:scopeId body)
                          (:tasks body) (:expiresAt body) (:status body) ts (:operatorActor body)])]
      (-> (hmac! secret msg)
          (.then (fn [expected]
                   (when-not (timing-safe=? expected sig)
                     (throw (ex-info "operator-signature-invalid" {:status 403})))))))))

;; --- record construction ----------------------------------------------------
(defn- fresh? [start end now max-age]
  (and (number? start) (number? end) (<= 0 start now) (< now end)
       (<= (- now start) max-age)))
(defn- eligibility-reason [record now]
  (cond
    (not= "active" (:status record)) "review-required"
    (not= "verified" (get-in record [:ekyc :status])) "verification-required"
    (not (fresh? (get-in record [:ekyc :verifiedAt]) (get-in record [:ekyc :expiresAt]) now ekyc-ttl-ms)) "verification-expired"
    (not= "clear" (get-in record [:screening :status])) "review-required"
    (not (fresh? (get-in record [:screening :checkedAt]) (get-in record [:screening :expiresAt]) now screening-ttl-ms)) "screening-expired"
    :else nil))
(defn- trust-valid?
  "The canonical trust grant is still backed by evidence: known, distinct
  routes; the fixed-policy score; a grant stamped no later than now; and the
  evidence the routes rest on (ekyc) verified and unexpired. The stored
  stamp's own 60-second window is the PROJECTION's freshness (contract:
  'caps freshness at 60 seconds or the earliest contributing evidence
  expiry'), not the grant's lifetime — reading it as the lifetime made every
  principal trust-route-required one minute after approval (measured live
  2026-09-15, first card verification through the console)."
  [record now]
  (let [trust (:trust record) ekyc (:ekyc record)]
    (and (vector? (:routes trust))
         (<= 1 (count (:routes trust)) 2)
         (= (count (:routes trust)) (count (set (:routes trust))))
         (every? #(contains? weights %) (:routes trust))
         (number? (:evaluatedAt trust)) (<= 0 (:evaluatedAt trust) now)
         (= "verified" (:status ekyc))
         (fresh? (:verifiedAt ekyc) (:expiresAt ekyc) now ekyc-ttl-ms)
         (number? (:score trust))
         (= (:score trust) (min 100 (reduce + 0 (map weights (:routes trust)))))
         (>= (:score trust) threshold))))
(defn- trust-projection
  "What the edge sees: the grant re-stamped for at most 60 seconds, never past
  the contributing evidence's expiry."
  [record now]
  (assoc (:trust record)
         :evaluatedAt now
         :expiresAt (min (+ now trust-window-ms) (get-in record [:ekyc :expiresAt]))
         :policyVersion "kotoba-trust-routes-2026-09-v1"))
(defn- session-projection [session-ref action now]
  ;; Uncalibrated projection: the edge has already authenticated the principal and
  ;; derived the session reference server-side over the private binding. Belief is
  ;; bounded at 0.9 pending production observers.
  {:policyVersion "kotoba-session-evidence-2026-09-v1" :sessionRef session-ref :action action
   :decision "allow" :opinion {:belief 0.9 :disbelief 0 :uncertainty 0.1 :calibrated false}
   :evaluatedAt now :expiresAt (+ now session-window-ms)})
(defn- public-record [record session-ref action now]
  (cond-> (assoc record
                 :assurance (research-policy/rung-allowance record now)
                 :compliance (secure/compliance-snapshot))
    true (assoc :continuous (session-projection session-ref action now))
    (trust-valid? record now)
    (assoc :trust (trust-projection record now))))

(defn- scope-approved? [record task scope-id now]
  (boolean (some #(and (= scope-id (:id %)) (= "approved" (:status %))
                       (number? (:expiresAt %)) (< now (:expiresAt %))
                       (some #{task} (:tasks %)))
                 (:scopes record))))
(defn- utc-day [now] (quot now 86400000))
(defn- quota-used [record day]
  (let [u (:usage record)] (if (and (= day (:day u)) (number? (:count u))) (:count u) 0)))
(defn- completion-shape? [body]
  (and (contains? upstream-models (get-in body [:request :model]))
       (or (contains? tasks (get-in body [:request :task]))
           (contains? #{"payload-crafting" "c2-tooling"} (get-in body [:request :task])))
       (text? (get-in body [:request :scopeId]) 256)
       (vector? (get-in body [:request :messages]))))

;; --- job lifecycle ----------------------------------------------------------
(defn- job-response [job record session-ref now]
  {:jobId (:jobId job) :principalId (:principalId job) :sessionRef session-ref
   :policyVersion "whitehat-2026-09-12-v1"
   :trustPolicyVersion "kotoba-trust-routes-2026-09-v1"
   :sessionPolicyVersion "kotoba-session-evidence-2026-09-v1"
   :model (get-in job [:request :model]) :billing (or (:billing job) "free") :policyDecision "allowed"
   :receiptId (:receiptId job) :status (:status job)
   :task (get-in job [:request :task]) :scopeId (get-in job [:request :scopeId])
   :content (:content job)
   ;; the provider's measured usage (token counts, model, timestamps — never
   ;; the prompt) so the edge can settle a paid reservation from a terminal
   ;; receipt, never from the request or the response text
   :usageReceipt (:usageReceipt job)
   :toolCalls (:toolCalls job)
   :finishReason (:finishReason job)
   :record (public-record record session-ref (get-in job [:request :task]) now)})
(defn- load-state [storage]
  (-> (js-invoke storage "get" "record") (.then decode)))
(defn- save-state [storage record]
  (js-invoke storage "put" "record" (js/JSON.stringify (clj->js record))))

(defn- store-job! [storage job]
  (js-invoke storage "put" (str "job:" (:jobId job)) (js/JSON.stringify (clj->js job))))

;; --- job retention -----------------------------------------------------------
;; A job record carries the prompt, the answer / tool_calls and the usage
;; receipt. It exists so a retry can re-attach (deterministic id) and a paid
;; job can settle from a terminal receipt — both happen within minutes. It
;; is deleted 24 hours after its terminal state (or after its creation, for
;; a job that never reached one): the ledger keeps the receipt id and the
;; token counts, the audit log keeps refusals, nothing keeps the text.
;; Until 2026-09-15 nothing deleted these records while the public page said
;; prompts and outputs were never kept.
(def job-retention-ms 86400000)

(defn- job-expiry [job]
  (let [anchor (or (:finishedAt job) (:createdAt job))]
    (when (number? anchor) (+ anchor job-retention-ms))))

(defn- arm-retention!
  "Make sure an alarm fires no later than `due` (the DO keeps one alarm)."
  [storage due]
  (-> (js-invoke storage "getAlarm")
      (.then (fn [current]
               (when (or (nil? current) (> current due))
                 (js-invoke storage "setAlarm" due))))
      (.catch (fn [e] (js/console.error "job-retention-arm-failed" (str (or (.-message e) e)))))))

(defn sweep-jobs!
  "Delete every job record past its expiry; re-arm for the earliest one left.
   Returns a promise of {:deleted n :kept n}."
  [storage now]
  (-> (js-invoke storage "list" #js {:prefix "job:"})
      (.then (fn [^js entries]
               (let [rows (atom [])]
                 (.forEach entries (fn [v k] (swap! rows conj [k (decode v)])))
                 (let [expired (filter (fn [[_ job]] (let [e (job-expiry job)] (or (nil? e) (<= e now)))) @rows)
                       kept (remove (fn [[_ job]] (let [e (job-expiry job)] (or (nil? e) (<= e now)))) @rows)]
                   (-> (js/Promise.all (clj->js (map (fn [[k _]] (js-invoke storage "delete" k)) expired)))
                       (.then (fn [_]
                                (when (seq kept)
                                  (arm-retention! storage (apply min (map (fn [[_ job]] (job-expiry job)) kept))))
                                (js/console.log "job-retention-sweep" (count expired) (count kept))
                                {:deleted (count expired) :kept (count kept)})))))))))
(defn- load-job [storage job-id]
  (-> (js-invoke storage "get" (str "job:" job-id)) (.then decode)))

;; --- text-form tool calls -------------------------------------------------
;; The origin's vLLM runs --tool-call-parser hermes, but this model emits
;; Qwen3-Coder XML (`<tool_call><function=NAME><parameter=KEY>VALUE
;; </parameter>…</function></tool_call>`), which that parser does not read —
;; so the calls arrive as TEXT content and the agent, which only reads
;; native tool_calls (or `<tool_call>{json}</tool_call>`), sees an empty
;; answer and falls back to another provider (measured 2026-09-15 21:04).
;; Convert both text forms to native tool_calls here. Parameter values are
;; strings in the XML; the request's tool schema says which are numbers,
;; booleans, objects or arrays (what vLLM's qwen3_xml parser does).
(def ^:private tool-call-block #"<tool_call>([\s\S]*?)</tool_call>")
(def ^:private xml-function #"<function=([^>\n]+)>([\s\S]*?)</function>")
(def ^:private xml-parameter #"<parameter=([^>\n]+)>\n?([\s\S]*?)\n?</parameter>")

(defn- schema-type [tools fname key]
  (some (fn [t]
          (when (= fname (get-in t [:function :name]))
            (get-in t [:function :parameters :properties (keyword key) :type])))
        tools))

(defn- coerce-parameter [type value]
  (case type
    ("integer" "number") (let [n (js/Number value)] (if (js/isNaN n) value n))
    "boolean" (case (.trim value) "true" true "false" false value)
    ("object" "array") (try (js->clj (js/JSON.parse value)) (catch :default _ value))
    value))

(defn- xml-tool-call [tools body]
  (when-let [[_ fname inner] (re-find xml-function body)]
    (let [fname (.trim fname)
          args (into {} (map (fn [[_ k v]] [(.trim k) (coerce-parameter (schema-type tools fname (.trim k)) v)])
                             (re-seq xml-parameter inner)))]
      {:id (str "call_" (subs (str (random-uuid)) 0 12)) :type "function"
       :function {:name fname :arguments (js/JSON.stringify (clj->js args))}})))

(defn- json-tool-call [body]
  (let [parsed (try (js->clj (js/JSON.parse (.trim body)) :keywordize-keys true) (catch :default _ nil))]
    (when (and (map? parsed) (string? (:name parsed)))
      {:id (str "call_" (subs (str (random-uuid)) 0 12)) :type "function"
       :function {:name (:name parsed)
                  :arguments (let [a (:arguments parsed)]
                               (if (string? a) a (js/JSON.stringify (clj->js (or a {})))))}})))

(defn- text-tool-calls
  "Native tool_calls recovered from text content, and the text that is left
  once the blocks are removed (nil when only whitespace remains). Blocks that
  parse as neither form are left in the text untouched."
  [content tools]
  (if-not (and (string? content) (.includes content "<tool_call>"))
    {:content content :tool-calls nil}
    (let [calls (keep (fn [[_ body]] (or (json-tool-call body) (xml-tool-call tools body)))
                      (re-seq tool-call-block content))]
      (if (empty? calls)
        {:content content :tool-calls nil}
        (let [rest (.trim (.replace content (js/RegExp. (.-source tool-call-block) "g") ""))]
          {:content (when (seq rest) rest) :tool-calls (vec calls)})))))

(defn- upstream-body
  "The origin request. Client tool definitions and tool_choice pass through
  when the edge admitted them: the origin's vLLM runs a tool-call parser, so
  the model answers with native `tool_calls` the agent executes on ITS side
  (nothing runs here). Without them the model cannot call anything — the
  agent's first two calls came back empty and it fell back to another
  provider (measured 2026-09-15)."
  [request]
  (clj->js (cond-> {:model (upstream-model-for (:model request)) :stream false
                    :messages (:messages request)
                    :max_tokens (:max_tokens request)}
             (seq (:tools request)) (assoc :tools (:tools request))
             (some? (:tool_choice request)) (assoc :tool_choice (:tool_choice request)))))

(def blue-route-url
  "The shared inference route's OpenAI-compatible endpoint. Which provider
  stands behind it is operator configuration; the public catalog never
  names it."
  "https://openrouter.ai/api/v1/chat/completions")
(defn- blue-route-headers
  "Blue-team route. The key is an operator secret (BLUE_ROUTE_API_KEY);
  without it the route refuses by name — a blue job never silently falls
  back to the red team's dedicated deployment. The two attribution headers
  are what the route expects from an application."
  [env]
  (let [key (aget env "BLUE_ROUTE_API_KEY")]
    (when-not (text? key 512)
      (throw (ex-info "blue-route-not-configured" {:status 503})))
    #js {"content-type" "application/json"
         "authorization" (str "Bearer " key)
         "HTTP-Referer" "https://kotoba.cloud"
         "X-Title" "Kotoba Cloud"}))
(defn- red-route-url
  "The dedicated research deployment's URL is an operator secret /
  configuration (MODAL_INFERENCE_URL — the secret's name is fixed by the
  stored value), never a browser field. Restricted to the deployment's host
  so this private Worker cannot be turned into an arbitrary authenticated
  HTTP relay."
  [env]
  (let [raw (aget env "MODAL_INFERENCE_URL")]
    (when-not (text? raw 2048)
      (throw (ex-info "red-route-not-configured" {:status 503})))
    (let [url (js/URL. raw)
          host (.toLowerCase (.-hostname url))]
      (when-not (and (= "https:" (.-protocol url)) (.endsWith host ".modal.run"))
        (throw (ex-info "red-route-url-invalid" {:status 503})))
      raw)))

(defn- upstream-usage-receipt
  "Accept only the upstream's measured OpenAI-compatible usage. Missing, negative, or
  inconsistent values are a provider error; no request-derived estimate may
  enter a future billing ledger."
  [decoded job]
  (let [usage (:usage decoded)
        input (:prompt_tokens usage)
        output (:completion_tokens usage)
        total (:total_tokens usage)]
    (when-not (and (integer? input) (<= 0 input)
                   (integer? output) (<= 0 output)
                   (integer? total) (= total (+ input output)))
      (throw (ex-info "usage-receipt-invalid" {})))
    {:receiptVersion "kotoba-inference-usage-2026-09-v1"
     :source "upstream-openai-compatible"
     :requestId (:jobId job)
     :receiptId (:receiptId job)
     :model (get-in job [:request :model])
     :upstreamModel (upstream-model-for (get-in job [:request :model]))
     :inputTokens input
     :cachedInputTokens 0
     :outputTokens output
     :totalTokens total
     :observedAt (js/Date.now)}))

(defn- run-inference! [env storage job-id]
  ;; Detached from the request: the Durable Object writes the terminal state; a
  ;; crashed run is reconciled on the next poll as "unknown", never re-dispatched.
  (let [p (load-job storage job-id)]
    (.then p (fn [job]
      (when (and job (= "queued" (:status job)))
        (let [blue? (blue-model? (get-in job [:request :model]))
              ;; the route is decided by the model's team (research.cljk
              ;; teams): blue → the shared route, red → the dedicated
              ;; deployment. A route that is not
              ;; configured refuses by name INSIDE the promise chain, so the
              ;; terminal catch below stores it — never a fallback to the
              ;; other team's deployment.
              unavailable (if blue? "blue-route-unavailable" "red-route-unavailable")
              q (try
                  (js/fetch (if blue? blue-route-url (red-route-url env))
                            #js {:method "POST" :redirect "manual"
                                 :signal (js/AbortSignal.timeout 2100000)
                                 :headers (if blue?
                                            (blue-route-headers env)
                                            #js {"content-type" "application/json"
                                                 "authorization" (str "Bearer " (or (aget env "MODAL_INFERENCE_TOKEN") ""))})
                                 :body (js/JSON.stringify (upstream-body (:request job)))})
                  (catch :default e (js/Promise.reject e)))
              ;; ONE terminal catch at the end of the chain. The previous shape
              ;; attached `fail` as the rejection handler of every `then`: a
              ;; non-ok upstream threw in the ok-handler, the NEXT step's `fail`
              ;; stored "failed" and resolved, and `succeed` then ran on
              ;; undefined — overwriting the job as "succeeded" with nil content.
              ;; The edge served that as 200 + `content: null` (measured live
              ;; 2026-09-15, first two PAT completions after eligibility).
              fail (fn [e]
                     (let [data (ex-data e) finished (js/Date.now)]
                       (js/console.error "inference-run-failed" job-id
                                         (str (or (.-message e) e))
                                         (js/JSON.stringify (clj->js (select-keys data [:status :upstream]))))
                       (-> (store-job! storage (assoc job :status "failed"
                                                      :error (str (or (.-message e) e))
                                                      :upstreamStatus (:status data)
                                                      :finishedAt finished))
                           (.then (fn [_] (arm-retention! storage (+ finished job-retention-ms)))))))
              succeed (fn [{:keys [content tool-calls finish-reason usage-receipt]}]
                        (when-not (or (text? content max-content-characters) (seq tool-calls))
                          (throw (ex-info "inference-result-empty" {})))
                        (let [finished (js/Date.now)]
                          (-> (store-job! storage (cond-> (assoc job :status "succeeded"
                                                                 :content (when (text? content max-content-characters) content)
                                                                 :finishReason finish-reason
                                                                 :usageReceipt usage-receipt
                                                                 :finishedAt finished)
                                                    (seq tool-calls) (assoc :toolCalls (vec tool-calls))))
                              (.then (fn [_] (arm-retention! storage (+ finished job-retention-ms)))))))
              fetched (js-invoke q "then"
                        (fn [r]
                          (if-not (.-ok r)
                            ;; keep the upstream's own error type/code (never
                            ;; the prompt) so the log names 401 vs 404 vs 5xx
                            (-> (.text r)
                                (.catch (fn [_] ""))
                                (.then (fn [detail]
                                         (let [err (try (get (js->clj (js/JSON.parse detail) :keywordize-keys true) :error)
                                                        (catch :default _ nil))]
                                           (throw (ex-info unavailable
                                                           {:status (.-status r)
                                                            :upstream (if (map? err) (select-keys err [:type :code :message])
                                                                          (subs (str detail) 0 (min 200 (count (str detail)))))}))))))
                            (.json r))))
              parsed (js-invoke fetched "then"
                       (fn [raw]
                         (let [decoded (decode raw)
                               choice (get-in decoded [:choices 0])
                               content (get-in choice [:message :content])
                               reasoning (get-in choice [:message :reasoning])
                               native (let [tc (get-in choice [:message :tool_calls])]
                                        (when (and (vector? tc) (seq tc)) tc))
                               ;; reasoning stands in for empty content ONLY when the
                               ;; answer is text: next to native tool calls it would be
                               ;; served as the assistant's words (measured 2026-09-15
                               ;; after the origin's qwen3_xml parser landed)
                               fallback (cond (text? content max-content-characters) content
                                              native nil
                                              :else reasoning)
                               ;; native tool calls: id / type function / name / arguments
                               ;; (a JSON string). Anything else is a malformed origin answer.
                               ;; Text-form calls (Qwen XML / json tags) are converted first.
                               recovered (text-tool-calls fallback (get-in job [:request :tools]))
                               fallback (:content recovered)
                               tool-calls (or native (:tool-calls recovered))
                               tool-calls-ok? (or (nil? tool-calls)
                                                  (and (<= (count tool-calls) 64)
                                                       (every? #(and (map? %) (text? (:id %) 128)
                                                                     (= "function" (:type %))
                                                                     (text? (get-in % [:function :name]) 64)
                                                                     (string? (get-in % [:function :arguments]))
                                                                     (<= (count (get-in % [:function :arguments])) max-content-characters))
                                                               tool-calls)))
                               ;; calls recovered from text arrive with the origin's
                               ;; "stop"; the agent needs tool_calls to act on them
                               finish-reason (cond (seq tool-calls) "tool_calls"
                                                   (= "length" (:finish_reason choice)) "length"
                                                   :else "stop")
                               expected (upstream-model-for (get-in job [:request :model]))]
                           (if-not (and (or (not expected)
                                            (= expected (:model decoded)))
                                        (= "chat.completion" (:object decoded))
                                        tool-calls-ok?
                                        (or (text? fallback max-content-characters) tool-calls))
                             (throw (ex-info "unexpected-upstream-model-or-response"
                                             {:upstream {:model (:model decoded) :object (:object decoded)
                                                         :finish (:finish_reason choice)}}))
                             {:content fallback
                              :tool-calls (when tool-calls
                                            (mapv #(hash-map :id (:id %) :type "function"
                                                             :function {:name (get-in % [:function :name])
                                                                        :arguments (get-in % [:function :arguments])})
                                                  tool-calls))
                              :finish-reason finish-reason
                              :usage-receipt (upstream-usage-receipt decoded job)}))))]
          (js-invoke (js-invoke parsed "then" succeed) "catch" fail)))))))
;; --- request handling -------------------------------------------------------
(defn- handle-status [storage body]
  (let [now (.now js/Date)]
    (-> (load-state storage)
        (.then (fn [record]
                 (let [record (or record {:status "none" :principalId (:principalId body)})]
                   (response (assoc (public-record record (:sessionRef body) (:action body) now)
                                    :policyVersion "whitehat-2026-09-12-v1"
                                    :principalId (:principalId body)) 200)))))))

(defn- handle-applications [storage body]
  (let [now (.now js/Date)]
    (-> (load-state storage)
        (.then (fn [record]
                 (let [record (or record {:status "none" :principalId (:principalId body)
                                          :applications []})
                       app {:applicationId (str "app-" (:requestId body))
                            :status "pending-review"
                            :verificationMode (get-in body [:application :verificationMode])
                            :purpose (get-in body [:application :purpose])
                            :scope (get-in body [:application :scope])
                            :submittedAt now
                            :policyVersion "whitehat-2026-09-12-v1"}
                       next (update record :applications (fnil conj []) app)]
                   ;; Consent via application also accepts the current policy
                   ;; version, so the edge eligibility check passes after approval.
                   (-> (save-state storage (assoc next :policyVersion "whitehat-2026-09-12-v1"))
                       (.then (fn [_] (response {:principalId (:principalId body)
                                                 :applicationId (:applicationId app)} 200))))))))))

(defn- handle-jobs-create [storage body]
  (let [now (.now js/Date)]
    (when-not (completion-shape? body) (throw (ex-info "invalid-job-request" {:status 400})))
    ;; Guardrails run FIRST and fail closed: a block verdict refuses the job
    ;; before any eligibility/quota work, and the refusal is a durable receipt.
    (let [guard (secure/evaluate-guardrails (get-in body [:request :messages]))]
      (when (= "block" (:verdict guard))
        (throw (ex-info "guardrail-blocked"
                        {:status 403
                         :guardrailVersion secure/guardrail-version
                         :matches (:matches guard)})))
    (-> (load-state storage)
        (.then (fn [record]
                 (let [record (or record {:status "none" :principalId (:principalId body)})]
                   ;; Firewall: deterministic tool deny INSIDE the loaded-record
                   ;; branch, after the guardrail gate, before eligibility. The
                   ;; blue team has no identity rung: it may call the three
                   ;; standard tasks and nothing in the offensive band.
                   (let [blue? (blue-model? (get-in body [:request :model]))
                         task (get-in body [:request :task])
                         fw (if blue?
                              {:tool task :decision (if (contains? tasks task) "allow" "deny")}
                              (secure/firewall-decision record task now))]
                     (when (= "deny" (:decision fw))
                       (throw (ex-info "firewall-denied"
                                       {:status 403
                                        :firewallVersion secure/firewall-version
                                        :tool (:tool fw)}))))
                   ;; Admission recheck happens here, atomically, before any reservation.
                   ;; Blue team: a signed-in principal and free quota (the edge
                   ;; authenticated the principal); red team: the whole ladder.
                   (if-let [reason (when-not (blue-model? (get-in body [:request :model]))
                                     (or (eligibility-reason record now)
                                         (when-not (trust-valid? record now)
                                           "trust-route-required")))]
                     (response {:error reason} 403)
                     ;; `:billing "paid"` is the edge's word that it holds a
                     ;; reservation on the principal's prepaid ledger for this
                     ;; job id (research-gateway paid-admission). A paid job is
                     ;; not counted against the free daily quota and is not
                     ;; refused by it; everything else (guardrails, firewall,
                     ;; the identity ladder above) is the same bar.
                     (let [day (utc-day now) used (quota-used record day)
                           paid? (= "paid" (:billing body))]
                       (cond
                         (and (not paid?) (>= used (:requestsPerDay free-limits)))
                         (response {:error "free-quota-exhausted"} 429)
                         :else
                         (-> (js-invoke storage "get" (str "job:" (:jobId body)))
                             (.then (fn [prior]
                                      (let [prior (decode prior)]
                                        (cond
                                          (and prior (not= (get-in body [:request :messages])
                                                           (get-in prior [:request :messages])))
                                          (response {:error "job-input-conflict"} 409)
                                          ;; a FAILED reservation is not a receipt: the same
                                          ;; prompt again re-dispatches (the deterministic id
                                          ;; otherwise made one transient origin failure
                                          ;; permanent for that prompt — measured 2026-09-15:
                                          ;; second identical request 502 in 0.3 s, no run)
                                          (and prior (not= "failed" (:status prior)))
                                          (response (job-response prior record (:sessionRef body) now) 200)
                                          :else
                                          (let [job {:jobId (:jobId body) :principalId (:principalId body)
                                                     :status "queued" :receiptId (str "receipt-" (:jobId body))
                                                     :billing (if paid? "paid" "free")
                                                     :request (select-keys (:request body) [:model :task :scopeId :messages :max_tokens :tools :tool_choice])
                                                     :createdAt now :sessionRef (:sessionRef body)}
                                                next (if paid? record
                                                       (-> record (assoc-in [:usage :day] day)
                                                           (assoc-in [:usage :count] (inc used))))]
                                            (-> (save-state storage next)
                                                (.then (fn [_] (store-job! storage job)))
                                                ;; a run that never reaches a terminal state
                                                ;; still expires from its creation
                                                (.then (fn [_] (arm-retention! storage (+ now job-retention-ms))))
                                                (.then (fn [_]
                                                         (response (job-response job record (:sessionRef body) now) 200))))))))))))))))))))

(defn- handle-jobs-status [storage body]
  (let [now (.now js/Date)]
    (-> (load-state storage)
        (.then (fn [record]
                 (-> (load-job storage (:jobId body))
                     (.then (fn [job]
                              (cond
                                (nil? job) (response (assoc (job-response
                                                             {:jobId (:jobId body) :principalId (:principalId body)
                                                              :status "unknown" :receiptId "receipt-unknown"}
                                                             (or record {:principalId (:principalId body)})
                                                             (:sessionRef body) now)
                                                            :policyDecision "denied")
                                                     404)
                                (not= (:principalId body) (:principalId job))
                                (response {:error "job-owner-mismatch"} 403)
                                :else (response (job-response job record (:sessionRef body) now) 200))))))))))

(defn- handle-review [storage body]
  (let [now (.now js/Date)]
    (-> (load-state storage)
        (.then (fn [record]
                 (let [record (or record {:status "none" :principalId (:principalId body)
                                          :scopes [] :applications []})
                       next (case (:op body)
                              "verify-ekyc"
                              (assoc record :ekyc {:status "verified" :evidenceRef (:caseId body)
                                                   :verifiedAt now :expiresAt (+ now ekyc-ttl-ms)})
                              "clear-screening"
                              (assoc record :screening {:status "clear" :evidenceRef (:caseId body)
                                                        :checkedAt now :expiresAt (+ now screening-ttl-ms)})
                              "grant-trust"
                              (assoc record :trust {:score (min 100 (reduce + 0 (map weights (:routes body))))
                                                    :routes (:routes body)
                                                    :evaluatedAt now :expiresAt (+ now trust-window-ms)})
                              "approve-scope"
                              (let [entry {:id (:scopeId body) :status "approved"
                                           :tasks (vec (:tasks body)) :expiresAt (:expiresAt body)}]
                                (assoc record :scopes
                                       (conj (filterv #(not= (:scopeId body) (:id %)) (:scopes record)) entry)))
                              "activate" (assoc record :status "active")
                              "suspend" (assoc record :status "suspended")
                              (throw (ex-info "operator-operation-unknown" {:status 400})))
                       audit {:op (:op body) :actor (:operatorActor body) :caseId (:caseId body)
                              :at now :receiptId (str "op-" (:operatorActor body) "-" now)}]
                   (-> (save-state storage (assoc next :lastReview audit))
                       (.then (fn [_]
                                (response {:principalId (:principalId body)
                                           :op (:op body) :receiptId (:receiptId audit)
                                           :status (:status next)} 200))))))))))

;; --- personal API token registry -------------------------------------------
;; The edge verifies a PAT statelessly (HMAC); this registry gives each v2
;; token (tokenId) a life: label / issuedAt / revokedAt on the principal's
;; record, consulted by the bearer path on every request. Legacy v1 tokens
;; carry no id; `legacyRevokedAt` refuses all of them at once. Nothing here
;; holds a token or its hash — only the 12-hex id the token itself carries.
(def max-tokens-per-principal 32)

(defn- tokens-of [record] (vec (or (:tokens record) [])))

(defn- handle-tokens [storage op body]
  (let [now (.now js/Date)
        token-id (:tokenId body)]
    (-> (load-state storage)
        (.then (fn [record]
                 (let [record (or record {:status "none" :principalId (:principalId body)})
                       tokens (tokens-of record)]
                   (case op
                     :tokens-register
                     (cond
                       (not (and (string? token-id) (re-matches #"[0-9a-f]{12}" token-id)))
                       (response {:error "invalid-token-id"} 400)
                       (some #(= token-id (:id %)) tokens)
                       (response {:error "token-id-taken"} 409)
                       (>= (count (remove :revokedAt tokens)) max-tokens-per-principal)
                       (response {:error "too-many-tokens"} 409)
                       :else
                       (let [entry {:id token-id :issuedAt now
                                    :label (when (text? (:label body) 64) (:label body))}]
                         (-> (save-state storage (assoc record :tokens (conj tokens entry)))
                             (.then (fn [_] (response {:principalId (:principalId body) :token entry} 200))))))
                     :tokens-list
                     (response {:principalId (:principalId body)
                                :tokens (mapv #(select-keys % [:id :label :issuedAt :revokedAt]) tokens)
                                :legacyRevokedAt (:legacyRevokedAt record)} 200)
                     :tokens-revoke
                     (if-not (some #(= token-id (:id %)) tokens)
                       (response {:error "token-not-found"} 404)
                       (let [next (mapv #(if (and (= token-id (:id %)) (nil? (:revokedAt %)))
                                           (assoc % :revokedAt now) %) tokens)]
                         (-> (save-state storage (assoc record :tokens next))
                             (.then (fn [_] (response {:principalId (:principalId body)
                                                       :token (some #(when (= token-id (:id %)) %) next)} 200))))))
                     :tokens-revoke-legacy
                     (-> (save-state storage (assoc record :legacyRevokedAt now))
                         (.then (fn [_] (response {:principalId (:principalId body) :legacyRevokedAt now} 200))))
                     :tokens-check
                     ;; the bearer path's question: may this token act? A v2 id
                     ;; must be registered and unrevoked; a legacy token (no id)
                     ;; is admitted until legacy tokens are revoked.
                     (let [entry (when token-id (some #(when (= token-id (:id %)) %) tokens))
                           allowed? (if token-id
                                      (and (some? entry) (nil? (:revokedAt entry)))
                                      (nil? (:legacyRevokedAt record)))]
                       (if allowed?
                         (response {:principalId (:principalId body) :ok true
                                    :tokenId token-id :label (:label entry)} 200)
                         (response {:error (cond (nil? token-id) "legacy-token-revoked"
                                                 (nil? entry) "token-unknown"
                                                 :else "token-revoked")} 403))))))))))

(defn- route-op [path]
  (case path
    "/status" :status
    "/tokens/register" :tokens-register
    "/tokens/list" :tokens-list
    "/tokens/revoke" :tokens-revoke
    "/tokens/revoke-legacy" :tokens-revoke-legacy
    "/tokens/check" :tokens-check
    "/applications" :applications
    "/jobs/create" :jobs-create
    "/jobs/status" :jobs-status
    "/complete" :complete
    "/review" :review
    "/ekyc/start" :ekyc-start
    "/ekyc/webhook" :ekyc-webhook
    "/ekyc/status" :ekyc-status
    "/ekyc/self/webhook" :ekyc-self-webhook
    "/ekyc/kotoba-proof/submit" :ekyc-kotoba-proof-submit
    nil))

(defn- handle-self-verify-ekyc [env storage body]
  ;; Layer wiring for the Self (self.xyz) route: Svix-verified webhook evidence
  ;; applies the full approval chain. Admissibility (signature, flow binding,
  ;; ofac/minimumAge proof attributes, freshness) is delegated to the provider
  ;; adapter; raw + svix headers ride in the body (edge relays them verbatim).
  (let [now (.now js/Date)
        challenge {:sessionId (:sessionId body) :externalId (:externalId body)
                   :principal (:principalId body) :scopeId (:scopeId body)
                   :tasks (vec (:tasks body)) :consumed false
                   :createdAt (:challengeCreatedAt body) :expiresAt (:challengeExpiresAt body)}]
    (-> (js/Promise.resolve (providers/verify-event
         {:apiKey (aget env "SELF_API_KEY") :webhookSecret (aget env "SELF_WEBHOOK_SECRET")
          :flowId (aget env "SELF_FLOW_ID") :flowVersionId (aget env "SELF_FLOW_VERSION_ID")}
         challenge (:raw body) (:svixHeaders body) now))
        (.then (fn [evidence]
                 ;; Layer 4: duplicate-person resistance — the scoped nullifier is
                 ;; consumed atomically with the approval chain.
                 (let [nf (str "self-nullifier:" (:nullifier evidence))]
                   (-> (js-invoke storage "get" nf)
                       (.then (fn [existing]
                                (let [prior (decode existing)]
                                  (when (and prior (not= prior (:principalId body)))
                                    (throw (ex-info "duplicate-person-rejected" {:status 403}))))
                                (-> (load-state storage)
                                    (.then (fn [record]
                                             (let [record (or record {:status "none"
                                                                      :principalId (:principalId body)
                                                                      :scopes [] :applications []})
                                                   next (-> record
                                                            (assoc :policyVersion "whitehat-2026-09-12-v1")
                                                            (assoc :ekyc {:status "verified"
                                                                          :evidenceRef (:sessionId evidence)
                                                                          :verifiedAt now :expiresAt (+ now ekyc-ttl-ms)})
                                                            (assoc :screening {:status "clear"
                                                                               :evidenceRef (str "self:" (:eventId evidence))
                                                                               :checkedAt now
                                                                               :expiresAt (+ now screening-ttl-ms)})
                                                            (assoc :trust {:score (get weights "web-reviewed")
                                                                           :routes ["web-reviewed"]
                                                                           :evaluatedAt now
                                                                           :expiresAt (+ now trust-window-ms)}))
                                                   next (assoc next :scopes
                                                               (conj (filterv #(not= (:scopeId body) (:id %)) (:scopes record))
                                                                     {:id (:scopeId body) :status "approved"
                                                                      :tasks (vec (:tasks body))
                                                                      :expiresAt (+ now 86400000)}))
                                                   next (assoc next :status "active")]
                                               (-> (js-invoke storage "put" nf
                                                              (js/JSON.stringify (clj->js (:principalId body))))
                                                   (.then (fn [_] (save-state storage next)))
                                                   (.then (fn [_]
                                                            (response {:principalId (:principalId body)
                                                                       :status (:status next)
                                                                       :provider "self"
                                                                       :approvedBy "self-zk"} 200)))))))))))))))))


(defn- handle [state env path body]
  (let [storage (aget state "storage") now (.now js/Date)]
    (case (route-op path)
      :status (handle-status storage body)
      (:tokens-register :tokens-list :tokens-revoke :tokens-revoke-legacy :tokens-check)
      (handle-tokens storage (route-op path) body)
      :applications (handle-applications storage body)
      :jobs-create (-> (handle-jobs-create storage body)
                       ;; Fire the detached upstream call only after the 202/200 is
                       ;; committed; waitUntil keeps it alive beyond the request.
                       (.then (fn [resp]
                                (when (= 200 (.-status resp))
                                  (js-invoke state "waitUntil" (run-inference! env storage (:jobId body))))
                                resp)))
      :jobs-status (handle-jobs-status storage body)
      :complete (response {:error "sync-completion-retired-use-jobs"} 501)
      :review (-> (require-operator! env body now)
                  (.then (fn [_] (handle-review storage body))))
      :ekyc-start (handle-ekyc-start env storage body)
      :ekyc-webhook (handle-ekyc-webhook env storage body)
      :ekyc-self-webhook (handle-self-verify-ekyc env storage body)
       :ekyc-kotoba-proof-submit (run-proof-submit
                                 {:storage storage :env env :body body :now now
                                  :load-state load-state :save-state save-state :response response
                                  :hmac hmac! :ekyc-ttl-ms ekyc-ttl-ms :screening-ttl-ms screening-ttl-ms
                                  :trust-window-ms trust-window-ms})
      :ekyc-status (handle-ekyc-status storage body)
      (js/Promise.resolve (response {:error "not-found"} 404)))))

(deftype ResearchAuthority [^js state env]
  Object
  (alarm [_]
    ;; job retention: the only alarm this object arms (arm-retention!)
    (-> (sweep-jobs! (aget state "storage") (js/Date.now))
        (.catch (fn [e] (js/console.error "job-retention-sweep-failed" (str (or (.-message e) e)))))))
  (fetch [_ request]
    (if (= "https://research.internal" (.-origin (js/URL. (.-url request))))
      (-> (.json request)
          (.then (fn [body]
                   (.blockConcurrencyWhile state
                     (fn [] (handle state env (.-pathname (js/URL. (.-url request)))
                                    (js->clj body :keywordize-keys true))))))
          (.catch (fn [e]
                    (js/console.error "authority-op-failed" (.-stack e))
                    (let [data (ex-data e)
                          status (or (:status data) 500)]
                      (response (merge {:error (if (= 500 status) "authority-internal"
                                                 (or (.-message e) "authority-error"))}
                                       (select-keys data [:guardrailVersion :matches
                                                          :firewallVersion :tool]))
                                status)))))
      (js/Promise.resolve (response {:error "private-binding-required"} 403)))))

(defn make-research-authority [state env] (ResearchAuthority. state env))

;; Worker entry: no public routes; this fetch exists only so wrangler can upload
;; the script. Every request without the internal origin is refused.
;; Service bindings land here, not on the DO. Read the body, derive the
;; per-principal DO id, and forward so the atomic blockConcurrencyWhile
;; semantics live inside the Durable Object.
(defn fetch! [request ^js env _ctx]
  (if (= "https://org.internal" (.-origin (js/URL. (.-url request))))
    (-> (.json request)
        (.then (fn [body]
                 (let [ns (aget env "ORG_RECORDS")
                       id (.idFromName ns "orgs5")
                       stub (.get ns id)]
                   (.fetch stub (js/Request. (.-url request)
                                             #js {:method "POST"
                                                  :headers #js {"content-type" "application/json"}
                                                  :body (js/JSON.stringify body)}))))))
    (if-not (= "https://research.internal" (.-origin (js/URL. (.-url request))))
    (js/Promise.resolve (response {:error "private-binding-required"} 403))
    (-> (.json request)
        (.then (fn [body]
                 (let [ns (.-RESEARCH_RECORDS env)
                       id (.idFromName ns (or (.-principalId body) "anonymous"))
                       stub (.get ns id)]
                   (.fetch stub (js/Request. (.-url request)
                                             #js {:method "POST"
                                                  :headers #js {"content-type" "application/json"}
                                                  :body (js/JSON.stringify body)})))))))))


(def default #js {:fetch fetch!})
