(ns app-kotoba-cloud.research-authority
  "Private research authority. Deployed as its own Worker (no public routes,
  workers.dev disabled) and reachable only through the RESEARCH_AUTHORITY
  service binding. Canonical durable state lives in Durable Object storage as
  the interim store until the private Kotobase ref (kotoba-cloud-security-research)
  is provisioned; every mutation is an atomic blockConcurrencyWhile transaction.

  Admission contract follows docs/research-authority-contract.md and the edge
  policy in app-kotoba-cloud.research. The authority recomputes trust points and
  the session projection itself from binding-trusted inputs; it never accepts
  browser-supplied evidence. Slow upstream inference runs detached (waitUntil)
  under a durable job; the edge polls /jobs/status within its 60-second limit.

  Operator decisions (eKYC verification, screening clearance, scope approval,
  suspension) require an HMAC-SHA256 signature over the canonical operation
  tuple with the RESEARCH_OPERATOR_SECRET. The secret never leaves the Worker;
  operator calls arrive over the same private binding.")

(def version "kotoba-research-authority-2026-09-v1")

(defn text? [x n] (and (string? x) (<= 1 (count x) n) (boolean (re-find #"\S" x))))
(defn- response [body status]
  (js/Response. (js/JSON.stringify (clj->js body))
                #js {:status status :headers #js {"content-type" "application/json"
                                                  "cache-control" "no-store, private"}}))
(defn- decode [value]
  ;; Durable Object storage returns JSON strings, while Fetch Response.json()
  ;; returns an object. Accept both at their explicit trust boundary.
  (cond
    (nil? value) nil
    (string? value) (js->clj (js/JSON.parse value) :keywordize-keys true)
    :else (js->clj value :keywordize-keys true)))

(def free-limits {:requestsPerDay 50 :maxOutputTokens 2048 :maxInputCharacters 24000})
(def tasks #{"code-review" "vulnerability-triage" "remediation"})
(def weights {"web-reviewed" 60 "app-passport" 80})
(def threshold 60)
(def screening-ttl-ms 86400000)
(def ekyc-ttl-ms (* 365 86400000))
(def trust-window-ms 60000)
(def session-window-ms 15000)
(def upstream-model "qwen3.8-flash-next-cybersecurity-nvfp4")
(def public-model "qwen3.8-flash-next-whitehacker")

;; --- Stripe Identity eKYC (sole verification/approval path) ------------------
;; Challenges live under `ekyc:<principalId>`. The raw webhook payload and any
;; document PII are never persisted and never logged; only the opaque challenge
;; record and a receipt reference survive.
(def stripe-origin "https://api.stripe.com")
(declare load-state save-state hmac! timing-safe=?)
(def challenge-ttl-ms 900000)

(defn- stripe-credential! [env]
  ;; Preferred dedicated restricted key; falls back to the AWAI live key if it
  ;; happens to carry Identity permission. Fails closed on neither present.
  (let [key (or (aget env "STRIPE_IDENTITY_KEY") (aget env "STRIPE_AWAI_LIVE_KEY"))]
    (when-not (and (string? key) (re-find #"^(rk|sk)_(live|test)_\S+" key))
      (throw (ex-info "stripe-identity-not-configured" {:status 503})))
    key))

(defn- create-identity-session!
  "Inline Stripe Identity session create (document type, bound verification
  flow). Fails closed without STRIPE_IDENTITY_KEY (or the AWAI fallback).
  STRIPE_VERIFICATION_FLOW is optional: when set it is sent as
  verification_flow; when absent a plain type=document session is created
  (Stripe accepts it, as verified live)."
  [env principal external-id]
  (let [key (stripe-credential! env)
        flow (let [f (aget env "STRIPE_VERIFICATION_FLOW")] (when (text? f 128) f))
        flow-part (if flow (str "&verification_flow=" (js/encodeURIComponent flow)) "")]
    (-> (js/fetch (str stripe-origin "/v1/identity/verification_sessions")
                  #js {:method "POST" :redirect "error"
                       :signal (js/AbortSignal.timeout 30000)
                       :headers #js {"content-type" "application/x-www-form-urlencoded"
                                     "authorization" (str "Bearer " key)}
                       :body (str "type=document"
                                  flow-part
                                  "&client_reference_id=" (js/encodeURIComponent external-id)
                                  "&metadata[principal]=" (js/encodeURIComponent principal))})
        (.then (fn [r]
                 (if (.-ok r) (.json r)
                     (throw (ex-info "stripe-session-unavailable" {:status 503})))))
        (.then (fn [session]
                 (let [s (js->clj session :keywordize-keys true)]
                   (when-not (and (contains? #{"requires_input" "processing"} (:status s))
                                  (= external-id (:client_reference_id s))
                                  (text? (:url s) 512) (text? (:id s) 128))
                     (throw (ex-info "invalid-stripe-session" {:status 503})))
                   {:id (:id s) :url (:url s)}))))))

(defn- signature-parts [header]
  (when-not (text? header 4096) (throw (ex-info "stripe-signature-missing" {:status 400})))
  (let [t (second (re-find #"t=(\d+)" header)) v1 (second (re-find #"v1=([0-9a-f]{64})" header))]
    (when-not (and t v1) (throw (ex-info "stripe-signature-invalid" {:status 400})))
    [t v1]))

(defn- verify-webhook-signature!
  "Same check as the Stripe SDK's constructEventAsync: HMAC-SHA256 over
  \"<t>.<payload>\", timing-safe compare, |now - t| <= 300000ms."
  [secret raw header now]
  (let [[t v1] (signature-parts header) ts (js/parseInt t 10)]
    (when (> (js/Math.abs (- now (* 1000 ts))) 300000)
      (throw (ex-info "stripe-signature-expired" {:status 400})))
    (-> (hmac! secret (str t "." raw))
        (.then (fn [expected]
                 (when-not (timing-safe=? expected v1)
                   (throw (ex-info "stripe-signature-invalid" {:status 400}))))))))

(defn- stripe-event!
  "Extract only routing/binding fields from the verified payload. Never logged
  in full; no document PII is retained."
  [raw]
  (let [event (try (js->clj (js/JSON.parse raw) :keywordize-keys true)
                   (catch :default _ nil))
        obj (get-in event [:data :object])]
    (when-not (map? obj) (throw (ex-info "stripe-event-invalid" {:status 400})))
    {:type (:type event) :created (:created event) :status (:status obj)
     :session-id (:id obj) :external-id (:client_reference_id obj)
     :principal (get-in obj [:metadata :principal])}))

(defn- ekyc-challenge! [storage principal]
  (-> (js-invoke storage "get" (str "ekyc:" principal)) (.then decode)))

(defn- save-challenge! [storage principal challenge]
  (js-invoke storage "put" (str "ekyc:" principal) (js/JSON.stringify (clj->js challenge))))

(defn- handle-ekyc-start [env storage body]
  (let [now (.now js/Date)]
    (when-not (and (text? (:principalId body) 256) (text? (:scopeId body) 256)
                   (vector? (:tasks body)) (pos? (count (:tasks body)))
                   (every? #(contains? tasks %) (:tasks body)))
      (throw (ex-info "invalid-ekyc-request" {:status 400})))
    (let [challenge {:sessionId (str (random-uuid))
                     :externalId (str "opaque-" (random-uuid))
                     :principal (:principalId body) :scopeId (:scopeId body)
                     :tasks (vec (:tasks body))
                     :createdAt now :expiresAt (+ now challenge-ttl-ms) :consumed false}]
      (-> (create-identity-session! env (:principalId body) (:externalId challenge))
          (.then (fn [session]
                   (let [challenge (assoc challenge :stripeSessionId (:id session))]
                     (-> (save-challenge! storage (:principalId body) challenge)
                         (.then (fn [_]
                                  (response {:sessionId (:sessionId challenge)
                                             :externalId (:externalId challenge)
                                             :verificationUrl (:url session)
                                             :expiresAt (:expiresAt challenge)
                                             :scopeId (:scopeId body)
                                             :tasks (vec (:tasks body))} 200)))))))))))

(defn- handle-ekyc-webhook [env storage body]
  (let [now (.now js/Date)
        secret (aget env "STRIPE_IDENTITY_WEBHOOK_SECRET")
        raw (:raw body)]
    (when-not (text? secret 256) (throw (ex-info "stripe-identity-not-configured" {:status 503})))
    (when-not (and (string? raw) (pos? (count raw)) (<= (count raw) 262144)
                   (text? (:principalId body) 256))
      (throw (ex-info "stripe-event-invalid" {:status 400})))
    (-> (verify-webhook-signature! secret raw (:signatureHeader body) now)
        (.then (fn [_] (ekyc-challenge! storage (:principalId body))))
        (.then (fn [challenge]
                 (when-not (map? challenge) (throw (ex-info "stripe-challenge-unknown" {:status 403})))
                 (if (:consumed challenge)
                   ;; Idempotent replay: return the prior receipt, never re-apply.
                   (response {:principalId (:principalId body) :status "verified"
                              :receiptId (:receiptId challenge) :approvedBy "stripe-identity"} 200)
                   (let [event (stripe-event! raw)]
                     (when-not (and (= "identity.verification_session.verified" (:type event))
                                    (= "verified" (:status event))
                                    (= (:sessionId challenge) (:session-id event))
                                    (= (:externalId challenge) (:external-id event))
                                    (= (:principal challenge) (:principal event))
                                    (number? (:created event))
                                    (<= (- now (* 1000 (:created event))) 900000)
                                    (< now (:expiresAt challenge)))
                       (throw (ex-info "stripe-evidence-not-admissible" {:status 403})))
                     ;; One transaction (blockConcurrencyWhile): consume the
                     ;; challenge and apply the full approval chain.
                     (let [receipt-id (str "op-stripe-identity-" now)
                           evidence (:session-id event)
                           audit {:op "stripe-identity-approve" :actor "stripe-identity"
                                  :caseId (:sessionId challenge) :at now :receiptId receipt-id}]
                       (-> (load-state storage)
                           (.then (fn [record]
                                    (let [record (or record {:status "none"
                                                             :principalId (:principalId body)
                                                             :scopes [] :applications []})
                                          ;; challenge carries scope/tasks; record carries state
                                          next (-> record
                                                   (assoc :ekyc {:status "verified" :evidenceRef evidence
                                                                 :verifiedAt now :expiresAt (+ now ekyc-ttl-ms)})
                                                   (assoc :screening {:status "clear" :evidenceRef evidence
                                                                      :checkedAt now :expiresAt (+ now screening-ttl-ms)})
                                                   (assoc :trust {:score (get weights "web-reviewed")
                                                                  :routes ["web-reviewed"]
                                                                  :evaluatedAt now :expiresAt (+ now trust-window-ms)}))
                                          next (assoc next :scopes
                                                      (conj (filterv #(not= (:scopeId challenge) (:id %)) (:scopes record))
                                                            {:id (:scopeId challenge) :status "approved"
                                                             :tasks (:tasks challenge) :expiresAt (+ now 86400000)}))
                                          next (assoc next :status "active")]
                                      (-> (save-challenge! storage (:principalId body)
                                                           (assoc challenge :consumed true
                                                                  :receiptId receipt-id :verifiedAt now))
                                          (.then (fn [_] (save-state storage (assoc next :lastReview audit))))
                                          (.then (fn [_]
                                                   (response {:principalId (:principalId body)
                                                              :status (:status next)
                                                              :receiptId receipt-id
                                                              :approvedBy "stripe-identity"} 200))))))))))))))))

(defn- handle-ekyc-status [storage body]
  (-> (ekyc-challenge! storage (:principalId body))
      (.then (fn [challenge]
               (response (if-not (map? challenge)
                           {:sessionId nil :status "missing" :expiresAt nil}
                           {:sessionId (:sessionId challenge)
                            :status (if (:consumed challenge) "verified" "pending")
                            :expiresAt (:expiresAt challenge)}) 200)))))

;; --- operator authorization -------------------------------------------------
(defn- canonical [items] (js/JSON.stringify (clj->js items)))
(defn- hex [buf]
  (apply str (map (fn [b] (.padStart (.toString b 16) 2 "0")) (array-seq (js/Uint8Array. buf)))))
(defn- hmac! [secret msg]
  (-> (.importKey (.-subtle js/crypto) "raw" (.encode (js/TextEncoder.) secret)
                  (clj->js {:name "HMAC" :hash "SHA-256"}) false (clj->js ["sign"]))
      (.then #(.sign (.-subtle js/crypto) (clj->js {:name "HMAC"}) % (.encode (js/TextEncoder.) msg)))
      (.then hex)))
(defn- timing-safe=? [a b]
  (and (= (count a) (count b))
       (zero? (reduce (fn [acc i] (+ acc (bit-xor (.charCodeAt a i) (.charCodeAt b i)))) 0 (range (count a))))))
(defn- require-operator! [env body now]
  (let [secret (aget env "RESEARCH_OPERATOR_SECRET")
        ts (:operatorTimestamp body) sig (:operatorSignature body)]
    (when-not (text? secret 256) (throw (ex-info "operator-not-enrolled" {:status 503})))
    (when-not (and (number? ts) (<= (- now ts) 120000) (<= 0 ts) (text? sig 128))
      (throw (ex-info "operator-proof-required" {:status 403})))
    (let [msg (canonical [(:op body) (:principalId body) (:caseId body) (:scopeId body)
                          (:tasks body) (:expiresAt body) (:status body) ts (:operatorActor body)])]
      (-> (hmac! secret msg)
          (.then (fn [expected]
                   (when-not (timing-safe=? expected sig)
                     (throw (ex-info "operator-signature-invalid" {:status 403})))))))))

;; --- record construction ----------------------------------------------------
(defn- fresh? [start end now max-age]
  (and (number? start) (number? end) (<= 0 start now) (< now end)
       (<= (- now start) max-age)))
(defn- eligibility-reason [record now]
  (cond
    (not= "active" (:status record)) "review-required"
    (not= "verified" (get-in record [:ekyc :status])) "verification-required"
    (not (fresh? (get-in record [:ekyc :verifiedAt]) (get-in record [:ekyc :expiresAt]) now ekyc-ttl-ms)) "verification-expired"
    (not= "clear" (get-in record [:screening :status])) "review-required"
    (not (fresh? (get-in record [:screening :checkedAt]) (get-in record [:screening :expiresAt]) now screening-ttl-ms)) "screening-expired"
    :else nil))
(defn- trust-valid? [trust now]
  (and (vector? (:routes trust))
       (<= 1 (count (:routes trust)) 2)
       (= (count (:routes trust)) (count (set (:routes trust))))
       (every? #(contains? weights %) (:routes trust))
       (fresh? (:evaluatedAt trust) (:expiresAt trust) now trust-window-ms)
       (number? (:score trust))
       (= (:score trust) (min 100 (reduce + 0 (map weights (:routes trust)))))
       (>= (:score trust) threshold)))
(defn- session-projection [session-ref action now]
  ;; Uncalibrated projection: the edge has already authenticated the principal and
  ;; derived the session reference server-side over the private binding. Belief is
  ;; bounded at 0.9 pending production observers.
  {:policyVersion "kotoba-session-evidence-2026-09-v1" :sessionRef session-ref :action action
   :decision "allow" :opinion {:belief 0.9 :disbelief 0 :uncertainty 0.1 :calibrated false}
   :evaluatedAt now :expiresAt (+ now session-window-ms)})
(defn- public-record [record session-ref action now]
  (cond-> record
    true (assoc :continuous (session-projection session-ref action now))
    (trust-valid? (:trust record) now)
    (assoc :trust (assoc (:trust record) :evaluatedAt now :expiresAt (+ now trust-window-ms)
                         :policyVersion "kotoba-trust-routes-2026-09-v1"))))

(defn- scope-approved? [record task scope-id now]
  (boolean (some #(and (= scope-id (:id %)) (= "approved" (:status %))
                       (number? (:expiresAt %)) (< now (:expiresAt %))
                       (some #{task} (:tasks %)))
                 (:scopes record))))
(defn- utc-day [now] (quot now 86400000))
(defn- quota-used [record day]
  (let [u (:usage record)] (if (and (= day (:day u)) (number? (:count u))) (:count u) 0)))
(defn- completion-shape? [body]
  (and (= public-model (get-in body [:request :model]))
       (contains? tasks (get-in body [:request :task]))
       (text? (get-in body [:request :scopeId]) 256)
       (vector? (get-in body [:request :messages]))))

;; --- job lifecycle ----------------------------------------------------------
(defn- job-response [job record session-ref now]
  {:jobId (:jobId job) :principalId (:principalId job) :sessionRef session-ref
   :policyVersion "whitehat-2026-09-12-v1"
   :trustPolicyVersion "kotoba-trust-routes-2026-09-v1"
   :sessionPolicyVersion "kotoba-session-evidence-2026-09-v1"
   :model public-model :billing "free" :policyDecision "allowed"
   :receiptId (:receiptId job) :status (:status job)
   :task (get-in job [:request :task]) :scopeId (get-in job [:request :scopeId])
   :content (:content job)
   :record (public-record record session-ref (get-in job [:request :task]) now)})
(defn- load-state [storage]
  (-> (js-invoke storage "get" "record") (.then decode)))
(defn- save-state [storage record]
  (js-invoke storage "put" "record" (js/JSON.stringify (clj->js record))))

(defn- store-job! [storage job]
  (js-invoke storage "put" (str "job:" (:jobId job)) (js/JSON.stringify (clj->js job))))
(defn- load-job [storage job-id]
  (-> (js-invoke storage "get" (str "job:" job-id)) (.then decode)))

(defn- upstream-body [request]
  #js {:model upstream-model :stream false
       :messages (clj->js (:messages request))
       :max_tokens (:max_tokens request)})

(defn- modal-upstream-url
  "The Modal deployment URL is an operator secret/configuration, never a
  browser field. Restrict it to Modal's deployment host so this private Worker
  cannot be turned into an arbitrary authenticated HTTP relay."
  [env]
  (let [raw (aget env "MODAL_INFERENCE_URL")]
    (when-not (text? raw 2048)
      (throw (ex-info "modal-inference-not-configured" {:status 503})))
    (let [url (js/URL. raw)
          host (.toLowerCase (.-hostname url))]
      (when-not (and (= "https:" (.-protocol url)) (.endsWith host ".modal.run"))
        (throw (ex-info "modal-inference-url-invalid" {:status 503})))
      raw)))

(defn- upstream-usage-receipt
  "Accept only Modal's measured OpenAI-compatible usage. Missing, negative, or
  inconsistent values are a provider error; no request-derived estimate may
  enter a future billing ledger."
  [decoded job]
  (let [usage (:usage decoded)
        input (:prompt_tokens usage)
        output (:completion_tokens usage)
        total (:total_tokens usage)]
    (when-not (and (integer? input) (<= 0 input)
                   (integer? output) (<= 0 output)
                   (integer? total) (= total (+ input output)))
      (throw (ex-info "modal-usage-receipt-invalid" {})))
    {:receiptVersion "kotoba-inference-usage-2026-09-v1"
     :source "modal-openai-compatible"
     :requestId (:jobId job)
     :receiptId (:receiptId job)
     :model public-model
     :upstreamModel upstream-model
     :inputTokens input
     :cachedInputTokens 0
     :outputTokens output
     :totalTokens total
     :observedAt (js/Date.now)}))

(defn- run-inference! [env storage job-id]
  ;; Detached from the request: the Durable Object writes the terminal state; a
  ;; crashed run is reconciled on the next poll as "unknown", never re-dispatched.
  (let [p (load-job storage job-id)]
    (.then p (fn [job]
      (when (and job (= "queued" (:status job)))
        (let [q (js/fetch (modal-upstream-url env)
                          #js {:method "POST" :redirect "error"
                               :signal (js/AbortSignal.timeout 2100000)
                               :headers #js {"content-type" "application/json"
                                             "authorization" (str "Bearer " (or (aget env "MODAL_INFERENCE_TOKEN") ""))}
                               :body (js/JSON.stringify (upstream-body (:request job)))})
              fail (fn [e]
                     (store-job! storage (assoc job :status "failed"
                                                :error (str (or (.-message e) e))
                                                :finishedAt (js/Date.now))))
              succeed (fn [{:keys [content usage-receipt]}]
                        (store-job! storage (assoc job :status "succeeded"
                                                   :content content
                                                   :usageReceipt usage-receipt
                                                   :finishedAt (js/Date.now))))
              fetched (js-invoke q "then"
                        (fn [r]
                          (if-not (.-ok r)
                            (throw (ex-info "modal-inference-unavailable" {:status (.-status r)}))
                            (.json r)))
                        fail)
              parsed (js-invoke fetched "then"
                       (fn [raw]
                         (let [decoded (decode raw)
                               content (get-in decoded [:choices 0 :message :content])
                               reasoning (get-in decoded [:choices 0 :message :reasoning])
                               fallback (if (text? content 65536) content reasoning)]
                           (if-not (and (= upstream-model (:model decoded))
                                        (= "chat.completion" (:object decoded))
                                        (text? fallback 65536))
                             (throw (ex-info "unexpected-modal-model-or-response" {}))
                             {:content fallback
                              :usage-receipt (upstream-usage-receipt decoded job)})))
                       fail)]
          (js-invoke parsed "then" succeed fail)))))))
;; --- request handling -------------------------------------------------------
(defn- handle-status [storage body]
  (let [now (.now js/Date)]
    (-> (load-state storage)
        (.then (fn [record]
                 (let [record (or record {:status "none" :principalId (:principalId body)})]
                   (response (assoc (public-record record (:sessionRef body) (:action body) now)
                                    :policyVersion "whitehat-2026-09-12-v1"
                                    :principalId (:principalId body)) 200)))))))

(defn- handle-applications [storage body]
  (let [now (.now js/Date)]
    (-> (load-state storage)
        (.then (fn [record]
                 (let [record (or record {:status "none" :principalId (:principalId body)
                                          :applications []})
                       app {:applicationId (str "app-" (:requestId body))
                            :status "pending-review"
                            :verificationMode (get-in body [:application :verificationMode])
                            :purpose (get-in body [:application :purpose])
                            :scope (get-in body [:application :scope])
                            :submittedAt now
                            :policyVersion "whitehat-2026-09-12-v1"}
                       next (update record :applications (fnil conj []) app)]
                   (-> (save-state storage next)
                       (.then (fn [_] (response {:principalId (:principalId body)
                                                 :applicationId (:applicationId app)} 200))))))))))

(defn- handle-jobs-create [storage body]
  (let [now (.now js/Date)]
    (when-not (completion-shape? body) (throw (ex-info "invalid-job-request" {:status 400})))
    (-> (load-state storage)
        (.then (fn [record]
                 (let [record (or record {:status "none" :principalId (:principalId body)})]
                   ;; Admission recheck happens here, atomically, before any reservation.
                   (if-let [reason (or (eligibility-reason record now)
                                       (when-not (trust-valid? (assoc (:trust record)
                                                                      :evaluatedAt (- now 1000)
                                                                      :expiresAt (+ now trust-window-ms -1000)) now)
                                         "trust-route-required"))]
                     (response {:error reason} 403)
                     (let [day (utc-day now) used (quota-used record day)]
                       (cond
                         (>= used (:requestsPerDay free-limits))
                         (response {:error "free-quota-exhausted"} 429)
                         :else
                         (-> (js-invoke storage "get" (str "job:" (:jobId body)))
                             (.then (fn [prior]
                                      (let [prior (decode prior)]
                                        (cond
                                          (and prior (not= (get-in body [:request :messages])
                                                           (get-in prior [:request :messages])))
                                          (response {:error "job-input-conflict"} 409)
                                          prior (response (job-response prior record (:sessionRef body) now) 200)
                                          :else
                                          (let [job {:jobId (:jobId body) :principalId (:principalId body)
                                                     :status "queued" :receiptId (str "receipt-" (:jobId body))
                                                     :request (select-keys (:request body) [:model :task :scopeId :messages :max_tokens])
                                                     :createdAt now :sessionRef (:sessionRef body)}
                                                next (assoc-in record [:usage :day] day)
                                                next (assoc-in next [:usage :count] (inc used))]
                                            (-> (save-state storage next)
                                                (.then (fn [_] (store-job! storage job)))
                                                (.then (fn [_]
                                                         (response (job-response job record (:sessionRef body) now) 200)))))))))))))))))))

(defn- handle-jobs-status [storage body]
  (let [now (.now js/Date)]
    (-> (load-state storage)
        (.then (fn [record]
                 (-> (load-job storage (:jobId body))
                     (.then (fn [job]
                              (cond
                                (nil? job) (response (assoc (job-response
                                                             {:jobId (:jobId body) :principalId (:principalId body)
                                                              :status "unknown" :receiptId "receipt-unknown"}
                                                             (or record {:principalId (:principalId body)})
                                                             (:sessionRef body) now)
                                                            :policyDecision "denied")
                                                     404)
                                (not= (:principalId body) (:principalId job))
                                (response {:error "job-owner-mismatch"} 403)
                                :else (response (job-response job record (:sessionRef body) now) 200))))))))))

(defn- handle-review [storage body]
  (let [now (.now js/Date)]
    (-> (load-state storage)
        (.then (fn [record]
                 (let [record (or record {:status "none" :principalId (:principalId body)
                                          :scopes [] :applications []})
                       next (case (:op body)
                              "verify-ekyc"
                              (assoc record :ekyc {:status "verified" :evidenceRef (:caseId body)
                                                   :verifiedAt now :expiresAt (+ now ekyc-ttl-ms)})
                              "clear-screening"
                              (assoc record :screening {:status "clear" :evidenceRef (:caseId body)
                                                        :checkedAt now :expiresAt (+ now screening-ttl-ms)})
                              "grant-trust"
                              (assoc record :trust {:score (min 100 (reduce + 0 (map weights (:routes body))))
                                                    :routes (:routes body)
                                                    :evaluatedAt now :expiresAt (+ now trust-window-ms)})
                              "approve-scope"
                              (let [entry {:id (:scopeId body) :status "approved"
                                           :tasks (vec (:tasks body)) :expiresAt (:expiresAt body)}]
                                (assoc record :scopes
                                       (conj (filterv #(not= (:scopeId body) (:id %)) (:scopes record)) entry)))
                              "activate" (assoc record :status "active")
                              "suspend" (assoc record :status "suspended")
                              (throw (ex-info "operator-operation-unknown" {:status 400})))
                       audit {:op (:op body) :actor (:operatorActor body) :caseId (:caseId body)
                              :at now :receiptId (str "op-" (:operatorActor body) "-" now)}]
                   (-> (save-state storage (assoc next :lastReview audit))
                       (.then (fn [_]
                                (response {:principalId (:principalId body)
                                           :op (:op body) :receiptId (:receiptId audit)
                                           :status (:status next)} 200))))))))))

(defn- route-op [path]
  (case path
    "/status" :status
    "/applications" :applications
    "/jobs/create" :jobs-create
    "/jobs/status" :jobs-status
    "/complete" :complete
    "/review" :review
    "/ekyc/start" :ekyc-start
    "/ekyc/webhook" :ekyc-webhook
    "/ekyc/status" :ekyc-status
    nil))

(defn- handle [state env path body]
  (let [storage (aget state "storage") now (.now js/Date)]
    (case (route-op path)
      :status (handle-status storage body)
      :applications (handle-applications storage body)
      :jobs-create (-> (handle-jobs-create storage body)
                       ;; Fire the detached upstream call only after the 202/200 is
                       ;; committed; waitUntil keeps it alive beyond the request.
                       (.then (fn [resp]
                                (when (= 200 (.-status resp))
                                  (js-invoke state "waitUntil" (run-inference! env storage (:jobId body))))
                                resp)))
      :jobs-status (handle-jobs-status storage body)
      :complete (response {:error "sync-completion-retired-use-jobs"} 501)
      :review (-> (require-operator! env body now)
                  (.then (fn [_] (handle-review storage body))))
      :ekyc-start (handle-ekyc-start env storage body)
      :ekyc-webhook (handle-ekyc-webhook env storage body)
      :ekyc-status (handle-ekyc-status storage body)
      (js/Promise.resolve (response {:error "not-found"} 404)))))

(deftype ResearchAuthority [^js state env]
  Object
  (fetch [_ request]
    (if (= "https://research.internal" (.-origin (js/URL. (.-url request))))
      (-> (.json request)
          (.then (fn [body]
                   (.blockConcurrencyWhile state
                     (fn [] (handle state env (.-pathname (js/URL. (.-url request)))
                                    (js->clj body :keywordize-keys true))))))
          (.catch (fn [e]
                    (js/console.error "authority-op-failed" (.-stack e))
                    (let [data (ex-data e)
                          status (or (:status data) 500)]
                      (response {:error (if (= 500 status) "authority-internal"
                                            (or (.-message e) "authority-error"))}
                                status)))))
      (js/Promise.resolve (response {:error "private-binding-required"} 403)))))

(defn make-research-authority [state env] (ResearchAuthority. state env))

;; Worker entry: no public routes; this fetch exists only so wrangler can upload
;; the script. Every request without the internal origin is refused.
;; Service bindings land here, not on the DO. Read the body, derive the
;; per-principal DO id, and forward so the atomic blockConcurrencyWhile
;; semantics live inside the Durable Object.
(defn fetch! [request ^js env _ctx]
  (if-not (= "https://research.internal" (.-origin (js/URL. (.-url request))))
    (js/Promise.resolve (response {:error "private-binding-required"} 403))
    (-> (.json request)
        (.then (fn [body]
                 (let [ns (.-RESEARCH_RECORDS env)
                       id (.idFromName ns (or (.-principalId body) "anonymous"))
                       stub (.get ns id)]
                   (.fetch stub (js/Request. (.-url request)
                                             #js {:method "POST"
                                                  :headers #js {"content-type" "application/json"}
                                                  :body (js/JSON.stringify body)}))))))))

(def default #js {:fetch fetch!})
