(ns app-kotoba-cloud.account-copy-generated
  "GENERATED by scripts/translate-console-copy.cljk --source account — do not edit by hand.
   Copy for every public locale other than en / ja, machine-translated from the
   authored source over the OpenRouter API (keys: keywords for the console chrome,
   the English strings themselves for a body — app-kotoba-cloud.copy/txt-for answers
   by them). `provenance` names the model and date per locale; none of it is
   native-speaker reviewed (ADR-2609091700 permits machine translation and forbids
   claiming review). Regenerate a locale with --only <code>.")

(def provenance
