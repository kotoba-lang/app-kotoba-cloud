(ns app-kotoba-cloud.worker
  (:require [app-kotoba-cloud.database-session :as database-session]
            [app-kotoba-cloud.billing-gateway :as billing-gateway]
            [app-kotoba-cloud.database-gateway :as database-gateway]
            [app-kotoba-cloud.attribution :as attribution]
            [app-kotoba-cloud.boot :as boot]
            [app-kotoba-cloud.knowledge :as knowledge]
            [app-kotoba-cloud.funnel :as funnel]
            [app-kotoba-cloud.research-gateway :as research-gateway]
            [app-kotoba-cloud.research :as research]
            [app-kotoba-cloud.security-services :as security-services]
            [app-kotoba-cloud.security-fit :as security-fit]
            [app-kotoba-cloud.identity-gateway :as identity-gateway]
            [app-kotoba-cloud.org-gateway :as org-gateway]
            [app-kotoba-cloud.org-sso-gateway :as org-sso-gateway]
            [app-kotoba-cloud.org-registry :as org-registry]
            [app-kotoba-cloud.locale :as locale]
            [app-kotoba-cloud.profile :as profile]
            [app-kotoba-cloud.rootkey :as rootkey]
            [app-kotoba-cloud.pqc :as pqc]
            [app-kotoba-cloud.session :as session]
            [app-kotoba-cloud.pat :as pat]
            [app-kotoba-cloud.csp :as csp]
            [goog.object :as gobj]))

(def security-headers
  ;; connect-src stays 'self' for first-party funnel POSTs. freebuff.com is
  ;; allowed only so a measured bfcid can load the vendor tag. No OpenAI Ads
  ;; host is listed.
  {"content-security-policy" csp/public-document
   "cross-origin-opener-policy" "same-origin"
   "referrer-policy" "no-referrer"
   "x-content-type-options" "nosniff"
   "x-frame-options" "DENY"
   "permissions-policy" "camera=(), microphone=(), geolocation=(), payment=()"})

(defn response
  ([body status content-type]
   (response body status content-type {}))
  ([body status content-type extra-headers]
   (let [headers (js/Headers.)]
     (doseq [[k v] security-headers] (.set headers k v))
     (doseq [[k v] extra-headers] (.set headers k v))
     (.set headers "content-type" content-type)
     (js/Response. body #js {:status status :headers headers})))
  ([body] (response body 200 "text/plain; charset=utf-8")))

(defn json-response
  ([value] (json-response value 200))
  ([value status]
   (response (js/JSON.stringify (clj->js value) nil 2)
             status "application/json; charset=utf-8")))

(defn- boot-json-response [value]
  (response (js/JSON.stringify (clj->js value) nil 2)
            200 "application/json; charset=utf-8"
            {"cache-control" "public, max-age=60, must-revalidate"}))

(defn- private-json-response
  ([value] (private-json-response value 200))
  ([value status]
  (response (js/JSON.stringify (clj->js value))
            status "application/json; charset=utf-8"
            {"cache-control" "no-store, private"})))

(defn- session-response [value] (private-json-response value))

(declare fetch-viewer)

;; Isolate-memory ledger. This Worker has no KV or D1 binding; do not
;; invent one. Tests may replace the atom via `reset-funnel-store!`.
(defonce funnel-store (atom (funnel/empty-state)))

(defn reset-funnel-store!
  "Test hook. Production never seeds this atom."
  []
  (reset! funnel-store (funnel/empty-state)))

(defn- funnel-cookie-header [visitor-id]
  (str session/funnel-cookie-name "=" visitor-id
       "; Path=/; Max-Age=31536000; SameSite=Lax; Secure"))

(defn- request-funnel-id [request]
  (session/cookie-value (.get (.-headers request) "cookie")
                        session/funnel-cookie-name))

(defn- new-funnel-id []
  (try
    (.randomUUID js/crypto)
    (catch :default _
      (str "funnel-" (.now js/Date)))))

(defn- record-funnel-event!
  [event dedup-key source]
  (let [result (funnel/apply-event @funnel-store
                                   {:event event
                                    :dedup-key dedup-key
                                    :source source})]
    (reset! funnel-store (:state result))
    result))

(defn- persistence-for [_env]
  ;; No FUNNEL KV/D1 binding is declared in wrangler.jsonc. A future
  ;; binding may flip this; until then the HOLD stays isolate-memory.
  (funnel/persistence-report "isolate-memory"))

(defn- funnel-snapshot [env]
  (funnel/snapshot @funnel-store (persistence-for env)))

(defn- request-source [request search]
  (funnel/infer-source
   (or (attribution/click-id search)
       (attribution/click-id (str "?" (or (.get (.-headers request) "referer") ""))))))

(defn- route-funnel-read [env]
  (response (js/JSON.stringify (clj->js (funnel-snapshot env)) nil 2)
            200 "application/json; charset=utf-8"
            {"cache-control" "no-store"}))

(defn- parse-funnel-body [text]
  (when (and (string? text) (pos? (count text)) (<= (count text) 4096))
    (try
      (js->clj (js/JSON.parse text) :keywordize-keys true)
      (catch :default _ nil))))

(defn- route-funnel-event [request env]
  (let [content-type (or (.get (.-headers request) "content-type") "")]
    (cond
      (not (.startsWith content-type "application/json"))
      (private-json-response {:ok false :error "content-type-required"} 415)

      :else
      (-> (.text request)
          (.then
           (fn [text]
             (let [body (parse-funnel-body text)
                   event (funnel/event-name (or (:event body) (:name body)))
                   search (.-search (js/URL. (.-url request)))
                   source (or (funnel/source-name (:source body))
                              (funnel/infer-source (:bfcid body))
                              (request-source request search))
                   existing-id (or (request-funnel-id request)
                                   (:session body)
                                   (:visitor body))
                   visitor-id (or existing-id (new-funnel-id))
                   extra (when-not existing-id
                           {"set-cookie" (funnel-cookie-header visitor-id)})]
               (cond
                 (nil? event)
                 (private-json-response {:ok false :error "unknown-event"
                                         :events (vec funnel/event-names)} 400)

                 (= event "signup_completed")
                 (-> (fetch-viewer request)
                     (.then
                      (fn [viewer]
                        (if-not (:valid viewer)
                          (private-json-response
                           {:ok false
                            :error "principal-session-required"
                            :note "signup_completed is counted only after a valid Stable Principal session. A bfcid is not required."}
                           401)
                          (let [result (record-funnel-event!
                                        "signup_completed"
                                        (:principalId viewer)
                                        source)]
                            (response (js/JSON.stringify
                                       (clj->js {:ok true
                                                 :accepted (:accepted result)
                                                 :reason (:reason result)
                                                 :event "signup_completed"
                                                 :funnel (:funnel (funnel-snapshot env))}))
                                      200 "application/json; charset=utf-8"
                                      (merge {"cache-control" "no-store, private"} extra)))))))

                 :else
                 (let [result (record-funnel-event! event visitor-id source)]
                   (response (js/JSON.stringify
                              (clj->js {:ok true
                                        :accepted (:accepted result)
                                        :reason (:reason result)
                                        :event event
                                        :funnel (:funnel (funnel-snapshot env))}))
                             200 "application/json; charset=utf-8"
                             (merge {"cache-control" "no-store, private"} extra)))))))
          (.catch
           (fn [_]
             (private-json-response {:ok false :error "funnel-event-failed"} 400)))))))

(defn- emit-signup-completed! [request env viewer]
  (when (:valid viewer)
    (record-funnel-event! "signup_completed"
                          (:principalId viewer)
                          (request-source request (.-search (js/URL. (.-url request)))))))

(defn- emit-signup-intent! [request]
  (let [existing (request-funnel-id request)
        visitor-id (or existing (new-funnel-id))
        search (.-search (js/URL. (.-url request)))
        _ (record-funnel-event! "signup" visitor-id (request-source request search))]
    (when-not existing
      {"set-cookie" (funnel-cookie-header visitor-id)})))

(defn- redirect
  ([location]
   (redirect location {}))
  ([location extra-headers]
   (response "" 302 "text/plain; charset=utf-8"
             (merge {"location" location} extra-headers))))

(defn- fetch-viewer [request]
  (if-let [token (session/cookie-value (.get (.-headers request) "cookie")
                                       session/cookie-name)]
    (-> (js/fetch session/viewer-url
                  #js {:method "GET"
                       :headers #js {"accept" "application/json"
                                     "cookie" (str session/cookie-name "=" token)}})
        (.then (fn [upstream] (when (.-ok upstream) (.json upstream))))
        (.then (fn [payload]
                 (when payload
                   (session/viewer-model (js->clj payload :keywordize-keys true)))))
        (.catch (fn [_] nil)))
    (js/Promise.resolve nil)))

(defn- route-session [request env]
  (-> (fetch-viewer request)
      (.then (fn [viewer]
               (let [model (or viewer {:valid false})]
                 (emit-signup-completed! request env model)
                 (session-response model))))))

(defn- route-logout
  "Same-origin sign-out proxy. The authn cookie (gftd_session) is issued for
  the apex (kotoba.cloud), but the page CSP keeps connect-src 'self', so the
  browser cannot POST auth.kotoba.cloud/v1/logout directly. Forward the
  session cookie to the authn worker's POST /v1/logout and pass the
  clearing Set-Cookie back untouched."
  [request]
  (if-let [token (session/cookie-value (.get (.-headers request) "cookie")
                                       session/cookie-name)]
    (-> (js/fetch (str session/identity-logout-url)
                  #js {:method "POST"
                       :headers #js {"accept" "application/json"
                                     "cookie" (str session/cookie-name "=" token)}})
        (.then (fn [upstream]
                 (let [headers (js/Headers.)]
                   (.set headers "cache-control" "no-store, private")
                   (.set headers "content-type" "application/json")
                   (let [set-cookie (or (.get upstream "set-cookie") (.get upstream "Set-Cookie"))]
                     (when set-cookie (.append headers "set-cookie" set-cookie)))
                   (js/Response. (js/JSON.stringify #js {:ok true})
                                 #js {:status (.-status upstream) :headers headers}))))
        (.catch (fn [_]
                  (js/Response. (js/JSON.stringify #js {:ok false})
                                #js {:status 502
                                     :headers #js {"content-type" "application/json"
                                                   "cache-control" "no-store"}}))))
    (js/Response. (js/JSON.stringify #js {:ok false :error "session-required"})
                  #js {:status 401
                       :headers #js {"content-type" "application/json"
                                     "cache-control" "no-store"}})))

(defn- route-api-token
  "Same-origin POST that issues a stateless personal API token (PAT) for local
  CLI/IDE agents. Signed-in viewer required. The token is HMAC-backed (see
  app-kotoba-cloud.pat) and returned exactly once; it is never logged and
  never accepted in query strings. Fail closed when PAT_SIGNING_SECRET is
  absent. Optional JSON body: {\"label\": \"...\"} (<= 64 chars, display only)."
  [request env viewer]
  (let [origin (.get (.-headers request) "origin")
        content-type (or (.get (.-headers request) "content-type") "")
        secret (aget env pat/secret-name)]
    (cond
      (not (contains? research-gateway/origins origin))
      (private-json-response {:ok false :error "invalid-origin"} 403)

      (not (.startsWith content-type "application/json"))
      (private-json-response {:ok false :error "content-type-required"} 415)

      (not (string? secret))
      (private-json-response {:ok false :error "pat-not-configured"} 503)

      :else
      (-> (.text request)
          (.then (fn [text]
                   (let [body (try (js->clj (js/JSON.parse text) :keywordize-keys true)
                                   (catch :default _ nil))
                         label (:label body)]
                     (if (and (some? label)
                              (or (not (string? label)) (> (count label) 64)))
                       (private-json-response {:ok false :error "invalid-token-label"} 400)
                       (-> (pat/issue (:principalId viewer) secret)
                           (.then (fn [token]
                                    (private-json-response
                                     {:ok true :token token
                                      :label (when (seq label) label)
                                      :note "This token is shown once. Store it now. Revocation is by rotating the signing secret — contact support@kotoba.cloud."
                                      :issuedAt (.toISOString (js/Date.))}))))))))))))

(def publication-schema
  "https://kotoba.cloud/schemas/library-publication-request/v3")

(def transition-schema
  "https://kotoba.cloud/schemas/pq-key-transition-request/v1")

(defn- bounded-string? [value max-length]
  (and (string? value) (pos? (count value)) (<= (count value) max-length)))

(defn- valid-publication-request? [body]
  (let [signed (:signedRecord body)
        valid-until (when (string? (:valid_until signed))
                      (js/Date.parse (:valid_until signed)))
        issued-at (when (string? (:issuedAt body)) (js/Date.parse (:issuedAt body)))
        expires-at (when (string? (:expiresAt body)) (js/Date.parse (:expiresAt body)))
        now (.now js/Date)]
    (and (= publication-schema (:schema body))
         (bounded-string? (:requestId body) 128)
         (integer? (:keyEpoch body)) (pos? (:keyEpoch body))
         (number? issued-at) (= issued-at issued-at)
         (number? expires-at) (= expires-at expires-at)
         (<= (- now (* 60 1000)) issued-at (+ now (* 60 1000)))
         (< issued-at expires-at (min (+ issued-at (* 15 60 1000))
                                      (+ now (* 15 60 1000))))
         (bounded-string? (:namespace body) 128)
         (bounded-string? (:releaseCid body) 128)
         (bounded-string? (:recordCid body) 128)
         (bounded-string? (:publisher body) 256)
         (bounded-string? (:ipnsName body) 128)
         (or (= "https://api.kotoba.cloud" (:storageOrigin body))
             (= "https://kotobase.net" (:storageOrigin body)))
         (map? signed)
         (= (:ipnsName body) (:name signed))
         (= (:recordCid body) (:value signed))
         (integer? (:sequence signed))
         (<= 0 (:sequence signed) js/Number.MAX_SAFE_INTEGER)
         (= (:publisher body) (:controller_did signed))
         (= (:publisher body) (:public_key_multibase signed))
         (bounded-string? (:valid_until signed) 64)
         (number? valid-until)
         (= valid-until valid-until)
         (< now valid-until (+ now (* 31 24 60 60 1000)))
         (bounded-string? (:public_key_multibase signed) 256)
         (bounded-string? (:signature_multibase signed) 256))))

(defn- signed-payload-matches? [body payload]
  (and (= publication-schema (:schema payload))
       (= "library-publish" (:purpose payload))
       (= (:requestId body) (:requestId payload))
       (= (:issuedAt body) (:issuedAt payload))
       (= (:expiresAt body) (:expiresAt payload))
       (= (:keyEpoch body) (:keyEpoch payload))
       (= (:namespace body) (:namespace payload))
       (= (:releaseCid body) (:releaseCid payload))
       (= (:recordCid body) (:recordCid payload))
       (= (:publisher body) (:publisher payload))
       (= (:ipnsName body) (:ipnsName payload))
       (= (:storageOrigin body) (:storageOrigin payload))
       (= (:signedRecord body) (:signedRecord payload))))

(defn- valid-transition-request? [body]
  (let [issued-at (when (string? (:issuedAt body)) (js/Date.parse (:issuedAt body)))
        expires-at (when (string? (:expiresAt body)) (js/Date.parse (:expiresAt body)))
        rotate? (= "rotate" (:action body))
        revoke? (= "revoke" (:action body))
        now (.now js/Date)]
    (and (= transition-schema (:schema body))
         (bounded-string? (:transitionId body) 128)
         (number? issued-at) (= issued-at issued-at)
         (number? expires-at) (= expires-at expires-at)
         (<= (- now (* 60 1000)) issued-at (+ now (* 60 1000)))
         (< issued-at expires-at (min (+ issued-at (* 15 60 1000))
                                      (+ now (* 15 60 1000))))
         (or rotate? revoke?)
         (integer? (:expectedEpoch body)) (pos? (:expectedEpoch body))
         (bounded-string? (:currentKeyId body) 128)
         (map? (:currentApproval body))
         (if rotate?
           (and (bounded-string? (:nextKeyId body) 128)
                (not= (:currentKeyId body) (:nextKeyId body))
                (map? (:nextApproval body)))
           (and (nil? (:nextKeyId body)) (nil? (:nextApproval body)))))))

(defn- transition-payload-matches? [body payload]
  (and (= transition-schema (:schema payload))
       (= "pq-key-transition" (:purpose payload))
       (= (:transitionId body) (:transitionId payload))
       (= (:issuedAt body) (:issuedAt payload))
       (= (:expiresAt body) (:expiresAt payload))
       (= (:action body) (:action payload))
       (= (:expectedEpoch body) (:expectedEpoch payload))
       (= (:currentKeyId body) (:currentKeyId payload))
       (= (:nextKeyId body) (:nextKeyId payload))))

(defn- admit-pq-key [env principal-id body {:keys [key-id public-key]}]
  (let [registry (gobj/get env "PQ_KEY_REGISTRY")]
    (when-not (and registry (bounded-string? principal-id 256))
      (throw (ex-info "pqc-key-registry-unavailable" {:status 503})))
    (let [id (js-invoke registry "idFromName" principal-id)
          stub (js-invoke registry "get" id)]
      (-> (js-invoke stub "fetch" "https://pqc-key-registry.internal/admit"
                     #js {:method "POST"
                          :headers #js {"content-type" "application/json"}
                          :body (js/JSON.stringify
                                 #js {:keyId key-id :publicKey public-key
                                      :keyEpoch (:keyEpoch body)
                                      :requestId (:requestId body)
                                      :expiresAt (js/Date.parse (:expiresAt body))})})
          (.then (fn [result]
                   (-> (.json result)
                       (.then (fn [binding]
                                (if (.-ok result)
                                  (js->clj binding :keywordize-keys true)
                                  (throw (ex-info
                                          (or (aget binding "reason")
                                              (if (= 409 (.-status result))
                                                "pqc-key-conflict"
                                                "pqc-key-binding-failed"))
                                          {:status (if (= 409 (.-status result)) 409 503)}))))))))))))

(defn- transition-pq-key [env principal-id body current next-key]
  (let [registry (gobj/get env "PQ_KEY_REGISTRY")]
    (when-not (and registry (bounded-string? principal-id 256))
      (throw (ex-info "pqc-key-registry-unavailable" {:status 503})))
    (let [id (js-invoke registry "idFromName" principal-id)
          stub (js-invoke registry "get" id)
          path (str "https://pqc-key-registry.internal/" (:action body))
          command (cond-> {:currentKeyId (:key-id current)
                           :expectedEpoch (:expectedEpoch body)
                           :transitionId (:transitionId body)}
                    next-key (assoc :nextKeyId (:key-id next-key)
                                    :nextPublicKey (:public-key next-key)))]
      (-> (js-invoke stub "fetch" path
                     #js {:method "POST"
                          :headers #js {"content-type" "application/json"}
                          :body (js/JSON.stringify (clj->js command))})
          (.then (fn [result]
                   (-> (.json result)
                       (.then (fn [transition]
                                (if (.-ok result)
                                  (js->clj transition :keywordize-keys true)
                                  (throw (ex-info
                                          (or (aget transition "reason")
                                              "pqc-key-transition-failed")
                                          {:status (if (= 409 (.-status result)) 409 503)}))))))))))))

(defn- route-pq-key-transition [request env action]
  (let [origin (.get (.-headers request) "origin")
        content-type (or (.get (.-headers request) "content-type") "")]
    (cond
      (not= "https://kotoba.cloud" origin)
      (private-json-response {:ok false :error "invalid-origin"} 403)

      (not (.startsWith content-type "application/json"))
      (private-json-response {:ok false :error "content-type-required"} 415)

      :else
      (-> (.text request)
          (.then (fn [text]
                   (if (> (count text) 32768)
                     (throw (ex-info "request-too-large" {:status 413}))
                     (js->clj (js/JSON.parse text) :keywordize-keys true))))
          (.then (fn [body]
                   (when-not (= action (:action body))
                     (throw (ex-info "pq-key-action-mismatch" {:status 400})))
                   (when-not (valid-transition-request? body)
                     (throw (ex-info "invalid-pq-key-transition-request" {:status 400})))
                   (-> (fetch-viewer request)
                       (.then (fn [viewer]
                                (when-not (:valid viewer)
                                  (throw (ex-info "passkey-session-required" {:status 401})))
                                [body viewer])))))
          (.then (fn [[body viewer]]
                   (-> (pqc/verify-approval (:currentApproval body))
                       (.then (fn [current]
                                (when-not (and (= (:currentKeyId body) (:key-id current))
                                               (transition-payload-matches?
                                                body (:payload current)))
                                  (throw (ex-info "pqc-current-approval-mismatch"
                                                  {:status 400})))
                                (if (= "rotate" action)
                                  (do
                                    (when-not (= (get-in body [:currentApproval :payload])
                                                 (get-in body [:nextApproval :payload]))
                                      (throw (ex-info "pqc-transition-bytes-mismatch"
                                                      {:status 400})))
                                    (-> (pqc/verify-approval (:nextApproval body))
                                      (.then (fn [next-key]
                                               (when-not (and (= (:nextKeyId body)
                                                                 (:key-id next-key))
                                                              (transition-payload-matches?
                                                               body (:payload next-key)))
                                                 (throw (ex-info "pqc-next-approval-mismatch"
                                                                 {:status 400})))
                                               [body viewer current next-key]))))
                                  (js/Promise.resolve [body viewer current nil])))))))
          (.then (fn [[body viewer current next-key]]
                   (-> (transition-pq-key env (:principalId viewer) body current next-key)
                       (.then (fn [transition]
                                (private-json-response
                                 (cond-> {:ok true
                                          :schema "https://kotoba.cloud/schemas/pq-key-transition-receipt/v1"
                                          :action action
                                          :principalId (:principalId viewer)
                                          :transitionId (:transitionId body)
                                          :previousEpoch (:previousEpoch transition)
                                          :epoch (:epoch transition)
                                          :previousKeyId (:previousKeyId transition)
                                          :keyId (:keyId transition)
                                          :status (:status transition)
                                          :currentApprovalVerified true
                                          :transitionedAt (.toISOString (js/Date.))}
                                   next-key (assoc :nextApprovalVerified true))))))))
          (.catch (fn [error]
                    (private-json-response
                     {:ok false :error (or (.-message error) "pq-key-transition-failed")}
                     (or (:status (ex-data error)) 400))))))))

(defn- route-library-publish [request env]
  (let [origin (.get (.-headers request) "origin")
        content-type (or (.get (.-headers request) "content-type") "")]
    (cond
      (not= "https://kotoba.cloud" origin)
      (private-json-response {:ok false :error "invalid-origin"} 403)

      (not (.startsWith content-type "application/json"))
      (private-json-response {:ok false :error "content-type-required"} 415)

      :else
      (-> (.text request)
          (.then (fn [text]
                   (if (> (count text) 16384)
                     (throw (ex-info "request-too-large" {:status 413}))
                     (js->clj (js/JSON.parse text) :keywordize-keys true))))
          (.then (fn [body]
                   (if-not (valid-publication-request? body)
                     (throw (ex-info "invalid-publication-request" {:status 400}))
                     (-> (fetch-viewer request)
                         (.then (fn [viewer]
                                  (when-not (:valid viewer)
                                    (throw (ex-info "passkey-session-required" {:status 401})))
                                  [body viewer]))))))
          (.then (fn [[body viewer]]
                   (-> (pqc/verify-approval (:pqcApproval body))
                       (.then (fn [verified]
                                (when-not (signed-payload-matches? body (:payload verified))
                                  (throw (ex-info "pqc-payload-mismatch" {:status 400})))
                                (-> (admit-pq-key env (:principalId viewer) body verified)
                                    (.then (fn [binding] [body viewer verified binding]))))))))
          (.then (fn [[body viewer verified binding]]
                   (-> (js/fetch
                        "https://kotobase.net/xrpc/com.etzhayyim.apps.kotoba.ipns.publish"
                        #js {:method "POST"
                             :headers #js {"accept" "application/json"
                                           "content-type" "application/json"}
                             :body (js/JSON.stringify
                                    (clj->js (get-in verified [:payload :signedRecord])))})
                       (.then (fn [upstream]
                                (-> (.json upstream)
                                    (.then (fn [result]
                                             (if-not (.-ok upstream)
                                               (throw (ex-info "kotobase-rejected"
                                                               {:status 502
                                                                :upstream-status (.-status upstream)}))
                                               (private-json-response
                                                {:ok true
                                                 :schema "https://kotoba.cloud/schemas/library-publication-receipt/v2"
                                                 :namespace (:namespace body)
                                                 :releaseCid (:releaseCid body)
                                                 :recordCid (:recordCid body)
                                                 :ipnsName (:ipnsName body)
                                                 :publisher (:publisher body)
                                                 :principalId (:principalId viewer)
                                                 :activeDid (:activeDid viewer)
                                                 :pqcVerified true
                                                 :pqcSuite (:suite verified)
                                                 :pqcKeyId (:key-id verified)
                                                 :pqcKeyEpoch (:epoch binding)
                                                 :pqcKeyBinding (:binding binding)
                                                 :requestId (:requestId body)
                                                 :kotobase (js->clj result :keywordize-keys true)
                                                 :publishedAt (.toISOString (js/Date.))}))))))))))
          (.catch (fn [error]
                    (private-json-response
                     {:ok false :error (or (.-message error) "publication-failed")}
                     (or (:status (ex-data error)) 400))))))))

(defn with-security-headers
  ([asset] (with-security-headers asset {}))
  ([asset extra-headers]
   (let [headers (js/Headers. (.-headers asset))]
     (doseq [[k v] security-headers] (.set headers k v))
     (doseq [[k v] extra-headers] (when v (.set headers k v)))
     (js/Response. (.-body asset)
                   #js {:status (.-status asset)
                        :statusText (.-statusText asset)
                        :headers headers}))))

(defn- request-country [^js request]
  (or (when-let [cf (gobj/get request "cf")] (gobj/get cf "country"))
      (.get (.-headers request) "cf-ipcountry")))

(defn- locale-redirect
  ([location]
   (locale-redirect location 302))
  ([location status]
   (response "" status "text/plain; charset=utf-8"
             (merge {"location" location
                     "cache-control" "private, no-store"
                     "vary" "Accept-Language, Cookie, CF-IPCountry"}))))

(defn- route-static [request env path]
  (let [url (js/URL. (.-url request))
        decision (locale/static-decision
                  {:path path
                   :cookie (session/cookie-value (.get (.-headers request) "cookie")
                                                 locale/cookie-name)
                   :accept-language (.get (.-headers request) "accept-language")
                   :country (request-country request)})]
    (if-let [target (:redirect decision)]
      (locale-redirect (str target (.-search url)) 302)
      (let [canonical (:canonical decision)
            asset-path (or (:serve decision) path)]
        (-> (if (= asset-path path)
              (.fetch ^js (gobj/get env "ASSETS") request)
              (let [asset-url (js/URL. (.-url request))]
                (set! (.-pathname asset-url) asset-path)
                (.fetch ^js (gobj/get env "ASSETS")
                        (js/Request. (str asset-url) request))))
            (.then (fn [asset]
                     ;; Variant miss → serve the locale-free document in place.
                     (if (and (not= asset-path path)
                              (= (.-status asset) 404))
                       (.fetch ^js (gobj/get env "ASSETS") request)
                       asset)))
            (.then (fn [asset]
                     (if (and canonical (not= (.-status asset) 404))
                       (let [r (locale-redirect (str canonical (.-search url)) 301)]
                         (.set (.-headers r) "set-cookie"
                               (locale/cookie-header (:locale decision)))
                         r)
                       (with-security-headers
                        asset
                        (cond-> {"vary" "Accept-Language, Cookie, CF-IPCountry"}
                          (or (locale/apex-path? path)
                              (= path (locale/locale-path (:locale decision))))
                          (assoc "content-security-policy"
                                 (.replace (get security-headers "content-security-policy")
                                           "connect-src 'self'" "connect-src 'self' https://api.kotoba.cloud"))
                          (:set-cookie? decision)
                          (assoc "set-cookie" (locale/cookie-header (:locale decision)))))))))))))

(defn- boot-error [error status]
  (response (js/JSON.stringify (clj->js {:ok false :error error}))
            status "application/json; charset=utf-8"
            {"cache-control" "no-store"}))

(defn- route-bootstrap [request ^js env]
  (if (.has (.-headers request) "range")
    (boot-error "range-not-supported" 416)
    (let [method (.-method request)
          bucket (gobj/get env "PUBLIC_BLOCKS")
          key (str "ipld/" (:cid boot/loader))]
      (if-not bucket
        (boot-error "immutable-bootstrap-unavailable" 503)
        (-> (js-invoke bucket "get" key)
          (.then (fn [object]
                   (let [expected-length (str (:bytes boot/loader))]
                     (if-not (and object (= (:bytes boot/loader) (.-size object)))
                       (boot-error "immutable-bootstrap-unavailable" 502)
                       (let [headers (js/Headers.)]
                         (doseq [[k v] security-headers] (.set headers k v))
                         (.set headers "content-type" "application/octet-stream")
                         (.set headers "content-length" expected-length)
                         (.set headers "cache-control" "public, max-age=31536000, immutable")
                         (.set headers "etag" (str "\"sha256-" (:sha256 boot/loader) "\""))
                         (.set headers "digest" (str "sha-256=" (:sha256Base64 boot/loader)))
                         (.set headers "x-aiueos-cid" (:cid boot/loader))
                         (.set headers "accept-ranges" "none")
                         (js/Response. (when (= "GET" method) (.-body object))
                                       #js {:status 200 :headers headers}))))))
          (.catch (fn [_] (boot-error "immutable-bootstrap-unavailable" 502))))))))

(defn- route-boot-host [request env path]
  (let [method (.-method request)]
    (cond
      (not (contains? #{"GET" "HEAD"} method))
      (boot-error "method-not-allowed" 405)

      (= path "/.well-known/kotoba-identity.json")
      (json-response research/identity-profile)

      (= path "/health")
      (boot-json-response {:ok true :service "kotoba-cloud-aiueos-boot"
                           :channel "k16-candidate" :status "candidate"})

      (= path boot/catalog-path)
      (boot-json-response boot/catalog)

      (= path boot/bootstrap-path)
      (route-bootstrap request env)

      :else
      (boot-error "not-found" 404))))

(defn- normalize-finding
  "Coerce JSON-decoded finding fields to the shapes the ledger validates
  against: snake_case JSON keys become the schema's kebab keys, and string
  values for :service/:severity become keywords."
  [f]
  (let [f (cond-> f
            (contains? f :finding_id) (assoc :finding-id (get f :finding_id))
            (contains? f :first_seen) (assoc :first-seen (get f :first_seen))
            (contains? f :last_seen) (assoc :last-seen (get f :last_seen)))]
    (cond-> f
      (string? (:service f)) (update :service keyword)
      (string? (:severity f)) (update :severity keyword))))

(defn- parse-findings-payload
  "Accepts a bare JSON array or {findings:[...]}. Returns [ok findings]."
  [body]
  (cond
    (vector? body) [true body]
    (and (map? body) (vector? (:findings body))) [true (:findings body)]
    :else [false nil]))

(defn- route-security-findings [request]
  (let [content-type (or (.get (.-headers request) "content-type") "")]
    (if-not (.startsWith content-type "application/json")
      (private-json-response {:ok false :error {:code "content-type-required"}} 415)
      (-> (.text request)
          (.then
           (fn [text]
             (let [body (js->clj (js/JSON.parse text) :keywordize-keys true)
                   [ok? findings] (parse-findings-payload body)
                   normalized (mapv normalize-finding (or findings []))
                   first-bad (when ok?
                               (some (fn [[i f]] (when-let [err (security-services/finding-error f)]
                                                   (assoc err :index i)))
                                     (map-indexed vector normalized)))]
               (cond
                 (not ok?)
                 (private-json-response
                  {:ok false :error {:code "invalid-findings-payload"
                                     :hint "submit a JSON array or a {findings: [...]} object"}} 400)

                 first-bad
                 (private-json-response
                  {:ok false :error {:code "invalid-finding"
                                     :index (:index first-bad)
                                     :field (:field first-bad)
                                     :reason (:code first-bad)}} 400)

                 :else
                 (private-json-response
                  (merge {:ok true :accepted (count normalized)}
                         {:ledger (security-services/build-ledger normalized)}))))))))))

(defn- route-security-vulnerabilities [request]
  (let [raw (.get (.-searchParams (js/URL. (.-url request))) "findings")]
    (if (not raw)
      (private-json-response
       (merge {:ok true :accepted 0}
              {:ledger (security-services/build-ledger nil)}))
      (-> (js/Promise.resolve nil)
          (.then
           (fn [_]
             (let [body (js->clj (js/JSON.parse raw) :keywordize-keys true)
                   [ok? findings] (parse-findings-payload body)
                   normalized (mapv normalize-finding (or findings []))
                   first-bad (when ok?
                               (some (fn [[i f]] (when-let [err (security-services/finding-error f)]
                                                   (assoc err :index i)))
                                     (map-indexed vector normalized)))]
               (cond
                 (not ok?)
                 (private-json-response {:ok false :error {:code "invalid-findings-payload"}} 400)
                 first-bad
                 (private-json-response
                  {:ok false :error {:code "invalid-finding"
                                     :index (:index first-bad)
                                     :field (:field first-bad)
                                     :reason (:code first-bad)}} 400)
                 :else
                 (private-json-response
                  (merge {:ok true :accepted (count normalized)}
                         {:ledger (security-services/build-ledger normalized)}))))))))))

(defn route [request ^js env]
  (let [url (js/URL. (.-url request))
        path (.-pathname url)
        hostname (.-hostname url)
        method (.-method request)
        sign-in (session/apex-sign-in-location path (.-search url))]
    (cond
      (= hostname "boot.kotoba.cloud")
      (route-boot-host request env path)

      ;; Operator console: admin.kotoba.cloud serves only the console document
      ;; and the shared identity gateway. No marketing surface, no discovery,
      ;; noindex, no-store. The private authority still decides availability.
      (= hostname "admin.kotoba.cloud")
      (cond
        (and (= path "/v1/session") (= method "GET"))
        (route-session request env)

        (contains? research-gateway/paths path)
        (research-gateway/route request env fetch-viewer private-json-response)

        (identity-gateway/operation path)
        (identity-gateway/route request env fetch-viewer private-json-response)

        (= path "/health")
        (json-response {:ok true :service "kotoba-cloud-operator-console"})

        (contains? #{"/js/session.js" "/favicon.ico"} path)
        (-> (.fetch (gobj/get env "ASSETS") (js/Request. (str (.-origin url) path) request))
            (.then #(with-security-headers % {"cache-control" "public, max-age=3600"})))

        (#{"/" "/admin/" "/index.html"} path)
        (-> (.fetch (gobj/get env "ASSETS") (js/Request. (str (.-origin url) "/admin/") request))
            (.then #(with-security-headers % {"cache-control" "no-store, private"
                                             "content-security-policy" csp/admin-document
                                             "x-robots-tag" "noindex"
                                             "referrer-policy" "no-referrer"})))

        :else
        (json-response {:error {:code "not-found"}} 404))

      (database-session/paths path)
      (database-session/route request env private-json-response)

      (database-gateway/selected? path)
      (database-gateway/route request env)

      (contains? billing-gateway/paths path)
      (billing-gateway/route request env fetch-viewer private-json-response)

      (contains? knowledge/paths path)
      (knowledge/route request env)

      (identity-gateway/operation path)
      (identity-gateway/route request env fetch-viewer private-json-response)

      (and (contains? #{"/identity" "/identity/"} path) (= method "GET"))
      (-> (.fetch (gobj/get env "ASSETS") (js/Request. (str (.-origin url) "/identity/") request))
          (.then #(with-security-headers % {"cache-control" "no-store, private"
                                           "content-security-policy" csp/identity-document
                                           "permissions-policy" "camera=(self), microphone=(), geolocation=(), payment=()"})))

      (contains? org-gateway/paths path)
      (org-gateway/route request env fetch-viewer private-json-response)

      ;; Linked identities and organization SSO (ADR-2609151900): the apex
      ;; owns plan + org role and mints the entitlement; auth.kotoba.cloud
      ;; owns the IdP round trip. No session is minted on either side.
      (contains? org-sso-gateway/paths path)
      (org-sso-gateway/route request env fetch-viewer private-json-response)

      ;; "Continue with Google / GitHub" — a link-start on auth.kotoba.cloud,
      ;; not a sign-in: the provider names the account, the passkey proves it.
      (and (= method "GET") (re-matches #"^/sign-in/(google|github)$" path))
      (redirect (org-sso-gateway/link-start-location
                 (second (re-matches #"^/sign-in/(google|github)$" path))
                 (str "https://kotoba.cloud" (if (= "ja" (.get (.-searchParams url) "lang")) "/ja/" "/")))
                (emit-signup-intent! request))
      (and (= method "GET") (re-matches #"^/account/link/(google|github)$" path))
      (redirect (org-sso-gateway/link-start-location
                 (second (re-matches #"^/account/link/(google|github)$" path))
                 "https://kotoba.cloud/account/"))

      (and (contains? #{"/account" "/account/"} path) (= method "GET"))
      (-> (.fetch (gobj/get env "ASSETS") (js/Request. (str (.-origin url) "/account/") request))
          (.then #(with-security-headers % {"cache-control" "no-store, private"
                                           "content-security-policy" csp/account-document})))

      (contains? research-gateway/paths path)
      (research-gateway/route request env fetch-viewer private-json-response)

      (and (= path "/v1/libraries/publish") (= method "POST"))
      (route-library-publish request env)

      (and (= path "/v1/pq-keys/rotate") (= method "POST"))
      (route-pq-key-transition request env "rotate")

      (and (= path "/v1/pq-keys/revoke") (= method "POST"))
      (route-pq-key-transition request env "revoke")

      (and (= path "/api/funnel/event") (= method "POST"))
      (route-funnel-event request env)

      ;; Former kotobase.net surfaces. Operations resolve to the graph
      ;; workbench on the apex document; documentation is a static page.
      ;; graph.kotoba.cloud stays unprovisioned (one canonical origin).
      (and (= path "/graph") (= method "GET"))
      (redirect (if (= (locale/negotiate
                        {:path path
                         :cookie (session/cookie-value (.get (.-headers request) "cookie")
                                                       locale/cookie-name)
                         :accept-language (.get (.-headers request) "accept-language")
                         :country (request-country request)})
                       :ja)
                 "/ja/#knowledge/overview"
                 "/#knowledge/overview"))

      (and (= path "/v1/logout") (= method "POST"))
      (route-logout request)

      ;; Personal API token issuance (local CLI/IDE agents). Same-origin POST,
      ;; signed-in viewer, BEFORE the GET/HEAD 405 gate.
      (and (= path "/v1/account/api-token") (= method "POST"))
      (-> (fetch-viewer request)
          (.then (fn [viewer]
                   (if-not (:valid viewer)
                     (private-json-response {:ok false :error "sign-in-required"} 401)
                     (route-api-token request env viewer)))))

      ;; VM ledger API (PR: security-apps). Deterministic, stateless: POST
      ;; /v1/security/findings validates the submitted finding records and
      ;; returns the deduped scored ledger computed from the body itself;
      ;; GET /v1/security/vulnerabilities computes the same ledger from an
      ;; optional ?findings= JSON param. POST routes MUST precede the
      ;; 405 catch-all below.
      (and (= path "/v1/security/findings") (= method "POST"))
      (route-security-findings request)

      (and (= path "/v1/security/vulnerabilities") (#{"GET" "HEAD"} method))
      (route-security-vulnerabilities request)

      (not (#{"GET" "HEAD"} method))
      (response "method not allowed" 405 "text/plain; charset=utf-8")

      sign-in
      (redirect sign-in (emit-signup-intent! request))

      (and (= path "/api/funnel") (#{"GET" "HEAD"} method))
      (route-funnel-read env)

      (= path "/.well-known/kotoba-identity.json")
      (json-response research/identity-profile)

      ;; Organization trust registry (ADR-2609141633). Static content, but
      ;; served by the edge so the smoke environment (no file assets) sees it.
      (= path "/.well-known/kotoba-org-registry.json")
      ;; The private authority returns the COMPLETE registry document (static
      ;; policy + live orgs). Pass it through verbatim; if the authority is
      ;; unreachable, serve the static policy document — never an error page.
      (if-let [org-binding (aget env "ORG_AUTHORITY")]
        (-> (.fetch org-binding
                    (js/Request. "https://org.internal/registry"
                                 #js {:method "POST" :redirect "manual"
                                      :signal (js/AbortSignal.timeout 15000)
                                      :headers #js {"content-type" "application/json"}
                                      :body "{}"}))
            (.then (fn [r]
                     (if-not (.-ok r)
                       (json-response org-registry/registry)
                       (.then (.json r)
                              (fn [doc] (json-response (js->clj doc :keywordize-keys true)))))))
            (.catch (fn [_] (json-response org-registry/registry))))
        (json-response org-registry/registry))

      ;; Public did:webvh log per organization (ADR-2609141633). The path shape
      ;; matches the did:webvh URL transform for com-<handle>.kotoba.cloud.
      (and (.startsWith path "/.well-known/kotoba-org-dids/") (= method "GET"))
      (let [prefix "/.well-known/kotoba-org-dids/"
            handle (subs path (count prefix))
            ;; did:webvh URL transform: <domain>/did.jsonl — the log file is
            ;; part of the path, not the handle.
            handle (if (.endsWith handle "/did.jsonl")
                     (subs handle 0 (- (count handle) 10))
                     handle)
            org-binding (aget env "ORG_AUTHORITY")]
        (if (and org-binding (re-find #"^com-[a-z0-9][a-z0-9-]{2,62}\.kotoba\.cloud$" handle))
          (-> (.fetch org-binding
                      (js/Request. "https://org.internal/registry"
                                   #js {:method "POST" :redirect "manual"
                                        :signal (js/AbortSignal.timeout 15000)
                                        :headers #js {"content-type" "application/json"}
                                        :body (js/JSON.stringify (clj->js {:handle handle}))}))
              (.then (fn [r]
                       (if-not (.-ok r)
                         (json-response {:error {:code "org-did-not-found"}} 404)
                         (.then (.json r)
                                (fn [d]
                                  (let [doc (js->clj d :keywordize-keys true)
                                        entry (some (fn [o] (when (= handle (:handle o)) o))
                                                    (:organizations doc))]
                                    (js/Response. (str (or (:log entry) (:log doc)) "\n")
                                                  #js {:status (if (or (:log entry) (:log doc)) 200 404)
                                                       :headers #js {"content-type" (if (or (:log entry) (:log doc))
                                                                                      "application/jsonl; charset=utf-8"
                                                                                      "application/json")
                                                                     "cache-control" "public, max-age=3600"}}))))))))
          (json-response {:error {:code "not-found"}} 404)))

      ;; SECURE surface (orcarouter pattern): public metadata of the runtime
      ;; controls — guardrail templates, firewall tool map, compliance coverage.
      ;; Read-only; the authority enforces, the edge only describes.
      ;; Security-services suite catalog (describing only): the edge serves
      ;; the ONE canonical def; any enforcement stays on the private
      ;; authority.
      (= path "/v1/security/services")
      (json-response security-services/security-services)

      ;; Compliance Fit Finder (deterministic, no AI): transitive
      ;; service -> catalog-category -> framework-control expansion over the
      ;; committed compliance-catalog fit mapping. Query-param or path form.
      (and (= path "/v1/security/compliance-fit") (#{"GET" "HEAD"} method))
      (let [fw (.get (.-searchParams (js/URL. (.-url request))) "framework")
            fit (when fw (security-fit/fit fw))]
        (if fit
          (json-response (merge {:ok true} fit))
          (json-response {:ok false
                          :error {:code "unknown-framework"
                                  :framework fw
                                  :committed (vec security-fit/frameworks)}}
                         (if fw 404 400))))

      (.startsWith path "/v1/security/compliance-fit/")
      (let [fw (subs path (count "/v1/security/compliance-fit/"))
            fit (security-fit/fit fw)]
        (if fit
          (json-response (merge {:ok true} fit))
          (json-response {:ok false
                          :error {:code "unknown-framework"
                                  :framework fw
                                  :committed (vec security-fit/frameworks)}} 404)))

      (= path "/v1/secure")
      (json-response research/secure-profile)

      (= path "/health")
      (json-response {:ok true :service "kotoba-cloud-control-plane"})

      (= path "/v1/session")
      (route-session request env)

      (or (= path "/.well-known/kotoba-cloud.json")
          (= path "/v1/control-plane"))
      (json-response profile/control-plane)

      ;; Served, but never as the authority: the genesis digest is pinned by the
      ;; caller, and a plane that reads the pin from here and verifies the log
      ;; against it has trusted this apex for both halves. Refuses rather than
      ;; serving a log it cannot itself verify against the configured genesis.
      (= path rootkey/log-path)
      (let [{:keys [status body]}
            (rootkey/served profile/root-key-log
                            (fn [_records] {:refused :no-verifier-configured}))]
        (json-response body status))

      (= path boot/catalog-path)
      (boot-json-response boot/catalog)

      (= path "/schemas/control-plane/v1")
      (json-response {:type "object"
                      :required ["schema" "service" "roles" "deploy" "security"]
                      :constSchema profile/schema})

      (= path "/schemas/aiueos-boot-catalog/v1")
      (json-response {:type "object"
                      :required ["schema" "status" "target" "bootstrap" "update"
                                 "distribution" "qualification" "source"]
                      :constSchema boot/schema})

      (= path "/schemas/library-publication-request/v3")
      (json-response {:type "object"
                      :required ["schema" "requestId" "issuedAt" "expiresAt" "keyEpoch"
                                 "namespace" "releaseCid" "recordCid"
                                 "publisher" "ipnsName" "storageOrigin" "signedRecord"
                                 "pqcApproval"]
                      :constSchema publication-schema})

      (= path "/schemas/pq-key-transition-request/v1")
      (json-response {:type "object"
                      :required ["schema" "transitionId" "issuedAt" "expiresAt"
                                 "action" "expectedEpoch" "currentKeyId"
                                 "currentApproval"]
                      :rotateRequired ["nextKeyId" "nextApproval"]
                      :actions ["rotate" "revoke"]
                      :constSchema transition-schema})

      :else
      (route-static request env path))))

(def app
  #js {:fetch (fn [request env _ctx]
                (js/Promise.resolve (route request env)))})
