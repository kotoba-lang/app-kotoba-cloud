(ns app-kotoba-cloud.account-site
  "Account console information architecture. One document, five panels:
  1. session (Stable Principal), 2. identity verification (Stripe Identity
  only), 3. research eligibility + free allowance, 4. approved scopes,
  5. billing. Panels render as static shells; account-browser fills them
  with live state. Every value cell carries an explicit state (loading /
  error / empty / value) per the cloud-kotoba-dds console pattern — the
  bare dash is never a state. Japanese copy; the page is emitted as a ja
  document."
  (:require [jp-go-dds.core :as dds]
            [cloud-kotoba-dds.console :as console]))

(def css
  "Console-pattern CSS is owned by cloud-kotoba-dds.console/css; this string
   is concatenated by site.cljk. Local rules only add what the pattern lacks."
  ".kc-account{padding-block:var(--hig-spacing-6);display:grid;gap:var(--hig-spacing-5)}")

(defn- panel
  [title body {:keys [id] :or {id (str "ck-console-" (hash title))}}]
  (dds/card
   (console/panel title body {:id id})))

(defn panel-session []
  (panel "アカウント"
   (console/note "サインイン状態を確認しています…" {:id "account-session-status" :role "status"})
   [:div {:id "account-session"}
    [:div {:class "ck-console__row"}
     [:span {:class "ck-console__label"} "USERNAME"]
     [:span {:class "ck-console__value" :id "account-username"
             :data-state "loading"} "読み込んでいます…"]]
    [:div {:class "ck-console__row"}
     [:span {:class "ck-console__label"} "STABLE PRINCIPAL"]
     [:span {:class "ck-console__value" :id "account-principal"
             :data-state "loading"} "読み込んでいます…"]]]
   {:id "account-panel-session"}))

(defn panel-identity []
  (panel "本人確認（カード認証 / Stripe Identity）"
   [:div {:class "ck-console__row"}
    [:span {:class "ck-console__label"} "確認状態"]
    [:span {:class "ck-console__value" :id "account-ekyc-state"
            :data-state "loading"} "読み込んでいます…"]]
   [:div {:class "ck-console__row"}
    [:span {:class "ck-console__label"} "PROVIDER"]
    [:span {:class "ck-console__value"} "カード認証 (checkout.stripe.com) / Stripe Identity (verify.stripe.com)"]]
   (console/note
    "カード認証（OrcaRouter 方式）: クレジット・デビットカードを登録して完了します。プリペイドカード・バーチャルカードは使えません。カードは支払い能力の証明であり、書類による本人確認（Stripe Identity）と併用できます。カード情報は Stripe にのみ送られ、kotoba.cloud は状態・有効期限・証跡参照のみを保持します。確認は 365 日で失効します。")
   (dds/row
    (dds/button "本人確認を開始" {:id "account-ekyc-start" :type :solid-fill :disabled true})
    (dds/button "状態を更新" {:id "account-refresh" :type :outline}))
   (console/note "" {:id "account-ekyc-note" :role "status"})
   {:id "account-panel-identity"}))

(defn panel-eligibility []
  (panel "研究環境の利用資格"
   [:div {:class "ck-console__row"}
    [:span {:class "ck-console__label"} "状態"]
    [:span {:class "ck-console__value" :id "account-eligibility-state"
            :data-state "loading"} "読み込んでいます…"]]
   [:div {:class "ck-console__row"}
    [:span {:class "ck-console__label"} "FREE TIER"]
    [:span {:class "ck-console__value" :id "account-free-tier"
            :data-state "loading"} "読み込んでいます…"]]
   (console/note "" {:id "account-eligibility-note" :role "status"})
   {:id "account-panel-eligibility"}))

(defn panel-scopes []
  (panel "承認済みスコープ"
   [:div {:id "account-scopes"}
    (console/cell "状態" nil {:state :loading})]
   (console/note
    "調査権限の根拠ごとに承認されます。期限切れ・停止中のスコープでは推論できません。")
   {:id "account-panel-scopes"}))

(defn panel-org []
  (panel "組織（Org DID）"
   [:div {:id "account-orgs"}
    (console/cell "状態" nil {:state :loading})]
   [:div {:class "ck-console__row"}
    [:span {:class "ck-console__label"} "ORG HANDLE"]
    [:input {:id "account-org-handle" :class "ck-console__value"
             :placeholder "com-example.kotoba.cloud" :maxlength 80}]]
   (dds/row
    (dds/button "組織を作成" {:id "account-org-create" :type :solid-fill :disabled true})
    (dds/button "状態を更新" {:id "account-refresh" :type :outline}))
   (console/note
    "組織は did:webvh DID として発行され、membership は検証可能な VC で管理されます。作成者には owner ロールが付与されます。"
    {:id "account-org-note" :role "status"})
   {:id "account-panel-org"}))

(defn panel-billing []
  (panel "請求・クレジット"
   [:div {:id "account-billing"}
    (console/cell "状態" nil {:state :loading})]
   (dds/row
    (dds/button "料金ページへ" {:href "/billing/" :type :outline}))
   (console/note
    "本人確認済みの無料研究枠は課金されません。有料枠の購入は自動チャージなしです。")
   {:id "account-panel-billing"}))

(defn panel-cli []
  (panel "CLI / IDE から使う"
   (console/note
    "ローカルの CLI / IDE エージェントから研究 API を呼び出すための接続トークンを発行します。トークンは一度だけ表示され、二度と表示されません。")
   (dds/row
    (dds/button "接続トークンを発行" {:id "account-pat-create" :type :solid-fill})
    (dds/button "ガイドを開く" {:href "/ekyc.md" :type :outline}))
   (console/note "" {:id "account-pat-note" :role "status"})
   [:div {:id "account-pat-result" :hidden true}
    [:div {:class "ck-console__row"}
     [:span {:class "ck-console__label"} "接続トークン（一度だけ表示）"]
     [:span {:class "ck-console__value" :id "account-pat-token"} "—"]
     (dds/button "コピー" {:id "account-pat-copy" :type :outline :size "sm"})]
    [:div {:class "ck-console__row"}
     [:span {:class "ck-console__label"} "ENV"]
     [:span {:class "ck-console__value" :id "account-pat-env"} "—"]
     (dds/button "コピー" {:id "account-pat-copy-env" :type :outline :size "sm"})]
    [:div {:class "ck-console__row"}
     [:span {:class "ck-console__label"} "CURL"]
     [:span {:class "ck-console__value" :id "account-pat-curl"} "—"]
     (dds/button "コピー" {:id "account-pat-copy-curl" :type :outline :size "sm"})]
    [:p {:class "ck-console__note"}
     "Claude Code など MCP 対応エージェントは "
     [:a {:href "/mcp.json"} "/mcp.json"]
     " を参照してください。完全なガイドは "
     [:a {:href "/llms.txt"} "/llms.txt"]
     " と "
     [:a {:href "/ekyc.md"} "/ekyc.md"]
     " にあります。取り消しは署名鍵の交換（サポート連絡）で行われます: support@kotoba.cloud"]]
   {:id "account-panel-cli"}))

(defn panel-secure []
  "Compliance / Guardrails / Firewall panel (orcarouter pattern). The edge
  describes, the authority enforces — this panel renders /v1/secure state."
  (panel "セキュリティ管理 (Guardrails / Firewall / Compliance)"
   [:div {:id "account-secure"}
    (console/cell "Guardrails" nil {:state :loading})
    (console/cell "Firewall" nil {:state :loading})
    (console/cell "Compliance" nil {:state :loading})]
   (console/note
    "Guardrails は全リクエストに適用されるコンテンツポリシー (CSAM/CBRN/詐欺は block、秘密情報は mask)。Firewall はタスクツールの許可判定 (run は assurance rung で決まる)。Coverage は自動実行制御のみで、認証ではありません。")
   (dds/row
    (dds/button "状態を更新" {:id "account-refresh" :type :outline})
    (dds/button "ポリシー全文" {:href "/security/aup/" :type :outline}))
   {:id "account-panel-secure"}))

(defn panel-team []
  "Members panel (orcarouter pattern): the org membership roster with roles.
  The org authority owns roles; this surface lists and invites."
  (panel "チーム (Members)"
   [:div {:id "account-team"}
    (console/cell "状態" nil {:state :loading})]
   (console/note
    "組織に member を招待すると、API トークン・スコープ・請求を共有します。ロールは owner / admin / member / billing。")
   (dds/row
    (dds/button "状態を更新" {:id "account-refresh" :type :outline})
    (dds/button "組織を作成" {:id "account-org-create" :type :solid-fill :disabled true}))
   {:id "account-panel-team"}))

(defn section []
  [:section {:id "account-console" :class "kc-research-section"}
   (dds/container
    (dds/heading 1 "アカウント管理" {:size "36"})
    (into [:div {:class "kc-account"}]
          [(panel-session) (panel-identity) (panel-eligibility) (panel-scopes) (panel-org) (panel-team) (panel-secure) (panel-billing) (panel-cli)]))])
