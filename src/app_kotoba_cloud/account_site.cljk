(ns app-kotoba-cloud.account-site
  "Account console information architecture. One document, five panels:
  1. session (Stable Principal), 2. identity verification (Stripe Identity
  only), 3. research eligibility + free allowance, 4. approved scopes,
  5. billing. Panels render as static shells; account-browser fills them
  with live state. Japanese copy; the page is emitted as a ja document."
  (:require [jp-go-dds.core :as dds]))

(def css
  ".kc-account{padding-block:var(--hig-spacing-6);display:grid;gap:var(--hig-spacing-5)}.kc-account-section{border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-sm);padding:var(--hig-spacing-5);background:var(--hig-color-system-background)}.kc-account-section h2{margin-bottom:var(--hig-spacing-2)}.kc-account-row{display:flex;justify-content:space-between;gap:var(--hig-spacing-4);padding-block:var(--hig-spacing-2);border-bottom:1px solid var(--hig-color-separator);flex-wrap:wrap}.kc-account-row:last-child{border-bottom:none}.kc-account-label{font-family:var(--hig-font-mono);font-size:var(--hig-text-caption1-font-size);font-weight:700;color:var(--hig-color-secondary-label)}.kc-account-value{font-family:var(--hig-font-mono);overflow-wrap:anywhere}.kc-account-state{font-weight:700}.kc-account-state[data-state=ok]{color:var(--hig-color-tint)}.kc-account-state[data-state=action]{color:var(--hig-color-primitive-orange-700,#c25700)}.kc-account-state[data-state=off]{color:var(--hig-color-secondary-label)}.kc-account-note{color:var(--hig-color-secondary-label);font-size:var(--hig-text-caption1-font-size)}")

(defn panel-session []
  (dds/card
   (dds/heading 2 "アカウント" {:size "24"})
   [:div {:id "account-session" :class "kc-account"}
    [:div {:class "kc-account-row"}
     [:span {:class "kc-account-label"} "USERNAME"]
     [:span {:class "kc-account-value" :id "account-username"} "—"]]
    [:div {:class "kc-account-row"}
     [:span {:class "kc-account-label"} "STABLE PRINCIPAL"]
     [:span {:class "kc-account-value" :id "account-principal"} "—"]]
    [:p {:id "account-session-status" :role "status" :class "kc-account-note"}
     "サインイン状態を確認しています…"]]))

(defn panel-identity []
  (dds/card
   (dds/heading 2 "本人確認（Stripe Identity のみ）" {:size "24"})
   [:div {:class "kc-account-row"}
    [:span {:class "kc-account-label"} "確認状態"]
    [:span {:class "kc-account-state" :id "account-ekyc-state" :data-state "off"} "—"]]
   [:div {:class "kc-account-row"}
    [:span {:class "kc-account-label"} "PROVIDER"]
    [:span {:class "kc-account-value"} "Stripe Identity (verify.stripe.com)"]]
   [:p {:class "kc-account-note"}
    "書類と顔写真は Stripe にのみ送られ、kotoba.cloud は状態・有効期限・証跡参照のみを保持します。確認は 365 日で失効します。"]
   (dds/row
    (dds/button "本人確認を開始" {:id "account-ekyc-start" :type :solid-fill :disabled true})
    (dds/button "状態を更新" {:id "account-refresh" :type :outline}))
   [:p {:id "account-ekyc-note" :class "kc-account-note" :role "status"}]))

(defn panel-eligibility []
  (dds/card
   (dds/heading 2 "研究環境の利用資格" {:size "24"})
   [:div {:class "kc-account-row"}
    [:span {:class "kc-account-label"} "状態"]
    [:span {:class "kc-account-state" :id "account-eligibility-state" :data-state "off"} "—"]]
   [:div {:class "kc-account-row"}
    [:span {:class "kc-account-label"} "FREE TIER"]
    [:span {:class "kc-account-value" :id "account-free-tier"} "—"]]
   [:p {:id "account-eligibility-note" :class "kc-account-note" :role "status"}]))

(defn panel-scopes []
  (dds/card
   (dds/heading 2 "承認済みスコープ" {:size "24"})
   [:div {:id "account-scopes" :class "kc-account"}]
   [:p {:class "kc-account-note"}
    "調査権限の根拠ごとに承認されます。期限切れ・停止中のスコープでは推論できません。"]))

(defn panel-billing []
  (dds/card
   (dds/heading 2 "請求・クレジット" {:size "24"})
   [:div {:id "account-billing" :class "kc-account"}
    [:p {:id "account-billing-state" :class "kc-account-note" :role "status"}
     "確認しています…"]]
   (dds/row
    (dds/button "料金ページへ" {:href "/billing/" :type :outline}))
   [:p {:class "kc-account-note"}
    "本人確認済みの無料研究枠は課金されません。有料枠の購入は自動チャージなしです。"]))

(defn section []
  [:section {:id "account-console" :class "kc-research-section"}
   (dds/container
    (dds/heading 1 "アカウント管理" {:size "36"})
    (into [:div {:class "kc-account"}]
          [(panel-session) (panel-identity) (panel-eligibility) (panel-scopes) (panel-billing)]))])
