(ns app-kotoba-cloud.models-site
  "The MANAGE › モデル console — the research models a principal can select,
  rendered from the SAME policy data the gateway admits
  (app-kotoba-cloud.research/models, free-limits, requirements). The
  browser adds what only the live surface knows: each model's current
  availability and the running policy version (/v1/models).

  Reference IA (OrcaRouter Models / Routing): title + one-line meaning, a
  table with explicit columns, the request shape the caller sends."
  (:require [jp-go-dds.core :as dds]
            [kotoba.lang.text :as str]
            [app-kotoba-cloud.research :as research]
            [cloud-kotoba-dds.console :as console]))

(def css
  (str
   ".kc-models{display:grid;gap:var(--hig-spacing-4);max-inline-size:64rem}"
   ".kc-models__lead{max-inline-size:48rem;color:var(--hig-color-secondary-label)}"
   ".kc-models table{inline-size:100%;border-collapse:collapse;font-size:var(--hig-text-footnote-font-size)}"
   ".kc-models th{text-align:start;font-family:var(--hig-font-mono);font-size:var(--hig-text-caption2-font-size);font-weight:700;letter-spacing:.06em;color:var(--hig-color-secondary-label);padding:var(--hig-spacing-2) var(--hig-spacing-3);border-block-end:1px solid var(--hig-color-separator)}"
   ".kc-models td{padding:var(--hig-spacing-3);border-block-end:1px solid var(--hig-color-separator);vertical-align:top;overflow-wrap:anywhere}"
   ".kc-models code{font-family:var(--hig-font-mono);font-size:var(--hig-text-caption1-font-size)}"
   ".kc-models__table{overflow-x:auto}"
   ".kc-models__limits{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,12rem),1fr));gap:var(--hig-spacing-3)}"
   ".kc-models__tile{border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-sm,8px);padding:var(--hig-spacing-4)}"
   ".kc-models__tile dt{font-family:var(--hig-font-mono);font-size:var(--hig-text-caption2-font-size);letter-spacing:.06em;color:var(--hig-color-secondary-label)}"
   ".kc-models__tile dd{margin:var(--hig-spacing-2) 0 0;font-family:var(--hig-font-mono);font-size:var(--hig-text-title2-font-size);font-weight:700}"
   ".kc-models pre{overflow-x:auto;padding:var(--hig-spacing-4);border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-sm);background:var(--hig-color-label);color:var(--hig-color-system-background);font-family:var(--hig-font-mono);line-height:1.7}"))

(def requirements
  "What a request must carry to be admitted — the gateway's list, in the
   person's words."
  [["authenticated-principal" "サインイン済み"]
   ["verified-ekyc" "本人確認済み"]
   ["current-aml-ctf-clearance" "AML/CTF 照合が有効"]
   ["current-trust-route" "信頼経路が有効"]
   ["approved-research-scope" "承認済みスコープ"]
   ["available-free-quota" "無料枠の残り"]])

(defn section []
  (let [{:keys [requestsPerDay maxOutputTokens maxInputCharacters]} research/free-limits]
    [:div {:class "kc-models"}
     (dds/heading 1 "モデル" {:size "36"})
     [:p {:class "kc-models__lead"}
      "研究 API で選べるモデル。既定は " [:code research/model-id] "。いずれも許可されたリクエストだけが到達します。"]
     [:p {:id "models-status" :role "status" :class "ck-console__note"} ""]
     [:section {:class "ck-console__panel"}
      [:h2 "選択できるモデル"]
      [:div {:class "kc-models__table"}
       [:table
        [:thead [:tr [:th "モデル"] [:th "提供状態"] [:th "出所"] [:th "帰属検証"]]]
        (into [:tbody]
              (for [[id {:keys [source strictAttribution]}] research/models]
                [:tr {:data-model id}
                 [:td [:code id] (when (= id research/model-id) [:span " " (console/badge "既定" {:state :ok})])]
                 ;; availability is live state: filled from /v1/models
                 [:td [:span {:class "ck-console__value" :data-model-availability id :data-state "empty"} "—"]]
                 [:td [:a {:href source} (last (str/split source #"/"))]]
                 [:td (if strictAttribution "上流が自身のモデル ID を返すことを要求" "応答の形と内容で検証")]]))]]]
     [:section {:class "ck-console__panel"}
      [:h2 "無料枠"]
      [:dl {:class "kc-models__limits"}
       [:div {:class "kc-models__tile"} [:dt "1 日のリクエスト"] [:dd requestsPerDay]]
       [:div {:class "kc-models__tile"} [:dt "出力トークン上限"] [:dd maxOutputTokens]]
       [:div {:class "kc-models__tile"} [:dt "入力文字数上限"] [:dd maxInputCharacters]]]
      [:p {:class "ck-console__note"} "本人確認済みの研究者の無料枠。有料枠は" [:a {:href "/billing/"} "料金・決済"] "で追加できます。"]]
     [:section {:class "ck-console__panel"}
      [:h2 "許可の条件"]
      [:div {:class "kc-models__table"}
       [:table
        [:thead [:tr [:th "条件"] [:th "意味"]]]
        (into [:tbody] (for [[k ja] requirements] [:tr [:td [:code k]] [:td ja]]))]]
      [:p {:class "ck-console__note"} "状態は" [:a {:href "/account"} "アカウント"] "で確認できます。"]]
     [:section {:class "ck-console__panel"}
      [:h2 "呼び出し方"]
      [:pre [:code (str "curl -s -X POST https://api.kotoba.cloud/v1/chat/completions \\\n"
                        "  -H \"Authorization: Bearer $KOTOBA_API_TOKEN\" \\\n"
                        "  -H \"content-type: application/json\" \\\n"
                        "  -d '{\"model\":\"" research/model-id "\",\"messages\":[{\"role\":\"user\",\"content\":\"…\"}]}'")]]
      [:p {:class "ck-console__note"} [:a {:href "/docs/reference/quickstart/"} "クイックスタート"] "に発行から最初のリクエストまでの手順があります。"]]]))
