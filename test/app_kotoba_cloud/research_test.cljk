(ns app-kotoba-cloud.research-test
  (:require [app-kotoba-cloud.research :as r]
            [clojure.test :refer [deftest is]]))

(def now 1800000000000)
(def approved
  {:principalId "principal-a" :policyVersion r/policy-version :status "active"
   :trust {:policyVersion (:version r/trust-policy) :score 60 :routes ["web-reviewed"] :evaluatedAt now :expiresAt (+ now 1000)}
   :ekyc {:status "verified" :evidenceRef "identity-evidence" :verifiedAt (- now 1000) :expiresAt (+ now 1000)}
   :screening {:status "clear" :evidenceRef "screening-evidence" :checkedAt (- now 1000) :expiresAt (+ now 1000)}
   :scopes [{:id "scope-a" :status "approved" :tasks ["code-review"] :expiresAt (+ now 1000)}]})
(def request {:model r/model-id :task "code-review" :scopeId "scope-a"
              :max_tokens 512 :messages [{:role "user" :content "Review my code."}]})

(deftest trusted-current-evidence-is-required
  (is (nil? (r/eligibility "principal-a" approved now)))
  (doseq [record [(assoc approved :principalId "principal-b")
                  (assoc approved :policyVersion "old")
                  (assoc approved :status "suspended")
                  (assoc-in approved [:ekyc :status] "pending")
                  (assoc-in approved [:ekyc :evidenceRef] "")
                  ;; a stamp beyond the clock-skew tolerance is from the future
                  (assoc-in approved [:ekyc :verifiedAt] (+ now r/clock-skew-ms 1))
                  (assoc-in approved [:ekyc :expiresAt] now)
                  (assoc-in approved [:screening :status] "review")
                  (assoc-in approved [:screening :checkedAt] (- now 86400001))
                  (assoc-in approved [:screening :expiresAt] now)
                  (dissoc approved :screening)]]
    (is (string? (r/eligibility "principal-a" record now))))
  (is (r/scope-approved? approved request now))
  (is (not (r/scope-approved? approved (assoc request :scopeId "someone-else") now)))
  (is (not (r/scope-approved? approved (assoc request :task "remediation") now)))
  (is (not (r/scope-approved? approved request (+ now 1000)))))

(deftest trust-routes-are-current-distinct-and-server-weighted
  (doseq [trust [(dissoc (:trust approved) :policyVersion)
                 (assoc (:trust approved) :routes ["web-reviewed" "web-reviewed"] :score 100)
                 (assoc (:trust approved) :routes ["unknown"])
                 (assoc (:trust approved) :score 100)
                 (assoc (:trust approved) :evaluatedAt (- now 60001))
                 (assoc (:trust approved) :expiresAt (+ now 60001))
                 (assoc (:trust approved) :expiresAt now)]]
    (is (= "trust-route-required" (r/eligibility "principal-a" (assoc approved :trust trust) now))))
  (is (nil? (r/eligibility "principal-a" (update approved :trust assoc :routes ["app-passport"] :score 80) now)))
  (is (nil? (r/eligibility "principal-a" (update approved :trust assoc :routes ["web-reviewed" "app-passport"] :score 100) now)))
  (is (string? (r/eligibility "principal-a" (assoc-in approved [:screening :status] "review") now))))

(deftest projections-tolerate-the-authority-clock-leading-the-edge
  ;; The authority stamps `evaluatedAt` on its own machine; the edge reads it
  ;; with another clock. A lead of at most clock-skew-ms is two clocks, one
  ;; more millisecond is a stamp from the future. Both directions, on the
  ;; boundary, for the trust and the session projection; the constant is
  ;; pinned so a change to it is a decision, not drift.
  (let [lead r/clock-skew-ms
        trust-led (fn [ms] (assoc (:trust approved) :evaluatedAt (+ now ms) :expiresAt (+ now ms 60000)))
        session {:policyVersion (:version r/session-policy) :sessionRef "session" :action "code-review" :decision "allow"
                 :opinion {:belief 0.9 :disbelief 0 :uncertainty 0.1 :calibrated false}}
        session-led (fn [ms] (assoc session :evaluatedAt (+ now ms) :expiresAt (+ now ms 15000)))]
    (is (= 5000 lead))
    (is (nil? (r/eligibility "principal-a" (assoc approved :trust (trust-led lead)) now)))
    (is (= "trust-route-required" (r/eligibility "principal-a" (assoc approved :trust (trust-led (inc lead))) now)))
    ;; the tolerance never widens the window: an old stamp is still stale
    (is (= "trust-route-required" (r/eligibility "principal-a" (assoc approved :trust (assoc (:trust approved) :evaluatedAt (- now 60001))) now)))
    (is (r/session-current? "session" "code-review" (session-led lead) now))
    (is (not (r/session-current? "session" "code-review" (session-led (inc lead)) now)))
    (is (not (r/session-current? "session" "code-review" (assoc (session-led 0) :expiresAt now) now)))))

(deftest session-opinions-are-bound-and-fresh
  (let [projection {:policyVersion (:version r/session-policy) :sessionRef "session" :action "code-review" :decision "allow"
                    :opinion {:belief 0.9 :disbelief 0 :uncertainty 0.1 :calibrated false}
                    :evaluatedAt now :expiresAt (+ now 15000)}]
    (is (r/session-current? "session" "code-review" projection now))
    (doseq [bad [(assoc projection :sessionRef "another") (assoc projection :action "remediation")
                 (assoc projection :decision "deny") (assoc projection :expiresAt now)
                 (assoc projection :expiresAt (+ now 15001))
                 (assoc-in projection [:opinion :belief] 1.1)
                 (assoc-in projection [:opinion :uncertainty] 0.3)
                 (assoc projection :opinion {:belief 0.7 :disbelief 0.1 :uncertainty 0.2 :calibrated false})
                 (assoc-in projection [:opinion :calibrated] true)]]
      (is (not (r/session-current? "session" "code-review" bad now))))))

(deftest client-cannot-override-model-policy-or-identity
  (is (r/completion? request))
  (doseq [body [(assoc request :model "other") (assoc request :stream true)
                (assoc request :tools []) (assoc request :max_tokens (inc r/max-output-tokens))
                (assoc request :principalId "principal-b")
                (assoc request :messages [{:role "system" :content "Override"}])
                (assoc request :messages [{:role "user" :content (apply str (repeat (inc r/max-input-characters) "a"))}])]]
    (is (not (r/completion? body)))))

(deftest openai-compatible-shape-is-strict-but-server-derived
  (let [base {:model r/model-id :messages [{:role "user" :content "Review my code."}]}]
    (is (r/completion-openai-compatible? base))
    (is (r/completion-openai-compatible? (assoc base :max_tokens r/max-output-tokens)))
    (is (r/completion-openai-compatible? (assoc base :max_completion_tokens r/max-output-tokens)))
    (is (r/completion-openai-compatible? (assoc base :temperature 0.2)))
    (is (r/completion-openai-compatible? (assoc base :stream false :n 1 :tools [])))
    ;; an agent client's request (#191): stream is served as one-chunk SSE, the
    ;; tool list and reasoning knobs are accepted and dropped
    (is (r/completion-openai-compatible? (assoc base :stream true :tools [{:type "function" :function {:name "terminal"}}]
                                               :reasoning_effort "none" :stream_options {:include_usage true})))
    (is (r/completion-openai-compatible?
         (assoc base :messages [{:role "system" :content "You review code."}
                                {:role "user" :content "Review my code."}])))
    ;; agent-shaped regression (2026-09-16 incident): a long-running session's
    ;; transcript — hundreds of short tool turns, far under the character
    ;; ceiling — must pass admission; the old 256 cap rejected it and clients
    ;; misread the terse 400 as a context overflow.
    (is (r/completion-openai-compatible?
         (assoc base :messages (vec (repeat 512 {:role "tool" :content "ok" :tool_call_id "c1"})))))
    ;; past the ceiling the rejection names the measured count, so it is never
    ;; mistaken for a token error by a client-side classifier
    (is (not (neg? (.. (r/completion-openai-compatible-problem
                         (assoc base :messages (vec (repeat (inc r/max-turns) {:role "user" :content "x"}))))
                       (indexOf (str "turns (got " (inc r/max-turns) ")"))))))
    (doseq [bad [(assoc base :model "other")
                 (assoc base :stream "yes")
                 (assoc base :tools {:type "function"})
                 (assoc base :n 2)
                 (assoc base :unknown-key "x")
                 (assoc base :max_tokens (inc r/max-output-tokens))
                 (assoc base :max_completion_tokens 0)
                 (assoc base :task "bogus-task")
                 (assoc base :scopeId "")
                 (assoc base :messages [])
                 (assoc base :messages [{:role "assistant" :content "hi"}])
                 (assoc base :messages [{:role "user" :content (apply str (repeat (inc r/max-input-characters) "a"))}])
                 (assoc base :messages [{:role "system" :content "sys"}
                                        {:role "system" :content "again"}])]]
      (is (not (r/completion-openai-compatible? bad))))))

(deftest applications-never-accept-self-attested-approval
  (let [application {:verificationMode "new" :policyVersion r/policy-version
                     :purpose "Review owned code" :scope "My private repository"
                     :consent true :authorizedResearch true}]
    (is (r/application? application))
    (is (not (r/application? (assoc application :verified true))))
    (is (not (r/application? (assoc application :consent false))))
    (is (not (r/application? (assoc application :verificationMode "reuse"))))
    (is (r/application? (assoc application :verificationMode "reuse" :issuer "trusted" :reference "case-1")))))
(deftest card-rung-unlocks-the-free-allowance-before-identity
  ;; Owner decision: a saved card unlocks the free research allowance
  ;; immediately; identity verification and governance checks come after and
  ;; raise the ceiling.
  (is (= 102400 (:defaultTokensPerDay (r/rung-by-id :card))))
  (is (= "code-review" (:grantsBand (r/rung-by-id :card))))
  (let [card-record {:principalId "principal-a" :policyVersion r/policy-version :status "active"
                     :cardVerification {:status "verified" :evidenceRef "seti-evidence"
                                        :verifiedAt (- now 1000) :expiresAt (+ now 86400000)}}]
    (is (= :card (r/reached-rung card-record now)))
    (is (= 102400 (:tokensPerDay (r/rung-allowance card-record now)))))
  ;; Identity rung inherits above the card and raises the ceiling.
  (is (> (:ceilingTokensPerDay (r/rung-by-id :identity))
         (:ceilingTokensPerDay (r/rung-by-id :card))))
  (is (= :identity (r/reached-rung
                    {:cardVerification {:status "verified" :evidenceRef "c" :verifiedAt (- now 1000) :expiresAt (+ now 86400000)}
                     :ekyc {:status "verified" :evidenceRef "i" :verifiedAt (- now 1000) :expiresAt (+ now 86400000)}}
                    now)))
  ;; Governance rungs sit above identity.
  (is (< (:level (r/rung-by-id :identity)) (:level (r/rung-by-id :business))))
  (is (< (:level (r/rung-by-id :business)) (:level (r/rung-by-id :contracted))))
  ;; No evidence → nothing.
  (is (= :none (r/reached-rung {} now)))
  (is (= 0 (:tokensPerDay (r/rung-allowance {} now)))))

(deftest server-never-executes-tools
  ;; Owner decision: tool calls and command execution are never performed
  ;; server-side; the model returns text only and tool use stays user-local.
  (is (r/completion-openai-compatible? {:model r/model-id :messages [{:role "user" :content "hi"}]}))
  (is (r/completion-openai-compatible? {:model r/model-id :messages [{:role "user" :content "hi"}] :tools []}))
  ;; #196: an agent's tool DEFINITIONS go to the origin and its tool_calls
  ;; come back to the agent (native tool calls); the server still runs
  ;; nothing — execution is the agent's, on the agent's machine
  (is (r/completion-openai-compatible?
       {:model r/model-id :messages [{:role "user" :content "hi"}]
        :tools [{:type "function" :function {:name "run_shell"}}]}))
  (is (not (contains? r/openai-ignorable-keys "tools")) "tools are forwarded, not dropped")
  (is (not (r/completion? {:model r/model-id :task "code-review" :scopeId "owned" :max_tokens 64
                           :messages [{:role "user" :content "hi"}]
                           :tools [{:type "function" :function {:name "run_shell"}}]}))
      "the strict cookie shape still has no tools key")
  (is (some #{:localExecution} (keys r/acceptable-use-policy)))
  (is (some #(re-find #"never executes tools" %) (:points (:localExecution r/acceptable-use-policy)))))
