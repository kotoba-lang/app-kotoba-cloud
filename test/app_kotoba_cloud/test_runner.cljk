(ns app-kotoba-cloud.test-runner
  (:require [app-kotoba-cloud.research-test]
            [app-kotoba-cloud.profile-test]
            [app-kotoba-cloud.rootkey-test]
            [app-kotoba-cloud.delegation-root-test]
            [app-kotoba-cloud.guardian-test]
            [app-kotoba-cloud.advisory-panel-test]
            [app-kotoba-cloud.chain-facts-test]
            [app-kotoba-cloud.boot-test]
            [app-kotoba-cloud.pq-key-lifecycle-test]
            [app-kotoba-cloud.free-sites-test]
            [app-kotoba-cloud.session-test]
            [app-kotoba-cloud.funnel-test]
            [app-kotoba-cloud.attribution-test]
            [app-kotoba-cloud.site-test]
            [app-kotoba-cloud.locale-test]
            [clojure.test :as test]))

(defn -main [& _]
  (let [result (test/run-tests 'app-kotoba-cloud.research-test
                          'app-kotoba-cloud.profile-test
                          'app-kotoba-cloud.rootkey-test
                          'app-kotoba-cloud.delegation-root-test
                          'app-kotoba-cloud.guardian-test
                          'app-kotoba-cloud.advisory-panel-test
                          'app-kotoba-cloud.chain-facts-test
                               'app-kotoba-cloud.boot-test
                               'app-kotoba-cloud.pq-key-lifecycle-test
                               'app-kotoba-cloud.free-sites-test
                               'app-kotoba-cloud.session-test
                               'app-kotoba-cloud.funnel-test
                               'app-kotoba-cloud.attribution-test
                               'app-kotoba-cloud.site-test
                               'app-kotoba-cloud.locale-test)]
    (when (pos? (+ (:fail result) (:error result)))
      (System/exit 1))))
