(ns app-kotoba-cloud.locale-test
  (:require [app-kotoba-cloud.locale :as locale]
            [app-kotoba-cloud.public-locales :as locales]
            [clojure.test :refer [deftest is testing]]))

(deftest catalog-keeps-prior-locales-and-adds-origin-set
  (is (= [:en :zh-Hans :hi :es :ar :fr :bn :pt :id :ur :ru :de :ja :ko :pcm :arz :mr
          :jv :su :he :it :ar-MA]
         locales/locale-order))
  (doseq [loc [:jv :su :he :it :ar-MA]]
    (is (contains? locales/copy loc))
    (is (string? (get locales/native-names loc))))
  (is (= "rtl" (locales/direction :he)))
  (is (= "rtl" (locales/direction :ar-MA)))
  (is (= "ltr" (locales/direction :jv)))
  (is (= "ltr" (locales/direction :it))))

(deftest path-wins-over-cookie-header-and-country
  (is (= :su (locale/negotiate {:path "/su/" :cookie "he"
                                :accept-language "it" :country "IL"})))
  (is (= :he (locale/negotiate {:path "/he" :cookie "it" :country "IT"})))
  (is (= :zh-Hans (locale/negotiate {:path "/zh/" :cookie "id"})))
  (is (= :ar-MA (locale/negotiate {:path "/ar-MA/" :country "EG"})))
  (is (nil? (locale/path-locale "/legal/")))
  (is (nil? (locale/path-locale "/billing/")))
  (is (nil? (locale/path-locale "/api/funnel")))
  (is (nil? (locale/path-locale "/js/language-selector.js"))))

(deftest cookie-beats-accept-language-and-country
  (is (= :jv (locale/negotiate {:path "/" :cookie "jv"
                                :accept-language "id" :country "ID"})))
  (is (= :en (locale/negotiate {:path "/" :cookie "en" :country "ID"})))
  (is (= :it (locale/parse-locale "it-IT"))))

(deftest accept-language-beats-country-and-can-select-jv-su
  (is (= :id (locale/negotiate {:path "/" :accept-language "id,en;q=0.8"
                                :country "IT"})))
  (is (= :he (locale/negotiate {:path "/" :accept-language "he-IL,he;q=0.9,en;q=0.4"
                                :country "DE"})))
  (is (= :jv (locale/negotiate {:path "/" :accept-language "jv;q=0.9,id;q=0.8"
                                :country "ID"})))
  (is (= :su (locale/accept-language-locale "su-ID,su;q=0.8")))
  (is (= :ar-MA (locale/accept-language-locale "ar-MA,ar;q=0.8")))
  (is (= :arz (locale/accept-language-locale "ar-EG,ar;q=0.5")))
  (is (= :zh-Hans (locale/accept-language-locale "zh-CN,zh;q=0.8,en;q=0.2")))
  (is (= :he (locale/accept-language-locale "iw")))
  (is (= :ar (locale/accept-language-locale "ar"))))

(deftest country-map-never-selects-jv-or-su
  (doseq [[country loc] [["ID" :id] ["IL" :he] ["KR" :ko] ["ES" :es]
                         ["IT" :it] ["DE" :de] ["MA" :ar-MA] ["EG" :arz]]]
    (is (= loc (locale/country-locale country)) country)
    (is (= loc (locale/negotiate {:path "/" :country country}))))
  (is (= :en (locale/negotiate {:path "/" :country "US"})))
  (is (nil? (locale/country-locale "JV")))
  (is (not= :jv (locale/country-locale "ID")))
  (is (not= :su (locale/country-locale "ID")))
  (is (empty? (filter locale/country-never (vals locale/country-locales)))))

(deftest serve-in-place-never-redirects
  ;; shinkansen.locale contract: one locale-free URL per document; weaker
  ;; signals than the path rewrite the asset path in place, never 302.
  (is (= {:locale :en :serve nil}
         (select-keys (locale/static-decision {:path "/"}) [:locale :serve])))
  (is (= {:locale :id :serve "/id/"}
         (select-keys (locale/static-decision {:path "/" :country "ID"}) [:locale :serve])))
  (is (= {:locale :he :serve "/he/"}
         (select-keys (locale/static-decision {:path "/" :accept-language "he"}) [:locale :serve])))
  (is (= {:locale :jv :serve "/jv/"}
         (select-keys (locale/static-decision {:path "/" :cookie "jv" :country "ID"}) [:locale :serve])))
  ;; explicit locale prefix → canonicalized away (301) with cookie persisted
  (is (= {:locale :su :set-cookie? true :canonical "/"}
         (select-keys (locale/static-decision {:path "/su/" :cookie "he"}) [:locale :set-cookie? :canonical])))
  (is (= {:locale :en :set-cookie? true :canonical "/"}
         (select-keys (locale/static-decision {:path "/en/" :country "ID"}) [:locale :set-cookie? :canonical])))
  (is (= {:locale :ja :set-cookie? true :canonical "/billing/"}
         (select-keys (locale/static-decision {:path "/ja/billing/"}) [:locale :set-cookie? :canonical])))
  ;; shared infrastructure namespaces are never rewritten or canonicalized
  (is (nil? (locale/serve-path "/admin/" :ja)))
  (is (nil? (locale/canonical-path "/ja/admin/")))
  (is (nil? (locale/canonical-path "/v1/models")))
  ;; the console documents are variant roots (2026-09-15): account, and
  ;; the five that still answered in Japanese to an English reader
  (doseq [root ["account" "secure" "models" "identity" "security" "security-data"]]
    (is (= (str "/ja/" root "/") (locale/serve-path (str "/" root "/") :ja)) root)
    (is (= (str "/" root "/") (locale/canonical-path (str "/ja/" root "/"))) root))
  ;; billing/legal/security/csf2/docs fork; unknown locales don't
  (is (= "/ja/billing/" (locale/serve-path "/billing/" :ja)))
  (is (= "/ja/legal/tokushoho/" (locale/serve-path "/legal/tokushoho/" :ja)))
  (is (= "/ja/" (locale/serve-path "/" :ja)))
  (is (nil? (locale/serve-path "/billing/" :en)))
  (is (true? (locale/apex-path? "/")))
  (is (false? (locale/apex-path? "/id/"))))

(deftest language-switch-is-a-query-on-the-same-route
  ;; ?lang=<locale> is the language switch: served directly as that variant
  ;; (no redirect), the choice persisted; path > query > cookie.
  (is (= {:locale :ja :source :query :set-cookie? true :serve "/ja/billing/"}
         (locale/static-decision {:path "/billing/" :query "ja" :cookie "he"})))
  (is (= {:locale :en :source :query :set-cookie? true :serve nil}
         (locale/static-decision {:path "/docs/" :query "en" :cookie "ja"})))
  (is (= {:locale :ja :source :query :set-cookie? true :serve "/ja/"}
         (locale/static-decision {:path "/" :query "ja"})))
  ;; a value outside the catalog is ignored, not persisted (fail-closed):
  ;; the saved choice still decides, and nothing is written
  (is (= {:locale :he :set-cookie? false :serve "/he/docs/"}
         (select-keys (locale/static-decision {:path "/docs/" :query "klingon" :cookie "he"})
                      [:locale :set-cookie? :serve])))
  (is (nil? (locale/query-locale "klingon")))
  (is (nil? (locale/query-locale nil)))
  ;; an explicit prefix still wins over the query (compat 301)
  (is (= {:locale :su :canonical "/billing/"}
         (select-keys (locale/static-decision {:path "/su/billing/" :query "ja"}) [:locale :canonical])))
  ;; every root that site.cljk emits under /<locale>/ is a variant root —
  ;; /blog/ and /apps/ were emitted but not served (measured live 2026-09-15)
  (is (= "/ja/blog/" (locale/serve-path "/blog/" :ja)))
  (is (= "/ja/blog/observatory-launch/" (locale/serve-path "/blog/observatory-launch/" :ja)))
  (is (= "/ja/apps/" (locale/serve-path "/apps/" :ja)))
  ;; the client script reads the href's lang query
  (is (re-find #"searchParams\.get\('lang'\)" locale/language-cookie-script)))

(deftest cookie-header-is-host-scoped
  (is (= "kb_locale" locale/cookie-name))
  (is (re-find #"^kb_locale=he; Path=/; Max-Age=31536000; SameSite=Lax; Secure$"
               (locale/cookie-header :he)))
  (is (re-find #"kb_locale=" locale/language-cookie-script)))
