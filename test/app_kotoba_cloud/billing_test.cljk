(ns app-kotoba-cloud.billing-test
  (:require [clojure.test :refer [deftest is]] [app-kotoba-cloud.billing :as b] [app-kotoba-cloud.billing-limits :as limits]))
(deftest receipt-metering
  (let [r {:requestId "r1" :model "security" :inputTokens 100 :cachedInputTokens 40 :outputTokens 10 :occurredAt "2026-09-14T00:00:00Z"}
        e (b/token-event r "customer")]
    (is (= 60 (get-in e [:properties :input_tokens])))
    (is (= 40 (get-in e [:properties :cached_input_tokens])))
    (is (= "inference:r1" (:transaction_id e)))
    (is (not (contains? (:properties e) :prompt)))
    (doseq [bad [(assoc r :inputTokens -1) (assoc r :cachedInputTokens 101) (dissoc r :outputTokens)]]
      (is (thrown? #?(:clj Exception :cljs js/Error) (b/token-event bad "customer"))))))
(deftest invoice-grants
  (let [i {:id "in_1" :status "paid" :currency "usd" :billing_reason "subscription_cycle"}
        l {:id "il_1" :quantity 1 :period {:start 10 :end 20} :pricing {:price_details {:price "price_1"}}}
        prices {"price_1" "pro"}]
    (is (= 12 (:credits (b/paid-line i l prices))))
    (doseq [bad [(assoc i :status "open") (assoc i :currency "jpy") (assoc i :billing_reason "subscription_update")]]
      (is (nil? (b/paid-line bad l prices))))
    (is (nil? (b/paid-line i (assoc l :proration true) prices)))
    (is (nil? (b/paid-line i (assoc l :quantity 2) prices)))
    (is (nil? (b/paid-line i l {})))))
(deftest catalog-separation
  (is (= 5 (count b/plans)))
  (is (= "ai" (:scope (b/plan "ai-credits-25")))))

(deftest bundled-allowances
  (let [line {:id "invoice:line" :scope "platform" :credits 12 :gib 20 :start 10 :end 20}
        [ai storage] (b/allowance-grants line)]
    (is (= "ai" (:scope ai)))
    (is (= 12 (:credits ai)))
    (is (nil? (:gib ai)))
    (is (= "storage" (:scope storage)))
    (is (= 20 (:gib storage)))
    (is (nil? (:credits storage)))
    (is (not= (:id ai) (:id storage)))
    (is (= [10 20] [(:start ai) (:end storage)]))
    (is (= [ai storage] (b/allowance-grants line))))
  (is (nil? (b/plan "ai-builder")))
  (is (every? #(and (:gib %) (:credits %) (= "platform" (:scope %))) (remove :topup b/plans))))

(deftest admission-reservations
  (let [g {:id "included" :scope "ai" :amount 100 :start 10 :end 20 :topup false}
        l (limits/grant limits/empty-ledger g)
        r {:id "one" :scope "ai" :maximum 80 :now 15}
        held (limits/reserve l r)
        settled (limits/settle held {:id "one" :actual 50 :receiptId "receipt1"})]
    (is (= l (limits/grant l g)))
    (is (= held (limits/reserve held r)))
    (is (thrown? #?(:clj Exception :cljs js/Error) (limits/reserve held (assoc r :id "two" :maximum 30))))
    (is (thrown? #?(:clj Exception :cljs js/Error) (limits/reserve l (assoc r :scope "storage"))))
    (is (thrown? #?(:clj Exception :cljs js/Error) (limits/reserve l (assoc r :now 20))))
    (is (thrown? #?(:clj Exception :cljs js/Error) (limits/reserve held (assoc r :maximum 50))))
    (is (= 50 (get-in settled [:spent "included"])))
    (is (= settled (limits/settle settled {:id "one" :actual 50 :receiptId "receipt1"})))
    (is (thrown? #?(:clj Exception :cljs js/Error) (limits/settle settled {:id "one" :actual 49 :receiptId "receipt1"})))
    (is (limits/reserve settled (assoc r :id "two" :maximum 50)))
    (is (:frozen (limits/settle held {:id "one" :actual 81 :receiptId "receipt1"})))
    (is (thrown? #?(:clj Exception :cljs js/Error) (limits/reserve (assoc held :frozen true) (assoc r :id "two"))))))
(deftest included-before-topup
  (let [l (-> limits/empty-ledger
              (limits/grant {:id "z-included" :scope "ai" :amount 30 :start 10 :end 20 :topup false})
              (limits/grant {:id "a-topup" :scope "ai" :amount 100 :start 10 :end 50 :topup true})
              (limits/reserve {:id "r" :scope "ai" :maximum 80 :now 15})
              (limits/settle {:id "r" :actual 40 :receiptId "receipt"}))]
    (is (= 30 (get-in l [:spent "z-included"])))
    (is (= 10 (get-in l [:spent "a-topup"])))))

(deftest authoritative-rating
  (let [r {:requestId "rating-test" :model "fixture" :inputTokens 1000000
           :cachedInputTokens 200000 :outputTokens 100000 :occurredAt "2026-09-14T00:00:00Z"}]
    (is (= 750000 (:amount (b/receipt-charge "inference" r))))
    (is (= 1 (:amount (b/receipt-charge "inference" (assoc r :inputTokens 1 :cachedInputTokens 0 :outputTokens 0)))))
    (is (thrown? #?(:clj Exception :cljs js/Error) (b/receipt-charge "inference" (assoc r :cachedInputTokens 1000001)))))
  (is (= 278 (:amount (b/receipt-charge "storage" {:sampleId "hour" :databaseId "db" :bytes 1073741824 :seconds 3600 :occurredAt "2026-09-14T00:00:00Z"})))))
