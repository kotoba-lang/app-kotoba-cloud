;; Fixture browser test. Start a graph-dev render server, set PLAYWRIGHT_MODULE
;; when Playwright is not on NODE_PATH; uses the installed Chrome channel.
(ns graph-workbench-browser (:require ["node:child_process" :as child]))
(let [result (child/spawnSync js/process.execPath
              #js ["-e" "const {chromium}=require(process.env.PLAYWRIGHT_MODULE||'playwright');\n(async()=>{\n const browser=await chromium.launch({headless:true,channel:\"chrome\"});\n const page=await browser.newPage({viewport:{width:1440,height:1000}});\n const errors=[];page.on('pageerror',e=>errors.push(e.message));\n const calls=[];let denied=false;\n await page.route('https://**/*',route=>route.abort());\n await page.route('https://api.kotoba.cloud/v1/database/**',async route=>{\n  const request=route.request(); calls.push({url:request.url(),authorization:request.headers().authorization,body:request.postData()});\n  const path=new URL(request.url()).pathname.replace('/v1/database','');let body={};if(denied){await route.fulfill({status:401,contentType:'application/json',body:JSON.stringify({error:'Unauthorized'})});return;}\n  if(path.endsWith('usageGet'))body={tier:'fixture',tenantDid:'did:example:fixture',used_pins:2,quota_pins:10};\n  else if(path.endsWith('datomic.listDatabases'))body={databases:[{name:'fixture-db'}]};\n  else if(path.endsWith('datomic.q'))body={rows:[[1,':asset/name','fixture-server'],[1,':asset/owner',2],[2,':owner/name','fixture-owner']]};\n  else if(path.endsWith('savedQuery.list'))body={saved_queries:[]};\n  else if(path==='/pins')body={results:[]};\n  else if(path==='/v1/audit')body={data:[]};\n  await route.fulfill({status:200,contentType:'application/json',body:JSON.stringify(body),headers:{'access-control-allow-origin':new URL(process.env.GRAPH_PREVIEW_URL||'http://127.0.0.1:8847/ja/').origin,'access-control-allow-credentials':'true'}});\n });\n await page.route('**/v1/session',route=>route.fulfill({status:200,contentType:'application/json',body:JSON.stringify({valid:true})}));\n await page.goto((process.env.GRAPH_PREVIEW_URL||'http://127.0.0.1:8847/ja/')+'#knowledge/overview');\n await page.locator('#knowledge-connect [type=submit]').click();\n await page.locator('[data-field=tenant]').waitFor();\n await page.waitForFunction(()=>document.querySelector('[data-field=tenant]')?.textContent==='did:example:fixture');\n await page.evaluate(()=>{window.__graphTestSentinel='survives';});\n await page.locator('#knowledge-mount .kb-console-nav a[href=\"#knowledge/query\"]').click();\n await page.locator('#q-db').fill('fixture-db');\n await page.locator('#q-edn').fill('{:find [?e ?a ?v] :where [[?e ?a ?v]] :limit 25}');\n \n const run=page.locator('#q-run');await run.click();\n await page.waitForTimeout(300);\n await page.locator('#knowledge-mount .kb-console-nav a[href=\"#knowledge/graph\"]').click();\n await page.locator('#graph [data-explore-db]').fill('fixture-db');\n await page.locator('#graph [data-explore-load]').click();\n await page.waitForTimeout(300);\n await page.locator('.kb-graph-node').first().waitFor();console.log('graph nodes',await page.locator('.kb-graph-node').count());\n await page.locator('#knowledge-mount .kb-console-nav a[href=\"#knowledge/ontology\"]').click();\n if(!(await page.locator('#ontology').innerText()).includes(':asset/name'))throw Error('Ontology lost shared snapshot');\n await page.locator('#knowledge-mount .kb-console-nav a[href=\"#knowledge/query\"]').click();\n if(await page.locator('#q-db').inputValue()!=='fixture-db')throw Error('query state lost');\n if(await page.evaluate(()=>window.__graphTestSentinel)!=='survives')throw Error('document reload');\n if(process.env.GRAPH_SCREENSHOT)await page.screenshot({path:process.env.GRAPH_SCREENSHOT});\n for(const width of [320,390,768,1440]){await page.setViewportSize({width,height:900});const dims=await page.evaluate(()=>({w:innerWidth,scroll:document.documentElement.scrollWidth}));console.log('layout',width,dims);if(dims.scroll>dims.w)throw Error('Horizontal overflow at '+width); }\n await page.locator('#knowledge-disconnect').click();\n if(await page.locator('#knowledge-mount').innerHTML()!=='')throw Error('disconnect retained data');\n if(calls.some(x=>x.authorization))throw Error('session transport unexpectedly injected authorization');\n denied=true;\n await page.locator('#knowledge-connect [type=submit]').click();\n await page.waitForFunction(()=>document.getElementById('knowledge-state')?.textContent.includes('session expired'));\n if(await page.locator('#knowledge-mount').innerHTML()!=='')throw Error('Stale tenant displayed after denial');\n if(!(await page.locator('#knowledge-sign-in').isVisible()))throw Error('Sign-in recovery hidden');\n if(errors.length)throw Error(JSON.stringify(errors));\n console.log('PASS fixture browser: auth transport, graph, ontology, query persistence, SPA, disconnect; requests='+calls.length);\n await browser.close();\n})().catch(e=>{console.error(e);process.exit(1)});\n"] #js {:stdio "inherit"})]
  (js/process.exit (or (.-status result) 1)))
