<bpmndi:BPMNEdge bpmnElement="flow-9"><di:waypoint x="1720" y="415"/><di:waypoint x="1820" y="350"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge bpmnElement="flow-10"><di:waypoint x="1970" y="350"/><di:waypoint x="2070" y="350"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
