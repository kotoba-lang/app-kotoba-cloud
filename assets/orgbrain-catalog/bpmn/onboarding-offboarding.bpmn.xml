<bpmndi:BPMNEdge bpmnElement="flow-10"><di:waypoint x="1220" y="415"/><di:waypoint x="1570" y="350"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>