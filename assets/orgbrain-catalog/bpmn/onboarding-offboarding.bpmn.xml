<bpmndi:BPMNEdge bpmnElement="flow-5"><di:waypoint x="970" y="285"/><di:waypoint x="1070" y="285"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge bpmnElement="flow-6"><di:waypoint x="1220" y="285"/><di:waypoint x="1320" y="350"/></bpmndi:BPMNEdge>
