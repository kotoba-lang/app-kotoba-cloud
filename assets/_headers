# did:webvh root of kotoba.cloud (ADR-2609021500 in net-kotobase/control-plane):
# the log is JSON Lines, and a resolver may fetch it cross-origin.
/.well-known/did.jsonl
  Content-Type: application/jsonl; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
/.well-known/did-witness.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
/.well-known/did.json
  Content-Type: application/did+json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
# The Linked Verifiable Presentation did:webvh's `<did>/whois` DID URL path
# dereferences to (`/.well-known/whois` for a .well-known DID); `whois.vp` is
# the explicit #whois service endpoint. Same bytes at both paths.
/.well-known/whois.vp
  Content-Type: application/vp; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
/.well-known/whois
  Content-Type: application/vp; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/agent-quickstart.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300
/robots.txt
  Content-Type: text/plain; charset=utf-8
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/security-data/blocks/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
/security-data/*.json
  Access-Control-Allow-Origin: *
/security-data/*.jsonld
  Content-Type: application/ld+json; charset=utf-8
  Access-Control-Allow-Origin: *
